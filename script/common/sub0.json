[
 {
  "id": "c0:0125c",
  "jp": "おいおい……。\nまだ始まったばかりじゃねぇか。\n冗談……キツイぜ……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x129"
  ],
  "voice": 1,
  "who": "イシュト"
 },
 {
  "id": "c0:012a5",
  "jp": "こんな中途半端な所で終われねぇ。\n待ってろ皆、今……帰る。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x175"
  ],
  "voice": 2,
  "who": "イシュト"
 },
 {
  "id": "c0:012e3",
  "jp": "体がピクリともしねぇ……。\nゴメンルルゥ、俺の意思は奴らには\n届かなかったみてぇだ……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1c1"
  ],
  "voice": 3,
  "who": "イシュト"
 },
 {
  "id": "c0:0133e",
  "jp": "ベルガス。\nいつの間にか、強くなりやがって……\nへへ……完敗だ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x20d"
  ],
  "voice": 4,
  "who": "イシュト"
 },
 {
  "id": "c0:01381",
  "jp": "アシュレイ……！\n俺はまだ負けてねぇ！　俺の意思は\n……クソ……クソオオォォ！！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x259"
  ],
  "voice": 5,
  "who": "イシュト"
 },
 {
  "id": "c0:013d4",
  "jp": "ルルゥ、俺が、わからないのか……\nルルゥ……ルルゥ……！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2a5"
  ],
  "voice": 6,
  "who": "イシュト"
 },
 {
  "id": "c0:01410",
  "jp": "すいません、兄貴。\nどうやらここでお別れです。\nどうせなら、兄貴の腕の中で……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2f1"
  ],
  "voice": 7,
  "who": "ピンガー"
 },
 {
  "id": "c0:01463",
  "jp": "猫の呪いは恐ろしいですよ……。\nせいぜい、恐怖することですね……！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x33d"
  ],
  "voice": 8,
  "who": "ピンガー"
 },
 {
  "id": "c0:014a9",
  "jp": "ルルゥ、悔しいですけど、\n兄貴をヨロシクお願いしますよ。\nでないと、恨みますから……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x389"
  ],
  "voice": 9,
  "who": "ピンガー"
 },
 {
  "id": "c0:01502",
  "jp": "やっぱり、兄貴は強いですね……。\nへへ、惚れ直しましたよ……。\n兄貴……――。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3d5"
  ],
  "voice": 10,
  "who": "ピンガー"
 },
 {
  "id": "c0:01553",
  "jp": "体が動かないよ……。\nイシュト、どこ？　どこ、なの？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4b7"
  ],
  "voice": 11,
  "who": "ルルゥ"
 },
 {
  "id": "c0:0158b",
  "jp": "これからは、アナタが私に\nなるんだね……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x503"
  ],
  "voice": 12,
  "who": "ルルゥ"
 },
 {
  "id": "c0:015b9",
  "jp": "わたし、間違ってなかったね……。\nやっぱり、イシュトこそが……\nユーフォリアの……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x54f"
  ],
  "voice": 13,
  "who": "ルルゥ"
 },
 {
  "id": "c0:01610",
  "jp": "嘘だろ、オイ……。\nこんな終わり方かよ…チクショウ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x62a"
  ],
  "voice": 14,
  "who": "ザザーランド"
 },
 {
  "id": "c0:01648",
  "jp": "惚れた弱みってのは、恐ろしいねぇ\n……先にいってるぜ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x676"
  ],
  "voice": 15,
  "who": "ザザーランド"
 },
 {
  "id": "c0:01682",
  "jp": "ルキア皇国……！\nお前らだけには負けられねぇんだ！\nこんな所で……終われるかよ……！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x6c2"
  ],
  "voice": 16,
  "who": "ザザーランド"
 },
 {
  "id": "c0:016d9",
  "jp": "ちっちぇえ娘っ子が、立派になった\nモンだなぁ……ったくよぉ。\nイシュト、後は、頼んだぜ……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x70e"
  ],
  "voice": 17,
  "who": "ザザーランド"
 },
 {
  "id": "c0:01738",
  "jp": "あのガキがよくもまぁここまで……\nイシュト……お前の、勝ちだ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x75a"
  ],
  "voice": 18,
  "who": "ザザーランド"
 },
 {
  "id": "c0:0177a",
  "jp": "親父、みんな……イシュト。\nごめん、ちょっとだけ、休むね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x7ea"
  ],
  "voice": 19,
  "who": "エリーシャ"
 },
 {
  "id": "c0:017b8",
  "jp": "これが、シンフォニアの力……！\n……凄いわね、ルルゥ。\nアイツが惚れるのもわかるわ……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x836"
  ],
  "voice": 20,
  "who": "エリーシャ"
 },
 {
  "id": "c0:01813",
  "jp": "お母さん……。\nアタシの名前を呼んでよ……。\nお母さん……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x882"
  ],
  "voice": 21,
  "who": "エリーシャ"
 },
 {
  "id": "c0:01852",
  "jp": "まさか、アンタに負ける日が\n来るなんてね……。\nまったく……惚れちゃいそうよ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x8ce"
  ],
  "voice": 22,
  "who": "エリーシャ"
 },
 {
  "id": "c0:018a3",
  "jp": "そんだけ強いなら、まぁ、\nお茶ぐらいなら付き合ってあげる。\n変なことしたら撃ち殺すわよ？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x91a"
  ],
  "voice": 23,
  "who": "エリーシャ"
 },
 {
  "id": "c0:018fe",
  "jp": "死ぬのは、自宅のベッドで\n妻に看られながらにしたかった……",
  "en": "",
  "status": "todo",
  "slots": [
   "0x9ee"
  ],
  "voice": 24,
  "who": "ミネソタ"
 },
 {
  "id": "c0:0193c",
  "jp": "ヤだよ……まだ、シンフォニアを\nみつけてないのに……。\n体が……痛いよぉ……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0xa7e"
  ],
  "voice": 25,
  "who": "ロコモコ"
 },
 {
  "id": "c0:0198d",
  "jp": "私は死んでも故郷に帰るだけっすが\n……はぁ、課長の大目玉が怖いっす\nねぇ……ブルブル。",
  "en": "",
  "status": "todo",
  "slots": [
   "0xb60"
  ],
  "voice": 26,
  "who": "ラズベリー"
 },
 {
  "id": "c0:019e6",
  "jp": "ガ、ガガガーガガ、ガ……ガ",
  "en": "",
  "status": "todo",
  "slots": [
   "0xc3b"
  ],
  "voice": 27,
  "who": "ガング"
 },
 {
  "id": "c0:01a05",
  "jp": "シャンティエが復興するまで、\n倒れるわけにはいかぬ……。\nいかぬのだ……！",
  "en": "",
  "status": "todo",
  "slots": [
   "0xccb"
  ],
  "voice": 28,
  "who": "フィービー"
 },
 {
  "id": "c0:01a52",
  "jp": "アタシの……お宝。\nバラ色の、人生が……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0xdad"
  ],
  "voice": 29,
  "who": "アンヌ"
 },
 {
  "id": "c0:01a80",
  "jp": "我が生涯に悔いあり！\n師匠！　不出来な弟子を\nお許しくだされえぇぇぇ！！",
  "en": "",
  "status": "todo",
  "slots": [
   "0xed1"
  ],
  "voice": 30,
  "who": "カミュル"
 },
 {
  "id": "c0:01acb",
  "jp": "センチュリオバスターが\n壊されるなんて……！\nあぁ、なんてこと……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0xf61"
  ],
  "voice": 31,
  "who": "ユグドラ"
 },
 {
  "id": "c0:01b12",
  "jp": "泡沫よ…、命も夢も、もろともに…\nぐ、ぐはぁっ……！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1043"
  ],
  "voice": 32,
  "who": "パメラ"
 },
 {
  "id": "c0:01b4a",
  "jp": "この世界ともお別れですね。\nいい詩も思い浮かびましたし、\nまぁ、こんなものでしょう……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1125"
  ],
  "voice": 33,
  "who": "イータ"
 },
 {
  "id": "c0:01ba5",
  "jp": "ヤベェ、眠くなってきた……。\nこれで地上界での生活も終わりか…\nチ、暴れ、足り……ねぇぜ……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1207"
  ],
  "voice": 34,
  "who": "#15"
 },
 {
  "id": "c0:01c06",
  "jp": "……すいません兄貴。\n一旦退かせてもらいます！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x419"
  ],
  "who": "ピンガー"
 },
 {
  "id": "c0:01c34",
  "jp": "ごめんねイシュト。\nちょっと、休ませて……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x593"
  ],
  "who": "ルルゥ"
 },
 {
  "id": "c0:01c60",
  "jp": "踏ん張ってきたけど、もうダメね。\nみんな、撤退よ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x95e"
  ],
  "who": "エリーシャ"
 },
 {
  "id": "c0:01c92",
  "jp": "そんな……。\nアタシじゃ、無理だってことなの？\nゴメン、親父。みんな……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x9a2"
  ],
  "who": "エリーシャ"
 },
 {
  "id": "c0:01cdb",
  "jp": "こいつぁちとヤベェな！\n一時撤退だ！　下がりやがれ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x79e"
  ],
  "who": "ザザーランド"
 },
 {
  "id": "c0:01d0f",
  "jp": "戦略を誤ったか……。\n撤退する！",
  "en": "",
  "status": "todo",
  "slots": [
   "0xa32"
  ],
  "who": "ミネソタ"
 },
 {
  "id": "c0:01d2f",
  "jp": "はひぃ～、ロコモコもう限界ぃ。\nみんなー、帰るよぉー……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0xac2"
  ],
  "who": "ロコモコ"
 },
 {
  "id": "c0:01d69",
  "jp": "ひ、疲労がマジでピークっす。\nこのまま死ぬぐらいなら……。\nすみません、撤退するっすよ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0xba4"
  ],
  "who": "ラズベリー"
 },
 {
  "id": "c0:01dc0",
  "jp": "ここが限界か……皆、すまない。\n同志達よ！　これ以上の進撃は\n不可能だ！　撤退するぞ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0xd0f"
  ],
  "who": "フィービー"
 },
 {
  "id": "c0:01e15",
  "jp": "疲労も限界。弾数も残り僅か。\n仕方ありませんね。\n撤退しましょう。",
  "en": "",
  "status": "todo",
  "slots": [
   "0xfa5"
  ],
  "who": "ユグドラ"
 },
 {
  "id": "c0:01e56",
  "jp": "ガンガグ！　ガンガグー！",
  "en": "",
  "status": "todo",
  "slots": [
   "0xc7f"
  ],
  "who": "ガング"
 },
 {
  "id": "c0:01e6f",
  "jp": "こんな所で死んでたまるもんか！\nアンタ達、撤退するよ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0xdf1"
  ],
  "who": "アンヌ"
 },
 {
  "id": "c0:01ea5",
  "jp": "ぬうぅぅ！！　なんたる不覚！\nお、覚えていろぉぉぉ！！",
  "en": "",
  "status": "todo",
  "slots": [
   "0xf15"
  ],
  "who": "カミュル"
 },
 {
  "id": "c0:01edb",
  "jp": "あ～もう信じらんない！\nこのままやっても無駄だし、私は\n撤退するわ！　グッバイ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1087"
  ],
  "who": "パメラ"
 },
 {
  "id": "c0:01f2a",
  "jp": "今の状態で演奏を続けるのは\n無理がありますね……。\n後はよろしくお願いします。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1169"
  ],
  "who": "イータ"
 },
 {
  "id": "c0:01f77",
  "jp": "チクショウ！　拳を痛めちまった！\n一旦下がって治療するぞ！\nチクショウ！　チクショウ！！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x124b"
  ],
  "who": "#15"
 },
 {
  "id": "c0:01fce",
  "jp": "っていうか、お互いに戦って疲れて\nたら、この後はもう何もする気も\n起きないんじゃないですか……？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x45d"
  ],
  "who": "ピンガー"
 },
 {
  "id": "c0:0202d",
  "jp": "にしても、これじゃあナンパ勝負は\nボク達の負けですね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x464"
  ],
  "who": "ピンガー"
 },
 {
  "id": "c0:02063",
  "jp": "エリーシャさん、どんな反応する\nでしょうか？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x46b"
  ],
  "who": "ピンガー"
 },
 {
  "id": "c0:0208f",
  "jp": "アナタも私も、ウィルが\nすっからかんだねぇ。\n惜しいなぁ、後ちょっとだったのに",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5d7"
  ],
  "who": "ルルゥ"
 },
 {
  "id": "c0:020dc",
  "jp": "勝負に負けちゃったけど……\nエリーシャになんて言おうかなぁ。\n傷つくだろうなぁ、エリーシャ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5de"
  ],
  "who": "ルルゥ"
 },
 {
  "id": "c0:02137",
  "jp": "うえええぇぇぇ～～～ん！\nいたいよぉぉぉ～！",
  "en": "",
  "status": "todo",
  "slots": [
   "0xb06"
  ],
  "who": "ロコモコ"
 },
 {
  "id": "c0:02163",
  "jp": "お兄ちゃんなんか嫌い！\nどっか行ってよ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0xb0d"
  ],
  "who": "ロコモコ"
 },
 {
  "id": "c0:0218b",
  "jp": "エリーシャお姉ちゃんになんて\n言おう……絶対怒られるよぉ……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0xb14"
  ],
  "who": "ロコモコ"
 },
 {
  "id": "c0:021c9",
  "jp": "もうこれ以上は戦えないんで、\nここは素直に逃げるっすよ。\nナンパ勝負はコッチの負けっすね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0xbe8"
  ],
  "who": "ラズベリー"
 },
 {
  "id": "c0:02222",
  "jp": "エリーシャさん、負けたって\n知ったらどんな反応するんすかね？\n修行の旅とかに出ちゃったりして…",
  "en": "",
  "status": "todo",
  "slots": [
   "0xbef"
  ],
  "who": "ラズベリー"
 },
 {
  "id": "c0:0227f",
  "jp": "私の戦闘についてくるとは……。\n見所があるな。\n一本とられたよ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0xd53"
  ],
  "who": "フィービー"
 },
 {
  "id": "c0:022be",
  "jp": "どうだ？　今日はこのまま\n戦闘訓練といこうじゃないか！",
  "en": "",
  "status": "todo",
  "slots": [
   "0xd5a"
  ],
  "who": "フィービー"
 },
 {
  "id": "c0:022f4",
  "jp": "ナンパ勝負などには興味は無いが、\nエリーシャには頭を下げないとな…\nなんと言われるのだろうか……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0xd61"
  ],
  "who": "フィービー"
 },
 {
  "id": "c0:02355",
  "jp": "お互いにボロボロですね……。\nまぁ、負けた時の予防線にそう\nしたのですけど……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0xfe9"
  ],
  "who": "ユグドラ"
 },
 {
  "id": "c0:023a4",
  "jp": "もう何もする気が起きないでしょ？\nだからお互い、今日は帰りましょ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0xff0"
  ],
  "who": "ユグドラ"
 },
 {
  "id": "c0:023e6",
  "jp": "エリーシャさんには申し訳ない事を\nしましたね。\nなんと言ったらいいか……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0xff7"
  ],
  "who": "ユグドラ"
 },
 {
  "id": "c0:0242f",
  "jp": "別に遊んでもいいけど、私ってば\n海賊の女なのよねぇ。\nグロリア海賊団って知ってる？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x10cb"
  ],
  "who": "パメラ"
 },
 {
  "id": "c0:02480",
  "jp": "海賊の女に手を出して無事で済む？\nどう？　まだ遊ぶ気ある？\nあ、もういない。逃げただわさ……",
  "en": "",
  "status": "todo",
  "slots": [
   "0x10d2"
  ],
  "who": "パメラ"
 },
 {
