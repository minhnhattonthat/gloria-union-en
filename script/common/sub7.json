  "status": "todo",
  "slots": [
   "0x14fe"
  ],
  "who": "エリーシャ"
 },
 {
  "id": "c7:0607a",
  "jp": "悪いけど、雨の中でガンナーと\nスナイパーはお荷物よ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1505"
  ],
  "who": "エリーシャ"
 },
 {
  "id": "c7:060ae",
  "jp": "そうか……まいったな。",
