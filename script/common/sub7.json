  "status": "todo",
  "slots": [
   "0x305"
  ],
  "who": "ピンガー"
 },
 {
  "id": "c7:023d2",
  "jp": "そして、バトルに参加する\n敵味方のユニットのリスト…\nデュエルオーダー画面が出ます。",
