  "status": "todo",
  "slots": [
   "0x685"
  ],
  "who": "エリーシャ"
 },
 {
  "id": "c7:0291f",
  "jp": "ユニオンを組めば、\n複数のユニットが連係して\n敵に挑む事ができるのよ！",
