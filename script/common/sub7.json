  "status": "todo",
  "slots": [
   "0x1a51"
  ],
  "who": "ピンガー"
 },
 {
  "id": "c7:04e81",
  "jp": "スキルを使いこなせば、\n逆に敵にステータス異常を\nかけることもでますよ。",
