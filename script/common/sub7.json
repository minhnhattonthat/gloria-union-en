  "status": "todo",
  "slots": [
   "0x34e"
  ],
  "who": "イシュト"
 },
 {
  "id": "c7:02522",
  "jp": "デュエルオーダー画面で\nこちらの有利を確認したら、\n○ボタンを押してみてください。",
