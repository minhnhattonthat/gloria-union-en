  "slots": [
   "0x4c4"
  ],
  "who": "ピンガー"
 },
 {
  "id": "c7:02822",
  "jp": "さらっと流されたな……。\n確認が出たら○ボタンで終了だな。\nさあ、次のターンにいくぜ！",
