  "status": "todo",
  "slots": [
   "0x15ac"
  ],
  "who": "イシュト"
 },
 {
  "id": "c7:0632c",
  "jp": "その代わり、晴れたらドーンと\nうっぷんを晴らせばいいのよ！\nそれじゃあ、行くわよ！",
