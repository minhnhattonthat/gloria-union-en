  "status": "todo",
  "slots": [
   "0x74e"
  ],
  "who": "イシュト"
 },
 {
  "id": "c7:02c93",
  "jp": "そんなことしたら\n『連戦ハンデ』でたちまち\n追い詰められるわよ？",
