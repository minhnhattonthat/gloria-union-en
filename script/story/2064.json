[
 {
  "id": "s2064:00028",
  "jp": "……来ましたか。お久しぶりですね",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2d3c"
  ],
  "voice": 2789,
  "who": "トレイシー"
 },
 {
  "id": "s2064:0004d",
  "jp": "決着を付けに来た。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2d55"
  ],
  "voice": 2790,
  "who": "ピンガー"
 },
 {
  "id": "s2064:00064",
  "jp": "スラム街で生ゴミを食べて生活して\nいた少女が、立派になりましたね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2d6e"
  ],
  "voice": 2791,
  "who": "トレイシー"
 },
 {
  "id": "s2064:000aa",
  "jp": "黙れ、これ以上お前と話していると\n血液が沸騰して死にそうなんだ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2d87"
  ],
  "voice": 2792,
  "who": "ピンガー"
 },
 {
  "id": "s2064:000ee",
  "jp": "ならばその血、私が鎮めてやろう。\n我が鉄槌でな。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2d9c"
  ],
  "voice": 2793,
  "who": "ローガン"
 },
 {
  "id": "s2064:00122",
  "jp": "ああぁ！　ロ、ローガンさん！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2e50"
  ],
  "voice": 2794,
  "who": "ラズベリー"
 },
 {
  "id": "s2064:00143",
  "jp": "どうしてここに！？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2e69"
  ],
  "voice": 2795,
  "who": "ルルゥ"
 },
 {
  "id": "s2064:0015a",
  "jp": "言ったはずだぞ、\n恩人を探しに行くと！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2e82"
  ],
  "voice": 2796,
  "who": "ローガン"
 },
 {
  "id": "s2064:00184",
  "jp": "ま、まさか……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2e9b"
  ],
  "voice": 2797,
  "who": "エリーシャ"
 },
 {
  "id": "s2064:00199",
  "jp": "そう、トレイシー嬢こそ我が恩人！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2eb4"
  ],
  "voice": 2798,
  "who": "ローガン"
 },
 {
  "id": "s2064:001be",
  "jp": "死者蘇生の錬金術。\nまさかこんな形になっているとは、\n思ってもみませんでした。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2ecd"
  ],
  "voice": 2799,
  "who": "トレイシー"
 },
 {
  "id": "s2064:0020f",
  "jp": "死者蘇生……！？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2f10"
  ],
  "voice": 2800,
  "who": "ラズベリー"
 },
 {
  "id": "s2064:00224",
  "jp": "とことん神様にケンカを売ってる\nよね……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2f29"
  ],
  "voice": 2801,
  "who": "ロコモコ"
 },
 {
  "id": "s2064:00252",
  "jp": "なるほど……ローガンはあんたの\n実験で蘇ったんだね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2f50"
  ],
  "voice": 2802,
  "who": "ピンガー"
 },
 {
  "id": "s2064:0028a",
  "jp": "しかし、私が蘇らせる予定だった\nのはローガンさんではありません。\nですから、実験は失敗ですね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2f70"
  ],
  "voice": 2803,
  "who": "トレイシー"
 },
 {
  "id": "s2064:002eb",
  "jp": "しかし、結果的に骨の魔人を\n蘇らせたのだ。\n……やはりこの女、只者じゃない。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2f90"
  ],
  "voice": 2804,
  "who": "ミネソタ"
 },
 {
  "id": "s2064:0033a",
  "jp": "その実験で、何人の犠牲者を\n出したんだ、お前は！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2fc5"
  ],
  "voice": 2805,
  "who": "イシュト"
 },
 {
  "id": "s2064:0036e",
  "jp": "そうですね……。\n道端で死んでいる人を十人ほど。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2fde"
  ],
  "voice": 2806,
  "who": "トレイシー"
 },
 {
  "id": "s2064:003a2",
  "jp": "その十人は……どうなった。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2ff7"
  ],
  "voice": 2807,
  "who": "イシュト"
 },
 {
  "id": "s2064:003c1",
  "jp": "木っ端微塵になってしまいました。\n付き添いの方々も驚いていました。\n何せ、弾けたのは肉親なんですから",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3010"
  ],
  "voice": 2808,
  "who": "トレイシー"
 },
 {
  "id": "s2064:00428",
  "jp": "肉親の見ている前で、\nそんな実験をしたの！？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3029"
  ],
  "voice": 2809,
  "who": "エリーシャ"
 },
 {
  "id": "s2064:00458",
  "jp": "外道……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3058"
  ],
  "voice": 2810,
  "who": "フィービー"
 },
 {
  "id": "s2064:00467",
  "jp": "あなた……狂ってますよ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x307f"
  ],
  "voice": 2811,
  "who": "ピンガー"
 },
 {
  "id": "s2064:00484",
  "jp": "狂ってなければ人体実験なんて\nしませんよ。\nあとは頼みましたよ、ローガンさん",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3098"
  ],
  "voice": 2812,
  "who": "トレイシー"
 },
 {
  "id": "s2064:004d3",
  "jp": "了解した、恩人よ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x30b1"
  ],
  "voice": 2813,
  "who": "ローガン"
 },
 {
  "id": "s2064:004ea",
  "jp": "ローガンさん。\nあなたは間違って呼び戻された。\n恩人も何もないでしょう。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3103"
  ],
  "voice": 2814,
  "who": "ラズベリー"
 },
 {
  "id": "s2064:00535",
  "jp": "蘇らせてくれたことに変わりはない\nではないか。\n受けた恩は返す。常識ではないか。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x311c"
  ],
  "voice": 2815,
  "who": "ローガン"
 },
 {
  "id": "s2064:00588",
  "jp": "いけ！　我が同胞よ！　\n今こそ恩を返す時よ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3236"
  ],
  "voice": 2816,
  "who": "ローガン"
 },
 {
  "id": "s2064:005b8",
  "jp": "ケー！",
  "en": "Keee!",
  "status": "done",
  "slots": [
   "0x324f"
  ],
  "voice": 2817,
  "who": "#50"
 },
 {
  "id": "s2064:005c3",
  "jp": "トレイシーは、また兵にまぎれて\n姿を消したわ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x326d"
  ],
  "voice": 2818,
  "who": "エリーシャ"
 },
 {
  "id": "s2064:005f5",
  "jp": "だったらまた引きずり出してやる！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3286"
  ],
  "voice": 2819,
  "who": "イシュト"
 },
 {
  "id": "s2064:0061a",
  "jp": "お前には感謝しているぞ。\nお前らのおかげで、私は今、\nもの凄く楽しい！！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x479b"
  ],
  "voice": 2820,
  "who": "ローガン"
 },
 {
  "id": "s2064:00665",
  "jp": "あ？　いきなりなんだよ",
  "en": "",
  "status": "todo",
  "slots": [
   "0x47b5"
  ],
  "voice": 2821,
  "who": "イシュト"
 },
 {
  "id": "s2064:00680",
  "jp": "お前らとの戦いは、生前のどの戦い\nにも劣らぬ。私はそれが楽しくて\n仕方がないのだ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x47ce"
  ],
  "voice": 2822,
  "who": "ローガン"
 },
 {
  "id": "s2064:006d5",
  "jp": "こっちはお前にかまってる暇なんて\nないんだよ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x47e8"
  ],
  "voice": 2823,
  "who": "イシュト"
 },
 {
  "id": "s2064:00707",
  "jp": "ラズベリーよ。\n少し、頼みたいことがある。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4f05"
  ],
  "voice": 2824,
  "who": "ローガン"
 },
 {
  "id": "s2064:00735",
  "jp": "なんすか？　",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4f1f"
  ],
  "voice": 2825,
  "who": "ラズベリー"
 },
 {
  "id": "s2064:00746",
  "jp": "トレイシー嬢が私を蘇らせたのは、\n偶然らしいのだ。なので、彼女を\n見逃してやってはくれまいか。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4f38"
  ],
  "voice": 2826,
  "who": "ローガン"
 },
 {
  "id": "s2064:007a7",
  "jp": "……残念っすけど。私にそれを\n決める権限はないっす。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4f52"
  ],
  "voice": 2827,
  "who": "ラズベリー"
 },
 {
  "id": "s2064:007df",
  "jp": "……なら今の話は忘れろ。\n同情で手を抜かれてはつまらない\nからな！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4f6b"
  ],
  "voice": 2828,
  "who": "ローガン"
 },
 {
  "id": "s2064:00824",
  "jp": "あんな奴に感謝するなんて、\nどうかしてますね……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x48c3"
  ],
  "who": "ピンガー"
 },
 {
  "id": "s2064:00856",
  "jp": "貴様とて、今の体があるからこそ\nここまで戦ってこれたのでは\nないのか？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x48dc"
  ],
  "who": "ローガン"
 },
 {
  "id": "s2064:0089b",
  "jp": "戦力に有り余る恨みがあるんですよ\n……まぁ、わからないでしょうが。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x48f6"
  ],
  "who": "ピンガー"
 },
 {
  "id": "s2064:008dd",
  "jp": "ここに来て最大のウィル……。\n本当に、戦うのが好きなんだね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x49ca"
  ],
  "who": "ルルゥ"
 },
 {
  "id": "s2064:00919",
  "jp": "生前の記憶に浮かぶのは、\n皆戦いの記憶ばかりなのでな。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x49e3"
  ],
  "who": "ローガン"
 },
 {
  "id": "s2064:0094f",
  "jp": "戦いなしでは、生きられぬ体なのだ",
  "en": "",
  "status": "todo",
  "slots": [
   "0x49ed"
  ],
  "who": "ローガン"
 },
 {
  "id": "s2064:00970",
  "jp": "どうやら、アンタも\nここまでのようね。\n観念なさい！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4ac1"
  ],
  "who": "エリーシャ"
 },
 {
  "id": "s2064:009a3",
  "jp": "フハハ！　\n女子とは思えぬ豪傑ぶりよ！\nさぁ、かかってくるがいい！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4ada"
  ],
  "who": "ローガン"
 },
 {
  "id": "s2064:009e4",
  "jp": "この先へ行きたければ、\n私を越えてみよ、現代の海賊王よ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4bcb"
  ],
  "who": "ローガン"
 },
 {
  "id": "s2064:00a1c",
  "jp": "別にそんな肩書きなんかには\n興味ないんだけどな……まぁいいや",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4be5"
  ],
  "who": "ザザーランド"
 },
 {
  "id": "s2064:00a58",
  "jp": "超えさせてもらうぜ。海賊王。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4bfa"
  ],
  "who": "ザザーランド"
 },
 {
  "id": "s2064:00a75",
  "jp": "この歴史的な戦いは書に残るぞ！\n光栄に思うがいい！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4ceb"
  ],
  "who": "ローガン"
 },
 {
  "id": "s2064:00aa7",
  "jp": "確かに、生きた人骨と戦った者など\n自分達以外におるまいよ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4d05"
  ],
  "who": "ミネソタ"
 },
 {
  "id": "s2064:00ae1",
  "jp": "この戦いの後に、書いてみようか。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4d0f"
  ],
  "who": "ミネソタ"
 },
 {
  "id": "s2064:00b02",
  "jp": "ここまで逞しい童女は初めてみた！\nフハハ！　素晴らしき逸材よ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4df9"
  ],
  "who": "ローガン"
 },
 {
  "id": "s2064:00b40",
  "jp": "アンタなんかにほめられたって\n嬉しくもなんともないよ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4e13"
  ],
  "who": "ロコモコ"
 },
 {
  "id": "s2064:00b76",
  "jp": "国に仕える騎士は烏合の衆と\n思っていたが。\nどうしてなかなか、やるではないか",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5055"
  ],
  "who": "ローガン"
 },
 {
  "id": "s2064:00bc1",
  "jp": "シャンティエの騎士の誇りの意思を\n前時代と一緒にするな！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x506f"
  ],
  "who": "フィービー"
 },
 {
  "id": "s2064:00bf9",
  "jp": "ガガガ、ガガン！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5143",
   "0xa135"
  ],
  "who": "ガング"
 },
 {
  "id": "s2064:00c0a",
  "jp": "その頑丈な体。\n私の鉄球の重圧に耐えられるか！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x515c"
  ],
  "who": "ローガン"
 },
 {
  "id": "s2064:00c38",
  "jp": "貴様の父……もしや、オルディーン\nという名ではないか？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5246"
  ],
  "who": "ローガン"
 },
 {
  "id": "s2064:00c6e",
  "jp": "ッ！？　\nお父様の事を知っているのですか！？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5260"
  ],
  "who": "ユグドラ"
 },
 {
  "id": "s2064:00c9a",
  "jp": "奴は生前の私を最も追い詰めた男！\n父を超えたくば、私を倒してみよ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5279"
  ],
  "who": "ローガン"
 },
 {
  "id": "s2064:00cdc",
  "jp": "若輩の戦士よ！\n一人前になりたくば、\n私を倒してみせよ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5363"
  ],
  "who": "ローガン"
 },
 {
  "id": "s2064:00d13",
  "jp": "伝説の大海賊……。\nその胸、借りさせていただきます！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x537d"
  ],
  "who": "カミュル"
 },
 {
  "id": "s2064:00d47",
  "jp": "ねぇ。かつての大海賊なら\n大量のお宝を持ってるわよね？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5451"
  ],
  "who": "アンヌ"
 },
 {
  "id": "s2064:00d7d",
  "jp": "その在り処。\n教えてもらうわよ？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x545b"
  ],
  "who": "アンヌ"
 },
 {
  "id": "s2064:00d9d",
  "jp": "宝とは奪い奪われるもの！\nよかろう！　ならば力づくで\n聞いてみよ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5474"
  ],
  "who": "ローガン"
 },
 {
  "id": "s2064:00dde",
  "jp": "私、前々からアンタのこと\n気にいらなかったのよねぇ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5548"
  ],
  "who": "パメラ"
 },
 {
  "id": "s2064:00e12",
  "jp": "そんなナリして、目立ちすぎ\nなんだわさ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5552"
  ],
  "who": "パメラ"
 },
 {
  "id": "s2064:00e3a",
  "jp": "フハハハハハ！\n伝説の海賊とは、そのオーラも\n伝説級なのだ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x556b"
  ],
  "who": "ローガン"
 },
 {
  "id": "s2064:00e75",
  "jp": "漢と漢の勝負だ！\n燃えるぜぇ！！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x563f"
  ],
  "who": "#15"
 },
 {
  "id": "s2064:00e95",
  "jp": "外見に似合わずなかなかに\n熱い御仁であるな、面白い！\nいざ尋常に、勝負！",
  "en": "",
  "status": "todo",
