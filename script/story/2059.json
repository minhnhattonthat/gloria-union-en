  "id": "s2059:01970",
  "jp": "素材が無い？\nだったら武器は作れないよ。\n帰んな。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x36b4",
   "0x88bd"
  ],
  "who": "#76"
 },
