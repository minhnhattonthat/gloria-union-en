[
 {
  "id": "s2059:00028",
  "jp": "ここがラッタートチェレステビーチ\n世界で一番美しいビーチね……。\n綺麗すぎて溜息がでちゃうわ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2c43"
  ],
  "voice": 2346,
  "who": "エリーシャ"
 },
 {
  "id": "s2059:00089",
  "jp": "環境を守るために、ある程度名声を\n得ている人でないと足を踏み入れ\nられないらしいですよ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2c59"
  ],
  "voice": 2347,
  "who": "ピンガー"
 },
 {
  "id": "s2059:000e4",
  "jp": "名声！？　\n私にピッタリの言葉ですね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2c82"
  ],
  "voice": 2348,
  "who": "ユグドラ"
 },
 {
  "id": "s2059:0010e",
  "jp": "美しい……思わず溜息がでるな。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2cb6"
  ],
  "voice": 2349,
  "who": "フィービー"
 },
 {
  "id": "s2059:00131",
  "jp": "どうしてこんなに綺麗なのかしら。\n気になるんだわさ……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2ce9"
  ],
  "voice": 2350,
  "who": "パメラ"
 },
 {
  "id": "s2059:0016d",
  "jp": "ここに殿方の一人でも呼んで、\n星を見ながら語らえば、その後は\n……んふふ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2d20"
  ],
  "voice": 2351,
  "who": "イータ"
 },
 {
  "id": "s2059:001ba",
  "jp": "私は泳げないんで、砂のお城でも\n作るっすよ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2d40"
  ],
  "voice": 2352,
  "who": "ラズベリー"
 },
 {
  "id": "s2059:001ea",
  "jp": "ロコモコも作る～。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2d56"
  ],
  "voice": 2353,
  "who": "ロコモコ"
 },
 {
  "id": "s2059:00201",
  "jp": "あたしは軽く泳いでから\nのんびりしようかしら。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2d6c"
  ],
  "voice": 2354,
  "who": "エリーシャ"
 },
 {
  "id": "s2059:00233",
  "jp": "オイルはおまかせを。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2d97"
  ],
  "voice": 2355,
  "who": "ピンガー"
 },
 {
  "id": "s2059:0024c",
  "jp": "黙れエロネコ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2dad"
  ],
  "voice": 2356,
  "who": "エリーシャ"
 },
 {
  "id": "s2059:0025f",
  "jp": "ねぇねぇ、早く泳ごうよぉ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2ddb"
  ],
  "voice": 2357,
  "who": "ルルゥ"
 },
 {
  "id": "s2059:0027e",
  "jp": "ねぇねぇお姉さん。\n俺達と一緒に泳ごうぜ？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2eac"
  ],
  "voice": 2358,
  "who": "#39"
 },
 {
  "id": "s2059:002ac",
  "jp": "ウフフ、\n冗談は顔と首と胴と腕と\n腰と足だけにしなさい。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2ec2"
  ],
  "voice": 2359,
  "who": "アンヌ"
 },
 {
  "id": "s2059:002e7",
  "jp": "って全部じゃねえぇかあああ！！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2ee9"
  ],
  "voice": 2360,
  "who": "#39"
 },
 {
  "id": "s2059:0030a",
  "jp": "あら、こんな綺麗な砂浜でも\nお盛んなんて、反吐が出るわね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2f5a"
  ],
  "voice": 2361,
  "who": "エリーシャ"
 },
 {
  "id": "s2059:00348",
  "jp": "第一声から辛辣ね。\n余りに見向きされないから\n拗ねてるのかしら？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2f73"
  ],
  "voice": 2362,
  "who": "アンヌ"
 },
 {
  "id": "s2059:0038b",
  "jp": "なんですってぇ……！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2fa8"
  ],
  "voice": 2363,
  "who": "エリーシャ"
 },
 {
  "id": "s2059:003a4",
  "jp": "おやおや、久々に会ったと思ったら\nこれですよ。困ったもんですね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2fc1"
  ],
  "voice": 2364,
  "who": "ピンガー"
 },
 {
  "id": "s2059:003e8",
  "jp": "無粋な。もう少しこの綺麗な海を\n眺めようとはしないものか……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2ff1"
  ],
  "voice": 2365,
  "who": "フィービー"
 },
 {
  "id": "s2059:0042a",
  "jp": "変な男に会わないうちに、\n海に入りましょう。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3021"
  ],
  "voice": 2366,
  "who": "ユグドラ"
 },
 {
  "id": "s2059:0045a",
  "jp": "どこの世界の男も、\n変わらないもんねぇ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3058"
  ],
  "voice": 2367,
  "who": "パメラ"
 },
 {
  "id": "s2059:00486",
  "jp": "あぁいう殿方は、\nご遠慮願いたいですね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x308f"
  ],
  "voice": 2368,
  "who": "イータ"
 },
 {
  "id": "s2059:004b2",
  "jp": "ほら、こうやって、腕を通すんすよ",
  "en": "",
  "status": "todo",
  "slots": [
   "0x30bb"
  ],
  "voice": 2369,
  "who": "ラズベリー"
 },
 {
  "id": "s2059:004d7",
  "jp": "わかった！　う～んしょ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x30d6"
  ],
  "voice": 2370,
  "who": "ロコモコ"
 },
 {
  "id": "s2059:004f4",
  "jp": "他のみんなは自由ですねぇ～。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x30ec"
  ],
  "voice": 2371,
  "who": "ピンガー"
 },
 {
  "id": "s2059:00515",
  "jp": "ねーねーおーよーごーよー。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x312f"
  ],
  "voice": 2372,
  "who": "ルルゥ"
 },
 {
  "id": "s2059:00534",
  "jp": "はいはい、せめてボク達は\n砂浜を楽しみましょうねー",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3148"
  ],
  "voice": 2373,
  "who": "ピンガー"
 },
 {
  "id": "s2059:0056a",
  "jp": "いい？　よく見てなさい！　\nあたしにかかれば男の一匹や二匹\n簡単に釣れるのよ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x316f"
  ],
  "voice": 2374,
  "who": "エリーシャ"
 },
 {
  "id": "s2059:005bb",
  "jp": "そう？　じゃあ勝負しましょう。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3188"
  ],
  "voice": 2375,
  "who": "アンヌ"
 },
 {
  "id": "s2059:005de",
  "jp": "望むところよ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x31af"
  ],
  "voice": 2376,
  "who": "エリーシャ"
 },
 {
  "id": "s2059:005f1",
  "jp": "なんか始まっちゃいましたね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x31c8"
  ],
  "voice": 2377,
  "who": "ピンガー"
 },
 {
  "id": "s2059:00612",
  "jp": "ピンガー。私達も遊びに行こ？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x31ec"
  ],
  "voice": 2378,
  "who": "ルルゥ"
 },
 {
  "id": "s2059:00633",
  "jp": "まぁ、色々見て回るのも\n楽しそうですね。行きますか。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3202"
  ],
  "voice": 2379,
  "who": "ピンガー"
 },
 {
  "id": "s2059:0066b",
  "jp": "お、いい女発見。\nねぇねぇそこの君ぃ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5e52"
  ],
  "voice": 2380,
  "who": "#43"
 },
 {
  "id": "s2059:00695",
  "jp": "はぁいゲットォちょろいちょろい。\nというわけで、悪いけど邪魔だから\n寝ててねぇ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5e6c"
  ],
  "voice": 2381,
  "who": "エリーシャ"
 },
 {
  "id": "s2059:006e8",
  "jp": "え、ええぇ！？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5e85"
  ],
  "voice": 2382,
  "who": "#43"
 },
 {
  "id": "s2059:006fb",
  "jp": "ありゃ、ルルゥ？　どこですか？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5f68"
  ],
  "voice": 2383,
  "who": "ピンガー"
 },
 {
  "id": "s2059:0071e",
  "jp": "ねぇねぇ君ぃ、\n可愛いコスプレしてるねぇ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5f7e"
  ],
  "voice": 2384,
  "who": "#52"
 },
 {
  "id": "s2059:0074c",
  "jp": "コスプレじゃねぇよ、\n消えろ味噌っかすが",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5f98"
  ],
  "voice": 2385,
  "who": "ピンガー"
 },
 {
  "id": "s2059:00778",
  "jp": "か、可愛い～！　君！　俺と一緒に\n遊んでくれないか！？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x608a"
  ],
  "voice": 2386,
  "who": "#41"
 },
 {
  "id": "s2059:007b2",
  "jp": "ちょ、邪魔！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x60a4"
  ],
  "voice": 2387,
  "who": "ルルゥ"
 },
 {
  "id": "s2059:007c3",
  "jp": "ウンディーネのお姉さん。\n俺達と一緒に泳がない？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x6196"
  ],
  "voice": 2388,
  "who": "#46"
 },
 {
  "id": "s2059:007f7",
  "jp": "この海に不釣合いな輩だな。\n……いいだろう。付いて来れるなら\n付いて来るがいい。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x61b0"
  ],
  "voice": 2389,
  "who": "フィービー"
 },
 {
  "id": "s2059:0084a",
  "jp": "ね、ねぇお嬢ちゃん。\nお、お兄ちゃんと一緒に、遊ぼう？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x62a2"
  ],
  "voice": 2390,
  "who": "#39"
 },
 {
  "id": "s2059:00884",
  "jp": "うん！　いいよ！\nロリコンのお兄ちゃん",
  "en": "",
  "status": "todo",
  "slots": [
   "0x62bc"
  ],
  "voice": 2391,
  "who": "ロコモコ"
 },
 {
  "id": "s2059:008ae",
  "jp": "あ、あの、その手にある巨大な銃は\nなんでしょうか……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x63ae"
  ],
  "voice": 2392,
  "who": "#46"
 },
 {
  "id": "s2059:008e8",
  "jp": "あらあらナンパですか？\n私も罪作りな女ですね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x63c8"
  ],
  "voice": 2393,
  "who": "ユグドラ"
 },
 {
  "id": "s2059:0091a",
  "jp": "え？　ち、違ッ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x63e1"
  ],
  "voice": 2394,
  "who": "#46"
 },
 {
  "id": "s2059:0092f",
  "jp": "う～ん、ミステリアスな女性。\nタイプだ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x64d3"
  ],
  "voice": 2395,
  "who": "#41"
 },
 {
  "id": "s2059:0095b",
  "jp": "なかなかお目が高いようだけど。\n用はないから、そこ退くだわさ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x64ed"
  ],
  "voice": 2396,
  "who": "パメラ"
 },
 {
  "id": "s2059:0099d",
  "jp": "ちょっとよろしいかしら。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x65c9"
  ],
  "voice": 2397,
  "who": "イータ"
 },
 {
  "id": "s2059:009ba",
  "jp": "うわ！　めっちゃ美人！\nこれは逃がすまい……！\nえぇと、なんでしょうか？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x65e2"
  ],
  "voice": 2398,
  "who": "#52"
 },
 {
  "id": "s2059:00a05",
  "jp": "詩を作っている端でチラチラと\n目障りなので、海の藻屑でも何でも\nなってくださいな。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x65fc"
  ],
  "voice": 2399,
  "who": "イータ"
 },
 {
  "id": "s2059:00a5a",
  "jp": "え……？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x6615"
  ],
  "voice": 2400,
  "who": "#52"
 },
 {
  "id": "s2059:00a67",
  "jp": "こ、こんなに強いなんて……！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x66f9"
  ],
  "who": "#39"
 },
 {
  "id": "s2059:00a84",
  "jp": "俺は、か弱い女の子が\n好きなんだよぉぉぉぉぉ！！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x6703"
  ],
  "who": "#39"
 },
 {
  "id": "s2059:00ab4",
  "jp": "か、勘弁してくださぁーーーい！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x6777"
  ],
  "who": "#43"
 },
 {
  "id": "s2059:00ad3",
  "jp": "お、俺のビューティフルフェイスが\nめちゃくちゃにぃ～～！！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x67eb"
  ],
  "who": "#52"
 },
 {
  "id": "s2059:00b0d",
  "jp": "き、綺麗な女性にはトゲがあるって\nわけか……ハハ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x685f"
  ],
  "who": "#41"
 },
 {
  "id": "s2059:00b3f",
  "jp": "いたいよ～～～ママ～～～～！！！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x6869"
  ],
  "who": "#41"
 },
 {
  "id": "s2059:00b60",
  "jp": "俺はただ、女の子と一緒に\n泳ぎたかっただけなんだよぉぉぉ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x68dd"
  ],
  "who": "#46"
 },
 {
  "id": "s2059:00b9a",
  "jp": "あら、ルルゥ、楽しんでる？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x7329"
  ],
  "voice": 2401,
  "who": "エリーシャ"
 },
 {
  "id": "s2059:00bb9",
  "jp": "うん。とっても楽しいよ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x733f"
  ],
  "voice": 2402,
  "who": "ルルゥ"
 },
 {
  "id": "s2059:00bd6",
  "jp": "はぁ～、スッキリしたわぁ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x7382"
  ],
  "voice": 2403,
  "who": "ユグドラ"
 },
 {
  "id": "s2059:00bf5",
  "jp": "お前は海の楽しみ方を間違えている\n……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x7397"
  ],
  "voice": 2404,
  "who": "フィービー"
 },
 {
  "id": "s2059:00c21",
  "jp": "いい詩が思い浮かびましたわ～。\nタイトルは“海に沈んだ僕”で\n決定ですわね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x73d1"
  ],
  "voice": 2405,
  "who": "イータ"
 },
 {
  "id": "s2059:00c70",
  "jp": "結局普通に遊んじゃったわねぇ。\nま、それもたまにはいいか！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x7404"
  ],
  "voice": 2406,
  "who": "パメラ"
 },
 {
  "id": "s2059:00cae",
  "jp": "ふぅ、むにゃ……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x742b"
  ],
  "voice": 2407,
  "who": "ロコモコ"
 },
 {
  "id": "s2059:00cc5",
  "jp": "あらら、ロコモコさん\nおねむっすか？　いっぱい遊び\nましたからねぇ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x7444"
  ],
  "voice": 2408,
  "who": "ラズベリー"
 },
 {
  "id": "s2059:00d0c",
  "jp": "あ、こんな所にいた。\nもう、探しましたよ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x74f2"
  ],
  "voice": 2409,
  "who": "ピンガー"
 },
 {
  "id": "s2059:00d3a",
  "jp": "ピンガー、久しぶり！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x7508"
  ],
  "voice": 2410,
  "who": "ルルゥ"
 },
 {
  "id": "s2059:00d53",
  "jp": "テンション高いですねー。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x751e"
  ],
  "voice": 2411,
  "who": "ピンガー"
 },
 {
  "id": "s2059:00d70",
  "jp": "ねぇちょっといい加減しつこいって\nわからないのかしら！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x7533"
  ],
  "voice": 2412,
  "who": "アンヌ"
 },
 {
  "id": "s2059:00daa",
  "jp": "フハハハ！\nよいではないかよいではないか！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x7548"
  ],
  "voice": 2413,
  "who": "ローガン"
 },
 {
  "id": "s2059:00dd8",
  "jp": "なにやら面白いことになってますね",
  "en": "",
  "status": "todo",
  "slots": [
   "0x7664"
  ],
  "voice": 2414,
  "who": "ピンガー"
 },
 {
  "id": "s2059:00dfd",
  "jp": "でもアンヌさん、嫌がってるみたい\nだよ？　どうする？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x767d"
  ],
  "voice": 2415,
  "who": "ルルゥ"
 },
 {
  "id": "s2059:00e35",
  "jp": "嫌がる女の子を無理やり\nナンパするとは、許すまじ！　\n二人とも、行くわよ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x7696"
  ],
  "voice": 2416,
  "who": "エリーシャ"
 },
 {
  "id": "s2059:00e82",
  "jp": "え、えぇ！？　行くんですか？\nどうせコーマックですよ？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x76af"
  ],
  "voice": 2417,
  "who": "ピンガー"
 },
 {
  "id": "s2059:00ebc",
  "jp": "今はそんなこと関係ないの！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x76c8"
  ],
  "voice": 2418,
  "who": "エリーシャ"
 },
 {
  "id": "s2059:00edb",
  "jp": "は、はぁ。わかりました。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x76e1"
  ],
  "voice": 2419,
  "who": "ピンガー"
 },
 {
  "id": "s2059:00ef8",
  "jp": "うわぁ綺麗な海！　\n人っこ一人いないし。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5207"
  ],
  "voice": 3949,
  "who": "エリーシャ"
 },
 {
  "id": "s2059:00f24",
  "jp": "これは泳ぐしかないわね！\n着替え着替えっとぉ～。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5219"
  ],
  "voice": 3950,
  "who": "エリーシャ"
 },
 {
  "id": "s2059:00f58",
  "jp": "うひゃぁ～\n冷たくて気持ちいいわねぇ～！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x530d"
  ],
  "voice": 3951,
  "who": "エリーシャ"
 },
 {
  "id": "s2059:00f84",
  "jp": "よぉし！　\nあの岩のところまで泳ぐわよぉ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5314"
  ],
  "voice": 3952,
  "who": "エリーシャ"
 },
 {
  "id": "s2059:00fb2",
  "jp": "ふぅ……。\nあぁ気持ちよかった。\nそろそろあがろうかしらね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5324"
  ],
  "voice": 3953,
  "who": "エリーシャ"
 },
 {
  "id": "s2059:00ff1",
  "jp": "おぉ、これはこれは、\n秘境って所じゃないですか？\nう～ん、なんという開放感！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5465"
  ],
  "voice": 3954,
  "who": "ピンガー"
 },
 {
  "id": "s2059:01040",
  "jp": "フフフ、誰もいないことだし、\nもう少し開放的になって\nみようかな。てりゃ～。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5477"
  ],
  "voice": 3955,
  "who": "ピンガー"
 },
 {
  "id": "s2059:0108f",
  "jp": "おぉ～、きもちぃもんですね。\n何かに目覚めてしまいそうです。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x556b"
  ],
  "voice": 3956,
  "who": "ピンガー"
 },
 {
  "id": "s2059:010cf",
  "jp": "兄貴のタイダルウェイブで\nサーフィンもしてみたいですねぇ。\n怒られそうですが……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5572"
  ],
  "voice": 3957,
  "who": "ピンガー"
 },
 {
  "id": "s2059:01124",
  "jp": "……さて、そろそろ行きますか。\n皆さんいますかねぇ？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5579"
  ],
  "voice": 3958,
  "who": "ピンガー"
 },
 {
  "id": "s2059:0115c",
  "jp": "なんときれいな海原よ！\nわたしの心はたかぶっておるぞー！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x56c1"
  ],
  "voice": 3959,
  "who": "ルルゥ"
 },
 {
  "id": "s2059:01198",
  "jp": "あ、でも服がぬれると怒られちゃう\nなぁ……いいや、脱いじゃえ！\nえぇーい！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x56d3"
  ],
  "voice": 3960,
  "who": "ルルゥ"
 },
 {
  "id": "s2059:011e5",
  "jp": "ん～！　水がとうめいでとっても\nきれい！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x57c7"
  ],
  "voice": 3961,
  "who": "ルルゥ"
 },
 {
  "id": "s2059:01211",
  "jp": "なんか水に入ってないみたい～。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x57ce"
  ],
  "voice": 3962,
  "who": "ルルゥ"
 },
 {
  "id": "s2059:01234",
  "jp": "ぶくぶくぶく……ぷはぁ！\nあ～、気持ちよかった！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x57de"
  ],
  "voice": 3963,
  "who": "ルルゥ"
 },
 {
  "id": "s2059:01268",
  "jp": "うあー、この服、あっついー！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5926"
  ],
  "voice": 3964,
  "who": "ロコモコ"
 },
 {
  "id": "s2059:01289",
  "jp": "海にも入りたいし……。\nうー！　がまんできないー！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5938"
  ],
  "voice": 3965,
  "who": "ロコモコ"
 },
 {
  "id": "s2059:012bf",
  "jp": "あー！　風がきもちー！\n水もつめたいし、さいこーだね！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5a2c"
  ],
  "voice": 3966,
  "who": "ロコモコ"
 },
 {
  "id": "s2059:012f9",
  "jp": "はぁ～、もうこのまま\nねちゃおうかなぁ……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5a33"
  ],
  "voice": 3967,
  "who": "ロコモコ"
 },
 {
  "id": "s2059:01329",
  "jp": "はっ、ダメダメ！\n早くみんなの所にもどらなくちゃ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5a3a"
  ],
  "voice": 3968,
  "who": "ロコモコ"
 },
 {
  "id": "s2059:0135f",
  "jp": "ひょえ～、\nここまで綺麗な海をみたのは\n初めてっすねぇ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5b7b"
  ],
  "voice": 3969,
  "who": "ラズベリー"
 },
 {
  "id": "s2059:0139a",
  "jp": "せっかくの機会ですし、\nちょっと泳ぎましょうか。\nそれー！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5b8d"
  ],
  "voice": 3970,
  "who": "ラズベリー"
 },
 {
  "id": "s2059:013d7",
  "jp": "ふい～。冷たくてきんもちぃっす。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5c81"
  ],
  "voice": 3971,
  "who": "ラズベリー"
 },
 {
  "id": "s2059:013fc",
  "jp": "課長もたまにはこういう癒しを\nくれないっすかねぇ～。",
