[
 {
  "id": "s2058:00028",
  "jp": "あ、この先です。\nこの先にローガンさんの\nウィルを感じまっす。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x25d4"
  ],
  "voice": 2242,
  "who": "ラズベリー"
 },
 {
  "id": "s2058:00069",
  "jp": "むぅ、私にはわからないのに。\nなんかくやしい。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x25ed"
  ],
  "voice": 2243,
  "who": "ルルゥ"
 },
 {
  "id": "s2058:0009b",
  "jp": "ロコモコも～。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2606"
  ],
  "voice": 2244,
  "who": "ロコモコ"
 },
 {
  "id": "s2058:000ae",
  "jp": "ハハ、死人のウィルはちょっと特殊\nっすから、訓練しなきゃ探知する\nのは、ちとムズイっすよ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x262d"
  ],
  "voice": 2245,
  "who": "ラズベリー"
 },
 {
  "id": "s2058:0010b",
  "jp": "へぇ～。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2646"
  ],
  "voice": 2246,
  "who": "ルルゥ"
 },
 {
  "id": "s2058:00118",
  "jp": "くんれんかぁ、いやな言葉だなぁ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2663"
  ],
  "voice": 2247,
  "who": "ロコモコ"
 },
 {
  "id": "s2058:0013d",
  "jp": "いやいや、訓練とはいいものです。\n努力し己を高める。\n素晴らしいじゃないですか。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x268f"
  ],
  "voice": 2248,
  "who": "カミュル"
 },
 {
  "id": "s2058:00190",
  "jp": "へいへい、ちょぉっと待ちな\nそこの老若男女諸君。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2738"
  ],
  "voice": 2249,
  "who": "パメラ"
 },
 {
  "id": "s2058:001c4",
  "jp": "老はいない気がしますが……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2764"
  ],
  "voice": 2250,
  "who": "ユグドラ"
 },
 {
  "id": "s2058:001e5",
  "jp": "ろうにゃくにゃんにょ。って\nなんて言葉だ？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2784"
  ],
  "voice": 2251,
  "who": "イシュト"
 },
 {
  "id": "s2058:00213",
  "jp": "言えてませんよ兄貴。\nろうにゃく、にょ。とは歳や男女の\n区別なく全ての人々って意味です。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x27af"
  ],
  "voice": 2252,
  "who": "ピンガー"
 },
 {
  "id": "s2058:0026e",
  "jp": "お前ちょっとごまかさなかったか？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x27c5"
  ],
  "voice": 2253,
  "who": "イシュト"
 },
 {
  "id": "s2058:00293",
  "jp": "なんのことかにゃ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x27db"
  ],
  "voice": 2254,
  "who": "ピンガー"
 },
 {
  "id": "s2058:002aa",
  "jp": "ちょっとぉ！\nこのパメラ様を差し置いて\nなに盛り上がってんだわさ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2810"
  ],
  "voice": 2255,
  "who": "パメラ"
 },
 {
  "id": "s2058:002ef",
  "jp": "あの二人はいつもあんな感じだよ？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2829"
  ],
  "voice": 2256,
  "who": "ルルゥ"
 },
 {
  "id": "s2058:00314",
  "jp": "そうなの？　苦労してるわねぇ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2842"
  ],
  "voice": 2257,
  "who": "パメラ"
 },
 {
  "id": "s2058:00337",
  "jp": "初対面の人に同情された！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2866"
  ],
  "voice": 2258,
  "who": "ルルゥ"
 },
 {
  "id": "s2058:00354",
  "jp": "ドンマイっすルルゥさん。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x287c"
  ],
  "voice": 2259,
  "who": "ラズベリー"
 },
 {
  "id": "s2058:00371",
  "jp": "それで？　あたし達を引き止めて\n何の用？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x28bc"
  ],
  "voice": 2260,
  "who": "エリーシャ"
 },
 {
  "id": "s2058:0039d",
  "jp": "あ、あぁそうそう。\nあんた達、古代遺跡の\n欠片みたいなの持ってなぁい？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x28d2"
  ],
  "voice": 2261,
  "who": "パメラ"
 },
 {
  "id": "s2058:003e6",
  "jp": "私のご飯のこと？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x28e8"
  ],
  "voice": 2262,
  "who": "ルルゥ"
 },
 {
  "id": "s2058:003fb",
  "jp": "だったら今はねぇぞ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x290c"
  ],
  "voice": 2263,
  "who": "ザザーランド"
 },
 {
  "id": "s2058:00414",
  "jp": "ご、ご飯？　変わった子ね。\n……ふーん。\nじゃあ、用はないのだわさ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2922"
  ],
  "voice": 2264,
  "who": "パメラ"
 },
 {
  "id": "s2058:0045b",
  "jp": "悪いな。じゃあ、そこをどいてくれ",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2938"
  ],
  "voice": 2265,
  "who": "イシュト"
 },
 {
  "id": "s2058:00480",
  "jp": "なんで恩もない奴を通さなきゃ\nいけないんだわさ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x296d"
  ],
  "voice": 2266,
  "who": "パメラ"
 },
 {
  "id": "s2058:004b4",
  "jp": "うわ、ちょっと兄貴、近年稀に見る\n迷惑な人ですよ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2983"
  ],
  "voice": 2267,
  "who": "ピンガー"
 },
 {
  "id": "s2058:004ea",
  "jp": "恩って、言われてもなぁ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x299c"
  ],
  "voice": 2268,
  "who": "イシュト"
 },
 {
  "id": "s2058:00507",
  "jp": "恩がなければ通れないというのも\n微妙な理由ですね……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x29cc"
  ],
  "voice": 2269,
  "who": "ユグドラ"
 },
 {
  "id": "s2058:00541",
  "jp": "別に、ここはあんたの島じゃない\nでしょうが。\nさぁ、退きなさい。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x29ec"
  ],
  "voice": 2270,
  "who": "エリーシャ"
 },
 {
  "id": "s2058:00584",
  "jp": "やだやだやだ！　遺跡の欠片を\n見つけるまで絶対どかない！\n持ってないなら、あっちいけ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2a05"
  ],
  "voice": 2271,
  "who": "パメラ"
 },
 {
  "id": "s2058:005dd",
  "jp": "うわ！　お兄ちゃん！　\nこれロコモコと同じ魔法だよ！\nそれもロコモコより強力な。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2a62"
  ],
  "voice": 2272,
  "who": "ロコモコ"
 },
 {
  "id": "s2058:00630",
  "jp": "えぇー迷惑な上に強いのかよ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2a89"
  ],
  "voice": 2273,
  "who": "イシュト"
 },
 {
  "id": "s2058:00651",
  "jp": "自分とは真逆の女だ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2aa2"
  ],
  "voice": 2274,
  "who": "ミネソタ"
 },
 {
  "id": "s2058:0066a",
  "jp": "こりゃあ、遺跡の欠片を持って来る\nしかねぇなぁ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2ac5"
  ],
  "voice": 2275,
  "who": "ザザーランド"
 },
 {
  "id": "s2058:0069e",
  "jp": "そうしましょう。\nまともに相手すると\nこっちが疲れるわ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2ade"
  ],
  "voice": 2276,
  "who": "エリーシャ"
 },
 {
  "id": "s2058:006d9",
  "jp": "ルルゥ、遺跡の欠片、ありそうか？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2af7"
  ],
  "voice": 2277,
  "who": "イシュト"
 },
 {
  "id": "s2058:006fe",
  "jp": "う～ん……あっち。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2b10"
  ],
  "voice": 2278,
  "who": "ルルゥ"
 },
 {
  "id": "s2058:00715",
  "jp": "随分と曖昧だな。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2b49"
  ],
  "voice": 2279,
  "who": "ミネソタ"
 },
 {
  "id": "s2058:0072a",
  "jp": "変なウィルに妨害されちゃってる\nみたいで……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2b8c"
  ],
  "voice": 2280,
  "who": "ルルゥ"
 },
 {
  "id": "s2058:0075c",
  "jp": "あぁ、多分それ、\nローガンさんのウィルっす。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2ba5"
  ],
  "voice": 2281,
  "who": "ラズベリー"
 },
 {
  "id": "s2058:0078c",
  "jp": "もうわかるようになったの？\nすっご～い！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2bbe"
  ],
  "voice": 2282,
  "who": "ロコモコ"
 },
 {
  "id": "s2058:007b8",
  "jp": "そ、そうかなぁ。えへへ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2bfa"
  ],
  "voice": 2283,
  "who": "ルルゥ"
 },
 {
  "id": "s2058:007d5",
  "jp": "まぁ今はそれも役に立たないけど。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2c13"
  ],
  "voice": 2284,
  "who": "エリーシャ"
 },
 {
  "id": "s2058:007fa",
  "jp": "むしろ逆効果だなぁ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2c2c"
  ],
  "voice": 2285,
  "who": "イシュト"
 },
 {
  "id": "s2058:00813",
  "jp": "……イシュト、きらい。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2c45"
  ],
  "voice": 2286,
  "who": "ルルゥ"
 },
 {
  "id": "s2058:0082e",
  "jp": "えぇ！？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2c73"
  ],
  "voice": 2287,
  "who": "イシュト"
 },
 {
  "id": "s2058:0083b",
  "jp": "自業自得よ、バカねぇ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2c8c"
  ],
  "voice": 2288,
  "who": "エリーシャ"
 },
 {
  "id": "s2058:00856",
  "jp": "イシュト、あそこ！\n遺跡を荒らしてる人達がいる！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3fcb"
  ],
  "voice": 2339,
  "who": "ルルゥ"
 },
 {
  "id": "s2058:0088a",
  "jp": "なにぃ！？\n許せねぇ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3fe9"
  ],
  "voice": 2340,
  "who": "イシュト"
 },
 {
  "id": "s2058:008a4",
  "jp": "待て待て、奴らがいるってことは、\nあそこに遺跡の欠片があるってぇ\nことだ。行くぞ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4007"
  ],
  "voice": 2341,
  "who": "ザザーランド"
 },
 {
  "id": "s2058:008f9",
  "jp": "あー！\n遺跡の欠片発見！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4265"
  ],
  "voice": 2289,
  "who": "ルルゥ"
 },
 {
  "id": "s2058:00915",
  "jp": "た、食べたい……って、ダメダメ！\n早くパメラさんに持って行かないと",
  "en": "",
  "status": "todo",
  "slots": [
   "0x427a"
  ],
  "voice": 2290,
  "who": "ルルゥ"
 },
 {
  "id": "s2058:0095b",
  "jp": "ほらよ、これでいいか？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x48d3"
  ],
  "voice": 2291,
  "who": "イシュト"
 },
 {
  "id": "s2058:00976",
  "jp": "おおぉっ！　これこれ！\nこれを探してたんだわさ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x48ec"
  ],
  "voice": 2292,
  "who": "パメラ"
 },
 {
  "id": "s2058:009aa",
  "jp": "なんでこれを探してたの？\nパメラさんも考古学者さん？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4905"
  ],
  "voice": 2293,
  "who": "ルルゥ"
 },
 {
  "id": "s2058:009e2",
  "jp": "私ってば、探究心の塊なのよねぇ。\nそんで、この世界のことを調べて\n周ってるわけだわさ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x491e"
  ],
  "voice": 2294,
  "who": "パメラ"
 },
 {
  "id": "s2058:00a3b",
  "jp": "なんでパメラおねえちゃんは、\n魔法が使えるの？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4937"
  ],
  "voice": 2295,
  "who": "ロコモコ"
 },
 {
  "id": "s2058:00a6d",
  "jp": "それは、ただあんたと出身が\n同じだけよ、オチビちゃん。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x495e"
  ],
  "voice": 2296,
  "who": "パメラ"
 },
 {
  "id": "s2058:00aa7",
  "jp": "そうなんだぁ。\nわぁ、なんだか嬉しいな！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4977"
  ],
  "voice": 2297,
  "who": "ロコモコ"
 },
 {
  "id": "s2058:00ad3",
  "jp": "まさか、こんなところで同郷の子に\n会えるなんて思わなかったわさ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4990"
  ],
  "voice": 2298,
  "who": "パメラ"
 },
 {
  "id": "s2058:00b17",
  "jp": "さぁ、満足したならそこを退いて。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x49a6"
  ],
  "voice": 2299,
  "who": "エリーシャ"
 },
 {
  "id": "s2058:00b3c",
  "jp": "うん！　これからよろしく！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x49bf"
  ],
  "voice": 2300,
  "who": "パメラ"
 },
 {
  "id": "s2058:00b5b",
  "jp": "ん？　いきなり話が飛びましたよ？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x49fb"
  ],
  "voice": 2301,
  "who": "ピンガー"
 },
 {
  "id": "s2058:00b80",
  "jp": "あんた達と一緒にいるとお目当ての\nものが手に入りやすそうだからね！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4a11"
  ],
  "voice": 2302,
  "who": "パメラ"
 },
 {
  "id": "s2058:00bc6",
  "jp": "うわ、これでもかってぐらいに\n自分勝手な理由だよ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4a27"
  ],
  "voice": 2303,
  "who": "ルルゥ"
 },
 {
  "id": "s2058:00bfc",
  "jp": "しかし、彼女の魔法は強力だぞ？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4a50"
  ],
  "voice": 2304,
  "who": "フィービー"
 },
 {
  "id": "s2058:00c1f",
  "jp": "そうですね。戦力は多いほうが\nいいと思います。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4a80"
  ],
  "voice": 2305,
  "who": "ユグドラ"
 },
 {
  "id": "s2058:00c51",
  "jp": "ロコモコは、おねえちゃんと\n一緒がいい！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4a9d"
  ],
  "voice": 2306,
  "who": "ロコモコ"
 },
 {
  "id": "s2058:00c7d",
  "jp": "すっかり妹気分だな。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4ad6"
  ],
  "voice": 2307,
  "who": "イシュト"
 },
 {
  "id": "s2058:00c96",
  "jp": "ま、しばらくすれば飽きるだろ。\n勝手にさせろ。船上で暴れられても\n困るしな。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4aef"
  ],
  "voice": 2308,
  "who": "ザザーランド"
 },
 {
  "id": "s2058:00ce5",
  "jp": "ま、仕方がないわね。\nこれで通れるし、\nさっさと行きましょう。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4b08"
  ],
  "voice": 2309,
  "who": "エリーシャ"
 },
 {
  "id": "s2058:00d26",
  "jp": "あ、師匠。\n狭いので、落ちないように\n注意してください。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4b7c"
  ],
  "voice": 2310,
  "who": "カミュル"
 },
 {
  "id": "s2058:00d61",
  "jp": "ありがと。それと師匠はやめなさい",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4b92"
  ],
  "voice": 2311,
  "who": "エリーシャ"
 },
 {
  "id": "s2058:00d86",
