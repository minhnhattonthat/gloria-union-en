  "status": "todo",
  "slots": [
   "0x2d0e"
  ],
  "voice": 3195,
  "who": "ガリオレッド"
 },
 {
  "id": "s2070:00e4a",
  "jp": "逃げやがったか……！\n追うぞ、お前ら！",
