[
 {
  "id": "s2070:00028",
  "jp": "黒幕とは、随分なご挨拶じゃないか\nザザーランド。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x173c"
  ],
  "voice": 3155,
  "who": "ガリオレッド"
 },
 {
  "id": "s2070:0005c",
  "jp": "黒い牙を裏で動かし、トレイシーに\n情報とカードを与えたお前を、\n誰が黒幕じゃないって言うんだ？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1755"
  ],
  "voice": 3156,
  "who": "ザザーランド"
 },
 {
  "id": "s2070:000bd",
  "jp": "クク、良くわかったな。\n成長したものだ……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x176e"
  ],
  "voice": 3157,
  "who": "ガリオレッド"
 },
 {
  "id": "s2070:000ed",
  "jp": "反吐が出るぜ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1787"
  ],
  "voice": 3158,
  "who": "ザザーランド"
 },
 {
  "id": "s2070:00100",
  "jp": "まぁ、そう言うな。\n同じ軍で汗を流した仲じゃないか。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x17a0"
  ],
  "voice": 3159,
  "who": "ガリオレッド"
 },
 {
  "id": "s2070:00138",
  "jp": "同じ、軍？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x17b9"
  ],
  "voice": 3160,
  "who": "イシュト"
 },
 {
  "id": "s2070:00147",
  "jp": "あの頃はよかったなぁ。\nもう一度戻りたいって思わねぇか？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x17d2"
  ],
  "voice": 3161,
  "who": "ザザーランド"
 },
 {
  "id": "s2070:00183",
  "jp": "クク、確かに。\nだが、戻ったとしても結末は\n同じであろうよ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x17f9"
  ],
  "voice": 3162,
  "who": "ガリオレッド"
 },
 {
  "id": "s2070:001c2",
  "jp": "そうだな。\n俺がお前を殺して、終わりだ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1812"
  ],
  "voice": 3163,
  "who": "ザザーランド"
 },
 {
  "id": "s2070:001ee",
  "jp": "よくいう……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x182b"
  ],
  "voice": 3164,
  "who": "ガリオレッド"
 },
 {
  "id": "s2070:00201",
  "jp": "これは……どういうことだ？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1844"
  ],
  "voice": 3165,
  "who": "イシュト"
 },
 {
  "id": "s2070:00220",
  "jp": "親父は昔、皇国軍の将軍だったの。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x185d"
  ],
  "voice": 3166,
  "who": "エリーシャ"
 },
 {
  "id": "s2070:00245",
  "jp": "ええぇ！？",
  "en": "Whaaat!?",
  "status": "done",
  "slots": [
   "0x1876"
  ],
  "voice": 3167,
  "who": "ルルゥ"
 },
 {
  "id": "s2070:00254",
  "jp": "親父が……ルキア皇国の、将軍？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x18ab"
  ],
  "voice": 3168,
  "who": "イシュト"
 },
 {
  "id": "s2070:00277",
  "jp": "何かしらの繋がりはある\nと思っていましたが……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x18c4"
  ],
  "voice": 3169,
  "who": "ピンガー"
 },
 {
  "id": "s2070:002ab",
  "jp": "話してなかったのか？\n相変わらず部下の統率が\n下手くそだな。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x18da"
  ],
  "voice": 3170,
  "who": "ガリオレッド"
 },
 {
  "id": "s2070:002ea",
  "jp": "いいんだよ。\n俺が話したくなかったんだからな。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x18f3"
  ],
  "voice": 3171,
  "who": "ザザーランド"
 },
 {
  "id": "s2070:0031c",
  "jp": "自分勝手甚だしいな。\nその脳筋さえなければ、今頃は俺と\nお前で世界を支配できたのだがな。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x190c"
  ],
  "voice": 3172,
  "who": "ガリオレッド"
 },
 {
  "id": "s2070:00377",
  "jp": "平和を生むのはお前の“力”でも、\nエンリエッタの“犠牲”でもねぇ。\n俺の“自由”さ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1925"
  ],
  "voice": 3173,
  "who": "ザザーランド"
 },
 {
  "id": "s2070:003ce",
  "jp": "力強き者が世界を制する。\n誰も逆らえぬ力は、戦を無くし！\n平和を生むのだ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x193e"
  ],
  "voice": 3174,
  "who": "ガリオレッド"
 },
 {
  "id": "s2070:0041b",
  "jp": "それは、闇のカード……！？\nなんでアナタが持っているの！？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1995"
  ],
  "voice": 3175,
  "who": "ルルゥ"
 },
 {
  "id": "s2070:00459",
  "jp": "ルキア皇国は闇の遺跡“闇の邪域”\nを基に作られていてな。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x19ab"
  ],
  "voice": 3176,
  "who": "ガリオレッド"
 },
 {
  "id": "s2070:00495",
  "jp": "クリスタルは王家の秘宝として\n代々伝わっているのだよ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x19b2"
  ],
  "voice": 3177,
  "who": "ガリオレッド"
 },
 {
  "id": "s2070:004cf",
  "jp": "エンリエッタの他にも、普通の体で\nカードを使えるほどのウィルを\n持っている人がいたなんて……！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x19e7"
  ],
  "voice": 3178,
  "who": "ルルゥ"
 },
 {
  "id": "s2070:00530",
  "jp": "言っただろう。\n貴様らの１７年と、私達の１７年を\n一緒にするなと！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1a00"
  ],
  "voice": 3179,
  "who": "ガリオレッド"
 },
 {
  "id": "s2070:00575",
  "jp": "さぁ、お喋りはこれまでだ。\nメギドの闇に沈んでもらおうか！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1a15"
  ],
  "voice": 3180,
  "who": "ガリオレッド"
 },
 {
  "id": "s2070:005b3",
  "jp": "貴様らさえ葬れば、我が\n“ユーフォリア計画”は完成する！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1b2c"
  ],
  "voice": 3181,
  "who": "ガリオレッド"
 },
 {
  "id": "s2070:005ef",
  "jp": "ユーフォリア……計画。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1b45"
  ],
  "voice": 3182,
  "who": "イシュト"
 },
 {
  "id": "s2070:0060a",
  "jp": "させねぇよ……！\nそのために、俺は今まで\n生きてきたんだからなぁ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1b63"
  ],
  "voice": 3183,
  "who": "ザザーランド"
 },
 {
  "id": "s2070:0064f",
  "jp": "闇のカード“メギド”は、\n渇望のウィルを力に変える！\n俺の意思は、力への渇望！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1dbf"
  ],
  "voice": 3184,
  "who": "ガリオレッド"
 },
 {
  "id": "s2070:006a0",
  "jp": "コイツもエンリエッタみたいに\nカードを使えるのかよ……！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1dd9"
  ],
  "voice": 3185,
  "who": "イシュト"
 },
 {
  "id": "s2070:006dc",
  "jp": "例え残り五枚のカードを使おうが、\nお前らは俺には勝てない！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1df2"
  ],
  "voice": 3186,
  "who": "ガリオレッド"
 },
 {
  "id": "s2070:0071a",
  "jp": "……。",
  "en": "......",
  "status": "done",
  "slots": [
   "0x20f3"
  ],
  "voice": 3187,
  "who": "ガリオレッド"
 },
 {
  "id": "s2070:00725",
  "jp": "な、何よ、人の顔をジロジロと。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x210a"
  ],
  "voice": 3188,
  "who": "エリーシャ"
 },
 {
  "id": "s2070:00748",
  "jp": "……お前、本当にザザーランドの\n娘か？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2120"
  ],
  "voice": 3189,
  "who": "ガリオレッド"
 },
 {
  "id": "s2070:00772",
  "jp": "その質問、正直され慣れたけど……\nあたしは正真正銘、親父の娘よ！\n親父譲りの力、見せてあげるわ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x213a"
  ],
  "voice": 3190,
  "who": "エリーシャ"
 },
 {
  "id": "s2070:007d5",
  "jp": "どんなに力を底上げしても、\n俺には勝てないぜ、宰相さんよぉ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x221d"
  ],
  "voice": 3191,
  "who": "ザザーランド"
 },
 {
  "id": "s2070:00815",
  "jp": "なぜ俺が態々ここに赴いたか\nわかるか？　貴様を殺すためだよ。\nザザーランド！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2236"
  ],
  "voice": 3192,
  "who": "ガリオレッド"
 },
 {
  "id": "s2070:00864",
  "jp": "グロリア海賊団の団員は皆殺しだ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1edc"
  ],
  "who": "ガリオレッド"
 },
 {
  "id": "s2070:00885",
  "jp": "この人が敵の親玉ですか……。\n流石に、威圧感がありますね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1ef6"
  ],
  "who": "ピンガー"
 },
 {
  "id": "s2070:008bf",
  "jp": "貴様はユーフォリア計画には\n重要な存在だ！\nさぁ、共に来るのだ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1fe0"
  ],
  "who": "ガリオレッド"
 },
 {
  "id": "s2070:008fe",
  "jp": "私は絶対にアナタと行かない！\n絶対に、イシュトと一緒に\nいるんだから！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1ffa"
  ],
  "who": "ルルゥ"
 },
 {
  "id": "s2070:00943",
  "jp": "そこまで絶対的力を持って……。\n恐怖政治でも布くつもりか？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x230a"
  ],
  "who": "ミネソタ"
 },
 {
  "id": "s2070:0097d",
  "jp": "人を支配するのに、\n恐怖は丁度いいんだよ。\nそして、恐怖を生むのは、力だ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2323"
  ],
  "who": "ガリオレッド"
 },
 {
  "id": "s2070:009c6",
  "jp": "なんて禍々しいウィル。\n闇のカードが扱えるわけだよ……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x23f0"
  ],
  "who": "ロコモコ"
 },
 {
  "id": "s2070:009fe",
  "jp": "この人に、これ以上力を与えちゃ\nダメ……絶対に、止めないと！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x23fa"
  ],
  "who": "ロコモコ"
 },
 {
  "id": "s2070:00a3a",
  "jp": "すごいウィルっすね……。\n黄泉の国でも、これだけのウィルを\n持った人はいないっすよ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x24c0"
  ],
  "who": "ラズベリー"
 },
 {
  "id": "s2070:00a8d",
  "jp": "負けられないっすね……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x24ca"
  ],
  "who": "ラズベリー"
 },
 {
  "id": "s2070:00aa6",
  "jp": "コイツが、ルキア皇国の宰相……。\n同志達の、仇！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2597"
  ],
  "who": "フィービー"
 },
 {
  "id": "s2070:00ad6",
  "jp": "必ず……必ず討つ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x25ac"
  ],
  "who": "フィービー"
 },
 {
  "id": "s2070:00ae9",
  "jp": "戦力は多いほうがいいな。\nよし、無駄な頭脳は抜いて、\n砲台として活用しようか。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2696"
  ],
  "who": "ガリオレッド"
 },
 {
  "id": "s2070:00b36",
  "jp": "ガガガガ、ガガンガ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x26b0"
  ],
  "who": "ガング"
 },
 {
  "id": "s2070:00b4b",
  "jp": "これが、この世界最大の悪。\n諸悪の根源……！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x277d"
  ],
  "who": "ユグドラ"
 },
 {
  "id": "s2070:00b77",
  "jp": "なんて、\n禍々しい力なのでしょうか……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2787"
  ],
  "who": "ユグドラ"
 },
 {
  "id": "s2070:00b9f",
  "jp": "貴様、裏切り者だそうだな。\nフン、ザザーランドの下につくなど\n気が知れんな。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x286a"
  ],
  "who": "ガリオレッド"
 },
 {
  "id": "s2070:00bea",
  "jp": "僕は、彼等の意思に賛同したのだ！\nもう皇国軍には戻らない！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2884"
  ],
  "who": "カミュル"
 },
 {
  "id": "s2070:00c24",
  "jp": "例え裏切り者と言われようとも、\n僕はルキア皇国を討つ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x288e"
  ],
  "who": "カミュル"
 },
 {
  "id": "s2070:00c5a",
  "jp": "うわ、スゴイ覇気ね。\nなんだか自分が場違いに思えて\nきちゃうわ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x295b"
  ],
  "who": "アンヌ"
 },
 {
  "id": "s2070:00c99",
  "jp": "船のお宝持って、\nトンズラしちゃおうかしら？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2965"
  ],
  "who": "アンヌ"
 },
 {
  "id": "s2070:00cc5",
  "jp": "いやぁ、ここまでこわ～いウィル。\nまるで伝説の魔竜みたいなんだわさ",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2a2b"
  ],
  "who": "パメラ"
 },
 {
  "id": "s2070:00d07",
  "jp": "果たして、私達の中に、\n勇者様はいるのかしらねぇ？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2a35"
  ],
  "who": "パメラ"
 },
 {
  "id": "s2070:00d39",
  "jp": "ヘッ、陰湿メガネヤローが……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2b02"
  ],
  "who": "#15"
 },
 {
  "id": "s2070:00d58",
  "jp": "そのひん曲がった性根。\n俺が打ん殴ってやるよ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2b17"
  ],
  "who": "#15"
 },
 {
  "id": "s2070:00d86",
  "jp": "力が必要なのだ！\n戦う意思すら撃ち砕く力が！\n誰も逆らえない、絶対無敵の力が！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2cd7"
  ],
  "voice": 3193,
  "who": "ガリオレッド"
 },
 {
  "id": "s2070:00dd7",
  "jp": "無敵の力なんて存在しねぇ！\n強ければその分、戦争は激化する\nだけだ！",
