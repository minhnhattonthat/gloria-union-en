[
 {
  "id": "s2076:00028",
  "jp": "ここが、ユーフォリアの中心……。\nあの台座に、剣を刺せば……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0xce9"
  ],
  "voice": 3623,
  "who": "アシュレイ"
 },
 {
  "id": "s2076:0006a",
  "jp": "幸せになるんだ。\n僕は……幸せに。",
  "en": "",
  "status": "todo",
  "slots": [
   "0xd2e"
  ],
  "voice": 3624,
  "who": "アシュレイ"
 },
 {
  "id": "s2076:00090",
  "jp": "悪いが、させられねぇよ。\nアシュレイ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0xd43"
  ],
  "voice": 3625,
  "who": "イシュト"
 },
 {
  "id": "s2076:000ba",
  "jp": "グロリア海賊団！？\n何故だ……何故、僕の邪魔を\nするのだ！！",
  "en": "",
  "status": "todo",
  "slots": [
   "0xf04"
  ],
  "voice": 3626,
  "who": "アシュレイ"
 },
 {
  "id": "s2076:000f9",
  "jp": "もう止めて！\nユーフォリアを復活させても、\nアナタは幸せになんてなれない！",
  "en": "",
  "status": "todo",
  "slots": [
   "0xf1d"
  ],
  "voice": 3627,
  "who": "ルルゥ"
 },
 {
  "id": "s2076:00146",
  "jp": "勝手なことを言うな！\n僕は、僕は、この日のために、\n生きてきたのだ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0xf36"
  ],
  "voice": 3628,
  "who": "アシュレイ"
 },
 {
  "id": "s2076:0018d",
  "jp": "今更邪魔なんて、させるか！",
  "en": "",
  "status": "todo",
  "slots": [
   "0xf40"
  ],
  "voice": 3629,
  "who": "アシュレイ"
 },
 {
  "id": "s2076:001ac",
  "jp": "アシュレイのウィルが\nどんどん上昇してる……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0xf59"
  ],
  "voice": 3630,
  "who": "ロコモコ"
 },
 {
  "id": "s2076:001de",
  "jp": "闇のカードが、アシュレイの\n暗いウィルに反応してるんだ……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0xf72"
  ],
  "voice": 3631,
  "who": "ルルゥ"
 },
 {
  "id": "s2076:0021e",
  "jp": "このままじゃ、アシュレイが\n暴走しちゃう。",
  "en": "",
  "status": "todo",
  "slots": [
   "0xf9c"
  ],
  "voice": 3632,
  "who": "ルルゥ"
 },
 {
  "id": "s2076:0024c",
  "jp": "イシュト、\nもう、考えている暇はないわ。\nアシュレイを……倒しましょう。",
  "en": "",
  "status": "todo",
  "slots": [
   "0xfca"
  ],
  "voice": 3633,
  "who": "エリーシャ"
 },
 {
  "id": "s2076:00297",
  "jp": "……それしか、ないのか。",
  "en": "",
  "status": "todo",
  "slots": [
   "0xfe3"
  ],
  "voice": 3634,
  "who": "イシュト"
 },
 {
  "id": "s2076:002b4",
  "jp": "総員、戦闘準備！\nこれが、最後の戦いだ！\n気を引き締めろ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0xff8"
  ],
  "voice": 3635,
  "who": "イシュト"
 },
 {
  "id": "s2076:002f1",
  "jp": "イシュト！！\n貴様は！　貴様だけは！\n僕が、殺してやる！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1188"
  ],
  "voice": 3636,
  "who": "アシュレイ"
 },
 {
  "id": "s2076:0032c",
  "jp": "来いアシュレイ！\n双子とか、王族とか関係ねぇ！\n男と男の、勝負だ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x11a2"
  ],
  "voice": 3637,
  "who": "イシュト"
 },
 {
  "id": "s2076:00371",
  "jp": "追い詰めましたよ……！\nこれで最後です！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x126f"
  ],
  "who": "ピンガー"
 },
 {
  "id": "s2076:00399",
  "jp": "これ以上、アナタを先には\n行かせない！\nここで、倒す！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1335"
  ],
  "who": "ルルゥ"
 },
 {
  "id": "s2076:003ce",
  "jp": "ここがアンタの墓場よ。\nこんな立派な所で死ねるんだから、\n光栄に思いなさいよ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x13fb"
  ],
  "who": "エリーシャ"
 },
 {
  "id": "s2076:0041b",
  "jp": "ここが年貢の納め時ってか。\n観念するんだな、アシュレイ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x14c1"
  ],
  "who": "ザザーランド"
 },
 {
  "id": "s2076:00453",
  "jp": "とうとうここまで来たか……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x158e"
  ],
  "who": "ミネソタ"
 },
 {
  "id": "s2076:00470",
  "jp": "決着の時だ。アシュレイ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x15a3"
  ],
  "who": "ミネソタ"
 },
 {
  "id": "s2076:00489",
  "jp": "ここで終わらせなくちゃ\nダメなんだよね……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1677"
  ],
  "who": "ロコモコ"
 },
 {
  "id": "s2076:004b5",
  "jp": "なら、ロコモコの最大魔法で、\n終わらせてあげる！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x168c"
  ],
  "who": "ロコモコ"
 },
 {
  "id": "s2076:004e5",
  "jp": "もうローガンさんもいないってのに\n随分と残業したもんすねぇ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1760"
  ],
  "who": "ラズベリー"
 },
 {
  "id": "s2076:00521",
  "jp": "でも、これで終わりっす！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1775"
  ],
  "who": "ラズベリー"
 },
 {
  "id": "s2076:0053a",
  "jp": "貴様を倒せば全てが終わる！\nここで決めさせてもらう！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1842"
  ],
  "who": "フィービー"
 },
 {
  "id": "s2076:0056e",
  "jp": "ガガグ、ガガン！！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1908"
  ],
  "who": "ガング"
 },
 {
  "id": "s2076:00581",
  "jp": "これでもまだ、復活を諦めないの\nならば、今度こそ私は、アナタを\n滅します！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x19ce"
  ],
  "who": "ユグドラ"
 },
 {
  "id": "s2076:005ca",
  "jp": "さぁ、大人しくしてください。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x19d8"
  ],
  "who": "ユグドラ"
 },
 {
  "id": "s2076:005e7",
  "jp": "これ以上世界を混乱に陥れる\nわけにはいかない！\nいくぞぉぉぉ！！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1a9e"
  ],
  "who": "カミュル"
 },
 {
  "id": "s2076:00626",
  "jp": "アナタ個人に恨みは無いけど、\n自由にお宝探しができないのは\n嫌なのよ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1b6b"
  ],
  "who": "アンヌ"
 },
 {
  "id": "s2076:0066b",
  "jp": "悪いけど。寝てもらうわよ？",
