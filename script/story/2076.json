  "status": "todo",
  "slots": [
   "0x1b80"
  ],
  "who": "アンヌ"
 },
 {
  "id": "s2076:00686",
  "jp": "この世界もなかなか興味深かった\nけど、どうやらここでお終いのよう\nなんだわさ。",
