  "status": "todo",
  "slots": [
   "0x239a"
  ],
  "voice": 866,
  "who": "ミネソタ"
 },
 {
  "id": "s2040:00613",
  "jp": "あいつら、ロコモコの時もいきなり\nおそってきたの！",
