  "status": "todo",
  "slots": [
   "0x1d3d"
  ],
  "voice": 837,
  "who": "ロコモコ"
 },
 {
  "id": "s2040:0013d",
  "jp": "なに～！？　よしお前ら！　\nまずは、あの飴を狙えー！",
