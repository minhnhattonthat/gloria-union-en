  "status": "todo",
  "slots": [
   "0x2199"
  ],
  "voice": 861,
  "who": "ロコモコ"
 },
 {
  "id": "s2040:004e5",
  "jp": "泣きっ面のくせに\nずいぶんと偉そうだなチビっこ。",
