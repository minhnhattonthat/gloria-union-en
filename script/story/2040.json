  "status": "todo",
  "slots": [
   "0x1d24"
  ],
  "voice": 836,
  "who": "#46"
 },
 {
  "id": "s2040:000da",
  "jp": "わはは！　ロコモコはね、この\nキャンディーを舐めることによって\nいつもの三倍の力が出せるのだよ！",
