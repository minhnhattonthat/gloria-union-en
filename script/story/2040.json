  "who": "ルルゥ"
 },
 {
  "id": "s2040:00cf7",
  "jp": "自慢げになるのはいいから、\n次行くわよ、次。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x81de"
  ],
  "voice": 907,
  "who": "エリーシャ"
 },
 {
  "id": "s2040:00d28",
  "jp": "長旅をするのなら、\n行く先々の村や都市には\nなるべく訪れた方がいいですよ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2515"
  ],
  "who": "#61"
 },
 {
  "id": "s2040:00d71",
  "jp": "いい情報はモチロン、なにかいい物\nをくれるかもしれません。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x251c"
  ],
  "who": "#61"
 },
 {
  "id": "s2040:00dab",
  "jp": "さらに、もらったり拾った物を\n別のものに交換してくれる人も\nいます。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2523"
  ],
  "who": "#61"
 },
 {
  "id": "s2040:00dee",
  "jp": "この島のどこかに鍛冶屋があるの\nですが、何か加工できそうな物を\n持っていけば……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x252a"
  ],
  "who": "#61"
 },
 {
  "id": "s2040:00e3f",
  "jp": "まぁ、この先は実際に行って\n確かめてみてださい。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2531"
  ],
  "who": "#61"
 },
 {
  "id": "s2040:00e6f",
  "jp": "お近づきの印にどうぞ。\n美味しいですよ。\nでは……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2538"
  ],
  "who": "#61"
 },
 {
  "id": "s2040:00ea2",
  "jp": "あぁ、そうそう。言い忘れていた。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x25cb"
  ],
  "who": "#61"
 },
 {
  "id": "s2040:00ec3",
  "jp": "時間経過によって変化してしまう\n物もあるから、気をつけるようにね",
  "en": "",
  "status": "todo",
  "slots": [
   "0x25d2"
  ],
  "who": "#61"
 },
 {
  "id": "s2040:00f03",
  "jp": "あと、自分の評判にも気をつけてね\n……それじゃ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x25d9"
  ],
  "who": "#61"
 },
 {
  "id": "s2040:00f33",
  "jp": "ワシはかつての大海賊の武器を\n作ったことがあるんじゃ！\n本当じゃって！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x339b"
  ],
  "who": "#68"
 },
 {
  "id": "s2040:00f78",
  "jp": "ホ、ホレ！\nしょ、証拠を見せてやるわい！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x33a2"
  ],
  "who": "#68"
 },
 {
  "id": "s2040:00fa0",
  "jp": "ホレ！　ゴールデンスピアじゃ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x341a"
  ],
  "who": "#68"
 },
 {
  "id": "s2040:00fbf",
  "jp": "金塊を引き伸ばしただけ？\nバ、馬鹿を言うでないわい！\n実際に使って確かめい！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3421"
  ],
  "who": "#68"
 },
 {
  "id": "s2040:0100a",
  "jp": "どうじゃ？　ゴールデンスピアは\n役に立ってるじゃろう？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3441"
  ],
  "who": "#68"
 },
 {
  "id": "s2040:01040",
  "jp": "なんせワシは、伝説の鍛冶師だから\nのう！\nワッハッハ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3448"
  ],
  "who": "#68"
 },
 {
  "id": "s2040:01075",
  "jp": "ワシはかつての大海賊の武器を\n作ったことがあるんじゃ！\n本当じゃって！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3460"
  ],
  "who": "#68"
 },
 {
  "id": "s2040:010ba",
  "jp": "な、何故誰も信じてくれ\nないんじゃ……。",
