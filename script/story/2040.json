  "status": "todo",
  "slots": [
   "0x1e23"
  ],
  "voice": 841,
  "who": "イシュト"
 },
 {
  "id": "s2040:001cc",
  "jp": "遺跡のウィルの他にもう一つ、\n変なウィルを感じるの。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1e38"
  ],
  "voice": 842,
  "who": "ルルゥ"
 },
 {
  "id": "s2040:00204",
  "jp": "島も近いし、島の住人のウィルとか\nじゃないか？",
