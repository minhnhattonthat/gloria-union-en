  "status": "todo",
  "slots": [
   "0x21e7"
  ],
  "voice": 863,
  "who": "ザザーランド"
 },
 {
  "id": "s2040:00560",
  "jp": "いたぞ！\n……くそ！　助けを求めたか。\nチッ、かまわん！　やれ！",
