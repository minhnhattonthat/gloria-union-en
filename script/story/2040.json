  "status": "todo",
  "slots": [
   "0x1f9c"
  ],
  "voice": 848,
  "who": "ロコモコ"
 },
 {
  "id": "s2040:0030e",
  "jp": "どんどん近寄ってくる……\nこの先だよ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1fb5"
  ],
  "voice": 849,
  "who": "ルルゥ"
 },
 {
  "id": "s2040:00338",
  "jp": "誰なんですかね？",
