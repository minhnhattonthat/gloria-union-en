  "status": "todo",
  "slots": [
   "0x5192"
  ],
  "who": "#72"
 },
 {
  "id": "s2040:01381",
  "jp": "私の他にも“海の平和を守る会”の\nメンバーは存在するわ！\n探してみてね！",
