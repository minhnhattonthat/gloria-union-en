  "status": "todo",
  "slots": [
   "0x1f3c"
  ],
  "voice": 847,
  "who": "トレイシー"
 },
 {
  "id": "s2040:002e0",
  "jp": "ぎゃああぁぁ！　\nほ、本当にうってきた！　",
