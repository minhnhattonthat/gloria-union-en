  "status": "todo",
  "slots": [
   "0x23b7"
  ],
  "voice": 867,
  "who": "ロコモコ"
 },
 {
  "id": "s2040:00649",
  "jp": "なんという幼女愛好家。\n世も末だと思いませんか？",
