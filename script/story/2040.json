   "0x1cd9"
  ],
  "voice": 833,
  "who": "ロコモコ"
 },
 {
  "id": "s2040:0003f",
  "jp": "待て！　止まらなければ撃つぞ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1cf2"
  ],
  "voice": 834,
  "who": "#46"
 },
 {
  "id": "s2040:00062",
  "jp": "うな～！　まだ追いかけてくる～！\nロコモコが何をしたっていうの～？",
