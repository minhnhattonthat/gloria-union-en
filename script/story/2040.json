  "slots": [
   "0x2180"
  ],
  "voice": 860,
  "who": "エリーシャ"
 },
 {
  "id": "s2040:0049c",
  "jp": "追われてるの！　助けて！　\n助けろ！　\n助けなさいよ、この鈍チンども！",
