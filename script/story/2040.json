  "status": "todo",
  "slots": [
   "0x21ce"
  ],
  "voice": 862,
  "who": "イシュト"
 },
 {
  "id": "s2040:00519",
  "jp": "混乱してるんだろ。\n……で、嬢ちゃん。\nその追ってきた奴らってのは？",
