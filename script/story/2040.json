   "0x7def"
  ],
  "voice": 875,
  "who": "ルルゥ"
 },
 {
  "id": "s2040:0078d",
  "jp": "恐らく、どっかの商団の連中だな。\nエンブレムが、商人を表すもの\nだった。",
