[
 {
  "id": "s2049:00028",
  "jp": "前方より敵影を確認！\nあれは、ルキア皇国軍です！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2517"
  ],
  "voice": 1486,
  "who": "ピンガー"
 },
 {
  "id": "s2049:0005c",
  "jp": "チッ。\nやっぱり追ってきやがったか……！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x252c"
  ],
  "voice": 1487,
  "who": "イシュト"
 },
 {
  "id": "s2049:00088",
  "jp": "ピンガー！　旗に書いてある数字を\n教えてくれ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2541"
  ],
  "voice": 1488,
  "who": "ザザーランド"
 },
 {
  "id": "s2049:000ba",
  "jp": "数字、ですか？\nえぇと……１と３、ですね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2556"
  ],
  "voice": 1489,
  "who": "ピンガー"
 },
 {
  "id": "s2049:000e8",
  "jp": "よりによってアイツらかよ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2576"
  ],
  "voice": 1490,
  "who": "ザザーランド"
 },
 {
  "id": "s2049:00107",
  "jp": "アイツらってなによ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2588"
  ],
  "voice": 1491,
  "who": "エリーシャ"
 },
 {
  "id": "s2049:00120",
  "jp": "一番隊隊長のガルム。\n三番隊隊長のメラニー。\nルキア皇国、最強の槍と盾だ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x259d"
  ],
  "voice": 1492,
  "who": "ザザーランド"
 },
 {
  "id": "s2049:0016d",
  "jp": "迂回はできないんですか？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x25b2"
  ],
  "voice": 1493,
  "who": "ピンガー"
 },
 {
  "id": "s2049:0018a",
  "jp": "ダメ！　どの航路も塞がれてる！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x25d5"
  ],
  "voice": 1494,
  "who": "ルルゥ"
 },
 {
  "id": "s2049:001ad",
  "jp": "え？　それって、おかしいわよ！\nそれじゃあアイツら、遺跡の場所が\nわかってるってことじゃない！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x25ea"
  ],
  "voice": 1495,
  "who": "エリーシャ"
 },
 {
  "id": "s2049:0020e",
  "jp": "私に言われても～……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x25ff"
  ],
  "voice": 1496,
  "who": "ルルゥ"
 },
 {
  "id": "s2049:00229",
  "jp": "時代は流れてんだ。\n恐らく、超高感度の探知機を\n開発したか、手に入れたんだろう。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2614"
  ],
  "voice": 1497,
  "who": "ザザーランド"
 },
 {
  "id": "s2049:0027c",
  "jp": "うぅ、私の存在意義が……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2629"
  ],
  "voice": 1498,
  "who": "ルルゥ"
 },
 {
  "id": "s2049:0029b",
  "jp": "止まれ！　グロリア海賊団！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x265e"
  ],
  "voice": 1499,
  "who": "ガルム"
 },
 {
  "id": "s2049:002ba",
  "jp": "鍵と羅針盤を渡せ！\n断れば、その場で戦闘することも\n止むを得ないぞ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2677"
  ],
  "voice": 1500,
  "who": "メラニー"
 },
 {
  "id": "s2049:00301",
  "jp": "鍵と、羅針盤だぁ？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x26c8"
  ],
  "voice": 1501,
  "who": "イシュト"
 },
 {
  "id": "s2049:00318",
  "jp": "アンタの剣と、ルルゥのことよ。\n事情を知ってる人達は、\n二人のことをそう呼ぶわ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x26dd"
  ],
  "voice": 1502,
  "who": "エリーシャ"
 },
 {
  "id": "s2049:0036b",
  "jp": "なんだかルルゥをモノ扱いされてる\nようで、気にいらねぇな。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x26f2"
  ],
  "voice": 1503,
  "who": "イシュト"
 },
 {
  "id": "s2049:003a9",
  "jp": "じゃあ、どうするの？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2707"
  ],
  "voice": 1504,
  "who": "エリーシャ"
 },
 {
  "id": "s2049:003c2",
  "jp": "断るに決まってんだろ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x271c"
  ],
  "voice": 1505,
  "who": "イシュト"
 },
 {
  "id": "s2049:003dd",
  "jp": "私も、せっかくみんなと\n会えたんだもん。\n出て行くわけにはいかないよ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2731"
  ],
  "voice": 1506,
  "who": "ルルゥ"
 },
 {
  "id": "s2049:00426",
  "jp": "なら、戦闘準備だ。\nやつらはお前らを只の子供に見てる\nからな。度肝抜いてやれ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2746"
  ],
  "voice": 1507,
  "who": "ザザーランド"
 },
 {
  "id": "s2049:00477",
  "jp": "おう！",
  "en": "You got it!",
  "status": "done",
  "slots": [
   "0x275b"
  ],
  "voice": 1508,
  "who": "イシュト"
 },
 {
  "id": "s2049:00482",
  "jp": "ウム、ニ隊で一気に潰すか？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x285a"
  ],
  "voice": 1509,
  "who": "ガルム"
 },
 {
  "id": "s2049:004a1",
  "jp": "ならば私が前線に出て、敵の攻撃を\n防ぎます。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2873"
  ],
  "voice": 1510,
  "who": "メラニー"
 },
 {
  "id": "s2049:004d1",
  "jp": "よし、ならば、攻撃は私に任せて\nもらおう。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x288c"
  ],
  "voice": 1511,
  "who": "ガルム"
 },
 {
  "id": "s2049:004ff",
  "jp": "槍のガルムに盾のメラニーか。\n一筋縄ではいかなそうだな……。\n武器の相性を考えねぇとな。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x28a5"
  ],
  "voice": 1512,
  "who": "イシュト"
 },
 {
  "id": "s2049:0055a",
  "jp": "どうした小僧、怖気づいたか？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x50cf"
  ],
  "voice": 1513,
  "who": "ガルム"
 },
 {
  "id": "s2049:0057b",
  "jp": "なんて威圧感。まるで、親父と\n戦ってるみてぇだ……！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x50e9"
  ],
  "voice": 1514,
  "who": "イシュト"
 },
 {
  "id": "s2049:005b3",
  "jp": "アシュレイ様の弟か、忌々しい。\nすぐに我が剣の錆にしてくれる！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5a43"
  ],
  "voice": 1515,
  "who": "メラニー"
 },
 {
  "id": "s2049:005f5",
  "jp": "隊列に隙がねぇ。\nどこから抜けばいいんだ……！？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5a5d"
  ],
  "voice": 1516,
  "who": "イシュト"
 },
 {
  "id": "s2049:00629",
  "jp": "機械仕掛けの人形が、\n人間に逆らうのか。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x52df"
  ],
  "voice": 1517,
  "who": "ガルム"
 },
 {
  "id": "s2049:00655",
  "jp": "アナタ達に、クリスタルは\n渡さない！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x52f9"
  ],
  "voice": 1518,
  "who": "ルルゥ"
 },
 {
  "id": "s2049:0067d",
  "jp": "懐かしいな。こうして討ち合える\nのは何年ぶりか！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x54ef"
  ],
  "voice": 1519,
  "who": "ガルム"
 },
 {
  "id": "s2049:006b1",
  "jp": "ヘッ、そんじゃあ今回も、\n勝ち逃げさせてもらおうかねぇ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5509"
  ],
  "voice": 1520,
  "who": "ザザーランド"
 },
 {
  "id": "s2049:006ed",
  "jp": "貴様に敗れてから、我が隊の盾は\nさらに強化された！\nもう破られることはない！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5e50"
  ],
  "voice": 1521,
  "who": "メラニー"
 },
 {
  "id": "s2049:0073c",
  "jp": "破られることはない、ねぇ。\nその自信、実力か？　\nそれとも、只の慢心か？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5e6a"
  ],
  "voice": 1522,
  "who": "ザザーランド"
 },
 {
  "id": "s2049:00787",
  "jp": "ルキア皇国騎士団一番隊隊長\n“神槍のガルム”！\n相手をしよう。獣人の娘よ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x51d3"
  ],
  "who": "ガルム"
 },
 {
  "id": "s2049:007d0",
  "jp": "ルキア皇国軍の将軍……。\n今のボク達に相手が\nできるのでしょうか……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x51ed"
  ],
  "who": "ピンガー"
 },
 {
  "id": "s2049:00815",
  "jp": "ルキア皇国騎士団三番隊隊長\n“守護神メラニー”\n貴様の攻撃、全て無効化してやる！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5b47"
  ],
  "who": "メラニー"
 },
 {
  "id": "s2049:00864",
  "jp": "完璧な隊列。隙が無いってのは\nこのことですね……。\nどう攻めましょうか？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5b61"
  ],
  "who": "ピンガー"
 },
 {
  "id": "s2049:008ab",
  "jp": "そこを退いて！\n次の遺跡にいけないでしょ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5c35"
  ],
  "who": "ルルゥ"
 },
 {
  "id": "s2049:008d5",
  "jp": "行く必要は無い。\n貴様等の旅はここで終わりだ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5c4e"
  ],
  "who": "メラニー"
 },
 {
  "id": "s2049:00903",
  "jp": "ザザーランドの娘か。\n後世の為に、ここで摘んでおくのも\n悪くは無いな。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x53e3"
  ],
  "who": "ガルム"
 },
 {
  "id": "s2049:00948",
  "jp": "そう簡単に摘まれて\nたまるもんですか！\n返り討ちにしてあげるわ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x53fd"
  ],
  "who": "エリーシャ"
 },
 {
  "id": "s2049:00987",
  "jp": "ガチガチに隊を固めちゃって、\nあたしの銃がそんなに怖いの？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5d29"
  ],
  "who": "エリーシャ"
 },
 {
  "id": "s2049:009c1",
  "jp": "安い挑発はやめたほうがいい。\n惨めに見えるぞ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5d42"
  ],
  "who": "メラニー"
 },
 {
  "id": "s2049:009ef",
  "jp": "語るなら、武器で語れ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5d57"
  ],
  "who": "メラニー"
 },
 {
  "id": "s2049:00a06",
  "jp": "ミネソタ・グレイ？\n著名な考古学者でもある\nアナタが何故こんな所に。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x55f3"
  ],
  "who": "ガルム"
 },
 {
  "id": "s2049:00a49",
  "jp": "妙な縁ができたのでね。\n悪いが、お相手願おうか。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x560d"
  ],
  "who": "ミネソタ"
 },
 {
  "id": "s2049:00a79",
  "jp": "まさかアナタがグロリア海賊団に\n入っていようとは。\nファンの身としてはショックですね",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5f5b"
  ],
  "who": "メラニー"
 },
 {
  "id": "s2049:00acc",
  "jp": "ファンか……。\n自分の書いた本を読んでくれている\n人物と会えるとは、嬉しいな。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5f75"
  ],
  "who": "ミネソタ"
 },
 {
  "id": "s2049:00b19",
  "jp": "だがそれなら、自分がどんな\n男なのかも知っているのでは\nないか？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5f8a"
  ],
  "who": "ミネソタ"
 },
 {
  "id": "s2049:00b58",
  "jp": "幼き娘よ、去れ。\nここはお前の様な者のいるべき\n場所ではない。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x56f7"
  ],
  "who": "ガルム"
 },
 {
  "id": "s2049:00b95",
  "jp": "よゆうでいられるのも今の内だよ！\nロコモコの魔法で、ビックリさせて\nあげるんだから！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5711"
  ],
  "who": "ロコモコ"
 },
 {
  "id": "s2049:00be8",
  "jp": "そんな隊列、ロコモコのメテオで\nまとめて吹き飛ばしてあげる！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x6065"
  ],
  "who": "ロコモコ"
 },
 {
  "id": "s2049:00c24",
  "jp": "童女の攻撃などで崩れるほど\n我が隊は柔ではない！\nかかってくるがいい！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x607e"
  ],
  "who": "メラニー"
 },
 {
  "id": "s2049:00c69",
  "jp": "貴様、奇妙な格好をしているな。\nどこの国の者だ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5802"
  ],
  "who": "ガルム"
 },
 {
  "id": "s2049:00c99",
  "jp": "私は黄泉の国\n悪魔局死人管理部罪人課の\nラズベリーっす！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x581c"
  ],
  "who": "ラズベリー"
 },
 {
  "id": "s2049:00cd0",
  "jp": "黄泉の国……\n聞いたことの無い名前だ。\n念の為、同行を願おうか。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5835"
  ],
  "who": "ガルム"
 },
 {
  "id": "s2049:00d0f",
  "jp": "貴様、何者だ！\n空を飛ぶ人間など見た事がない！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x6168"
  ],
  "who": "メラニー"
 },
 {
  "id": "s2049:00d3d",
  "jp": "私は黄泉の国\n悪魔局死人管理部罪人課の\nラズベリーっす！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x6182"
  ],
  "who": "ラズベリー"
 },
 {
  "id": "s2049:00d74",
  "jp": "よ、黄泉の国？\nわ、わけがわからない……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x6197"
  ],
  "who": "メラニー"
 },
 {
  "id": "s2049:00d9e",
  "jp": "皇国騎士団の隊長か。\n丁度いい、\nここで討たせてもらうぞ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5917"
  ],
  "who": "フィービー"
 },
 {
  "id": "s2049:00dd7",
  "jp": "シャンティエの出身者か。\n物資を得るために海賊を頼るとは、\n堕ちたものだな。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5930"
  ],
  "who": "ガルム"
 },
 {
  "id": "s2049:00e22",
  "jp": "貴様……！\n馬ごと深海に引きずり込んでやる！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x594a"
  ],
  "who": "フィービー"
 },
 {
  "id": "s2049:00e4e",
  "jp": "貴様等の脆弱な陣形など、\n私の槍で貫いてやる！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x626b"
  ],
  "who": "フィービー"
 },
 {
  "id": "s2049:00e7c",
  "jp": "フン、貴様如きが。\n強さを語るな！",
