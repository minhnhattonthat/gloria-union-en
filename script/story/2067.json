[
 {
  "id": "s2067:00028",
  "jp": "ここが、エルマーレ連合国の本部。\n光の遺跡、通称“光の海域”\nです。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3482"
  ],
  "voice": 2907,
  "who": "エンリエッタ"
 },
 {
  "id": "s2067:0006f",
  "jp": "うひゃあ、広ぉい！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x349b"
  ],
  "voice": 2908,
  "who": "ロコモコ"
 },
 {
  "id": "s2067:00086",
  "jp": "綺麗な建物ですねぇ。\nまさしく光の遺跡。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x34c7"
  ],
  "voice": 2909,
  "who": "イータ"
 },
 {
  "id": "s2067:000b2",
  "jp": "もっと豪勢にしてるのかと思ったら\n案外そうでもないのねぇ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x34fa"
  ],
  "voice": 2910,
  "who": "パメラ"
 },
 {
  "id": "s2067:000f0",
  "jp": "同盟の旗の数が半端じゃないっす。\n噂では聞いてたっすけど、ここまで\n大きな組織とは思わなかったっす。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x351a"
  ],
  "voice": 2911,
  "who": "ラズベリー"
 },
 {
  "id": "s2067:00157",
  "jp": "同盟国は全部で七つ。\nしかしそれでも、皇国軍の力には\n及ばないのです。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3533"
  ],
  "voice": 2912,
  "who": "エンリエッタ"
 },
 {
  "id": "s2067:001a0",
  "jp": "ルキア皇国は、世界有数の軍事国家\nだが……。\nまさかこれほどに差があるとはな。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3565"
  ],
  "voice": 2913,
  "who": "ミネソタ"
 },
 {
  "id": "s2067:001f1",
  "jp": "皆、歯噛みしております。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x357b"
  ],
  "voice": 2914,
  "who": "エンリエッタ"
 },
 {
  "id": "s2067:0020e",
  "jp": "……イシュト、\n大人しくついて来ちゃったけど、\nよかったの？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3594"
  ],
  "voice": 2915,
  "who": "ルルゥ"
 },
 {
  "id": "s2067:0024d",
  "jp": "それ以外に道はなかったよ。\n光の海域に着いたし、結果オーライ\nじゃないか？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x35ad"
  ],
  "voice": 2916,
  "who": "イシュト"
 },
 {
  "id": "s2067:0029a",
  "jp": "それはそうだけど……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x35c6"
  ],
  "voice": 2917,
  "who": "ルルゥ"
 },
 {
  "id": "s2067:002b5",
  "jp": "うぅん……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x35df"
  ],
  "voice": 2918,
  "who": "エリーシャ"
 },
 {
  "id": "s2067:002c6",
  "jp": "あれ？　エリーシャさん、浮かない\n顔ですね。母親と再会出来たんです\nから、もっと喜んではどうですか？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x360a"
  ],
  "voice": 2919,
  "who": "ピンガー"
 },
 {
  "id": "s2067:0032d",
  "jp": "再会っていっても、あたしが\n生まれてすぐに別れたらしいし。\n初対面みたいなもんよ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3620"
  ],
  "voice": 2920,
  "who": "エリーシャ"
 },
 {
  "id": "s2067:00382",
  "jp": "そうなんですか？\nチ、せっかくエリーシャさんの\nデレが見れると思ったのに……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3636"
  ],
  "voice": 2921,
  "who": "ピンガー"
 },
 {
  "id": "s2067:003d3",
  "jp": "デレってなによ……。\nま、嬉しいのは確かよ。混乱して\n逆に冷静なのかもしれないわね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x364f"
  ],
  "voice": 2922,
  "who": "エリーシャ"
 },
 {
  "id": "s2067:0042a",
  "jp": "で？　突然俺達の前に現れた理由は\nなんだ？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3684"
  ],
  "voice": 2923,
  "who": "ザザーランド"
 },
 {
  "id": "s2067:00458",
  "jp": "アナタならわかっていると思うけど\n……これよ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x369d"
  ],
  "voice": 2924,
  "who": "エンリエッタ"
 },
 {
  "id": "s2067:0048a",
  "jp": "光のクリスタル……！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x36b6"
  ],
  "voice": 2925,
  "who": "ルルゥ"
 },
 {
  "id": "s2067:004a3",
  "jp": "イシュトさん。\nアナタに、このクリスタルの封印を\n解いて欲しいのです。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x36cf"
  ],
  "voice": 2926,
  "who": "エンリエッタ"
 },
 {
  "id": "s2067:004ec",
  "jp": "ちょ……なんで、イシュトが封印を\n解けるって知ってるのよ！？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x36f3"
  ],
  "voice": 2927,
  "who": "エリーシャ"
 },
 {
  "id": "s2067:0052c",
  "jp": "光のクリスタルが置かれていた\n台座に刻まれていたのですよ。\n“王家の末裔を探せ”と。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3709"
  ],
  "voice": 2928,
  "who": "エンリエッタ"
 },
 {
  "id": "s2067:00583",
  "jp": "なんで、イシュトがユーフォリアの\n末裔だって、知ってるの？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3722"
  ],
  "voice": 2929,
  "who": "ルルゥ"
 },
 {
  "id": "s2067:005c1",
  "jp": "それは、船長さんに聞けばわかる\nと思います。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x373b"
  ],
  "voice": 2930,
  "who": "エンリエッタ"
 },
 {
  "id": "s2067:005f1",
  "jp": "親父に……？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3751"
  ],
  "voice": 2931,
  "who": "エリーシャ"
 },
 {
  "id": "s2067:00602",
  "jp": "……ま、その話は後だ。\nイシュト。封印を解いてくれ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3767"
  ],
  "voice": 2932,
  "who": "ザザーランド"
 },
 {
  "id": "s2067:0063a",
  "jp": "わかった。\n……うお、なんだこれ、今までとは\n桁違いにウィルが吸い取られるぞ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3780"
  ],
  "voice": 2933,
  "who": "イシュト"
 },
 {
  "id": "s2067:0068b",
  "jp": "光のカードは要のカードだから。\n頑張って、イシュト。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3799"
  ],
  "voice": 2934,
  "who": "ルルゥ"
 },
 {
  "id": "s2067:006c3",
  "jp": "おう、サンキューなルルゥ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x37b2"
  ],
  "voice": 2935,
  "who": "イシュト"
 },
 {
  "id": "s2067:006e2",
  "jp": "……ふん！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3805"
  ],
  "voice": 2936,
  "who": "イシュト"
 },
 {
  "id": "s2067:006f1",
  "jp": "ふぅ……。完了っと。\n光のカード、名前は“ホーリー”\nか……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x386d"
  ],
  "voice": 2937,
  "who": "イシュト"
 },
 {
  "id": "s2067:00732",
  "jp": "お疲れ様。スゴイ汗ね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3883"
  ],
  "voice": 2938,
  "who": "エリーシャ"
 },
 {
  "id": "s2067:0074d",
  "jp": "ギリギリだった……。\nそんなに強力なカードなのか？\nこのカード……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3899"
  ],
  "voice": 2939,
  "who": "イシュト"
 },
 {
  "id": "s2067:00794",
  "jp": "……お願いね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x38b2"
  ],
  "voice": 2940,
  "who": "エンリエッタ"
 },
 {
  "id": "s2067:007a7",
  "jp": "セヤァ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x38dd"
  ],
  "voice": 2941,
  "who": "#42"
 },
 {
  "id": "s2067:007b4",
  "jp": "え？\nうわあぁぁぁ！！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3912"
  ],
  "voice": 2942,
  "who": "イシュト"
 },
 {
  "id": "s2067:007ce",
  "jp": "ひ、光のカードが奪われた！！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x396b"
  ],
  "voice": 2943,
  "who": "ルルゥ"
 },
 {
  "id": "s2067:007ef",
  "jp": "エンリエッタ様、これを。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3984"
  ],
  "voice": 2944,
  "who": "#42"
 },
 {
  "id": "s2067:0080c",
  "jp": "ありがとう。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x399d"
  ],
  "voice": 2945,
  "who": "エンリエッタ"
 },
 {
  "id": "s2067:0081d",
  "jp": "どういうことだ……！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x39b6"
  ],
  "voice": 2946,
  "who": "イシュト"
 },
 {
  "id": "s2067:00836",
  "jp": "ごめんなさい……。\n私は、どうしても世界を平和に\n導かなければならないの。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x39cf"
  ],
  "voice": 2947,
  "who": "エンリエッタ"
 },
 {
  "id": "s2067:00883",
  "jp": "お母さん……？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x39f3"
  ],
  "voice": 2948,
  "who": "エリーシャ"
 },
 {
  "id": "s2067:00896",
  "jp": "た、たくさんのウィルが、\nこっちに近づいてくるよ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3a28"
  ],
  "voice": 2949,
  "who": "ロコモコ"
 },
 {
  "id": "s2067:008cc",
  "jp": "少しはマシになったと期待したが。\n……甘かったか。\n総員戦闘準備！　迎え撃て！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3a41"
  ],
  "voice": 2950,
  "who": "ザザーランド"
 },
 {
  "id": "s2067:0091d",
  "jp": "何々、なんなのよ一体！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3dcc"
  ],
  "voice": 2951,
  "who": "エリーシャ"
 },
 {
  "id": "s2067:00938",
  "jp": "ルルゥ、遺跡のカードは俺にしか\n使えないんじゃないのか！？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3de5"
  ],
  "voice": 2952,
  "who": "イシュト"
 },
 {
  "id": "s2067:00976",
  "jp": "イシュトにしか出来ないのは\n封印の解除だけ！\nカードの使用は、誰でもできるの！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3e03"
  ],
  "voice": 2953,
  "who": "ルルゥ"
 },
 {
  "id": "s2067:009c7",
  "jp": "なんだとぉ！？\nじゃ、じゃあ皆も使えるのか！？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3e1c"
  ],
  "voice": 2954,
  "who": "イシュト"
 },
 {
  "id": "s2067:009f9",
  "jp": "消費量が多すぎて誰も使えないよ。\nエンリエッタさんのウィルの量が\n異常なだけ……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3e3a"
  ],
  "voice": 2955,
  "who": "ルルゥ"
 },
 {
  "id": "s2067:00a4e",
  "jp": "ウィルとは意思。心の力と\n謂われているわ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3e53"
  ],
  "voice": 2956,
  "who": "エンリエッタ"
 },
 {
  "id": "s2067:00a7c",
  "jp": "私は幼少の頃より、確固たる意思を\n持って生活してきた……。\nその意思の力、味わいなさい。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3e5d"
  ],
  "voice": 2957,
  "who": "エンリエッタ"
 },
 {
  "id": "s2067:00ad7",
  "jp": "あなた達のおかげで、私は仲間を\n手に入れました。\nエンリエッタという、仲間を。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x617c"
  ],
  "voice": 2958,
  "who": "ジゼル"
 },
 {
  "id": "s2067:00b28",
  "jp": "ジゼル……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x6195"
  ],
  "voice": 2959,
  "who": "イシュト"
 },
 {
  "id": "s2067:00b39",
  "jp": "私は、エンリエッタの過去と\n今を知り、そして共感しました。\nなので、私はアナタの敵です。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x61ae"
  ],
  "voice": 2960,
  "who": "ジゼル"
 },
 {
  "id": "s2067:00b94",
  "jp": "……見たかったぜ、\n鯛や平目の舞踊り。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x61c7"
  ],
  "voice": 2961,
  "who": "イシュト"
 },
 {
  "id": "s2067:00bbe",
  "jp": "アナタも平和のための\n犠牲となりなさい。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x6409"
  ],
  "voice": 2962,
  "who": "エンリエッタ"
 },
 {
  "id": "s2067:00bea",
  "jp": "平和のための犠牲？\nわけがわからん。\n自分の平和ぐらい自分で見つける。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x6423"
  ],
  "voice": 2963,
  "who": "イシュト"
 },
 {
  "id": "s2067:00c33",
  "jp": "そういうところ、\n昔の彼とそっくりだわ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x643c"
  ],
  "voice": 2964,
  "who": "エンリエッタ"
 },
 {
  "id": "s2067:00c5f",
  "jp": "まさか、実の母親に裏切られるとは\n思わなかったわ……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x6710"
  ],
  "voice": 2965,
  "who": "エリーシャ"
 },
 {
  "id": "s2067:00c99",
  "jp": "ごめんなさいね。\nでも、これが私の意思なの。\n例え娘でも、情はかけられないわ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x6729"
  ],
  "voice": 2966,
  "who": "エンリエッタ"
 },
 {
  "id": "s2067:00cea",
  "jp": "ま、ほぼ初対面なんだし、\n情も何もないわ。\n……覚悟してちょうだいね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x6743"
  ],
  "voice": 2967,
  "who": "エリーシャ"
 },
 {
  "id": "s2067:00d33",
  "jp": "私がイシュト君のカードを奪った時\nアナタ、止められたんじゃないの？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x6835"
  ],
  "voice": 2968,
  "who": "エンリエッタ"
 },
 {
  "id": "s2067:00d79",
  "jp": "まさか、光のカードを使えるほどに\n強くなってるとは思わなかった。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x684f"
  ],
  "voice": 2969,
  "who": "ザザーランド"
 },
 {
  "id": "s2067:00dbd",
  "jp": "へぇ……優しいのね。相変わらず。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x6868"
  ],
  "voice": 2970,
  "who": "エンリエッタ"
 },
 {
  "id": "s2067:00de2",
  "jp": "馬鹿野郎。\nただの弱みだよ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x6882"
  ],
  "voice": 2971,
  "who": "ザザーランド"
 },
 {
  "id": "s2067:00e02",
  "jp": "陛下……まさか、もう一度戦う事に\nなるとは思いませんでした……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x62aa"
  ],
  "voice": 2972,
  "who": "フィービー"
 },
 {
  "id": "s2067:00e46",
  "jp": "えぇ、今度は負けませんよ。\n私にも、仲間ができたのですから。\n共に歩む仲間が。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x62c3"
  ],
  "voice": 2973,
  "who": "ジゼル"
 },
 {
  "id": "s2067:00e97",
  "jp": "我等の意思はシャンティエにあり。\nあなたから、最初に教わった言葉\nです。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x62dd"
  ],
  "voice": 2974,
  "who": "フィービー"
 },
 {
  "id": "s2067:00ee2",
  "jp": "フフ、懐かしいわ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x62f6"
  ],
  "voice": 2975,
  "who": "ジゼル"
 },
 {
  "id": "s2067:00ef9",
  "jp": "全力で、いくぞ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x6310"
  ],
  "voice": 2976,
  "who": "フィービー"
 },
 {
  "id": "s2067:00f0e",
  "jp": "どうしてわざわざ兄貴を\n襲うようなマネを？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x6510"
  ],
  "who": "ピンガー"
 },
 {
  "id": "s2067:00f38",
  "jp": "そんな事するより、\n協力し合った方が何倍も\nいいじゃないですか。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x651a"
  ],
  "who": "ピンガー"
 },
 {
  "id": "s2067:00f77",
  "jp": "アナタ達があの人の下にいる時点で\nその可能性は消えたわ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x6533"
  ],
  "who": "エンリエッタ"
 },
 {
  "id": "s2067:00faf",
  "jp": "さぁ、いきますよ。子猫さん。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x653d"
  ],
  "who": "エンリエッタ"
 },
 {
  "id": "s2067:00fcc",
  "jp": "生身の体でそのカードを\n使いこなせるなんて……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x6611"
  ],
  "who": "ルルゥ"
 },
 {
  "id": "s2067:00ffc",
  "jp": "アナタの心には……意思には、\nどれほどの思いが宿ってるの……？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x661b"
  ],
  "who": "ルルゥ"
 },
 {
  "id": "s2067:0103a",
  "jp": "私の平和への意思は、\nこの世の誰にも負けません。\nさぁ、いきますよ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x6634"
  ],
  "who": "エンリエッタ"
 },
 {
  "id": "s2067:0107d",
  "jp": "アナタは、平和の為なら娘をも\n殺す気なのか……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x695d"
  ],
  "who": "ミネソタ"
 },
 {
  "id": "s2067:010ad",
  "jp": "……えぇ。\nそうです。\nそれが、なにか？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x6976"
  ],
  "who": "エンリエッタ"
 },
 {
  "id": "s2067:010d4",
  "jp": "……よかろう。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x6990"
  ],
  "who": "ミネソタ"
 },
 {
  "id": "s2067:010e3",
  "jp": "ならばその歪んだ意思、\n自分の槍で正してやる！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x69a5"
  ],
  "who": "ミネソタ"
 },
 {
  "id": "s2067:01111",
  "jp": "この戦いが終われば、アナタの様な\n子供が戦う事もなくなるのです。\nだから、大人しくしていてね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x6a96"
  ],
  "who": "エンリエッタ"
 },
 {
  "id": "s2067:0116e",
  "jp": "やぁだよっ！\nロコモコ、まだお兄ちゃん達と\n一緒にいたいもん！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x6ab0"
  ],
  "who": "ロコモコ"
 },
 {
  "id": "s2067:011ab",
  "jp": "アナタ。\n黄泉の国の出身らしいですね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x6b9a"
  ],
  "who": "エンリエッタ"
 },
 {
  "id": "s2067:011d1",
  "jp": "死んでいった者達は、\nどうしているのかしら？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x6ba4"
  ],
  "who": "エンリエッタ"
 },
 {
  "id": "s2067:011fd",
  "jp": "残念っすけど、私は罪人課なんで。\n信教者の方々とは課が違うっすよ。\nごめんなさいっす。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x6bbe"
  ],
  "who": "ラズベリー"
 },
 {
  "id": "s2067:01252",
  "jp": "シャンティエは\n反皇国連合国の一つ。\nアナタは、国に逆らうのですか？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x6ca8"
  ],
  "who": "エンリエッタ"
 },
 {
  "id": "s2067:01295",
  "jp": "国に逆らった気など毛頭も無い！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x6cc2"
  ],
  "who": "フィービー"
 },
 {
  "id": "s2067:012b4",
  "jp": "貴様の正義は歪んでいる。\n従うわけには、いかない！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x6ccc"
  ],
  "who": "フィービー"
 },
 {
  "id": "s2067:012e6",
  "jp": "アナタは正義の賞金稼ぎを\n自負している。\n何故、戦おうとするのですか。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x6ea3"
  ],
  "who": "エンリエッタ"
 },
 {
  "id": "s2067:0132b",
  "jp": "私とアナタの正義は\n同じようで大きく違います。\nアナタは、私の敵です。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x6ebd"
  ],
  "who": "ユグドラ"
 },
 {
  "id": "s2067:01370",
  "jp": "ガンガガガ、ガガガング！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x6da0"
  ],
  "who": "ガング"
 },
 {
  "id": "s2067:01389",
  "jp": "古代遺跡の守護者。\nアナタを倒せるほどの力があれば、\n平和への道は一気に広がります。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x6db9"
  ],
  "who": "エンリエッタ"
 },
 {
  "id": "s2067:013dc",
  "jp": "聞かせてください。\nアナタは何故、皇国軍の様な所に\n所属していたのですか？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x6fa7"
  ],
  "who": "エンリエッタ"
 },
 {
  "id": "s2067:01425",
  "jp": "幼い頃から武に才能があり、\nその才能を活かせ、尚且つ給料が\n高かったのが皇国軍だった。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x6fc1"
  ],
  "who": "カミュル"
 },
 {
  "id": "s2067:0147a",
  "jp": "たった、それだけの事です。\nお偉い方の考えなど、\n僕にはわかりません！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x6fcb"
  ],
  "who": "カミュル"
 },
 {
  "id": "s2067:014bf",
  "jp": "アナタ。こんな事して疲れないの？\nもっと好きに生きればぁ？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x709f"
  ],
  "who": "アンヌ"
 },
 {
  "id": "s2067:014f9",
  "jp": "心配なさらずとも、\n私は自分の好きに生きていますよ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x70b8"
  ],
  "who": "エンリエッタ"
 },
 {
  "id": "s2067:0152d",
  "jp": "さぁ、アナタも平和への犠牲に\nなりなさい！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x71a2"
  ],
  "who": "エンリエッタ"
 },
 {
  "id": "s2067:01557",
  "jp": "平和平和平和って。\nどこの世界にもいるもんねぇ。\nこういう平和狂いの狂信家。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x71bc"
  ],
  "who": "パメラ"
 },
 {
  "id": "s2067:015a2",
  "jp": "平和の為に、アナタ達をここで\n討ちます！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x72a6"
  ],
  "who": "エンリエッタ"
 },
 {
  "id": "s2067:015ca",
  "jp": "そんな武器を振りかざさなくても、\n楽器一つで世界は平和になると\nいうのに……かわいそうな人。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x72c0"
  ],
  "who": "イータ"
 },
 {
  "id": "s2067:01625",
  "jp": "フィービー。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x74e3"
  ],
  "voice": 2977,
  "who": "ジゼル"
 },
 {
  "id": "s2067:01636",
  "jp": "はい！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x7501"
  ],
  "voice": 2978,
  "who": "フィービー"
 },
 {
  "id": "s2067:01641",
  "jp": "私の体はもう持ちません。\n消滅し、赤子として、生を得る\nでしょう。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x751a"
  ],
  "voice": 2979,
  "who": "ジゼル"
 },
 {
  "id": "s2067:01686",
  "jp": "そんな……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x7538"
  ],
  "voice": 2980,
  "who": "フィービー"
 },
 {
  "id": "s2067:01697",
  "jp": "その時まで、シャンティエを、\n頼みましたよ……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x7551"
  ],
  "voice": 2981,
  "who": "ジゼル"
 },
 {
  "id": "s2067:016cb",
  "jp": "はい……はい……！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x756f"
  ],
  "voice": 2982,
  "who": "フィービー"
 },
 {
  "id": "s2067:016e2",
  "jp": "我等の意思はシャンティエにあり。\n……エンリエッタ。力になれなくて\nごめんなさいね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x7588"
  ],
  "voice": 2983,
  "who": "ジゼル"
 },
 {
  "id": "s2067:01739",
  "jp": "我等の意思はシャンティエにあり。\n陛下。安らかに、お眠りください。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x7694"
  ],
  "voice": 2984,
  "who": "フィービー"
 },
 {
  "id": "s2067:0177f",
  "jp": "また一人、犠牲者が出た。\nだけど、それは必要な犠牲……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x7cb0"
  ],
  "voice": 2985,
  "who": "エンリエッタ"
 },
 {
  "id": "s2067:017bb",
  "jp": "犠牲なくして救いはない。\nそして、その犠牲を決めない限り、\n世界に平和は訪れない。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x7cb7"
  ],
  "voice": 2986,
  "who": "エンリエッタ"
 },
 {
  "id": "s2067:01810",
  "jp": "犠牲を、決める……？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x7cd5"
  ],
  "voice": 2987,
  "who": "エリーシャ"
 },
 {
  "id": "s2067:01829",
  "jp": "犠牲を決めるのはとても辛く難しい\nこと。しかし、私はあえて……\nその役目を担おうと思うわ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x7cee"
  ],
  "voice": 2988,
  "who": "エンリエッタ"
 },
 {
  "id": "s2067:01886",
  "jp": "神にでもなるつもりですか……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x7d09"
  ],
  "voice": 2989,
  "who": "ピンガー"
 },
 {
  "id": "s2067:018a9",
  "jp": "神なんて、ただ見てるだけの\n無能な存在よ。\nだから私は、審判者となる。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x7d1f"
  ],
  "voice": 2990,
  "who": "エンリエッタ"
 },
 {
  "id": "s2067:018f2",
  "jp": "審判者ねぇ……。\nなるほど。それが、アンタの意思\nってやつか。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x7d3d"
  ],
  "voice": 2991,
  "who": "イシュト"
 },
 {
  "id": "s2067:01933",
  "jp": "私はこの意思を叶えるわ。\nアナタ達は、その尊き犠牲の一つに\nなるのよ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x7d64"
  ],
  "voice": 2992,
  "who": "エンリエッタ"
 },
 {
  "id": "s2067:0197c",
  "jp": "敵が遠くから近づいてくるよ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x7d82"
  ],
  "voice": 2993,
  "who": "ルルゥ"
 },
 {
  "id": "s2067:0199d",
  "jp": "止まったら囲まれるな……。\nお前ら！　移動しながら戦うぞ！\n付いて来い！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x7da0"
  ],
  "voice": 2994,
  "who": "ザザーランド"
 },
 {
  "id": "s2067:019e8",
  "jp": "あ！　そのおてがみ！\nわたしが出したおてがみだ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x9198"
  ],
  "who": "#73"
 },
 {
  "id": "s2067:01a18",
  "jp": "アナタがひろってくれたの？\nえへへ～ありがとう！\nねぇ、おともだちになりましょう？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x919f"
  ],
  "who": "#73"
 },
 {
  "id": "s2067:01a69",
  "jp": "いいの？　わ～いやったー！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x91a6"
  ],
  "who": "#73"
 },
 {
  "id": "s2067:01a84",
  "jp": "じゃ、じゃあ。\nおちかづきのしるしに、\nこれあげるね！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x91ad"
  ],
  "who": "#73"
 },
 {
  "id": "s2067:01ab9",
  "jp": "えへへ、うれしいね！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x921c"
  ],
  "who": "#73"
 },
 {
  "id": "s2067:01ace",
  "jp": "ねぇ、なにして遊ぶ？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x923c"
  ],
  "who": "#73"
 },
 {
  "id": "s2067:01ae3",
  "jp": "ここギイセには、かつて英雄が\n住んでいたといわれています。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x9254"
  ],
  "who": "#70"
 },
 {
  "id": "s2067:01b1d",
  "jp": "そして今、再び英雄が、この土地に\n帰ってきました。\nその方こそ、エンリエッタ様です。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x925b"
  ],
  "who": "#70"
 },
 {
  "id": "s2067:01b70",
  "jp": "今世界は、エンリエッタ様のお力で\n着実に平和への道を歩んでいます。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x9262"
  ],
  "who": "#70"
 },
 {
  "id": "s2067:01bb2",
  "jp": "エンリエッタ様が世界の英雄として\n語り継がれるのは、そう遠い日では\nないようですね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x9269"
  ],
  "who": "#70"
 },
 {
  "id": "s2067:01c05",
  "jp": "私は救済都市エゴンの市長。\n現在戦線では武器が不足している。\n何か寄付をしてくれんかね？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x9310"
  ],
  "who": "#75"
 },
 {
  "id": "s2067:01c5c",
  "jp": "おぉ、交換してくれるか、助かる。\nでは、礼としてこの剣をやろう。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x9317"
  ],
  "who": "#75"
 },
 {
  "id": "s2067:01c9c",
  "jp": "かつて名将を夢見ていた頃に使って\nいたワシの剣じゃ。\nありがたく受け取れ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x9365"
  ],
  "who": "#75"
 },
 {
  "id": "s2067:01ce5",
  "jp": "さぁ、何か寄付してくれる物は\nないかね？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x9385"
  ],
  "who": "#75"
 },
 {
  "id": "s2067:01d0d",
  "jp": "私は救済都市エゴンの市長。\n現在戦線では武器が不足している。\n何か寄付をしてくれんかね？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x939d"
  ],
  "who": "#75"
 },
 {
  "id": "s2067:01d64",
  "jp": "この島は“光の海域”と呼ばれる\n古代遺跡でのう。\nなんと島全体が一つの遺跡なんじゃ",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3f5d",
   "0x9434"
  ],
  "who": "#68"
 },
 {
  "id": "s2067:01db5",
  "jp": "光の海域には、\n古代ユーフォリア時代に実際に\n使われていた研究施設があっての。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3f64",
   "0x943b"
  ],
  "who": "#68"
 },
 {
  "id": "s2067:01e02",
  "jp": "今わかっている古代ユーフォリアの\n歴史のほとんどが、その研究施設に\n残された資料に記されていた事じゃ",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3f6b",
   "0x9442"
  ],
  "who": "#68"
 },
 {
  "id": "s2067:01e65",
  "jp": "もしかしたら、まだ知られざる\n歴史が眠ってるかもしれんぞ？\nひぇっひぇっひぇ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3f72",
   "0x9449"
  ],
  "who": "#68"
 },
 {
  "id": "s2067:01eb2",
  "jp": "これもまた、知られざる歴史の\n一つじゃ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3f92",
   "0x9469"
  ],
  "who": "#68"
 },
 {
  "id": "s2067:01eda",
  "jp": "この砲台、記録では数千年前から\n存在しておるが、未だに機能が\n生きておる。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4001",
   "0x94d8"
  ],
  "who": "#68"
 },
 {
  "id": "s2067:01f23",
  "jp": "なぜ動くのか、何故朽ちないのか。\nまだ誰にも解明できておらん。",
