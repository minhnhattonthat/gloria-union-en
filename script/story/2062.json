[
 {
  "id": "s2062:00028",
  "jp": "“バッソフォンド”戦場の最先端と\nいわれる都市か。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x33bc"
  ],
  "voice": 2630,
  "who": "ザザーランド"
 },
 {
  "id": "s2062:0005e",
  "jp": "まさしく戦場ね。\n埃っぽくてかなわないわ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x33e8"
  ],
  "voice": 2631,
  "who": "アンヌ"
 },
 {
  "id": "s2062:0008c",
  "jp": "もはや、島全体が戦場と化して\nいますね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3418"
  ],
  "voice": 2632,
  "who": "ユグドラ"
 },
 {
  "id": "s2062:000b8",
  "jp": "戦場で思い浮かぶ詩は、\n皆悲しい詩になってしまいます。\n例えそれが平和の詩でも……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x344b"
  ],
  "voice": 2633,
  "who": "イータ"
 },
 {
  "id": "s2062:0010f",
  "jp": "ある意味、地獄よりも悲惨な所\nっすね。戦場っていうのは。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x346b"
  ],
  "voice": 2634,
  "who": "ラズベリー"
 },
 {
  "id": "s2062:0014b",
  "jp": "怖いよ……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3480"
  ],
  "voice": 2635,
  "who": "ロコモコ"
 },
 {
  "id": "s2062:0015c",
  "jp": "戦場になる前は、どんな都市\nだったの？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3499"
  ],
  "voice": 2636,
  "who": "ルルゥ"
 },
 {
  "id": "s2062:00186",
  "jp": "ルキア皇国の領内だったらしい\nです。なんでも、厳しい接収に\n耐え切れず反旗を翻したとか。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x34b2"
  ],
  "voice": 2637,
  "who": "ピンガー"
 },
 {
  "id": "s2062:001e1",
  "jp": "胸くそ悪い話ね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x34e4"
  ],
  "voice": 2638,
  "who": "エリーシャ"
 },
 {
  "id": "s2062:001f6",
  "jp": "だが、どこにでもある話だ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x34fa"
  ],
  "voice": 2639,
  "who": "ミネソタ"
 },
 {
  "id": "s2062:00215",
  "jp": "なくなるといいね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3510"
  ],
  "voice": 2640,
  "who": "ルルゥ"
 },
 {
  "id": "s2062:0022c",
  "jp": "なくすために、私達がいるのです。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x353c"
  ],
  "voice": 2641,
  "who": "ユグドラ"
 },
 {
  "id": "s2062:00251",
  "jp": "なくすのだ。私達の手で。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x356f"
  ],
  "voice": 2642,
  "who": "フィービー"
 },
 {
  "id": "s2062:0026e",
  "jp": "仕事が増えるのも嫌っすからねぇ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x358f"
  ],
  "voice": 2643,
  "who": "ラズベリー"
 },
 {
  "id": "s2062:00293",
  "jp": "あんたはもうちょっと真面目に\n考えられないの？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x35ac"
  ],
  "voice": 2644,
  "who": "エリーシャ"
 },
 {
  "id": "s2062:002c5",
  "jp": "文化の違いっすよ。すいませんっす",
  "en": "",
  "status": "todo",
  "slots": [
   "0x35c2"
  ],
  "voice": 2645,
  "who": "ラズベリー"
 },
 {
  "id": "s2062:002ea",
  "jp": "バッソフォンド側が押されてるな。\nここはいっちょ、救援にでも行くか",
  "en": "",
  "status": "todo",
  "slots": [
   "0x35f0"
  ],
  "voice": 2646,
  "who": "イシュト"
 },
 {
  "id": "s2062:00330",
  "jp": "フッフ、私の銃が唸っています。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x361c"
  ],
  "voice": 2647,
  "who": "ユグドラ"
 },
 {
  "id": "s2062:00353",
  "jp": "あんたは一人でも戦争できそうね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3635"
  ],
  "voice": 2648,
  "who": "エリーシャ"
 },
 {
  "id": "s2062:00378",
  "jp": "そこのお方、ちょっとよろしい\nでしょうか。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3658"
  ],
  "voice": 2649,
  "who": "サイード"
 },
 {
  "id": "s2062:003a6",
  "jp": "ん？　なんだお前、バッソフォンド\nの人間か？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x36f6"
  ],
  "voice": 2650,
  "who": "イシュト"
 },
 {
  "id": "s2062:003d6",
  "jp": "一応、この都市の長をしておる。\nサイードというものじゃ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x370f"
  ],
  "voice": 2651,
  "who": "サイード"
 },
 {
  "id": "s2062:00412",
  "jp": "長！？\nおま……アナタが、ですか？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3741"
  ],
  "voice": 2652,
  "who": "ミネソタ"
 },
 {
  "id": "s2062:00438",
  "jp": "その人が何のようですか？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3757"
  ],
  "voice": 2653,
  "who": "ピンガー"
 },
 {
  "id": "s2062:00455",
  "jp": "あなた方を旅のお方と見込んで、\nお願いしたいことがあるんじゃ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x376d"
  ],
  "voice": 2654,
  "who": "サイード"
 },
 {
  "id": "s2062:00497",
  "jp": "お願いしたいこと？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3783"
  ],
  "voice": 2655,
  "who": "ルルゥ"
 },
 {
  "id": "s2062:004ae",
  "jp": "この先の森に生えている薬草を採り\nたいのじゃが、山賊が邪魔をして\nおってのう。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3799"
  ],
  "voice": 2656,
  "who": "サイード"
 },
 {
  "id": "s2062:004ff",
  "jp": "採りに行ってほしいってことか。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x37e0"
  ],
  "voice": 2657,
  "who": "ザザーランド"
 },
 {
  "id": "s2062:00522",
  "jp": "礼ならいくらでもする！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x37f9"
  ],
  "voice": 2658,
  "who": "サイード"
 },
 {
  "id": "s2062:0053d",
  "jp": "イシュト、どうするの？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3812"
  ],
  "voice": 2659,
  "who": "ルルゥ"
 },
 {
  "id": "s2062:00558",
  "jp": "んー、中心街の救援にも行きたいん\nだけどなぁ。薬草は早い内じゃない\nとダメか？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3839"
  ],
  "voice": 2660,
  "who": "イシュト"
 },
 {
  "id": "s2062:005a9",
  "jp": "一刻を争う状況じゃ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3885"
  ],
  "voice": 2661,
  "who": "サイード"
 },
 {
  "id": "s2062:005c2",
  "jp": "補給地点の薬草がなくなりかけて\nいるのかもしれん。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x38a9"
  ],
  "voice": 2662,
  "who": "ミネソタ"
 },
 {
  "id": "s2062:005f8",
  "jp": "そうなったら大変だよー。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x38bf"
  ],
  "voice": 2663,
  "who": "ロコモコ"
 },
 {
  "id": "s2062:00615",
  "jp": "しかし、紛争そのものを\n終わらせれば、その必要もない。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x38eb"
  ],
  "voice": 2664,
  "who": "フィービー"
 },
 {
  "id": "s2062:0064f",
  "jp": "強引っすけど、確実っすね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x38fd"
  ],
  "voice": 2665,
  "who": "ラズベリー"
 },
 {
  "id": "s2062:0066e",
  "jp": "掛かる時間はどちらも同じぐらいね",
  "en": "",
  "status": "todo",
  "slots": [
   "0x391a"
  ],
  "voice": 2666,
  "who": "エリーシャ"
 },
 {
  "id": "s2062:00693",
  "jp": "そうか……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3937"
  ],
  "voice": 2667,
  "who": "イシュト"
 },
 {
  "id": "s2062:006a4",
  "jp": "これが薬草か。\nよし、さっさと届けようぜ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x6ec7"
  ],
  "voice": 2668,
  "who": "イシュト"
 },
 {
  "id": "s2062:006d2",
  "jp": "この薬草は……\nなるほど、そういうことか。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x6edc"
  ],
  "voice": 2669,
  "who": "ザザーランド"
 },
 {
  "id": "s2062:00700",
  "jp": "おい！　取ってきたぞ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x77a7"
  ],
  "voice": 2670,
  "who": "イシュト"
 },
 {
  "id": "s2062:0071b",
  "jp": "すまんのう！\nこれで……これでまた、戦える。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x77c0"
  ],
  "voice": 2671,
  "who": "サイード"
 },
 {
  "id": "s2062:0074b",
  "jp": "え……それって、どういう……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x77d9"
  ],
  "voice": 2672,
  "who": "ルルゥ"
 },
 {
  "id": "s2062:0076e",
  "jp": "ッ！！　あんた、その怪我！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x77f6"
  ],
  "voice": 2673,
  "who": "エリーシャ"
 },
 {
  "id": "s2062:0078d",
  "jp": "うゎ、グロ……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x782d"
  ],
  "voice": 2674,
  "who": "パメラ"
 },
 {
  "id": "s2062:007a2",
  "jp": "折れた骨が皮膚を突き破っているな\n……相当の重傷だ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x7851"
  ],
  "voice": 2675,
  "who": "ミネソタ"
 },
 {
  "id": "s2062:007da",
  "jp": "うぅ、見てるだけで痛い……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x786a"
  ],
  "voice": 2676,
  "who": "ロコモコ"
 },
 {
  "id": "s2062:007fb",
  "jp": "たしかに、その怪我じゃ山賊を\n倒すどころか、森に行くことも\nできませんね……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x7891"
  ],
  "voice": 2677,
  "who": "ピンガー"
 },
 {
  "id": "s2062:0084c",
  "jp": "この薬草は、痛みを麻痺させる\n効果がある。これさえあれば……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x78bc"
  ],
  "voice": 2678,
  "who": "サイード"
 },
 {
  "id": "s2062:0088e",
  "jp": "痛みを和らげたところで、\n機能が回復したわけでもあるまい。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x78d2"
  ],
  "voice": 2679,
  "who": "ミネソタ"
 },
 {
  "id": "s2062:008cc",
  "jp": "付け焼刃だな。お前、死ぬぞ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x7900"
  ],
  "voice": 2680,
  "who": "ザザーランド"
 },
 {
  "id": "s2062:008ed",
  "jp": "生きていることに意味があるのだ。\n死んでは話にならん。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x7929"
  ],
  "voice": 2681,
  "who": "フィービー"
 },
 {
  "id": "s2062:00927",
  "jp": "武勲をあげなくちゃいけないん\nじゃよ。この貧しい都市で生きて\nいくにはの……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x7946"
  ],
  "voice": 2682,
  "who": "サイード"
 },
 {
  "id": "s2062:00978",
  "jp": "確かに、武勲をあげれば、\nそれなりの金と食料は優先される。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x795f"
  ],
  "voice": 2683,
  "who": "ザザーランド"
 },
 {
  "id": "s2062:009b6",
  "jp": "だからって無理して戦うことなんて\nないじゃない！\n方法は他にたくさんあるわ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x7986"
  ],
  "voice": 2684,
  "who": "エリーシャ"
 },
 {
  "id": "s2062:00a05",
  "jp": "働く場所は破壊される。都市を\n出ようとした者は、殺される。\n戦うしか……ないんじゃよ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x799c"
  ],
  "voice": 2685,
  "who": "サイード"
 },
 {
  "id": "s2062:00a5e",
  "jp": "そんな……！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x79b2"
  ],
  "voice": 2686,
  "who": "エリーシャ"
 },
 {
  "id": "s2062:00a6f",
  "jp": "長でさえも、そんな状況なのか……\nクッ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x79e2"
  ],
  "voice": 2687,
  "who": "フィービー"
 },
 {
  "id": "s2062:00a9b",
  "jp": "国には国の事情がある。\n俺達には関係ない。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x7a02"
  ],
  "voice": 2688,
  "who": "ザザーランド"
 },
 {
  "id": "s2062:00ac9",
  "jp": "冷たくねぇか、親父。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x7a29"
  ],
  "voice": 2689,
  "who": "イシュト"
 },
 {
  "id": "s2062:00ae2",
  "jp": "兄貴、わかってるでしょう。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x7a42"
  ],
  "voice": 2690,
  "who": "ピンガー"
 },
 {
  "id": "s2062:00b01",
  "jp": "わかってるよ。俺はまだ、ルールを\n変えられるほど強くないってさ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x7a5b"
  ],
  "voice": 2691,
  "who": "イシュト"
 },
 {
  "id": "s2062:00b45",
  "jp": "まだ、ですか。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x7a74"
  ],
  "voice": 2692,
  "who": "ピンガー"
 },
 {
  "id": "s2062:00b58",
  "jp": "あぁ。まだだ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x7a8d"
  ],
  "voice": 2693,
  "who": "イシュト"
 },
 {
  "id": "s2062:00b6b",
  "jp": "行くぞ。急ぐ理由が増えた。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x7aa6"
  ],
  "voice": 2694,
  "who": "ザザーランド"
 },
 {
  "id": "s2062:00b8a",
  "jp": "了解。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x7abf"
  ],
  "voice": 2695,
  "who": "イシュト"
 },
 {
  "id": "s2062:00b95",
  "jp": "な、なんでこんな所にグロリアが！\nて、撤退！　撤退だぁー！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x6ffb"
  ],
  "voice": 2696,
  "who": "#41"
 },
 {
  "id": "s2062:00bd3",
  "jp": "よし、これで皇国軍も\nしばらく来ないだろ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x7ca3"
  ],
  "voice": 2697,
  "who": "イシュト"
 },
 {
  "id": "s2062:00c01",
  "jp": "だんだんイシュトさんの強さも\n常軌を逸してきたっすね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x7cb9"
  ],
  "voice": 2698,
  "who": "ラズベリー"
 },
 {
  "id": "s2062:00c3b",
  "jp": "普通に強くなったとは\n言ってくれないのか……？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x7ccf"
  ],
  "voice": 2699,
  "who": "イシュト"
 },
 {
  "id": "s2062:00c6d",
  "jp": "みんな大活躍だったねぇ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x7ce5"
  ],
  "voice": 2700,
  "who": "ロコモコ"
 },
 {
  "id": "s2062:00c8a",
  "jp": "これだけ敵だらけだと、掃射しても\n味方に当たらなくていいですね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x7d23"
  ],
  "voice": 2701,
  "who": "ユグドラ"
 },
 {
  "id": "s2062:00cce",
  "jp": "少し、複雑ですね。\n……っていかんいかん！\n弱気の兵は戦場に呑まれるぞ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x7d53"
  ],
  "voice": 2702,
  "who": "カミュル"
 },
 {
  "id": "s2062:00d19",
  "jp": "ケホ。さすがに喉が乾燥しやすい\nですね。\nお水お水っと。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x7d83"
  ],
  "voice": 2703,
  "who": "イータ"
 },
 {
  "id": "s2062:00d54",
  "jp": "あ、あんた達……。なんてことを\n……なんてことをしてくれたんだ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x7dd3"
  ],
  "voice": 2704,
  "who": "#77"
 },
 {
  "id": "s2062:00d98",
  "jp": "え？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x7de9"
  ],
  "voice": 2705,
  "who": "イシュト"
 },
 {
  "id": "s2062:00da1",
  "jp": "な、なんで、怒ってるの……？\n協力したのに。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x7dff"
  ],
  "voice": 2706,
  "who": "ルルゥ"
 },
 {
  "id": "s2062:00dd1",
  "jp": "……なるほど、そういうわけね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x7e36"
  ],
  "voice": 2707,
  "who": "アンヌ"
 },
 {
  "id": "s2062:00df4",
  "jp": "余所者が武勲を横取りしやがって！\nこの泥棒！！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x7e53"
  ],
  "voice": 2708,
  "who": "#77"
 },
 {
  "id": "s2062:00e26",
  "jp": "な……んだとぉ！？\nあのままだったら、お前達死んで\nたんだぞ！？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x7e65"
  ],
  "voice": 2709,
  "who": "イシュト"
 },
 {
  "id": "s2062:00e69",
  "jp": "武勲をあげなきゃ食料もねぇんだ！\n死んだも同じよ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x7e77"
  ],
  "voice": 2710,
  "who": "#77"
 },
 {
  "id": "s2062:00e9f",
  "jp": "食料を規制して、無理やり戦わせて\nいるのね……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x7ea9"
  ],
  "voice": 2711,
  "who": "エリーシャ"
 },
 {
  "id": "s2062:00ed3",
  "jp": "戦闘意欲を出させるのには抜群な\n政治といえるな。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x7ebf"
  ],
  "voice": 2712,
  "who": "ミネソタ"
 },
 {
  "id": "s2062:00f07",
  "jp": "反吐が出るわ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x7ed5"
  ],
  "voice": 2713,
  "who": "エリーシャ"
 },
 {
  "id": "s2062:00f1a",
  "jp": "共感しよう。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x7eeb"
  ],
  "voice": 2714,
  "who": "ミネソタ"
 },
 {
  "id": "s2062:00f2b",
  "jp": "そんな……。じゃあ、私達、\n邪魔をしたってこと？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x7f16"
  ],
  "voice": 2715,
  "who": "ルルゥ"
 },
 {
  "id": "s2062:00f5f",
  "jp": "いやいや、助けなきゃ死んでたんす\nから、どっちにしろ貧乏くじだった\nんすよ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x7f2c"
  ],
  "voice": 2716,
  "who": "ラズベリー"
 },
 {
  "id": "s2062:00fae",
  "jp": "誇りもなにもない、只生きるため\nだけの戦争か……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x7f71"
  ],
  "voice": 2717,
  "who": "フィービー"
 },
 {
  "id": "s2062:00fe4",
  "jp": "あのまま皇国軍にいたら。\nボクもこの戦争に出ていたかも\nしれないのか……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x7fa1"
  ],
  "voice": 2718,
  "who": "カミュル"
 },
 {
  "id": "s2062:01031",
  "jp": "なんだろう……とても、空しい。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x7fbe"
  ],
  "voice": 2719,
  "who": "ルルゥ"
 },
 {
  "id": "s2062:01054",
  "jp": "世の中には、色々なルールがあるん\nですよ。気にしてはダメです。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x7fd4"
  ],
  "voice": 2720,
  "who": "ピンガー"
 },
 {
  "id": "s2062:01096",
  "jp": "チッ……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x800d"
  ],
  "voice": 2721,
  "who": "イシュト"
 },
 {
  "id": "s2062:010a5",
  "jp": "ふてくされてないで、ルルゥを\n励ましてきなさいよ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x8023"
  ],
  "voice": 2722,
  "who": "エリーシャ"
 },
 {
  "id": "s2062:010db",
  "jp": "……わかったよ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x8039"
  ],
  "voice": 2723,
  "who": "イシュト"
 },
 {
  "id": "s2062:010f0",
  "jp": "さっさと行きましょう。\nあまりここには居たくないん\nだわさ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x8077"
  ],
  "voice": 2724,
  "who": "パメラ"
 },
 {
  "id": "s2062:0112f",
  "jp": "まぁ、いい訓練になったとだけ\n考えてろ。行くぞ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x8094"
  ],
  "voice": 2725,
  "who": "ザザーランド"
 },
 {
  "id": "s2062:01163",
  "jp": "……了解。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x80aa"
  ],
  "voice": 2726,
  "who": "イシュト"
 },
 {
  "id": "s2062:01174",
  "jp": "オラ！　一列に並べ！\n順番は紙に書いてある通り！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3ae3"
  ],
  "who": "#41"
 },
 {
  "id": "s2062:011a4",
  "jp": "先の戦闘で活躍したものから\n順に並べ！　いいな！？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3aea"
  ],
  "who": "#41"
 },
 {
  "id": "s2062:011d6",
  "jp": "貴様は、余所者か？\nフン、せいぜい戦争の邪魔はしない\nことだな。ホレ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3af1"
  ],
  "who": "#41"
 },
 {
  "id": "s2062:0121b",
  "jp": "余計な手を出して後悔するのは\n貴様のほうだぞ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3b60"
  ],
  "who": "#41"
 },
 {
  "id": "s2062:01249",
  "jp": "運がよかったな。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3b78"
  ],
  "who": "#41"
 },
 {
  "id": "s2062:0125a",
  "jp": "今日はたまたまサイード市長が\n頑張ってくださったおかげで\n豪華な食事だったんだ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3b7f"
  ],
  "who": "#41"
 },
 {
  "id": "s2062:012a9",
  "jp": "そのサイード市長も怪我をなされた\n……次はもうないと思え。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3b86"
  ],
  "who": "#41"
 },
 {
  "id": "s2062:012e3",
  "jp": "院長！　急患です！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3c19"
  ],
  "who": "#72"
 },
 {
  "id": "s2062:012f6",
  "jp": "またか！　クソ！\n骨が折れている程度なら広場へ\n運べ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3c2b"
  ],
  "who": "#62"
 },
 {
  "id": "s2062:0132b",
  "jp": "治療を終えた患者にも手伝わせろ！\n無理をさせない程度にだ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3c32"
  ],
  "who": "#62"
 },
 {
  "id": "s2062:01365",
  "jp": "もうこの都市に患者も医者も\n関係ない！\nできるものがやらねば！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3c39"
  ],
  "who": "#62"
 },
 {
  "id": "s2062:013a2",
  "jp": "そうしなければ……この数は\n捌ききれんぞ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3c40"
  ],
  "who": "#62"
 },
 {
  "id": "s2062:013cc",
  "jp": "お、おぉ。手伝ってくれるのか？\nすまない！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3c6d"
  ],
  "who": "#62"
 },
 {
  "id": "s2062:013f6",
  "jp": "あなた……あなた……！！\nどうして、どうして、死んで\nしまったの……！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3d14"
  ],
  "who": "#71"
 },
 {
  "id": "s2062:0143b",
  "jp": "私を……お腹の赤ちゃんを残して。\nなんで……！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3d1b"
  ],
  "who": "#71"
 },
 {
  "id": "s2062:01469",
  "jp": "アナタ……夫の友人の方ですか？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3d22"
  ],
  "who": "#71"
 },
 {
  "id": "s2062:01488",
  "jp": "受け取ってください……夫の形見\nです。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3d91"
  ],
  "who": "#71"
 },
 {
  "id": "s2062:014ae",
  "jp": "いいんです！\n持ってると……後を追ってしまい\nそうだから……受け取ってください",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3d98"
  ],
  "who": "#71"
 },
 {
  "id": "s2062:014fb",
  "jp": "私には、お腹の中の子がいます……\n夫の分まで、私が、育てないと\nいけないんです……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3db0"
  ],
  "who": "#71"
 },
 {
  "id": "s2062:0154e",
  "jp": "だから、死ねないんですよ、私。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3db7"
  ],
  "who": "#71"
 },
 {
  "id": "s2062:0156d",
  "jp": "あなた……あなた……！！\nどうして、どうして、死んで\nしまったの……！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3dd7"
  ],
  "who": "#71"
 },
 {
  "id": "s2062:015b2",
  "jp": "私を……お腹の赤ちゃんを残して。\nなんで……！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3dde"
  ],
  "who": "#71"
 },
 {
  "id": "s2062:015e0",
  "jp": "アナタ……夫の友人の方ですか？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3de5"
  ],
  "who": "#71"
 },
 {
  "id": "s2062:015ff",
  "jp": "これで……これでどうか！\n夫の恨みを晴らしてください！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3e54"
  ],
  "who": "#71"
 },
 {
  "id": "s2062:01635",
  "jp": "この槍で、憎き皇国の心臓を……\n貫いてください！！\nお願いします、お願いします……！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3e5b"
  ],
  "who": "#71"
 },
 {
  "id": "s2062:01688",
  "jp": "憎い……夫を奪った皇国が！\n戦争を呼び込んだ皇国が！\n憎い憎い憎い憎いニクイニクイ！！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3e73"
  ],
  "who": "#71"
 },
 {
  "id": "s2062:016dd",
  "jp": "あ、あの……\nその魔水晶とエレメント。\nこの太陽のオーブと交換しません？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3f0f"
  ],
  "who": "#70"
 },
 {
  "id": "s2062:01724",
  "jp": "いいんですか？\nやったぁ！　これで逃げるための\n資金は集るぞ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3f16"
  ],
  "who": "#70"
 },
 {
  "id": "s2062:01761",
  "jp": "そういえば……あの商人さん\n大丈夫かなぁ？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3fef"
  ],
  "who": "#70"
 },
 {
  "id": "s2062:0178b",
  "jp": "この先の洞窟に逃げ込んだみたい\nですが……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3ff6"
  ],
  "who": "#70"
 },
 {
  "id": "s2062:017b7",
  "jp": "洞窟は、ここから北へ行った所に\nあります。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4016"
  ],
  "who": "#70"
 },
 {
  "id": "s2062:017e1",
  "jp": "こんな怖い所、とてもじゃないけど\nいられない！\n資金を溜めて、脱出しないと！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x402e"
  ],
  "who": "#70"
 },
 {
  "id": "s2062:0182c",
  "jp": "敵兵から逃げていたら、\nこんな所に来ちまった。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x40ca"
  ],
  "who": "#61"
 },
 {
  "id": "s2062:0185a",
  "jp": "この金庫、恐らくこの島の全財産が\n避難されている。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x40d1"
  ],
  "who": "#61"
 },
 {
  "id": "s2062:0188c",
  "jp": "っと。別に盗ろうとしているわけ\nじゃねぇ。\nこちとら立派な商人魂持ってんだ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x40d8"
  ],
  "who": "#61"
 },
 {
  "id": "s2062:018d7",
  "jp": "ホラよ、お近づきの印ってやつだ。\nお互い死なねぇようにしねぇとな。\nまたな！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x41c8"
  ],
  "who": "#61"
 },
 {
  "id": "s2062:01922",
  "jp": "ちゃんと戦争が終わった後の事も\n考えてるんだ。\n立派な市長じゃあねぇか。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x41e0"
  ],
  "who": "#61"
 },
 {
  "id": "s2062:01969",
  "jp": "キーキー！\nキキキーキキキ、キーキーキキー！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4274"
  ],
  "who": "#65"
 },
 {
  "id": "s2062:01995",
  "jp": "キキーキー！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x42e3"
  ],
  "who": "#65"
 },
 {
