  "slots": [
   "0x4322"
  ],
  "who": "#65"
 },
 {
  "id": "s2062:019e8",
  "jp": "うお！　剣だ、ラッキー！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x43d1"
  ],
  "who": "イシュト"
 },
 {
  "id": "s2062:01a01",
  "jp": "って！　なんじゃこりゃあ！\nボロボロじゃねぇかぁ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4427"
  ],
  "who": "イシュト"
 },
 {
  "id": "s2062:01a33",
  "jp": "おぉ、こんな所に剣が。\n兄貴へのお土産にしますかねぇ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4481"
  ],
  "who": "ピンガー"
 },
 {
  "id": "s2062:01a69",
  "jp": "ニャニャ！？\nこ、これじゃあなんの役にも\n立ちませんよ……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x44d7"
  ],
  "who": "ピンガー"
 },
 {
  "id": "s2062:01aa4",
  "jp": "おぉ、こんな所に立派な剣が\n刺さってるよ。\n抜いてみよう！　う～んしょっと！",
