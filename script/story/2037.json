[
 {
  "id": "s2037:00028",
  "jp": "あら？　随分と賑やかねぇ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0xa8f"
  ],
  "voice": 565,
  "who": "アンヌ"
 },
 {
  "id": "s2037:00047",
  "jp": "お前は……！",
  "en": "",
  "status": "todo",
  "slots": [
   "0xc9d"
  ],
  "voice": 566,
  "who": "イシュト"
 },
 {
  "id": "s2037:00058",
  "jp": "あら？　アナタ達。\n脱走しちゃったの？\nフフ、いけない人達ね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0xcb6"
  ],
  "voice": 567,
  "who": "アンヌ"
 },
 {
  "id": "s2037:00099",
  "jp": "悪いけど、もう一度牢屋に入って\nもらうわよ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0xcbd"
  ],
  "voice": 568,
  "who": "アンヌ"
 },
 {
  "id": "s2037:000c9",
  "jp": "また捕まるのは嫌だよ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0xcd6"
  ],
  "voice": 569,
  "who": "ルルゥ"
 },
 {
  "id": "s2037:000e4",
  "jp": "エリーシャの親父さんを\n助けなきゃならないし、\n逃げるわけにはいかないな。",
  "en": "",
  "status": "todo",
  "slots": [
   "0xcef"
  ],
  "voice": 570,
  "who": "イシュト"
 },
 {
  "id": "s2037:00131",
  "jp": "急ぐわよ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0xd08"
  ],
  "voice": 571,
  "who": "エリーシャ"
 },
 {
  "id": "s2037:00140",
  "jp": "と言っても、\n脱獄の後処理は契約外なのよねぇ。\n下っ端にでもまかせるわ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0xd21"
  ],
  "voice": 572,
  "who": "アンヌ"
 },
 {
  "id": "s2037:0018b",
  "jp": "せいぜい、また捕まらないことね。\nバイバァイ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0xd28"
  ],
  "voice": 573,
  "who": "アンヌ"
 },
 {
  "id": "s2037:001bd",
  "jp": "なにこの鍵！　特殊すぎて鍵開け\nなんて出来ないわ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x11f9"
  ],
  "voice": 574,
  "who": "エリーシャ"
 },
 {
  "id": "s2037:001f3",
  "jp": "ほあああぁ！　またやり直しかよ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1213"
  ],
  "voice": 575,
  "who": "イシュト"
 },
 {
  "id": "s2037:00218",
  "jp": "ん……よし、開いたわ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1b23"
  ],
  "voice": 576,
  "who": "エリーシャ"
 },
 {
  "id": "s2037:00233",
  "jp": "エリーシャの親父だからなぁ。\nどんな人なんだろうな。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1b69"
  ],
  "voice": 577,
  "who": "イシュト"
 },
 {
  "id": "s2037:0026b",
  "jp": "エリーシャに似てカッコいい人\nなんじゃないの？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1b91"
  ],
  "voice": 578,
  "who": "ルルゥ"
 },
 {
  "id": "s2037:0029d",
  "jp": "そうゆうもんですかねぇ？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1bab"
  ],
  "voice": 579,
  "who": "ピンガー"
 },
 {
  "id": "s2037:002ba",
  "jp": "おいおい、そんなに期待されると\n出にくいじゃねぇか。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1bc0"
  ],
  "voice": 580,
  "who": "ザザーランド"
 },
 {
  "id": "s2037:002f2",
  "jp": "ハイハイ、愚痴ってないで、\n協力しなさいよ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1bfa"
  ],
  "voice": 581,
  "who": "エリーシャ"
 },
 {
  "id": "s2037:00322",
  "jp": "これが、エリーシャのお父さん？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1c14"
  ],
  "voice": 582,
  "who": "ルルゥ"
 },
 {
  "id": "s2037:00345",
  "jp": "デケェ……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1c3c"
  ],
  "voice": 583,
  "who": "イシュト"
 },
 {
  "id": "s2037:00356",
  "jp": "ほぉ、お前らが……そうか。\nユーフォリアの鍵。羅針盤……。\nこれで奴らに一泡吹かせられるな。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1d38"
  ],
  "voice": 584,
  "who": "ザザーランド"
 },
 {
  "id": "s2037:003b5",
  "jp": "ん？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1d52"
  ],
  "voice": 585,
  "who": "イシュト"
 },
 {
  "id": "s2037:003be",
  "jp": "ん？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1d88"
  ],
  "voice": 586,
  "who": "ルルゥ"
 },
 {
  "id": "s2037:003c7",
  "jp": "なんでもねぇよ。\n俺が、グロリア海賊団船長\nザザーランドだ。よろしくな。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1da2"
  ],
  "voice": 587,
  "who": "ザザーランド"
 },
 {
  "id": "s2037:00412",
  "jp": "どうよ親父！\n見事仲間にしてみせたわよ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1dbc"
  ],
  "voice": 588,
  "who": "エリーシャ"
 },
 {
  "id": "s2037:0043e",
  "jp": "そうみたいだな。\n偉いぞぉエリーシャ。\nこれで俺が働く手間が省けた。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1dd6"
  ],
  "voice": 589,
  "who": "ザザーランド"
 },
 {
  "id": "s2037:00485",
  "jp": "そういえば、ザザーランドは\nどうして黒い牙に捕まってたんだ？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1dfe"
  ],
  "voice": 590,
  "who": "イシュト"
 },
 {
  "id": "s2037:004c5",
  "jp": "それは、奴らが仕組んだ\n巧妙な罠がだなぁ……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1e18"
  ],
  "voice": 591,
  "who": "ザザーランド"
 },
 {
  "id": "s2037:004f7",
  "jp": "宴終わりに飲んだくれてた所を\n攫われただけでしょうが。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1e32"
  ],
  "voice": 592,
  "who": "エリーシャ"
 },
 {
  "id": "s2037:00531",
  "jp": "え、ダサ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1e4c"
  ],
  "voice": 593,
  "who": "ピンガー"
 },
 {
  "id": "s2037:00540",
  "jp": "宴の最中に襲うのは海賊の流儀に\n反するんだ！\n黒い牙はそれがわかってねぇんだ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1e66"
  ],
  "voice": 594,
  "who": "ザザーランド"
 },
 {
  "id": "s2037:00591",
  "jp": "っていうかさぁ。\nコレぐらいの檻なら、\nさっさと脱出できたんじゃないの？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1e8e"
  ],
  "voice": 595,
  "who": "エリーシャ"
 },
 {
  "id": "s2037:005dc",
  "jp": "黒い牙の狙いは俺達と同じだろ？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1ea8"
  ],
  "voice": 596,
  "who": "ザザーランド"
 },
 {
  "id": "s2037:005ff",
  "jp": "だったら、黒い牙が奪った奴を\n俺が奪えばいいんじゃね？\nって考えたわけだ！　名案だろ？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1eaf"
  ],
  "voice": 597,
  "who": "ザザーランド"
 },
 {
  "id": "s2037:00658",
  "jp": "めんどくさがりなだけじゃない。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1ec9"
  ],
  "voice": 598,
  "who": "エリーシャ"
 },
 {
  "id": "s2037:0067b",
  "jp": "で、でも、\nあながち間違えてないかも。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1eff"
  ],
  "voice": 599,
  "who": "ルルゥ"
 },
 {
  "id": "s2037:006a5",
  "jp": "だろ？\n……よし、こんな暗いところでの\n禁酒はもう嫌だ！　脱出するぞ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1f19"
  ],
  "voice": 600,
  "who": "ザザーランド"
 },
 {
  "id": "s2037:006ee",
  "jp": "お、おー！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1f33"
  ],
  "voice": 601,
  "who": "イシュト"
 },
 {
  "id": "s2037:006fd",
  "jp": "あ、あれは、ザザーランド！？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x210d"
  ],
  "voice": 602,
  "who": "アンヌ"
 },
 {
  "id": "s2037:0071e",
  "jp": "チ！\n厄介なのが出てきちゃったわね。\n契約外だけど、今は関係ないわ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2117"
  ],
  "voice": 603,
  "who": "アンヌ"
 },
 {
  "id": "s2037:00765",
  "jp": "このまま脱獄されて依頼者が\n倒されちゃ堪らないわ！\nザザーランドを集中して狙うのよ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2121"
  ],
  "voice": 604,
  "who": "アンヌ"
 },
 {
  "id": "s2037:02518",
  "jp": "そこを退いてもらうぜ。\nアンヌ・コーマック！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3a4e"
  ],
  "voice": 605,
  "who": "イシュト"
 },
 {
  "id": "s2037:02548",
  "jp": "ウフフ。い・や・よ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3a67"
  ],
  "voice": 606,
  "who": "アンヌ"
 },
 {
  "id": "s2037:02561",
  "jp": "いい加減にしないと、\nいくらアタシでも怒っちゃうわよ？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3b59"
  ],
  "voice": 607,
  "who": "アンヌ"
 },
 {
  "id": "s2037:0259b",
  "jp": "なら、怒らせる前に\n帰らせてもらうよ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3b73"
  ],
  "voice": 608,
  "who": "ピンガー"
 },
 {
  "id": "s2037:025c5",
  "jp": "アナタだけでも連れて行かないと、\n契約違反になっちゃうわ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3c65"
  ],
  "voice": 609,
  "who": "アンヌ"
 },
 {
  "id": "s2037:02603",
  "jp": "私はもう捕まんないよ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3c7f"
  ],
  "voice": 610,
  "who": "ルルゥ"
 },
 {
  "id": "s2037:0261e",
  "jp": "親父が加わったんだから、\nアンタも終りね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3d5b"
  ],
  "voice": 611,
  "who": "エリーシャ"
 },
 {
  "id": "s2037:0264c",
  "jp": "彼は三日間なにも食べていないの。\nそれでも同じ口がきけるかしら？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3d74"
  ],
  "voice": 612,
  "who": "アンヌ"
 },
 {
  "id": "s2037:02690",
  "jp": "な、何よこの強さ！　反則！\n……まぁ報酬分は働いたし\n帰りましょう。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3f27"
  ],
  "voice": 613,
  "who": "アンヌ"
 },
 {
  "id": "s2037:026d7",
  "jp": "ふぃー。まぁ、こんなもんかね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x45a8"
  ],
  "voice": 614,
  "who": "ザザーランド"
 },
 {
  "id": "s2037:026fa",
  "jp": "なによ、いつもより調子が出てる\nじゃない。やっぱり禁酒させるべき\nなのかしら……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x45c1"
  ],
  "voice": 615,
  "who": "エリーシャ"
 },
 {
  "id": "s2037:0274f",
  "jp": "それだけは勘弁してくれ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x45da"
  ],
  "voice": 616,
  "who": "ザザーランド"
 },
 {
  "id": "s2037:0276c",
  "jp": "こ、これが、\nグロリア海賊団船長の力……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x45f3"
  ],
  "voice": 617,
  "who": "イシュト"
 },
 {
  "id": "s2037:0279a",
  "jp": "ん？　ハハッ。\n俺の力なんざ、お前の底力には\n劣っちまうよ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x460c"
  ],
  "voice": 618,
  "who": "ザザーランド"
 },
 {
  "id": "s2037:027d9",
  "jp": "いやいや、俺に一振りで五人も\n吹き飛ばすほどの力は……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4625"
  ],
  "voice": 619,
  "who": "イシュト"
 },
 {
  "id": "s2037:02815",
  "jp": "フフ、わかってねぇなぁ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x463e"
  ],
  "voice": 620,
  "who": "ザザーランド"
 },
 {
  "id": "s2037:02832",
  "jp": "？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x465e"
  ],
  "voice": 621,
  "who": "イシュト"
 },
 {
  "id": "s2037:02839",
  "jp": "クリスタルでもありゃあ、\n少しはわかっかもよ？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4677"
  ],
  "voice": 622,
  "who": "ザザーランド"
 },
 {
  "id": "s2037:0286b",
  "jp": "？？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x46ac"
  ],
  "voice": 623,
  "who": "イシュト"
 },
 {
  "id": "s2037:02874",
  "jp": "ハイハイ。\nアホなことやってないで、\nさっさと出ますよ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x46c5"
  ],
  "voice": 624,
  "who": "ピンガー"
 },
 {
  "id": "s2037:028af",
  "jp": "はぁ……はぁ……。\nうぅ、お腹減ったよぉ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x46de"
  ],
  "voice": 625,
  "who": "ルルゥ"
 },
 {
  "id": "s2037:028dd",
  "jp": "えぇー！　ここでか。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4705"
  ],
  "voice": 626,
  "who": "イシュト"
 },
 {
  "id": "s2037:028f6",
  "jp": "案外燃費悪いのね、この子。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x471e"
  ],
  "voice": 627,
  "who": "エリーシャ"
 },
 {
  "id": "s2037:02915",
  "jp": "ほら、これでも食いな。\n遺跡から採れた鉱物だ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4753"
  ],
  "voice": 628,
  "who": "ザザーランド"
 },
 {
  "id": "s2037:02947",
  "jp": "あ、ありがとう。親父さん。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x476c"
  ],
  "voice": 629,
  "who": "ルルゥ"
 },
 {
  "id": "s2037:02966",
  "jp": "ハッハ、どういたしまして。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4785"
  ],
  "voice": 630,
  "who": "ザザーランド"
 },
 {
  "id": "s2037:02985",
  "jp": "……ん？　コイツ、なんでルルゥの\n特殊な食生活を知ってんだ……？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x47ba"
  ],
  "voice": 631,
  "who": "イシュト"
 },
 {
  "id": "s2037:029c9",
  "jp": "コラーーーーーーーーーー！！\n貴重な鉱物を食べるとは、\n何たることだ！！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x47d9"
  ],
  "voice": 632,
  "who": "ミネソタ"
 },
 {
  "id": "s2037:02a14",
  "jp": "わあぁぁ！　人が考え事してんのに\n怒鳴るんじゃねぇよ！　誰だ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x488b"
  ],
  "voice": 633,
  "who": "イシュト"
 },
 {
  "id": "s2037:02a56",
  "jp": "で？　\nあたし達に怒鳴ったあんたは何者？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x48a4"
  ],
  "voice": 634,
  "who": "エリーシャ"
 },
 {
  "id": "s2037:02a82",
  "jp": "フン！　マナーも守らん輩に\n名乗る名はない！\n貴様等こそ何者だ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x48d9"
  ],
  "voice": 635,
  "who": "ミネソタ"
 },
 {
  "id": "s2037:02ac5",
  "jp": "人の名を聞くときは、\nまず自分からだとは思わんかね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x48f2"
  ],
  "voice": 636,
  "who": "ピンガー"
 },
 {
  "id": "s2037:02afd",
