[
 {
  "id": "s2043:00028",
  "jp": "どこを見ても海賊海賊海賊。\nまさに海賊天国ですねぇ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2345"
  ],
  "voice": 1080,
  "who": "ピンガー"
 },
 {
  "id": "s2043:00060",
  "jp": "ねぇ、天国って本当にあるの？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2371"
  ],
  "voice": 1081,
  "who": "ルルゥ"
 },
 {
  "id": "s2043:00081",
  "jp": "ありまっすよ。\n生前罪を犯さず頑張った人達を\n労う所が、天国って呼ばれてるんす",
  "en": "",
  "status": "todo",
  "slots": [
   "0x238e"
  ],
  "voice": 1082,
  "who": "ラズベリー"
 },
 {
  "id": "s2043:000d2",
  "jp": "無駄話してないの。\n周りの奴等がいつ襲ってくるか\nわからないんだから。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x23b5"
  ],
  "voice": 1083,
  "who": "エリーシャ"
 },
 {
  "id": "s2043:0011b",
  "jp": "いつでも戦える準備だけはして\nおけよ。こいつら全員、黒い牙の\n傘下に入ってる海賊どもだ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x23d5"
  ],
  "voice": 1084,
  "who": "ザザーランド"
 },
 {
  "id": "s2043:00176",
  "jp": "なんだって！？\nざっと数えても十はいるぞ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x23ee"
  ],
  "voice": 1085,
  "who": "イシュト"
 },
 {
  "id": "s2043:001a4",
  "jp": "伊達にグロリア海賊団と張り合って\nないわよ。いくらあたし達が強く\nても、この数はてこずるわ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2407"
  ],
  "voice": 1086,
  "who": "エリーシャ"
 },
 {
  "id": "s2043:00203",
  "jp": "それでもてこずる程度ってところに\n驚きだよ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2420"
  ],
  "voice": 1087,
  "who": "ルルゥ"
 },
 {
  "id": "s2043:00233",
  "jp": "止まれ。グロリア海賊団。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2462"
  ],
  "voice": 1088,
  "who": "フィービー"
 },
 {
  "id": "s2043:00250",
  "jp": "お、早速お出ましか。ここは\nいっちょ派手に暴れて、周りの\n奴等をビビらせてやろうぜ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x25dd"
  ],
  "voice": 1089,
  "who": "イシュト"
 },
 {
  "id": "s2043:002a7",
  "jp": "私の名はフィービー。\n“シャンティエ”の戦士。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x25f6"
  ],
  "voice": 1090,
  "who": "フィービー"
 },
 {
  "id": "s2043:002d9",
  "jp": "シャンティエって、\nあの“腐海都市”のシャンティエ？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x260f"
  ],
  "voice": 1091,
  "who": "エリーシャ"
 },
 {
  "id": "s2043:00311",
  "jp": "馬鹿、それは禁句だ……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2628"
  ],
  "voice": 1092,
  "who": "ミネソタ"
 },
 {
  "id": "s2043:0032e",
  "jp": "シャンティエは腐海などではない！\n貴様、我が故郷を愚弄するとは、\n許さん！！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2641"
  ],
  "voice": 1093,
  "who": "フィービー"
 },
 {
  "id": "s2043:0037d",
  "jp": "な、なんか凄く怒ってるみたい\nだけど！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2674"
  ],
  "voice": 1094,
  "who": "ロコモコ"
 },
 {
  "id": "s2043:003a7",
  "jp": "言葉の選択とは重要だな。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2694"
  ],
  "voice": 1095,
  "who": "ミネソタ"
 },
 {
  "id": "s2043:003c4",
  "jp": "う、ご、ごめんなさい。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x26b1"
  ],
  "voice": 1096,
  "who": "エリーシャ"
 },
 {
  "id": "s2043:003df",
  "jp": "シャンティエ。かつてウンディーネ\nの聖地とされ、世界で最も美しいと\n謳われた麗水都市か……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2781"
  ],
  "voice": 1097,
  "who": "ミネソタ"
 },
 {
  "id": "s2043:0043e",
  "jp": "かつてって言うと、今は違うのか？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x279a"
  ],
  "voice": 1098,
  "who": "イシュト"
 },
 {
  "id": "s2043:00463",
  "jp": "数百年前、ルキア皇国の求婚を\nシャンティエの女王が断って以来\n二つの国は現在も戦争を続けている",
  "en": "",
  "status": "todo",
  "slots": [
   "0x27b8"
  ],
  "voice": 1099,
  "who": "ミネソタ"
 },
 {
  "id": "s2043:004c4",
  "jp": "数百年も、戦争を？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x27d6"
  ],
  "voice": 1100,
  "who": "ルルゥ"
 },
 {
  "id": "s2043:004db",
  "jp": "かつての麗水都市は建物の崩壊や\n放置された死体などで穢れ、今じゃ\n“腐海都市”と呼ばれている。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x27f4"
  ],
  "voice": 1101,
  "who": "ミネソタ"
 },
 {
  "id": "s2043:0053c",
  "jp": "黙れ！　\nその名はただの蔑称に過ぎない！\nシャンティエは、まだ生きている！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x280d"
  ],
  "voice": 1102,
  "who": "フィービー"
 },
 {
  "id": "s2043:00589",
  "jp": "うわぁ！　海から攻めてくる！\nず、ずるいよ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x282b"
  ],
  "voice": 1103,
  "who": "ルルゥ"
 },
 {
  "id": "s2043:005b9",
  "jp": "相手はウンディーネですからね。\n彼女は水上を移動できるので\n注意しましょう！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2849"
  ],
  "voice": 1104,
  "who": "ピンガー"
 },
 {
  "id": "s2043:00608",
  "jp": "馬鹿な……シャンティエの誇りが、\nこんな奴らに……！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x553a"
  ],
  "voice": 1105,
  "who": "フィービー"
 },
 {
  "id": "s2043:00640",
  "jp": "私の負けだ……殺せ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5bce"
  ],
  "voice": 1106,
  "who": "フィービー"
 },
 {
  "id": "s2043:00659",
  "jp": "……親父、殺すのか？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5be7"
  ],
  "voice": 1107,
  "who": "イシュト"
 },
 {
  "id": "s2043:00672",
  "jp": "ま、理由次第だな。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5c05"
  ],
  "voice": 1108,
  "who": "ザザーランド"
 },
 {
  "id": "s2043:00689",
  "jp": "親父……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5c23"
  ],
  "voice": 1109,
  "who": "エリーシャ"
 },
 {
  "id": "s2043:00698",
  "jp": "なんだ？　殺す前に私で楽しもうと\n言うか。だが残念だったな。\n私の下半身は魚だ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5c66"
  ],
  "voice": 1110,
  "who": "フィービー"
 },
 {
  "id": "s2043:006eb",
  "jp": "なんでそうなる！\n折角船長らしい所を見せられたのに\nその雰囲気を壊すんじゃねぇ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5c84"
  ],
  "voice": 1111,
  "who": "ザザーランド"
 },
 {
  "id": "s2043:0073e",
  "jp": "お前のどこが船長らしいんだ。\nバーカバーカ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5c9d"
  ],
  "voice": 1112,
  "who": "フィービー"
 },
 {
  "id": "s2043:0076e",
  "jp": "っせえ！\n誰か！　こいつを摘み出せ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5cbb"
  ],
  "voice": 1113,
  "who": "ザザーランド"
 },
 {
  "id": "s2043:00796",
  "jp": "上半身でも楽しめそうですけどね。\n……って言われると、\nどんな想像しますか？　兄貴。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5cf5"
  ],
  "voice": 1114,
  "who": "ピンガー"
 },
 {
  "id": "s2043:007ed",
  "jp": "何も考えねぇよ！\n……ハッ！　考えるな俺！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5d0e"
  ],
  "voice": 1115,
  "who": "イシュト"
 },
 {
  "id": "s2043:0081b",
  "jp": "イシュト、さいてー",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5d2c"
  ],
  "voice": 1116,
  "who": "ルルゥ"
 },
 {
  "id": "s2043:00832",
  "jp": "不謹慎極まりないわね。\n一発、逝っとく？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5d4a"
  ],
  "voice": 1117,
  "who": "エリーシャ"
 },
 {
  "id": "s2043:0085e",
  "jp": "冗談だって冗談！　本気にするな！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5d63"
  ],
  "voice": 1118,
  "who": "イシュト"
 },
 {
  "id": "s2043:00883",
  "jp": "ん？　どういうこと？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5da9"
  ],
  "voice": 1119,
  "who": "ロコモコ"
 },
 {
  "id": "s2043:0089c",
  "jp": "お前にはまだ早い。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5dc7"
  ],
  "voice": 1120,
  "who": "ミネソタ"
 },
 {
  "id": "s2043:008b3",
  "jp": "チッ！　失敗しやがって。\n取引は不成立だな。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5e68"
  ],
  "voice": 1121,
  "who": "#43"
 },
 {
  "id": "s2043:008e3",
  "jp": "お前ら、黒い牙！！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5e83"
  ],
  "voice": 1122,
  "who": "イシュト"
 },
 {
  "id": "s2043:008fa",
  "jp": "不成立だと……。ふざけるな！\nそれでは何のために私達は戦った\nというのだ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5e9c"
  ],
  "voice": 1123,
  "who": "フィービー"
 },
 {
  "id": "s2043:00947",
  "jp": "契約を果たせなかった\nテメェが悪いんだぜ。\nさぁ、グロリアと共に死ね！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5eb5"
  ],
  "voice": 1124,
  "who": "#43"
 },
 {
  "id": "s2043:00990",
  "jp": "私の名前はＤｒ．デラックス。\n男は女へ、女は男へと性の転換を\n可能とする医師。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x45db",
   "0x4b25",
   "0x910b",
   "0x9655"
  ],
  "who": "#63"
 },
 {
  "id": "s2043:009dd",
  "jp": "だから、ウンディーネはあまり\n好きではないんだ……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x45e2",
   "0x9112"
  ],
  "who": "#63"
 },
 {
  "id": "s2043:00a11",
  "jp": "性別が一つしかないとは、\n中途半端甚だしい。\nそうは思わんかね？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x45e9",
   "0x9119"
  ],
  "who": "#63"
 },
 {
  "id": "s2043:00a50",
  "jp": "性別を超越するとは、\nこういうことをいうのだ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x45f0",
   "0x9120"
  ],
  "who": "#63"
 },
 {
  "id": "s2043:00a7e",
  "jp": "性別なんかには囚われない。\nそれが、神秘への\n近道なのよ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4600",
   "0x9130"
  ],
  "who": "#63"
 },
 {
  "id": "s2043:00ab7",
  "jp": "なぁんか、落ち着かねぇなぁ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4686",
   "0x91b6"
  ],
  "voice": 3975,
  "who": "イシュト"
 },
 {
  "id": "s2043:00ad8",
  "jp": "心なしか、逞しくなった気が\nしますね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x46ca",
   "0x91fa"
  ],
  "voice": 3976,
  "who": "ピンガー"
 },
 {
  "id": "s2043:00b02",
  "jp": "う～ん。なんか変な感じ……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x470e",
   "0x923e"
  ],
  "voice": 3977,
  "who": "ルルゥ"
 },
 {
  "id": "s2043:00b23",
  "jp": "悪か……ねぇか？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4796",
   "0x92c6"
  ],
  "voice": 3978,
  "who": "ザザーランド"
 },
 {
  "id": "s2043:00b38",
  "jp": "変わってない？\nいい度胸ね。\nちょっと面貸しなさいよ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4752",
   "0x9282"
  ],
  "voice": 3979,
  "who": "エリーシャ"
 },
 {
  "id": "s2043:00b71",
  "jp": "こんな知識は……いらない。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x47da",
   "0x930a"
  ],
  "voice": 3980,
  "who": "ミネソタ"
 },
 {
  "id": "s2043:00b90",
  "jp": "わーい！　おとこおとこー！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x482c",
   "0x935c"
  ],
  "voice": 3981,
  "who": "ロコモコ"
 },
 {
  "id": "s2043:00baf",
  "jp": "男らしくなったっすか？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x487e",
   "0x93ae"
  ],
  "voice": 3982,
  "who": "ラズベリー"
 },
 {
  "id": "s2043:00bca",
  "jp": "ガガ……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x48d0",
   "0x9400"
  ],
  "voice": 3983,
  "who": "ガング"
 },
 {
  "id": "s2043:00bd9",
  "jp": "これは……ある意味、歴史的瞬間\nなのかもしれない……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4922",
   "0x9452"
  ],
  "voice": 3984,
  "who": "フィービー"
 },
 {
  "id": "s2043:00c13",
  "jp": "ま、これで変な男に言い寄られなく\nて済むわね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4974",
   "0x94a4"
  ],
  "voice": 3985,
  "who": "アンヌ"
 },
 {
  "id": "s2043:00c45",
  "jp": "涙が、涙が止まらないいいいぃぃ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x49c6",
   "0x94f6"
  ],
  "voice": 3986,
  "who": "カミュル"
 },
 {
  "id": "s2043:00c6a",
  "jp": "こんなの、初めてです……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4a18",
   "0x9548"
  ],
  "voice": 3987,
  "who": "ユグドラ"
 },
 {
  "id": "s2043:00c89",
  "jp": "新、天、地だわさ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4a6a",
   "0x959a"
  ],
  "voice": 3988,
  "who": "パメラ"
 },
 {
  "id": "s2043:00ca0",
  "jp": "うふふ、私には無意味ですよ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4ac6",
   "0x95f6"
  ],
  "voice": 3989,
  "who": "イータ"
 },
 {
  "id": "s2043:00cc1",
  "jp": "意味ねぇことしてねぇで、さっさと\n戦闘に戻れぇ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4b04",
   "0x9634"
  ],
  "voice": 3990,
  "who": "#15"
 },
 {
  "id": "s2043:00cf5",
  "jp": "性別を超越する。\nすなわち神秘の行いよ。",
  "en": "",
  "status": "todo",
  "slots": []
 },
 {
  "id": "s2043:00d1d",
  "jp": "どうだい？\n“天上”は見えたか？",
  "en": "",
  "status": "todo",
  "slots": []
 },
 {
  "id": "s2043:00d3d",
  "jp": "だから、ウンディーネはあまり\n好きではないんだ……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4b2c",
   "0x965c"
  ],
  "who": "#63"
 },
 {
  "id": "s2043:00d71",
  "jp": "性別が一つしかないとは、\n中途半端甚だしい。\nそうは思わんかね？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4b33",
   "0x9663"
  ],
  "who": "#63"
 },
 {
  "id": "s2043:00db0",
  "jp": "神秘の一族が、\n聞いて呆れるわね。",
  "en": "",
