[
 {
  "id": "s2080:00008",
  "jp": "久しぶりだなルルゥ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x80d"
  ],
  "voice": 41,
  "who": "イシュト"
 },
 {
  "id": "s2080:00021",
  "jp": "悪いな、なかなか来れなくて。\n色々と面倒ごとに巻き込まれてさ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x814"
  ],
  "voice": 42,
  "who": "イシュト"
 },
 {
  "id": "s2080:00063",
  "jp": "でも、これで終わり。\n後はどっかの頭のいい奴にでも\nまかせて、俺はしばらく休暇だ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x81b"
  ],
  "voice": 43,
  "who": "イシュト"
 },
 {
  "id": "s2080:000b8",
  "jp": "あぁ、それと。\n俺、グロリア海賊団、辞めてきた。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x822"
  ],
  "voice": 44,
  "who": "イシュト"
 },
 {
  "id": "s2080:000ec",
  "jp": "海賊が嫌になったわけじゃないし、\n親父……ザザーランドと決別した\nわけじゃない。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x829"
  ],
  "voice": 45,
  "who": "イシュト"
 },
 {
  "id": "s2080:0013f",
  "jp": "戦いたくなったのさ。\nグロリア海賊団のみんなと。\nピンガーはついてきたけどな。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x833"
  ],
  "voice": 46,
  "who": "イシュト"
 },
 {
  "id": "s2080:00190",
  "jp": "まぁ、要するに、最初に戻った\nわけだ！\n強くてコンティニューだ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x848"
  ],
  "voice": 47,
  "who": "イシュト"
 },
 {
  "id": "s2080:001d3",
  "jp": "ココに来たのは、その報告。\n……我ながら、未練は断ち切れんよ\nウン。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x85a"
  ],
  "voice": 48,
  "who": "イシュト"
 },
 {
  "id": "s2080:0021a",
  "jp": "あ～、会いてぇよ～ルルゥ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x86c"
  ],
  "voice": 49,
  "who": "イシュト"
 },
 {
  "id": "s2080:00239",
  "jp": "……いっそ、もう一度復活させて\nみるか。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x87e"
  ],
  "voice": 50,
  "who": "イシュト"
 },
 {
  "id": "s2080:00265",
  "jp": "そんなことしたら、\nエリーシャさんに殺されますよ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x890"
  ],
  "voice": 51,
  "who": "ピンガー"
 },
 {
  "id": "s2080:0029b",
  "jp": "ピンガー……フ、確かに、そりゃあ\n恐ろしいな。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x92d"
  ],
  "voice": 52,
  "who": "イシュト"
 },
 {
  "id": "s2080:002cd",
  "jp": "で？　何のようだ？\n俺は今感傷に浸ってたんだが。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x93f"
  ],
  "voice": 53,
  "who": "イシュト"
 },
 {
  "id": "s2080:00301",
  "jp": "未練タラタラに悔し涙流して\nハンカチ噛んでただけでしょ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x955"
  ],
  "voice": 54,
  "who": "ピンガー"
 },
 {
  "id": "s2080:0033d",
  "jp": "出航の準備が出来ました。\n新米の子分もいるんですから、\n早いところきてくださいね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x967"
  ],
  "voice": 55,
  "who": "ピンガー"
 },
 {
  "id": "s2080:00392",
  "jp": "先に行って待ってますから。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x96e"
  ],
  "voice": 56,
  "who": "ピンガー"
 },
 {
  "id": "s2080:003b1",
  "jp": "……ケッ、一年の間に一段とキツく\nなりやがって、誰に似たんだ……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x9b2"
  ],
  "voice": 57,
  "who": "イシュト"
 },
 {
  "id": "s2080:003f7",
  "jp": "そんじゃ！　行くわ！\nまた暇があったら来る。\nザザーランドを俺の子分にしてな！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x9b9"
  ],
  "voice": 58,
  "who": "イシュト"
 },
 {
  "id": "s2080:00448",
  "jp": "兄貴ー！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x9d2"
  ],
  "voice": 59,
  "who": "ピンガー"
 },
 {
  "id": "s2080:00455",
  "jp": "今行くー！\n……ったく、急かすんじゃねぇよ",
  "en": "",
  "status": "todo",
  "slots": [
   "0x9eb"
  ],
  "voice": 60,
  "who": "イシュト"
 },
 {
  "id": "s2080:00483",
  "jp": "……また来るよ、必ず。\nそれまで、もう少しだけ、\n待っててくれ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0xa00"
  ],
  "voice": 61,
  "who": "イシュト"
 },
 {
  "id": "s2080:004c6",
  "jp": "……じゃあな。",
  "en": "",
  "status": "todo",
  "slots": [
   "0xa07"
  ],
  "voice": 62,
  "who": "イシュト"
 },
 {
