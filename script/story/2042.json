  "status": "todo",
  "slots": [
   "0x3975"
  ],
  "voice": 1040,
  "who": "エリーシャ"
 },
 {
  "id": "s2042:00630",
  "jp": "ロコモコ、なんか最近逃げて\nばっかりな気がする……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x39a6"
  ],
  "voice": 1041,
  "who": "ロコモコ"
 },
 {
  "id": "s2042:00668",
  "jp": "我慢が足りないということだ。\n反省しろ、イシュト。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x39d2"
  ],
  "voice": 1042,
  "who": "ザザーランド"
 },
 {
  "id": "s2042:0069e",
  "jp": "悪い噂が広がらなければ\nいいんだけどな。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x39f0"
  ],
  "voice": 1043,
  "who": "ミネソタ"
 },
 {
  "id": "s2042:006ca",
  "jp": "うぅ……まだまだ修行が足りないぜ",
