  "slots": [
   "0x3cd7"
  ],
  "voice": 1059,
  "who": "イシュト"
 },
 {
  "id": "s2042:00916",
  "jp": "蚊帳です。これ以上アホなこと\n言わないで下さい。可愛すぎて\n抱き枕にしそうです。ハァハァ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3cf2"
  ],
  "voice": 1060,
  "who": "ピンガー"
 },
 {
  "id": "s2042:00973",
  "jp": "勘弁してくれ……。",
