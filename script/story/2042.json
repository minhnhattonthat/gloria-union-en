  "status": "todo",
  "slots": [
   "0x3b18"
  ],
  "voice": 1045,
  "who": "エリーシャ"
 },
 {
  "id": "s2042:00710",
  "jp": "さんきゅ。で、どうだった？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3b2e"
  ],
  "voice": 1046,
  "who": "イシュト"
 },
 {
  "id": "s2042:0072f",
  "jp": "生贄が行われたのは意外にも\n最近からで、ある人物の\nお告げがあったからだそうよ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3b49"
  ],
  "voice": 1047,
  "who": "エリーシャ"
 },
 {
  "id": "s2042:00782",
  "jp": "お告げ？　\n津波が来るから生贄を出せー、\nって？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3b64"
  ],
  "voice": 1048,
  "who": "ルルゥ"
 },
 {
  "id": "s2042:007b9",
  "jp": "……怪しいですね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3b7f"
  ],
  "voice": 1050,
  "who": "ピンガー"
 },
 {
  "id": "s2042:007d0",
  "jp": "そのお告げをした人ってのは、\n今どこにいるのかわかるか？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3b9a"
  ],
  "voice": 1051,
  "who": "ミネソタ"
 },
 {
  "id": "s2042:0080c",
  "jp": "それが……今儀式が行われている\n崖の下で見た人がいるみたいなの。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3bed"
  ],
  "voice": 1052,
  "who": "エリーシャ"
 },
 {
  "id": "s2042:00850",
  "jp": "なるほど。そういうことか。",
