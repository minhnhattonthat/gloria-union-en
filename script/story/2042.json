  "status": "todo",
  "slots": [
   "0x2160",
   "0x4c27"
  ],
  "who": "#69"
 },
 {
  "id": "s2042:009e3",
  "jp": "生贄の儀式を行っては、生贄と\nなった子達の事を思って泣いて\nいるのよ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2167",
   "0x4c2e"
  ],
  "who": "#69"
 },
 {
  "id": "s2042:00a28",
  "jp": "アナタ達も、あの人のことを\nわかってあげてね？",
