  "status": "todo",
  "slots": [
   "0x3d08"
  ],
  "voice": 1061,
  "who": "イシュト"
 },
 {
  "id": "s2042:0098c",
  "jp": "あの人だって、やりたくて\nやっているわけではないのよ。\n村を守るために、必死なだけで……",
