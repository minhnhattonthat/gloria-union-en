[
 {
  "id": "s2042:00028",
  "jp": "海の神よ！　怒りを静めたまえ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1dbe"
  ],
  "voice": 1007,
  "who": "#68"
 },
 {
  "id": "s2042:0004b",
  "jp": "……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1dd4"
  ],
  "voice": 1008,
  "who": "#71"
 },
 {
  "id": "s2042:00056",
  "jp": "どうやら、この島では生贄の習慣が\nまだあるようですね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1df1"
  ],
  "voice": 1009,
  "who": "ピンガー"
 },
 {
  "id": "s2042:00090",
  "jp": "生贄か……嫌な感じだな。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1e15"
  ],
  "voice": 1010,
  "who": "イシュト"
 },
 {
  "id": "s2042:000ad",
  "jp": "習慣って、昔からしてたってこと\nだよね。こんなことを、もう何年も\nやってるんだ……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1e35"
  ],
  "voice": 1011,
  "who": "ルルゥ"
 },
 {
  "id": "s2042:00104",
  "jp": "そんなことしても、\nどうにもならないのにね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1e4e"
  ],
  "voice": 1012,
  "who": "エリーシャ"
 },
 {
  "id": "s2042:00134",
  "jp": "黄泉の国にも、あぁやって生贄に\nなって来る人は結構多いっす。\nみんな、悲しい目をしてるっすよ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1e81"
  ],
  "voice": 1013,
  "who": "ラズベリー"
 },
 {
  "id": "s2042:00195",
  "jp": "……なぁ、俺達で止めようぜ。\nそれで、無駄だってわからせて\nやろう。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1ea1"
  ],
  "voice": 1014,
  "who": "イシュト"
 },
 {
  "id": "s2042:001dc",
  "jp": "おいおい、俺達の目的はなんだ？\nもたもたしてっとブラックモアの\n野郎にまた奪われちまうぞ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1ec1"
  ],
  "voice": 1015,
  "who": "ザザーランド"
 },
 {
  "id": "s2042:00239",
  "jp": "うぐ……ご、ごめん。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1ede"
  ],
  "voice": 1016,
  "who": "イシュト"
 },
 {
  "id": "s2042:00252",
  "jp": "親っさん……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1ef4"
  ],
  "voice": 1017,
  "who": "ピンガー"
 },
 {
  "id": "s2042:00265",
  "jp": "親父ぃ……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1f11"
  ],
  "voice": 1018,
  "who": "エリーシャ"
 },
 {
  "id": "s2042:00276",
  "jp": "……ルルゥ、いいのか？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1f2e"
  ],
  "voice": 1019,
  "who": "ザザーランド"
 },
 {
  "id": "s2042:00291",
  "jp": "うん……だって、見ちゃったから。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1f47"
  ],
  "voice": 1020,
  "who": "ルルゥ"
 },
 {
  "id": "s2042:002b6",
  "jp": "お人好しどもめ……。\nさっさと終わらせろよ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1f60"
  ],
  "voice": 1021,
  "who": "ザザーランド"
 },
 {
  "id": "s2042:002e6",
  "jp": "あぁ、もちろんだ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1f87"
  ],
  "voice": 1022,
  "who": "イシュト"
 },
 {
  "id": "s2042:002fd",
  "jp": "イシュト、とりあえず村に行って\n情報を聞きましょう。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1fa0"
  ],
  "voice": 1023,
  "who": "エリーシャ"
 },
 {
  "id": "s2042:00335",
  "jp": "どうしてそんな面倒くさいマネ\nしなきゃならないんだよ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1fb6"
  ],
  "voice": 1024,
  "who": "イシュト"
 },
 {
  "id": "s2042:0036f",
  "jp": "情報は大事ですよ。\n聞いておいて損はないと思います。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1fcc"
  ],
  "voice": 1025,
  "who": "ピンガー"
 },
 {
  "id": "s2042:003a7",
  "jp": "やっぱり、俺は我慢できねぇよ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2d75"
  ],
  "voice": 1026,
  "who": "イシュト"
 },
 {
  "id": "s2042:003ca",
  "jp": "な、なんじゃ貴様らは！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2d8b"
  ],
  "voice": 1027,
  "who": "#68"
 },
 {
  "id": "s2042:003e5",
  "jp": "あんたのやってることはただの\n人殺しだ、即刻止めろ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2da9"
  ],
  "voice": 1028,
  "who": "イシュト"
 },
 {
  "id": "s2042:0041d",
  "jp": "儀式を邪魔するとは何たること！\n村人達よ！　奴等をここから\n追い出せ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2dbf"
  ],
  "voice": 1029,
  "who": "#68"
 },
 {
  "id": "s2042:00466",
  "jp": "イシュト、殺しちゃダメだからね！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2ddd"
  ],
  "voice": 1030,
  "who": "ルルゥ"
 },
 {
  "id": "s2042:0048b",
  "jp": "手加減は苦手だが、まかせろ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2dfb"
  ],
  "voice": 1031,
  "who": "イシュト"
 },
 {
  "id": "s2042:004ac",
  "jp": "ふぅ、まさか全員でかかってくる\nとは。\n……大丈夫か？　娘さん。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3834"
  ],
  "voice": 1032,
  "who": "イシュト"
 },
 {
  "id": "s2042:004ef",
  "jp": "あ、イシュトさん、\n無闇に話かけたら！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3865"
  ],
  "voice": 1033,
  "who": "ラズベリー"
 },
 {
  "id": "s2042:00519",
  "jp": "お爺ちゃん……お爺ちゃん！！\nあなた達！　お爺ちゃんに\nなんてことするの！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3882"
  ],
  "voice": 1034,
  "who": "#71"
 },
 {
  "id": "s2042:00566",
