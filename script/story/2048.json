[
 {
  "id": "s2048:00028",
  "jp": "この島のどこかに、クリスタルの\nウィルを感じる。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x19e7"
  ],
  "voice": 1370,
  "who": "ルルゥ"
 },
 {
  "id": "s2048:0005c",
  "jp": "この島に……クリスタルが。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1a00"
  ],
  "voice": 1371,
  "who": "イシュト"
 },
 {
  "id": "s2048:0007b",
  "jp": "うん。間違いない。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1a19"
  ],
  "voice": 1372,
  "who": "ルルゥ"
 },
 {
  "id": "s2048:00092",
  "jp": "雨がうっとうしいわね。\n火薬が湿気のせいで燃えにくく\nなってる。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1a32"
  ],
  "voice": 1373,
  "who": "エリーシャ"
 },
 {
  "id": "s2048:000d5",
  "jp": "銃の威力は半減か。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1a48"
  ],
  "voice": 1374,
  "who": "ミネソタ"
 },
 {
  "id": "s2048:000ec",
  "jp": "水のカードの力で、多少和らげる\nことはできるけど……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1a5e"
  ],
  "voice": 1375,
  "who": "ルルゥ"
 },
 {
  "id": "s2048:00126",
  "jp": "この雨じゃあ意味ないですね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1a74"
  ],
  "voice": 1376,
  "who": "ピンガー"
 },
 {
  "id": "s2048:00147",
  "jp": "フッハッハ！\n命がけで奪ったモンのわりに、\n大したことねぇなぁ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1b67"
  ],
  "voice": 1377,
  "who": "ブラックモア"
 },
 {
  "id": "s2048:0018a",
  "jp": "ブラックモア！？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1bc7"
  ],
  "voice": 1378,
  "who": "イシュト"
 },
 {
  "id": "s2048:0019f",
  "jp": "なによ！？　あの砲台の数！！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1be0"
  ],
  "voice": 1379,
  "who": "エリーシャ"
 },
 {
  "id": "s2048:001c0",
  "jp": "完全に囲まれていますね……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1c07"
  ],
  "voice": 1380,
  "who": "ピンガー"
 },
 {
  "id": "s2048:001e1",
  "jp": "そんな……。\nまた、先を越されちゃったの！？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1c20"
  ],
  "voice": 1381,
  "who": "ルルゥ"
 },
 {
  "id": "s2048:00211",
  "jp": "なるほど……誘われていたわけか。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1c47"
  ],
  "voice": 1382,
  "who": "ザザーランド"
 },
 {
  "id": "s2048:00236",
  "jp": "別に誘っちゃいねぇが、まぁいい。\nこの雨じゃ、そこの小娘の銃の\n威力も落ちるだろ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1c60"
  ],
  "voice": 1383,
  "who": "ブラックモア"
 },
 {
  "id": "s2048:0028b",
  "jp": "向こうは雨避け完備か。\nやってくれるぜ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1c79"
  ],
  "voice": 1384,
  "who": "ザザーランド"
 },
 {
  "id": "s2048:002b7",
  "jp": "ま、せいぜいこんがり焼けてくれ。\n馬の食費は高いんでな。\nヒャハハハハ！！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1c92"
  ],
  "voice": 1385,
  "who": "ブラックモア"
 },
 {
  "id": "s2048:00304",
  "jp": "ふざけやがって……\nアイツだけはただじゃおかねぇぞ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1cd6"
  ],
  "voice": 1386,
  "who": "イシュト"
 },
 {
  "id": "s2048:0033c",
  "jp": "さっきも話したが、雨の中じゃ\n銃の威力が著しく落ちる。\nそこを考えろ。いいな？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1de6"
  ],
  "voice": 1387,
  "who": "ザザーランド"
 },
 {
  "id": "s2048:0038d",
  "jp": "イシュト。熱くならないで、\n焦りは死神を呼び寄せるわよ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1e04"
  ],
  "voice": 1388,
  "who": "エリーシャ"
 },
 {
  "id": "s2048:003c9",
  "jp": "グ……フゥー！　……わかった。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1e1d"
  ],
  "voice": 1389,
  "who": "イシュト"
 },
 {
  "id": "s2048:003ec",
  "jp": "よし。いくわよ、イシュト。\n敵をやっつけて、ブラックモアを\n引きずり出してやりましょう！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1e3b"
  ],
  "voice": 1390,
  "who": "エリーシャ"
 },
 {
  "id": "s2048:00447",
  "jp": "あぁ、了解ぃ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1e54"
  ],
  "voice": 1391,
  "who": "イシュト"
 },
 {
  "id": "s2048:0045a",
  "jp": "あの大砲は厄介ですね……。\nフフッ、その厄介が味方についたら\nどれほど気持ちがいいんでしょうか",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1e6d"
  ],
  "voice": 1392,
  "who": "ピンガー"
 },
 {
  "id": "s2048:004bb",
  "jp": "兄貴、ちょっと用事があるんで、\nボクは一旦離脱しますよ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1e90"
  ],
  "voice": 1393,
  "who": "ピンガー"
 },
 {
  "id": "s2048:004f7",
  "jp": "用事……？\nま、お前のことだ、何かあるんだろ\n早く帰って来いよ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1ea9"
  ],
  "voice": 1394,
  "who": "イシュト"
 },
 {
  "id": "s2048:0053a",
  "jp": "了解。そんでは、いってきます！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1ec2"
  ],
  "voice": 1395,
  "who": "ピンガー"
 },
 {
  "id": "s2048:0055d",
  "jp": "なんだよなんだよ。\n雁首揃えて大したことねぇなぁ！\nオラ、もっと派手に行こうか！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x479b"
  ],
  "voice": 1396,
  "who": "ザザーランド"
 },
 {
  "id": "s2048:005b0",
  "jp": "ヌドリャア！！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4e62"
  ],
  "voice": 1397,
  "who": "ザザーランド"
 },
 {
  "id": "s2048:005c3",
  "jp": "ヒイィィ！　ば、化物ぉぉぉ！！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4e89"
  ],
  "voice": 1398,
  "who": "#43"
 },
 {
  "id": "s2048:005e6",
  "jp": "改めてすげぇな。親父の奴。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4ea2"
  ],
  "voice": 1399,
  "who": "イシュト"
 },
 {
  "id": "s2048:00605",
  "jp": "一振りで５人が吹っ飛ぶなんて……\nありえないよ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4ec0"
  ],
  "voice": 1400,
  "who": "ルルゥ"
 },
 {
  "id": "s2048:00639",
  "jp": "それくらい親父も怒ってるって\nことよ。あんたのためにね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4ede"
  ],
  "voice": 1401,
  "who": "エリーシャ"
 },
 {
  "id": "s2048:00675",
  "jp": "俺の、ため？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4ef7"
  ],
  "voice": 1402,
  "who": "イシュト"
 },
 {
  "id": "s2048:00686",
  "jp": "当たり前でしょ？　あたし“達”は\n親父の子供なのよ？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4f23"
  ],
  "voice": 1403,
  "who": "エリーシャ"
 },
 {
  "id": "s2048:006be",
  "jp": "どしたぁ！　俺を倒したければ\n今の５倍はきやがれ！！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4f51"
  ],
  "voice": 1404,
  "who": "ザザーランド"
 },
 {
  "id": "s2048:006f6",
  "jp": "ギギ。なんという武力だ……。\n俺が長年かけて育てた部下を……！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4f71"
  ],
  "voice": 1405,
  "who": "ブラックモア"
 },
 {
  "id": "s2048:00738",
  "jp": "だ、だがしかし。この雨が降る限り\n砲撃手は倒せない！　",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4f7b"
  ],
  "voice": 1406,
  "who": "ブラックモア"
 },
 {
  "id": "s2048:00772",
  "jp": "砲撃手？　ボクのことかい？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4f90"
  ],
  "voice": 1407,
  "who": "ピンガー"
 },
 {
  "id": "s2048:00791",
  "jp": "ナニィ！？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5040"
  ],
  "voice": 1408,
  "who": "ブラックモア"
 },
 {
  "id": "s2048:007a0",
  "jp": "ピンガー！？　\nい、いつの間に……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x505e"
  ],
  "voice": 1409,
  "who": "ルルゥ"
 },
 {
  "id": "s2048:007c8",
  "jp": "悪いけど、大砲はもらったよ。\n泥棒猫なもんでね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5077"
  ],
  "voice": 1410,
  "who": "ピンガー"
 },
 {
  "id": "s2048:007fc",
  "jp": "ハ。ハハッ！\nまったく、頼りになるなぁ、\nお前ってやつは！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x508d"
  ],
  "voice": 1411,
  "who": "イシュト"
 },
 {
  "id": "s2048:00839",
  "jp": "ギイィ！　……どこまでも使えない\n部下どもめ！\n何故猫一匹捕らえられないんだ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x50a6"
  ],
  "voice": 1412,
  "who": "ブラックモア"
 },
 {
  "id": "s2048:0088a",
  "jp": "来いよ、ブラックモア。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x50cd"
  ],
  "voice": 1413,
  "who": "イシュト"
 },
 {
  "id": "s2048:008a5",
  "jp": "俺はまだ親父みたいに強かぁないが\n……気にいらねぇ奴をぶっ倒す力は\n持ってるぞ！！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x50d7"
  ],
  "voice": 1414,
  "who": "イシュト"
 },
 {
  "id": "s2048:008fc",
  "jp": "あ、あの……その金貨、この頭巾と\n交換してくれますか？\n……ダメ……ですか？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1fe2",
   "0x6565"
  ],
  "who": "#73"
 },
 {
  "id": "s2048:00947",
  "jp": "い、いいんですか……？\nあ、ありがとう！\nありがとうございます！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2051",
   "0x65d4"
  ],
  "who": "#73"
 },
 {
  "id": "s2048:00986",
  "jp": "その頭巾、お姉ちゃんが作ったもの\nなんです。\n大事にしてください。それでは。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2058",
   "0x65db"
  ],
  "who": "#73"
 },
 {
  "id": "s2048:009d1",
  "jp": "エヘヘ、これで、お姉ちゃんに\n楽をさせてあげられるぞ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2078",
   "0x65fb"
  ],
  "who": "#73"
 },
 {
  "id": "s2048:00a07",
  "jp": "どこかに……お金になりそうなもの\nないかなぁ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2090",
   "0x6613"
  ],
  "who": "#73"
 },
 {
  "id": "s2048:00a35",
  "jp": "早く見つけて、お姉ちゃんに\n楽をさせてあげないと！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2097",
   "0x661a"
  ],
  "who": "#73"
 },
 {
  "id": "s2048:00a67",
  "jp": "遂に、俺達にもチャンスが来た！\nこの地獄の島から逃げる\nチャンスが！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x73e4"
  ],
  "who": "#70"
 },
 {
  "id": "s2048:00aaa",
  "jp": "黒い牙が実用していた砲台だ。\n型落ちしてるが、それでも\n威力は充分。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x73eb"
  ],
  "who": "#70"
 },
 {
  "id": "s2048:00aed",
  "jp": "心配ない、まだ数はある。\n共に、黒い牙を倒そうじゃないか！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x745a"
  ],
  "who": "#70"
 },
 {
  "id": "s2048:00b27",
  "jp": "今こそ、この地獄の島から\n抜け出す時だ！\n全員、装備は充分か！？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x7472"
  ],
  "who": "#70"
 },
 {
  "id": "s2048:00b66",
  "jp": "なんだ、何もないのか？\n仕方ない。コレを着ろ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x7479"
  ],
  "who": "#70"
 },
 {
  "id": "s2048:00b94",
  "jp": "これで少しは凌げるだろう。\n……よし！　みんな、行くぞ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x74e8"
  ],
  "who": "#70"
 },
 {
  "id": "s2048:00bcc",
  "jp": "絶対にこの島から出てやる……！\n故郷の家族に……会わなければ！\n墓前に花を……手向けなければ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x7500"
  ],
  "who": "#70"
 },
 {
  "id": "s2048:00c29",
  "jp": "黒い牙が壊滅寸前！？\nそ、それは……本当ですか？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2e75",
   "0x75be"
  ],
  "who": "#76"
 },
 {
  "id": "s2048:00c59",
  "jp": "やったぞ！　俺達は、帰れるんだ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2e87",
   "0x75d0"
  ],
  "who": "#61"
 },
 {
  "id": "s2048:00c7a",
  "jp": "アンタ達がやってくれたのかい？\nおぉ……なんということだ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2e99",
   "0x75e2"
  ],
  "who": "#60"
 },
 {
  "id": "s2048:00cb4",
  "jp": "これはせめてものお礼だ。\n受け取ってくれ",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2f08",
   "0x7651"
  ],
  "who": "#60"
 },
 {
  "id": "s2048:00cdc",
  "jp": "よっしゃ！　そうと決まったら\n早速脱出するぞ！\nもうこんな島とはおさらばだ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2f1a",
   "0x7663"
  ],
  "who": "#70"
 },
 {
  "id": "s2048:00d27",
  "jp": "このご恩は一生忘れません。\n勇者様。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2f32",
   "0x767b"
  ],
  "who": "#71"
 },
 {
  "id": "s2048:00d4b",
  "jp": "こんな所にカバンが落ちてら……。\n開けてみるか。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3d0f",
   "0x8458"
  ],
  "who": "イシュト"
 },
 {
  "id": "s2048:00d7b",
  "jp": "ふんぎぎぎ……ッハァ！　ハァ……\nあ、開かねぇ……なんなんだよ\nまったく……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3d65",
   "0x84ae"
  ],
  "who": "イシュト"
 },
 {
  "id": "s2048:00dc8",
  "jp": "このカバン、まだ中身がある\nようですね……開けて、みますか？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3dbf",
   "0x8508"
  ],
  "who": "ピンガー"
 },
 {
  "id": "s2048:00e04",
  "jp": "ってぇ！　\nビクともしないじゃないですか！\nとんだトラップですね……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3e10",
   "0x8559"
  ],
  "who": "ピンガー"
 },
 {
  "id": "s2048:00e49",
  "jp": "あ、カバンだ。\nでも閉まってるね……開けてみる？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3e6a",
   "0x85b3"
  ],
  "who": "ルルゥ"
 },
 {
  "id": "s2048:00e79",
  "jp": "ふにゅる～……ッハァ、ハァ。\nも～全然開かないよ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3ebb",
   "0x8604"
  ],
  "who": "ルルゥ"
 },
 {
  "id": "s2048:00eab",
  "jp": "中々高級そうなカバンね。\nなんでこんな所に落っこちてる\nのかしら？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3f0e",
