[
 {
  "id": "s2072:00028",
  "jp": "ここは……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x148f"
  ],
  "voice": 3329,
  "who": "イシュト"
 },
 {
  "id": "s2072:00039",
  "jp": "皇国城。闇の遺跡って言ったほうが\nわかりやすいか？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x14a5"
  ],
  "voice": 3330,
  "who": "ザザーランド"
 },
 {
  "id": "s2072:0006f",
  "jp": "“闇の邪域”\n闇のクリスタルが眠っていた場所。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x14be"
  ],
  "voice": 3331,
  "who": "ルルゥ"
 },
 {
  "id": "s2072:000a1",
  "jp": "アシュレイは、ここに来て何を\nする気なんだろう。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x14c8"
  ],
  "voice": 3332,
  "who": "ルルゥ"
 },
 {
  "id": "s2072:000d5",
  "jp": "ユーフォリアの王になるってことは\n古代都市を蘇らせる気マンマンって\nことよね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x14e1"
  ],
  "voice": 3333,
  "who": "エリーシャ"
 },
 {
  "id": "s2072:00126",
  "jp": "どちらにせよ、急ぐ必要がある\nようね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x14e8"
  ],
  "voice": 3334,
  "who": "エリーシャ"
 },
 {
  "id": "s2072:00150",
  "jp": "ッ！　敵影確認！\n皇国軍です！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1501"
  ],
  "voice": 3335,
  "who": "ピンガー"
 },
 {
  "id": "s2072:00172",
  "jp": "グロリア海賊団……イシュト……！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1628"
  ],
  "voice": 3336,
  "who": "アシュレイ"
 },
 {
  "id": "s2072:00197",
  "jp": "メラニーとガルムはまだか。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1632"
  ],
  "voice": 3337,
  "who": "アシュレイ"
 },
 {
  "id": "s2072:001b6",
  "jp": "まだ、ご到着しておりません。\nエルマーレ連合の残党に阻まれて\nしまいまして……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x164b"
  ],
  "voice": 3338,
  "who": "#53"
 },
 {
  "id": "s2072:00209",
  "jp": "そうか。\nガリオレッドではなく、光の海域\nごと消滅させればよかったか……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1664"
  ],
  "voice": 3339,
  "who": "アシュレイ"
 },
 {
  "id": "s2072:00256",
  "jp": "ちょっと待った！\n世界を支配なんて、\nさせてたまるか！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x168b"
  ],
  "voice": 3340,
  "who": "イシュト"
 },
 {
  "id": "s2072:0028f",
  "jp": "支配？\nそんなことするつもりはない。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x16a4"
  ],
  "voice": 3341,
  "who": "アシュレイ"
 },
 {
  "id": "s2072:002b7",
  "jp": "何ィ……？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x16cb"
  ],
  "voice": 3342,
  "who": "イシュト"
 },
 {
  "id": "s2072:002c6",
  "jp": "僕は、幸せになるんだ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x16f2"
  ],
  "voice": 3343,
  "who": "アシュレイ"
 },
 {
  "id": "s2072:002e1",
  "jp": "幸せ？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x170b"
  ],
  "voice": 3344,
  "who": "エリーシャ"
 },
 {
  "id": "s2072:002ec",
  "jp": "ユーフォリアの意味を、\nお前達は知っているか？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1724"
  ],
  "voice": 3345,
  "who": "アシュレイ"
 },
 {
  "id": "s2072:0031e",
  "jp": "幸福感……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x173d"
  ],
  "voice": 3346,
  "who": "ルルゥ"
 },
 {
  "id": "s2072:0032f",
  "jp": "そう、“幸福感”だ。\nユーフォリアは、僕に幸福を\n与えてくれる大切なものだ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1756"
  ],
  "voice": 3347,
  "who": "アシュレイ"
 },
 {
  "id": "s2072:0037e",
  "jp": "そう思うように、ガリオレッドに\n教育でもされたか……？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x176f"
  ],
  "voice": 3348,
  "who": "ザザーランド"
 },
 {
  "id": "s2072:003b8",
  "jp": "ガリオレッドは関係ない。\nこれは、僕の意思だ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x17a4"
  ],
  "voice": 3349,
  "who": "アシュレイ"
 },
 {
  "id": "s2072:003ea",
  "jp": "幸せになることが意思ですか……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x17bd"
  ],
  "voice": 3350,
  "who": "ピンガー"
 },
 {
  "id": "s2072:0040f",
  "jp": "誰もが望み、限られた者にしか\n叶えられない意思だな……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x17d6"
  ],
  "voice": 3351,
  "who": "ザザーランド"
 },
 {
  "id": "s2072:0044b",
  "jp": "僕の幸せは、僕だけが掴める。\nユーフォリアは、渡さない！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x17ef"
  ],
  "voice": 3352,
  "who": "アシュレイ"
 },
 {
  "id": "s2072:00487",
  "jp": "カードはお互い三枚ずつか。\nいい勝負ができそうだな。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x18ab"
  ],
  "voice": 3353,
  "who": "イシュト"
 },
 {
  "id": "s2072:004bf",
  "jp": "いい勝負などいらない。\n僕は今すぐにでも幸せになりたい。\nだから、死ね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x18c4"
  ],
  "voice": 3354,
  "who": "アシュレイ"
 },
 {
  "id": "s2072:0050a",
  "jp": "いいか！　絶対にアシュレイを\n止めろ！　絶対にだ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x18dd"
  ],
  "voice": 3355,
  "who": "ザザーランド"
 },
 {
  "id": "s2072:00540",
  "jp": "イシュト、僕はどうして、\nお前を逃がしたのだろうな。\nその剣まで持たせて、だ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1a1d"
  ],
  "voice": 3356,
  "who": "アシュレイ"
 },
 {
  "id": "s2072:00591",
  "jp": "知るか。\n昔は昔だろうが。\n今を生きろよ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1a37"
  ],
  "voice": 3357,
  "who": "イシュト"
 },
 {
  "id": "s2072:005be",
  "jp": "……そうだな。\n今はただ、お前を殺すことに\n集中するとしよう。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1a50"
  ],
  "voice": 3358,
  "who": "アシュレイ"
 },
 {
  "id": "s2072:005ff",
  "jp": "クッ……！\nまた、この感じ……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1c3a"
  ],
  "voice": 3359,
  "who": "ルルゥ"
 },
 {
  "id": "s2072:00623",
  "jp": "一体、なんなの……これ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1c44"
  ],
  "voice": 3360,
  "who": "ルルゥ"
 },
 {
  "id": "s2072:00640",
  "jp": "ホント、見れば見るほど、\n兄貴にそっくりですね。\nまぁ、外見だけですが。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1b2b"
  ],
  "who": "ピンガー"
 },
 {
  "id": "s2072:00687",
  "jp": "僕とアイツを一緒にするな！\n虫唾が走るわ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1b44"
  ],
  "who": "アシュレイ"
 },
 {
  "id": "s2072:006b1",
  "jp": "安心してください。\nアナタよりも、兄貴の方が\n百倍カッコいいですから！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1b5e"
  ],
  "who": "ピンガー"
 },
 {
  "id": "s2072:006f6",
  "jp": "アンタを倒せば全てが終わる！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1d11"
  ],
  "who": "エリーシャ"
 },
 {
  "id": "s2072:00713",
  "jp": "倒させてもらうわよ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1d1b"
  ],
  "who": "エリーシャ"
 },
 {
  "id": "s2072:00728",
  "jp": "一介の海賊が……。\n僕の邪魔を、するんじゃない！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1d34"
  ],
  "who": "アシュレイ"
 },
 {
  "id": "s2072:00758",
  "jp": "もう貴様等の時代は終わったのだ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1e25"
  ],
  "who": "アシュレイ"
 },
 {
  "id": "s2072:00779",
  "jp": "これからは、僕が世界を動かす！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1e2f"
  ],
  "who": "アシュレイ"
 },
 {
  "id": "s2072:00798",
  "jp": "やれやれ、ガリオレッドの奴め。\nとんだ置き土産を残しやがって",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1e49"
  ],
  "who": "ザザーランド"
 },
 {
  "id": "s2072:007d4",
  "jp": "悪いが、こちとらまだまだ\n現役でね。\n若いモンにゃあ、負けねぇよ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1e5e"
  ],
  "who": "ザザーランド"
 },
 {
  "id": "s2072:00815",
  "jp": "幸せになる……か。\nそれにしては、やり方が些か\n乱暴すぎやしないか？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1f39"
  ],
  "who": "ミネソタ"
 },
 {
  "id": "s2072:00858",
  "jp": "やり方？\nこれ以外のやり方があるとでも\nいうのか？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1f52"
  ],
  "who": "アシュレイ"
 },
 {
  "id": "s2072:00889",
  "jp": "それ以外……だと？\nそうか、知らないのか……\n不憫なものだな。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1f67"
  ],
  "who": "ミネソタ"
 },
 {
  "id": "s2072:008c6",
  "jp": "幸せになるのなんて簡単だよ！\nこうやって、笑えばいいの！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x203b"
  ],
  "who": "ロコモコ"
 },
 {
  "id": "s2072:008fe",
  "jp": "笑えばいい、か。\nその笑い方が、わからないんだ\nけどな……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2054"
  ],
  "who": "アシュレイ"
 },
 {
  "id": "s2072:00939",
  "jp": "幸せなんて、よくよく考えた事も\nなかったすねぇ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2128"
  ],
  "who": "ラズベリー"
 },
 {
  "id": "s2072:00969",
  "jp": "ま、それを考える必要もないぐらい\n幸せなのかもしれないっすね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x213d"
  ],
  "who": "ラズベリー"
 },
 {
  "id": "s2072:009a7",
  "jp": "アシュレイ……まるで、以前の私を\n見ているようだ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2211"
  ],
  "who": "フィービー"
 },
 {
  "id": "s2072:009d9",
  "jp": "断ち切らなければ……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2226"
  ],
  "who": "フィービー"
 },
 {
  "id": "s2072:009f0",
  "jp": "ガガングガンガ、グガンガ、ガグ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x22fa"
  ],
  "who": "ガング"
 },
 {
  "id": "s2072:00a11",
  "jp": "このような兵器にまで、幸せは\n宿っているのだろうか……フッ。\n虫唾が走るな。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2313"
  ],
  "who": "アシュレイ"
 },
 {
  "id": "s2072:00a5c",
  "jp": "幸せになりたい。\nそんな些細な事で、アナタは世界を\n動かそうというのですか！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x23ee"
  ],
  "who": "ユグドラ"
 },
 {
  "id": "s2072:00aa7",
  "jp": "その些細な事さえ得られないから、\nここまで必死なんじゃないか。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2407"
  ],
  "who": "アシュレイ"
 },
 {
  "id": "s2072:00ae5",
  "jp": "まぁ、貴様等にはわからない\nだろうがな。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x241c"
  ],
  "who": "アシュレイ"
 },
 {
  "id": "s2072:00b0d",
  "jp": "まさか、ガリオレッド宰相の後ろに\nこんな人がいたなんて……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x24f7"
  ],
  "who": "カミュル"
 },
 {
  "id": "s2072:00b49",
  "jp": "本当に、\n僕は何も知らなかったのだな……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x250c"
  ],
  "who": "カミュル"
 },
 {
  "id": "s2072:00b73",
  "jp": "幸せになるのなんて簡単よ。\n欲望のままに動けばいいんだわ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x25d9"
  ],
  "who": "アンヌ"
 },
 {
  "id": "s2072:00bad",
  "jp": "ま、その結果が今の行動なんだから\n質が悪いわね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x25e3"
  ],
  "who": "アンヌ"
 },
 {
  "id": "s2072:00bdd",
  "jp": "好きに生きれないってのが、\nアンタの最大の不幸なんだわさ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x26a9"
  ],
  "who": "パメラ"
 },
 {
  "id": "s2072:00c17",
  "jp": "やっと好きに生きれたのに、\n行動がこれじゃあねぇ。\nま、ご愁傷様。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x26b3"
  ],
  "who": "パメラ"
 },
 {
  "id": "s2072:00c58",
  "jp": "私の詩を聞けば、\nどんな暗い気持ちも吹き飛びますわ",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2780"
  ],
  "who": "イータ"
 },
 {
  "id": "s2072:00c8a",
  "jp": "さぁ、ご覧あれ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2795"
  ],
  "who": "イータ"
 },
 {
  "id": "s2072:00c9b",
  "jp": "ツッ……これは、厳しいな。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x29c8"
  ],
  "voice": 3361,
  "who": "アシュレイ"
 },
 {
  "id": "s2072:00cba",
  "jp": "この人数差で互角なの？\nまったく……皇国の人間って、\nみんな化物ね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x30f3"
  ],
  "voice": 3362,
  "who": "エリーシャ"
 },
 {
  "id": "s2072:00d01",
  "jp": "それほど意思の強い奴が多いんだ。\n世界最強の軍事力は伊達じゃない。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x310c"
  ],
  "voice": 3363,
  "who": "ザザーランド"
 },
 {
  "id": "s2072:00d47",
  "jp": "アシュレイ、終わりだ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3125"
  ],
  "voice": 3364,
  "who": "イシュト"
 },
 {
  "id": "s2072:00d62",
  "jp": "終わりはしない！\n終わって、なるものか！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x313e"
  ],
  "voice": 3365,
  "who": "アシュレイ"
 },
 {
  "id": "s2072:00d8e",
  "jp": "アシュレイ様ァ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x322f"
  ],
  "voice": 3366,
  "who": "メラニー"
 },
 {
  "id": "s2072:00da3",
  "jp": "メラニー、ガルム……。\n来るのが、少し遅いぞ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3248"
  ],
  "voice": 3367,
  "who": "アシュレイ"
 },
 {
  "id": "s2072:00dd5",
  "jp": "チッ、将軍部隊が到着しやがった！\nお前ら、下がれぇ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3261"
  ],
  "voice": 3368,
  "who": "ザザーランド"
 },
 {
  "id": "s2072:00e0d",
  "jp": "な、なんでだよ！\nここでアシュレイを討てば、\n終わるんだぞ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x327a"
  ],
  "voice": 3369,
  "who": "イシュト"
 },
 {
  "id": "s2072:00e4c",
  "jp": "馬鹿野郎！\n今アシュレイを殺してみろ！\n次に殺されるのは俺達だ！",
  "en": "",
  "status": "todo",
  "slots": [
