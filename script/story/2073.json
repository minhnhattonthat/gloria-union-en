  "status": "todo",
  "slots": [
   "0x51c6"
  ],
  "voice": 3409,
  "who": "メラニー"
 },
 {
  "id": "s2073:010dc",
  "jp": "メラニー！\n……仇は討たせてもらうぞ！\nオオオオオオオオオオォォォォ！！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x52c8"
  ],
  "voice": 3410,
  "who": "ガルム"
 },
 {
  "id": "s2073:01127",
  "jp": "アシュレイ様……\n申し訳、ありませぬ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5051"
  ],
  "voice": 3411,
  "who": "ガルム"
 },
 {
  "id": "s2073:01151",
  "jp": "お先に、あの世でお待ちして\nおります……アシュレイ様。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x51d0"
  ],
  "voice": 3412,
  "who": "メラニー"
 },
 {
  "id": "s2073:0118b",
  "jp": "ガルム、メラニー。\n最後まで主に仕える精神、\n見事であった……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5a4f"
  ],
  "voice": 3413,
  "who": "ザザーランド"
 },
 {
  "id": "s2073:011ce",
  "jp": "ボクも、この二人みたいになりたい\nですね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5a6a"
  ],
  "voice": 3414,
  "who": "ピンガー"
 },
 {
  "id": "s2073:011fc",
  "jp": "バカ、お前は俺の子分だ。\n主従なんて堅苦しいのは\n似合わねぇよ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5a88"
  ],
  "voice": 3415,
  "who": "イシュト"
 },
 {
  "id": "s2073:0123f",
  "jp": "……それもそうですね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5aa6"
  ],
  "voice": 3416,
  "who": "ピンガー"
 },
 {
  "id": "s2073:0125a",
  "jp": "さぁ、早く追いかけましょう。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5ac4"
  ],
  "voice": 3417,
  "who": "エリーシャ"
 },
 {
  "id": "s2073:0127b",
  "jp": "待って！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5ae5"
  ],
  "voice": 3418,
  "who": "ルルゥ"
 },
 {
  "id": "s2073:01288",
  "jp": "ん？　どうした、ルルゥ。",
  "en": "Hm? What's up, Ruru?",
  "status": "done",
  "slots": [
   "0x5b03"
  ],
  "voice": 3419,
  "who": "イシュト"
 },
 {
  "id": "s2073:012a5",
  "jp": "近づいてくる……\nさっきとは比べ物にならないほど、\n大きなウィルが！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5b21"
  ],
  "voice": 3420,
  "who": "ルルゥ"
 },
 {
  "id": "s2073:012ec",
  "jp": "なんだと！？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5b4d"
  ],
  "voice": 3421,
  "who": "イシュト"
 },
 {
  "id": "s2073:012fd",
  "jp": "……死んだのか。ガルム、メラニー",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5c0b"
  ],
  "voice": 3422,
  "who": "アシュレイ"
 },
 {
  "id": "s2073:01322",
  "jp": "いい家臣を持ったな。\nとだけ言っておこう……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5c29"
  ],
  "voice": 3423,
  "who": "ザザーランド"
 },
 {
  "id": "s2073:01354",
  "jp": "……そうか。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5c57"
  ],
  "voice": 3424,
  "who": "アシュレイ"
 },
 {
  "id": "s2073:01365",
  "jp": "家臣の死に、涙も出ないのね。\nあんたって奴は。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5c75"
  ],
  "voice": 3425,
  "who": "エリーシャ"
 },
 {
  "id": "s2073:01397",
  "jp": "涙は枯れた。泣き方は忘れた。\n悲しみも、感じない……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5c8e"
  ],
  "voice": 3426,
  "who": "アシュレイ"
 },
 {
  "id": "s2073:013d1",
  "jp": "同情はしないぞ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5cba"
  ],
  "voice": 3427,
  "who": "イシュト"
 },
 {
  "id": "s2073:013e6",
  "jp": "それは助かるな。\n同情されたりしたら、虫唾が走る。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5cd3"
  ],
  "voice": 3428,
  "who": "アシュレイ"
 },
 {
  "id": "s2073:0141c",
  "jp": "終わりにしてやるぜ、アシュレイ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5cff"
  ],
  "voice": 3429,
  "who": "イシュト"
 },
 {
  "id": "s2073:01444",
  "jp": "ようあんさん！\n驚いたかい？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1fb7",
   "0x7337"
  ],
  "who": "#61"
 },
 {
  "id": "s2073:01460",
  "jp": "ルキア皇国ってのはなぁ。\n一つのデッケェ城なんだよ！\nだから、街も城の中にあるんだ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1fbe",
   "0x733e"
  ],
  "who": "#61"
 },
 {
  "id": "s2073:014b3",
  "jp": "ルキア皇国は世間じゃ\n“悪の国”だからな。\nこうやって安全にしているのさ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1fc5",
   "0x7345"
  ],
  "who": "#61"
 },
 {
  "id": "s2073:014fc",
  "jp": "外からの客なんて珍しいからな。\nコイツはサービスだ！\nまたきてくれよな！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2034",
   "0x73b4"
  ],
  "who": "#61"
 },
 {
  "id": "s2073:01543",
  "jp": "ルキア皇国は、別に政治が悪いわけ\nじゃねぇんだ。\n現に俺達は笑って暮らせてる。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x204c",
   "0x73cc"
  ],
  "who": "#61"
 },
 {
  "id": "s2073:01590",
  "jp": "ただ力が強すぎるだけなんだよ。\nこの国はな。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2053",
   "0x73d3"
  ],
  "who": "#61"
 },
 {
  "id": "s2073:015bc",
  "jp": "ルキア皇国。俺が生まれた国、か。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2076",
   "0x73f6"
  ],
  "who": "イシュト"
 },
 {
  "id": "s2073:015dd",
  "jp": "……なぁんにも感じねぇな。\n幼い頃の記憶が蘇る！　ぐらいは\nあると思ったんだけど。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x207d",
   "0x73fd"
  ],
  "who": "イシュト"
 },
 {
  "id": "s2073:0162e",
  "jp": "ま、過去の事なんてどうでも\nいいか。\n大事なのは、今を生きる事だ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2084",
   "0x7404"
  ],
  "who": "イシュト"
 },
 {
  "id": "s2073:0166f",
  "jp": "何をしたくて、何をしたのか。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x209c",
   "0x741c"
  ],
  "who": "イシュト"
 },
 {
  "id": "s2073:0168c",
  "jp": "俺は、今を生きるぜ、みんな！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x20a3",
   "0x7423"
  ],
  "who": "イシュト"
 },
 {
  "id": "s2073:016a9",
  "jp": "キミ！　その手に持っている品、\nボクに譲ってくれないか！？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x81f4"
  ],
  "who": "#70"
 },
 {
  "id": "s2073:016e3",
  "jp": "それさえあれば、ボクの究極の\n錬金術が完成するんだ！　頼む！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x81fb"
  ],
  "who": "#70"
 },
 {
  "id": "s2073:0171f",
  "jp": "譲ってくれるのか？\nハハハ！　助かるよ！\nちょっと待っててくれ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x8202"
  ],
  "who": "#70"
 },
 {
  "id": "s2073:0175e",
  "jp": "か、完成した……完成したぞ！\n遂に、遂にボクはやったんだ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x82e0"
  ],
  "who": "#70"
 },
 {
  "id": "s2073:01798",
  "jp": "ありがとうキミ！\nキミのおかげで成功したような\nものだ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x82e7"
  ],
  "who": "#70"
 },
 {
  "id": "s2073:017cf",
  "jp": "その砂時計はプレゼントするよ！\n有効に使ってくれ！\nヒャッホー！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x82ee"
  ],
  "who": "#70"
 },
 {
  "id": "s2073:0180e",
  "jp": "星屑の砂時計は時を操る時計だ！\nただし使えるのは一回だけ。\n有効に使ってくれたまえよ？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x830e"
  ],
  "who": "#70"
 },
 {
  "id": "s2073:01863",
  "jp": "足りないぃ……足りないぃ……。\n誰かぁ！　深海の雪とスターダスト\nを持ってきてくれぇ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x8326"
  ],
  "who": "#70"
 },
 {
  "id": "s2073:05e58",
  "jp": "その体で、僕の相手をするのか。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x71f7"
  ],
  "voice": 3430,
  "who": "アシュレイ"
 },
 {
  "id": "s2073:05e7b",
  "jp": "お前にだって、前の戦闘のダメージ\nが残ってるだろうが。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x7215"
  ],
  "voice": 3431,
  "who": "イシュト"
 },
 {
  "id": "s2073:05eb5",
  "jp": "一気に決めてやるぜ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x722a"
  ],
  "voice": 3432,
  "who": "イシュト"
 },
 {
  "id": "s2073:05ece",
  "jp": "アシュレイ。\nお前にも、人の心があったんだな。\n部下を心配して、戻ったんだろ？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x9706"
  ],
  "who": "イシュト"
 },
 {
  "id": "s2073:05f1b",
  "jp": "当たり前だ。僕は人間だからな。\nならば、その心配した部下を\n殺された僕の気持ちも、わかるな？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x971f"
  ],
  "who": "アシュレイ"
 },
 {
  "id": "s2073:05f76",
  "jp": "アシュレイ。\n何故、戻ってきたのですか？\n二人のお陰で逃げられたのに。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x97f3"
  ],
  "who": "ピンガー"
 },
 {
  "id": "s2073:05fbb",
  "jp": "なんてことはない。\nただの、未練だ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x980c"
  ],
  "who": "アシュレイ"
 },
 {
  "id": "s2073:05fdf",
  "jp": "ッ……頭が、痛い。\nアシュレイが近くにいるだけで、\n頭が割れそう……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x98d9"
  ],
  "who": "ルルゥ"
 },
 {
  "id": "s2073:06024",
  "jp": "どうなってるの……？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x98e3"
  ],
  "who": "ルルゥ"
 },
 {
  "id": "s2073:06039",
  "jp": "悲しみは感じないって。\nひしひし伝わってくるっつの……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x99b0"
  ],
  "who": "エリーシャ"
 },
 {
  "id": "s2073:06071",
  "jp": "アンタにも人の心が\nあったってわけね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x99ba"
  ],
  "who": "エリーシャ"
 },
 {
  "id": "s2073:06097",
  "jp": "でも、手を抜く訳にはいかないの。\n覚悟してもらうわよ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x99cf"
  ],
  "who": "エリーシャ"
 },
 {
  "id": "s2073:060cd",
  "jp": "アシュレイ。\nテメェ、ただ戻ってきたわけじゃ\nなさそうだな。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x9aaa"
  ],
  "who": "ザザーランド"
 },
 {
  "id": "s2073:06108",
  "jp": "流石はザザーランド。\nよくわかってるじゃないか。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x9ac3"
  ],
  "who": "アシュレイ"
 },
 {
  "id": "s2073:06138",
  "jp": "ユーフォリアの復活はさせねぇ。\nテメェはここで、殺すぜ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x9add"
  ],
  "who": "ザザーランド"
 },
 {
  "id": "s2073:06170",
  "jp": "どうやら、ユーフォリア復活には\nまだ時間がかかるようだな。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x9bb1"
  ],
  "who": "ミネソタ"
 },
 {
  "id": "s2073:061aa",
  "jp": "このスキに決めなければ、マズイな",
  "en": "",
  "status": "todo",
  "slots": [
   "0x9bbb"
  ],
  "who": "ミネソタ"
 },
 {
  "id": "s2073:061cb",
  "jp": "アシュレイのウィル。\n悲しんでるけど、それだけじゃない\n……気は抜けないね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x9c81"
  ],
  "who": "ロコモコ"
 },
 {
  "id": "s2073:06216",
  "jp": "表情から感情を読み取れないっす。\nこれが本当の無表情って\nいうんすかね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x9d47"
  ],
  "who": "ラズベリー"
 },
 {
  "id": "s2073:0625d",
  "jp": "貴様の出生、人生には大いに\n同情する部分もある。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x9e14"
  ],
  "who": "フィービー"
 },
 {
  "id": "s2073:0628d",
  "jp": "しかし、この戦いはすでに\nそんな感情を抱くわけには\nいかないほどに激化している。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x9e1e"
  ],
  "who": "フィービー"
 },
 {
  "id": "s2073:062dc",
  "jp": "許せ……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x9e33"
  ],
  "who": "フィービー"
 },
 {
  "id": "s2073:062e7",
  "jp": "ガンガガ、ガガグンガ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x9f07"
  ],
  "who": "ガング"
 },
 {
  "id": "s2073:062fe",
  "jp": "ガグガ。グガガガ、ガガン。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x9f1c"
  ],
  "who": "ガング"
 },
 {
  "id": "s2073:06319",
  "jp": "アナタの悲しみ。\nこちらには、ひしひしと\n伝わってきますよ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x9ff0"
  ],
  "who": "ユグドラ"
 },
 {
  "id": "s2073:06354",
  "jp": "しかし、それは因果応報というもの\n……覚悟してください。",
  "en": "",
  "status": "todo",
  "slots": [
   "0xa005"
  ],
  "who": "ユグドラ"
 },
 {
  "id": "s2073:0638c",
  "jp": "仲間を失う悲しみは、誰にでも\n宿るもの。\nそれは皇帝のアナタとて同じ。",
