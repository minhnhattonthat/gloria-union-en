[
 {
  "id": "s2073:00028",
  "jp": "アシュレイ様はこれまで、数多くの\n辛い思いをされてきた。\n世界を掴むためにな！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1cb7"
  ],
  "voice": 3383,
  "who": "メラニー"
 },
 {
  "id": "s2073:00079",
  "jp": "世界を……掴む？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1cd0"
  ],
  "voice": 3384,
  "who": "イシュト"
 },
 {
  "id": "s2073:0008e",
  "jp": "アシュレイ様は、十年も前から\n世界の王となるために必死で努力を\nなさってきた！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1ce9"
  ],
  "voice": 3385,
  "who": "メラニー"
 },
 {
  "id": "s2073:000df",
  "jp": "当時新米だった我らとしては、見て\nいられなかった。日に日に感情が\n無くなっていくアシュレイ様を。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1cff"
  ],
  "voice": 3386,
  "who": "ガルム"
 },
 {
  "id": "s2073:00142",
  "jp": "感情がなくなるほどの訓練……？\nどうかしてるわね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1d15"
  ],
  "voice": 3387,
  "who": "エリーシャ"
 },
 {
  "id": "s2073:00178",
  "jp": "我らは騎士として、家族として……\nアシュレイ様を見守ってきた。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1d2b"
  ],
  "voice": 3388,
  "who": "ガルム"
 },
 {
  "id": "s2073:001ba",
  "jp": "故に、私達はアシュレイ様に\n幸せを手に入れて欲しいのだ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1d41"
  ],
  "voice": 3389,
  "who": "メラニー"
 },
 {
  "id": "s2073:001f6",
  "jp": "イシュト……。",
  "en": "Ishut...",
  "status": "done",
  "slots": [
   "0x1d5a"
  ],
  "voice": 3390,
  "who": "ルルゥ"
 },
 {
  "id": "s2073:00209",
  "jp": "攻撃しづらいか？　\nハハ、ルルゥは優しいからな。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1d73"
  ],
  "voice": 3391,
  "who": "イシュト"
 },
 {
  "id": "s2073:0023d",
  "jp": "兄貴は大丈夫なんですか？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1d8c"
  ],
  "voice": 3392,
  "who": "ピンガー"
 },
 {
  "id": "s2073:0025a",
  "jp": "……俺はお人好しじゃあない。\nそれに、ここで迷ってたらベルガス\nに笑われる。らしくねぇってな。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1dc1"
  ],
  "voice": 3393,
  "who": "イシュト"
 },
 {
  "id": "s2073:002bb",
  "jp": "ま、それもそうよね。\n考えて行動するなんて、\nバカのあんたらしくないわ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1dda"
  ],
  "voice": 3394,
  "who": "エリーシャ"
 },
 {
  "id": "s2073:00306",
  "jp": "イシュト……。",
  "en": "Ishut...",
  "status": "done",
  "slots": [
   "0x1df3"
  ],
  "voice": 3395,
  "who": "ルルゥ"
 },
 {
  "id": "s2073:00319",
  "jp": "というわけだ。通してもらうぜ。\nガルム、メラニー。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1e28"
  ],
  "voice": 3396,
  "who": "ザザーランド"
 },
 {
  "id": "s2073:0034f",
  "jp": "アシュレイ様を幸せにするのが\nわれらの意思、そして信念！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1e48"
  ],
  "voice": 3397,
  "who": "ガルム"
 },
 {
  "id": "s2073:0038b",
  "jp": "何人たりとも、ここは通さん！！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1e61"
  ],
  "voice": 3398,
  "who": "メラニー"
 },
 {
  "id": "s2073:003ae",
  "jp": "ルキア皇国の槍として、\n私は貴様を穿つ！！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x34a0"
  ],
  "voice": 3399,
  "who": "ガルム"
 },
 {
  "id": "s2073:003dc",
  "jp": "お前がルキア皇国の槍なら、\n俺はグロリア海賊団の剣だ！\n覚悟しやがれ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x34ba"
  ],
  "voice": 3400,
  "who": "イシュト"
 },
 {
  "id": "s2073:00425",
  "jp": "私は、皇国の盾……！\n崩れるわけには、いかないんだぁ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x42bf"
  ],
  "voice": 3401,
  "who": "メラニー"
 },
 {
  "id": "s2073:0045f",
  "jp": "俺達だって、アシュレイに\nユーフォリアを渡すわけには\nいかないんだ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x42d9"
  ],
  "voice": 3402,
  "who": "イシュト"
 },
 {
  "id": "s2073:004a6",
  "jp": "貴様には……貴様にだけは負けん！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x388c"
  ],
  "voice": 3403,
  "who": "ガルム"
 },
 {
  "id": "s2073:004cb",
  "jp": "こいガルム。\n引導を渡してやる。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x38a6"
  ],
  "voice": 3404,
  "who": "ザザーランド"
 },
 {
  "id": "s2073:004ef",
  "jp": "私は死なない！　\nアシュレイ様の夢が叶うまでは！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x46c1"
  ],
  "voice": 3405,
  "who": "メラニー"
 },
 {
  "id": "s2073:00523",
  "jp": "夢のために世界を支配しようと\nするってぇなら、\n俺は全力でそれを止めてやるよ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x46db"
  ],
  "voice": 3406,
  "who": "ザザーランド"
 },
 {
  "id": "s2073:00574",
  "jp": "アナタ達がアシュレイに幸せに\nなって欲しいという意思以上に、\nボクは兄貴に幸せになって欲しい。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x358e"
  ],
  "who": "ピンガー"
 },
 {
  "id": "s2073:005d1",
  "jp": "だから、負けられないんですよ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x35a3"
  ],
  "who": "ピンガー"
 },
 {
  "id": "s2073:005f0",
  "jp": "ボクが兄貴を思う気持ちは誰にも\n負けません……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x43a6"
  ],
  "who": "ピンガー"
 },
 {
  "id": "s2073:00620",
  "jp": "例え一国の将軍であろうとも、\nこの意思は負けません！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x43b0"
  ],
  "who": "ピンガー"
 },
 {
  "id": "s2073:00654",
  "jp": "ここまで他人に依存している意思を\n見るのはピンガー以来だよ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3677"
  ],
  "who": "ルルゥ"
 },
 {
  "id": "s2073:00690",
  "jp": "でも、私だって負けられない！\nそこ、通してもらうね！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x368c"
  ],
  "who": "ルルゥ"
 },
 {
  "id": "s2073:006c4",
  "jp": "もはや捕らえる事は考えない！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4493"
  ],
  "who": "メラニー"
 },
 {
  "id": "s2073:006e1",
  "jp": "完全に破壊する。\n後悔するなよ？　古代兵器！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x449d"
  ],
  "who": "メラニー"
 },
 {
  "id": "s2073:0070d",
  "jp": "私だって。\n絶対に、負けないんだから！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x44b7"
  ],
  "who": "ルルゥ"
 },
 {
  "id": "s2073:00733",
  "jp": "ザザーランドの娘。\n末恐ろしい存在が、\nここまで成長したか。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3776"
  ],
  "who": "ガルム"
 },
 {
  "id": "s2073:0076e",
  "jp": "悪いけど、ここで止まる気はないわ",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3790"
  ],
  "who": "エリーシャ"
 },
 {
  "id": "s2073:0078f",
  "jp": "いつか親父にも\n追いついて、追い抜くのが、\n私の意思なんだから！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x379a"
  ],
  "who": "エリーシャ"
 },
 {
  "id": "s2073:007ce",
  "jp": "地の利、武の利、全てこちらにある",
  "en": "",
  "status": "todo",
  "slots": [
   "0x45a1"
  ],
  "who": "メラニー"
 },
 {
  "id": "s2073:007ef",
  "jp": "グロリア海賊団。ここで討つ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x45ab"
  ],
  "who": "メラニー"
 },
 {
  "id": "s2073:0080c",
  "jp": "少しばかり有利だからって、\n調子に乗るんじゃないわよ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x45c5"
  ],
  "who": "エリーシャ"
 },
 {
  "id": "s2073:00842",
  "jp": "こんな差、ハンデにもならないわ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x45cf"
  ],
  "who": "エリーシャ"
 },
 {
  "id": "s2073:00863",
  "jp": "貴殿は元々考古学者。\n返す恩は返したろうに、\n何故奴らの味方をするのだ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3990"
  ],
  "who": "ガルム"
 },
 {
  "id": "s2073:008aa",
  "jp": "恩など遥か昔に返したよ。\n今自分が動く理由は、一つ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x39aa"
  ],
  "who": "ミネソタ"
 },
 {
  "id": "s2073:008de",
  "jp": "感謝の念だ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x39b4"
  ],
  "who": "ミネソタ"
 },
 {
  "id": "s2073:008eb",
  "jp": "貴様等はここでなんとしても\n喰い止める！\n例えこの四肢砕けようとも！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x47c5"
  ],
  "who": "メラニー"
 },
 {
  "id": "s2073:0092e",
  "jp": "なんという忠義心だ……。\nしかし、こちらとて負ける訳には\nいかない……いかないのだ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x47df"
  ],
  "who": "ミネソタ"
 },
 {
  "id": "s2073:00981",
  "jp": "ちょっと！　そこどいてよ！\n先に行けないじゃない！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3a88"
  ],
  "who": "ロコモコ"
 },
 {
  "id": "s2073:009b3",
  "jp": "意地でも通さん！\nネズミ一匹、後ろにはいかさん！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3a9d"
  ],
  "who": "ガルム"
 },
 {
  "id": "s2073:009e3",
  "jp": "うぅ、人がぎっしり。\nどこからも抜けられないよ……！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x48b3"
  ],
  "who": "ロコモコ"
 },
 {
  "id": "s2073:00a17",
  "jp": "どんなことがあろうとここを\n通すな！\n隊列を乱すな！　いけぇ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x48cc"
  ],
  "who": "メラニー"
 },
 {
  "id": "s2073:00a54",
  "jp": "あらら、皆さん決死の表情っすねぇ\nこういう人達が、一番厄介っす。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3b71"
  ],
  "who": "ラズベリー"
 },
 {
  "id": "s2073:00a94",
  "jp": "心してかからないと、\nボロ負けしちゃいそうっすね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3b86"
  ],
  "who": "ラズベリー"
 },
 {
  "id": "s2073:00ac6",
  "jp": "空を飛べば抜けられるっすけど。\n一人で行くわけにもいかないっす\nからねぇ……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4999"
  ],
  "who": "ラズベリー"
 },
 {
  "id": "s2073:00b13",
  "jp": "……頑張って、みましょうかね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x49a3"
  ],
  "who": "ラズベリー"
 },
 {
  "id": "s2073:00b32",
  "jp": "ここにきて必死だな。ルキア皇国。\n今お前らが感じている感覚を、\nシャンティは百年間味わい続けた！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3c53"
  ],
  "who": "フィービー"
 },
 {
  "id": "s2073:00b91",
  "jp": "その思い、今こそ晴らす時だ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3c5d"
  ],
  "who": "フィービー"
 },
 {
  "id": "s2073:00bae",
  "jp": "貴様等を倒し、\nシャンティエを救う！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4a70"
  ],
  "who": "フィービー"
 },
 {
  "id": "s2073:00bd2",
  "jp": "他人の力を借りなければ国一つ\n救えない脆弱な種族が！\n粋がるな！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4a89"
  ],
  "who": "メラニー"
 },
 {
  "id": "s2073:00c11",
  "jp": "ガンガガングング、ガガンガ\nグンガングガガガ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3d23"
  ],
  "who": "ガング"
 },
 {
  "id": "s2073:00c3f",
  "jp": "ガンガガガガグガガン……。\nガガ、ガンガガガ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4b56"
  ],
  "who": "ガング"
 },
 {
  "id": "s2073:00c6d",
  "jp": "これほどの重圧を感じる\nなんて……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3df0"
  ],
  "who": "ユグドラ"
 },
 {
  "id": "s2073:00c91",
  "jp": "心なしか、センチュリオバスターも\n重く感じますね……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3dfa"
  ],
  "who": "ユグドラ"
 },
 {
  "id": "s2073:00cc7",
  "jp": "しかし、負ける訳にはいきません！\n必ず勝ちます！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3e0f"
  ],
  "who": "ユグドラ"
 },
 {
  "id": "s2073:00cf7",
  "jp": "その乱れのない隊列。\nセンチュリオバスターでバラバラに\n粉砕してあげます！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4c1c"
  ],
  "who": "ユグドラ"
 },
 {
  "id": "s2073:00d40",
  "jp": "攻撃のガルム将軍が\n守りに徹するとは……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3edc"
  ],
  "who": "カミュル"
 },
 {
  "id": "s2073:00d6a",
  "jp": "勝てる……勝てるぞ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3ee6"
  ],
  "who": "カミュル"
 },
 {
  "id": "s2073:00d7f",
  "jp": "メラニー将軍……。\n不肖カミュル。\nアナタを超えさせていただきます！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4ce2"
  ],
  "who": "カミュル"
 },
 {
  "id": "s2073:00dc2",
  "jp": "あらあら、必死になっちゃって。\n一国の将軍が、必死なものね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3fb3"
  ],
  "who": "アンヌ"
 },
 {
  "id": "s2073:00dfe",
  "jp": "悪いけど、通させてもらうわよ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3fc8"
  ],
  "who": "アンヌ"
 },
 {
  "id": "s2073:00e1d",
  "jp": "どんなに鉄壁を誇ってたって、\n壊れない壁はないのよ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4da8"
  ],
  "who": "アンヌ"
 },
 {
  "id": "s2073:00e51",
  "jp": "切り崩すわよ。\n覚悟しなさい！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4db2"
  ],
  "who": "アンヌ"
 },
 {
  "id": "s2073:00e6f",
  "jp": "そんなにガチガチに固めちゃって、\nまともに動けるの？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4095"
  ],
  "who": "パメラ"
 },
 {
  "id": "s2073:00ea3",
  "jp": "ま、どんなに防御を固めても、\n最強のパメラ様には意味ないん\nだけどね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x409f"
  ],
  "who": "パメラ"
 },
 {
  "id": "s2073:00ee8",
  "jp": "最強の盾を誇ってるようだけど、\nパメラ様の攻撃の前には\n紙切れ同然なんだわさ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4e78"
  ],
  "who": "パメラ"
 },
 {
  "id": "s2073:00f35",
  "jp": "一生懸命になる人の姿は\nみな素晴らしいですわね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x417a"
  ],
  "who": "イータ"
 },
 {
  "id": "s2073:00f65",
  "jp": "詩には残しました。\n惜しいですが、後は壊すだけですわ",
  "en": "",
  "status": "todo",
  "slots": [
   "0x418f"
  ],
  "who": "イータ"
 },
 {
  "id": "s2073:00f99",
  "jp": "アナタの詩には、少し恋の色が\n混じっていますわね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4f53"
  ],
  "who": "イータ"
 },
 {
  "id": "s2073:00fcb",
  "jp": "ウフフ。\n一国の将軍にも、\n恋心はあるんですわね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4f68"
  ],
  "who": "イータ"
 },
 {
  "id": "s2073:00ffc",
  "jp": "決死戦か！　面白ぇ！\n俺の拳でその道、\n抉じ開けてやるぜ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x41d4"
  ],
  "who": "#15"
 },
 {
  "id": "s2073:01035",
  "jp": "敵ながら見事な隊列だぜ、面白ぇ！\n簡単に崩されてくれるなよ！？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4fad"
  ],
  "who": "#15"
 },
 {
  "id": "s2073:01073",
  "jp": "む……無念……！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5047"
  ],
  "voice": 3407,
  "who": "ガルム"
 },
 {
  "id": "s2073:01088",
  "jp": "ガルム！\n……貴様等！　許さん！！\nウオオオオオオオオォォォ！！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5154"
  ],
  "voice": 3408,
  "who": "メラニー"
 },
 {
  "id": "s2073:010cb",
  "jp": "無念……だ。",
