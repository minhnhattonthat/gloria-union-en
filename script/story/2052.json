[
 {
  "id": "s2052:00028",
  "jp": "あら、随分遅かったわね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2406"
  ],
  "voice": 1805,
  "who": "トレイシー"
 },
 {
  "id": "s2052:00045",
  "jp": "ん？　誰だあんた。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x241c"
  ],
  "voice": 1806,
  "who": "イシュト"
 },
 {
  "id": "s2052:0005c",
  "jp": "あなた達の敵、といえばいい\nかしら？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2435"
  ],
  "voice": 1807,
  "who": "トレイシー"
 },
 {
  "id": "s2052:00084",
  "jp": "なんですって……！？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x244e"
  ],
  "voice": 1808,
  "who": "エリーシャ"
 },
 {
  "id": "s2052:0009d",
  "jp": "武器を構えもしないで、\n随分と余裕だな？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x247a"
  ],
  "voice": 1809,
  "who": "フィービー"
 },
 {
  "id": "s2052:000c9",
  "jp": "ウフフ。\nさて、これは一体なんでしょうね？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x24a1"
  ],
  "voice": 1810,
  "who": "トレイシー"
 },
 {
  "id": "s2052:000f7",
  "jp": "うひゃあ！　眩しいっす！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x251e"
  ],
  "voice": 1811,
  "who": "ラズベリー"
 },
 {
  "id": "s2052:00114",
  "jp": "それは、バーストウィング！？\n風のカードが……なんで！？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2537"
  ],
  "voice": 1812,
  "who": "ルルゥ"
 },
 {
  "id": "s2052:00150",
  "jp": "先を越されてたのか……！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2550"
  ],
  "voice": 1813,
  "who": "イシュト"
 },
 {
  "id": "s2052:0016d",
  "jp": "兵がいないところを見ると。\nやつらは既に大地の槍に向かって\nるってのか……チクショウ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2569"
  ],
  "voice": 1814,
  "who": "ザザーランド"
 },
 {
  "id": "s2052:001c6",
  "jp": "そんな……火のカードに続いて、\n風と土のカードまで……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x25ac"
  ],
  "voice": 1815,
  "who": "ピンガー"
 },
 {
  "id": "s2052:00202",
  "jp": "精確ではない探知でもこの差……。\n完全に船の性能差ね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x25c5"
  ],
  "voice": 1816,
  "who": "エリーシャ"
 },
 {
  "id": "s2052:0023c",
  "jp": "まさか、ここまで性能に差が\n出てるとはな……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x25ec"
  ],
  "voice": 1817,
  "who": "ザザーランド"
 },
 {
  "id": "s2052:0026e",
  "jp": "ウフフ、そういうこと。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2605"
  ],
  "voice": 1818,
  "who": "トレイシー"
 },
 {
  "id": "s2052:00289",
  "jp": "でも、アナタにそのカードは\n使えない。\n消費するウィルの量が多すぎる。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x261e"
  ],
  "voice": 1819,
  "who": "ルルゥ"
 },
 {
  "id": "s2052:002d2",
  "jp": "そうですね。\n古代ユーフォリア王家の末裔でも\nない限り、これは使えません。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2637"
  ],
  "voice": 1820,
  "who": "トレイシー"
 },
 {
  "id": "s2052:0031f",
  "jp": "古代ユーフォリア王家の、末裔？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2673"
  ],
  "voice": 1821,
  "who": "イシュト"
 },
 {
  "id": "s2052:00342",
  "jp": "あら、知らないのですか？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x268c"
  ],
  "voice": 1822,
  "who": "トレイシー"
 },
 {
  "id": "s2052:0035f",
  "jp": "お前……何者だ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x26a5"
  ],
  "voice": 1823,
  "who": "イシュト"
 },
 {
  "id": "s2052:00374",
  "jp": "あら、それは失礼しました。\n申し遅れました。私の名前は",
  "en": "",
  "status": "todo",
  "slots": [
   "0x26be"
  ],
  "voice": 1824,
  "who": "トレイシー"
 },
 {
  "id": "s2052:003ae",
  "jp": "トレイシー",
  "en": "Tracey",
  "status": "done",
  "slots": [
   "0x26d7"
  ],
  "voice": 1825,
  "who": "ピンガー"
 },
 {
  "id": "s2052:003bd",
  "jp": "……あら、あなたは憶えてたのね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x26ed"
  ],
  "voice": 1826,
  "who": "トレイシー"
 },
 {
  "id": "s2052:003e2",
  "jp": "忘れるわけない。あなたは人間の\nボクを殺した人だから……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2714"
  ],
  "voice": 1827,
  "who": "ピンガー"
 },
 {
  "id": "s2052:00420",
  "jp": "え……？　“人間のボク”って……\nいったい何よ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x272d"
  ],
  "voice": 1828,
  "who": "エリーシャ"
 },
 {
  "id": "s2052:00454",
  "jp": "そうか、そいつがそうなんだな、\nピンガー。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2746"
  ],
  "voice": 1829,
  "who": "イシュト"
 },
 {
  "id": "s2052:00482",
  "jp": "えぇ、彼女こそ\nボクを獣人に改造した女……\nトレイシーだ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x275f"
  ],
  "voice": 1830,
  "who": "ピンガー"
 },
 {
  "id": "s2052:004bf",
  "jp": "トレイシー……。\n“レバレッジ商団”の女団長か",
  "en": "",
  "status": "todo",
  "slots": [
   "0x28c1"
  ],
  "voice": 1831,
  "who": "ザザーランド"
 },
 {
  "id": "s2052:004f1",
  "jp": "あのグロリア海賊団の船長に知って\nいただいていたとは、光栄です。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x28da"
  ],
  "voice": 1832,
  "who": "トレイシー"
 },
 {
  "id": "s2052:00535",
  "jp": "金の為ならどんな商売でもするって\n有名だよ。\n……ロコモコを狙ったのもお前らか",
  "en": "",
  "status": "todo",
  "slots": [
   "0x28f8"
  ],
  "voice": 1833,
  "who": "ザザーランド"
 },
 {
  "id": "s2052:00586",
  "jp": "そうです。魔法という存在に興味が\nありまして。\nまぁ商品として、ですが。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2911"
  ],
  "voice": 1834,
  "who": "トレイシー"
 },
 {
  "id": "s2052:005d1",
  "jp": "絶対にぶっ飛ばす。そこで待ってろ",
  "en": "",
  "status": "todo",
  "slots": [
   "0x292a"
  ],
  "voice": 1835,
  "who": "イシュト"
 },
 {
  "id": "s2052:005f6",
  "jp": "待って兄貴、それはボクの役目\nだから。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2943"
  ],
  "voice": 1836,
  "who": "ピンガー"
 },
 {
  "id": "s2052:00620",
  "jp": "ウッフフ。こわいこわい。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x295c"
  ],
  "voice": 1837,
  "who": "トレイシー"
 },
 {
  "id": "s2052:0063d",
  "jp": "トレイシーは目に特殊な術を施して\nカードを二枚使えるようになって\nいます！　注意してください！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2975"
  ],
  "voice": 1838,
  "who": "ピンガー"
 },
 {
  "id": "s2052:0069e",
  "jp": "あなたがピンガーの面倒を見て\nくれていたのね。フフッ、運命って\nわからないものだわぁ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2aca"
  ],
  "voice": 1839,
  "who": "トレイシー"
 },
 {
  "id": "s2052:006f7",
  "jp": "お前がピンガーの心にどれほどの\n傷をつけたのか俺は知ってる。\n悪いが、倒させてもらうぞ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2ae4"
  ],
  "voice": 1840,
  "who": "イシュト"
 },
 {
  "id": "s2052:00752",
  "jp": "あなたにはもう興味がありません。\nどっかの野原で猫と戯れてなさい。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2bd6"
  ],
  "voice": 1841,
  "who": "トレイシー"
 },
 {
  "id": "s2052:00798",
  "jp": "そんなこと言って……。\nボクの力を見て後悔するといいさ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2bf0"
  ],
  "voice": 1842,
  "who": "ピンガー"
 },
 {
  "id": "s2052:007d4",
  "jp": "アナタ、どうしてそんなに\n詳しいの？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2cc4"
  ],
  "who": "ルルゥ"
 },
 {
  "id": "s2052:007f8",
  "jp": "こんなこと、限られた人しか\n知らないはずなのに。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2cce"
  ],
  "who": "ルルゥ"
 },
 {
  "id": "s2052:00828",
  "jp": "それは、私がその限られた人の\n一人だからですよ。\nウフフ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2ce7"
  ],
  "who": "トレイシー"
 },
 {
  "id": "s2052:00861",
  "jp": "ピンガーがアソコまで\n取り乱すなんて。\nアンタ、相当悪い奴みたいね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2dbb"
  ],
  "who": "エリーシャ"
 },
 {
  "id": "s2052:008a4",
  "jp": "だからどうしたというのですか？\n私は私のしたいようにやった。\nそれだけです。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2dd4"
  ],
  "who": "トレイシー"
 },
 {
  "id": "s2052:008ef",
  "jp": "有名商団の団長さんが、こんな所で\nどんな商売をしようってんだ？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2ea8"
  ],
  "who": "ザザーランド"
 },
 {
  "id": "s2052:0092d",
  "jp": "今回はただの私欲ですよ。\nお金を抜きにしても、これほど\n美味しい話はありませんでしたから",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2ec1"
  ],
  "who": "トレイシー"
 },
 {
  "id": "s2052:00984",
  "jp": "レバレッジ商団の行動は前々から\n商人として逸脱しているという事で\n話題になっていたが。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2f95"
  ],
  "who": "ミネソタ"
 },
 {
  "id": "s2052:009d9",
  "jp": "まさか、こんなことになるとはな。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2f9f"
  ],
  "who": "ミネソタ"
 },
 {
  "id": "s2052:009fa",
  "jp": "レバレッジ商団はあくまで\n私の目的を叶える為の外殻でしか\nありませんから。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2fb8"
  ],
  "who": "トレイシー"
 },
 {
  "id": "s2052:00a43",
  "jp": "考古学者が世間の噂に左右されては\nいけませんよ？\nウフフ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2fc2"
  ],
  "who": "トレイシー"
 },
 {
  "id": "s2052:00a7c",
  "jp": "いつかの恨み！\nここで晴らしてやるんだから！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3096"
  ],
  "who": "ロコモコ"
 },
 {
  "id": "s2052:00aa8",
  "jp": "用があったのはアナタの\n探知能力だけなので、アナタはもう\n用済みです。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x30af"
  ],
  "who": "トレイシー"
 },
 {
  "id": "s2052:00aed",
  "jp": "退却を願いたいですね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x30b9"
  ],
  "who": "トレイシー"
 },
 {
  "id": "s2052:00b04",
  "jp": "あくどい商売もいいっすけど。\nあまりやりすぎると、罪人課の\n世話になってしまいますよ？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x318d"
  ],
  "who": "ラズベリー"
 },
 {
  "id": "s2052:00b59",
  "jp": "人は生まれながらに罪を背負う\n生き物です。\nどうしようもありませんよ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x31a6"
  ],
  "who": "トレイシー"
 },
 {
  "id": "s2052:00b9e",
  "jp": "ウンディーネ。\n確か、アナタ方の血は万病に効くと\n云われていますね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3290"
  ],
  "who": "トレイシー"
 },
 {
  "id": "s2052:00be1",
  "jp": "本当なのですか？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3297"
  ],
  "who": "トレイシー"
 },
 {
  "id": "s2052:00bf2",
  "jp": "それは、ルキア皇国が\nシャンティエを滅ぼす為に流した\nデマだ。本気にすることはない。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x32b1"
  ],
  "who": "フィービー"
 },
 {
  "id": "s2052:00c45",
  "jp": "そうですか。\nフフ、残念。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x32ca"
  ],
  "who": "トレイシー"
 },
 {
  "id": "s2052:00c5f",
  "jp": "レバレッジ商団。\nその悪行は私の耳にも入って\nいますよ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x339e"
  ],
  "who": "ユグドラ"
 },
 {
  "id": "s2052:00c96",
  "jp": "商人というのは、多少あくどく\nなければ生きていけないんですよ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x33b7"
  ],
  "who": "トレイシー"
 },
 {
  "id": "s2052:00cd4",
  "jp": "悪徳商人に強欲海賊か。\nヘッ、似たもの姉妹だな！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3492"
  ],
  "who": "イシュト"
 },
 {
  "id": "s2052:00d04",
  "jp": "強欲である事が海賊の定義なのよ。\nま、お子ちゃまにはわからない\nでしょうけどね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x34ab"
  ],
  "who": "アンヌ"
 },
 {
  "id": "s2052:00d53",
  "jp": "最初見た時からまさかとは\n思ってたけど。\nへぇ、アナタが……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3595"
  ],
  "who": "アンヌ"
 },
 {
  "id": "s2052:00d90",
  "jp": "なんですか、人の顔をジロジロと。\n気持ち悪いですね……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x35af"
  ],
  "who": "ピンガー"
 },
 {
  "id": "s2052:00dc8",
  "jp": "私ってば、\nやっぱりツイてるのかしら？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x36a0"
  ],
  "who": "アンヌ"
 },
 {
  "id": "s2052:00dee",
  "jp": "こんな所に、一攫千金があるなんて",
  "en": "",
  "status": "todo",
  "slots": [
   "0x36b5"
  ],
  "who": "アンヌ"
 },
 {
  "id": "s2052:00e0f",
  "jp": "もう捕まるのは嫌だし、\n捕まる気もないんだから！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x36cf"
  ],
  "who": "ルルゥ"
 },
 {
  "id": "s2052:00e3f",
  "jp": "アンタって、そうやって毎日雇い主\n変えてるわけ？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x37b8"
  ],
  "who": "エリーシャ"
 },
 {
  "id": "s2052:00e6f",
  "jp": "呆れた尻軽女ね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x37cd"
  ],
  "who": "エリーシャ"
 },
 {
  "id": "s2052:00e80",
  "jp": "そう……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x37e6"
  ],
  "who": "アンヌ"
 },
 {
  "id": "s2052:00e8b",
  "jp": "じゃあアナタは、どっしりとした\n重～～～いお尻ってわけね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x37ed"
  ],
  "who": "アンヌ"
 },
 {
  "id": "s2052:00ec5",
  "jp": "なんですってぇ！？\nキィー！　もう許さないんだから！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3807"
  ],
  "who": "エリーシャ"
 },
 {
  "id": "s2052:00ef9",
  "jp": "なんだ？\nこの前は逃げ出したってのに、\n随分とやる気じゃねぇか。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x38f0"
  ],
  "who": "ザザーランド"
 },
 {
  "id": "s2052:00f38",
  "jp": "これだけの人数差よ？\n気持ちも大きくなるってものだわ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3909"
  ],
  "who": "アンヌ"
 },
 {
  "id": "s2052:00f6e",
  "jp": "細切れにしてあげるわ。\n大海賊さん？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x391e"
  ],
  "who": "アンヌ"
 },
 {
  "id": "s2052:00f92",
  "jp": "約束の時間に遅れるとは、\n何たるマナー違反だ！\n粛清してくれる！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x39f9"
  ],
  "who": "ミネソタ"
 },
 {
  "id": "s2052:00fd1",
  "jp": "な、なんなのこの人。\nスゴイ気迫なんだけど。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3a12"
  ],
  "who": "アンヌ"
 },
 {
  "id": "s2052:00ffd",
  "jp": "っていうか、怒る所ってそこ？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3a1c"
  ],
  "who": "アンヌ"
 },
 {
  "id": "s2052:0101a",
  "jp": "お姉ちゃんもあの商人の仲間なの？\nじゃあ、ロコモコの敵だねっ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3af0"
  ],
  "who": "ロコモコ"
 },
 {
  "id": "s2052:01058",
  "jp": "あらあら、小さい子ねぇ。\n遊んでほしいの？　ウフフ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3b09"
  ],
  "who": "アンヌ"
 },
 {
  "id": "s2052:0108c",
  "jp": "なに？　その羽。\nイカしたデザインね。\nちょっと触らせてよ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3bf3"
  ],
  "who": "アンヌ"
 },
 {
  "id": "s2052:010c7",
  "jp": "これは私が初給料で買った\n黄泉最新モデルのウィングっす！\nそう易々と触らせはしないっす！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3c0d"
  ],
  "who": "ラズベリー"
 },
 {
  "id": "s2052:0111e",
  "jp": "いいわよねぇ。ウンディーネって。\n永遠にその姿のままなんて、\nズルイと思わない？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3cf7"
  ],
  "who": "アンヌ"
 },
 {
  "id": "s2052:0116d",
  "jp": "この体はいつまでも国の力と\nなれる為に若さを保っているのだ！\nそんな不純な目で見るな！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3d11"
  ],
  "who": "フィービー"
 },
 {
  "id": "s2052:011c2",
  "jp": "ゲゲ、アンタ達\nファンタジニア旅団じゃない。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3dfb"
  ],
  "who": "アンヌ"
 },
 {
  "id": "s2052:011ee",
  "jp": "アンタ達、しつこいから\n嫌いなのよねぇ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3e05"
  ],
  "who": "アンヌ"
 },
 {
  "id": "s2052:01216",
  "jp": "シャルム海賊団の\nアンヌ・コーマック！\nその首、私がいただきますよ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3e1f"
  ],
  "who": "ユグドラ"
 },
 {
  "id": "s2052:01259",
  "jp": "ここここののうらうら恨み！\n晴らさでおおおおおくべきか！！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3f09"
  ],
  "who": "アジョー"
 },
 {
  "id": "s2052:01293",
  "jp": "うお、すげぇ気迫だな。\n面白ぇ、受けて立つぜ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3f23"
  ],
  "who": "イシュト"
 },
 {
  "id": "s2052:012c1",
  "jp": "うがああああぁぁぁ！！！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x400d"
  ],
  "who": "アジョー"
 },
 {
  "id": "s2052:012da",
  "jp": "ものすごい咆哮ですね。\nボクよりも獣っぽいんじゃ\nないですか？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4027"
  ],
  "who": "ピンガー"
 },
 {
  "id": "s2052:01317",
  "jp": "バラバラバラバラしてやる！！\n貴様のかかか体だだ！　隅々まで\n研究しつくしてやるぁぁあ！！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4111"
  ],
  "who": "アジョー"
 },
 {
  "id": "s2052:01370",
  "jp": "うぅ、スゴイ禍々しいウィル。\n思わず体が竦んじゃうよ……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x412b"
  ],
  "who": "ルルゥ"
 },
 {
  "id": "s2052:013aa",
  "jp": "まったく、厄介な男に目を\nつけられたものね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x41ff"
  ],
  "who": "エリーシャ"
 },
 {
  "id": "s2052:013d6",
  "jp": "悪いけど、黙っててもらうわよ。\nあたしの双銃でね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4214"
  ],
  "who": "エリーシャ"
 },
 {
  "id": "s2052:01408",
  "jp": "うおおおおおぉぉぉぉ！！！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x42fe"
  ],
  "who": "アジョー"
 },
 {
  "id": "s2052:01423",
  "jp": "チッ！\n無闇やたらに突っ込んでくる奴ほど\n怖いもんもねぇぜ。ったく。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4318"
  ],
  "who": "ザザーランド"
 },
 {
  "id": "s2052:01466",
  "jp": "殺す殺す殺すころおぉぉぉす！！\nクケケケケケ！！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4402"
  ],
  "who": "アジョー"
 },
 {
  "id": "s2052:01496",
  "jp": "……自分は、あぁならないように\nしないとな。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x441c"
  ],
  "who": "ミネソタ"
 },
 {
  "id": "s2052:014c2",
  "jp": "子供とか関係ねぇぇぇ！\n全員解体だぁぁぁ！！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4506"
  ],
  "who": "アジョー"
 },
 {
  "id": "s2052:014ee",
  "jp": "ふえぇ～ん！\n怖いよぉ～！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4520"
  ],
  "who": "ロコモコ"
 },
 {
  "id": "s2052:01508",
  "jp": "吸血鬼の体ァァアァアハハハハ！！\n興味深い！　興味深いぞぉぉ！！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x460a"
  ],
  "who": "アジョー"
 },
 {
  "id": "s2052:01548",
  "jp": "わ、私なんか食べても\n美味しくもなんともないっすよぉ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4624"
  ],
  "who": "ラズベリー"
 },
 {
  "id": "s2052:0157e",
  "jp": "ウンディィィィィネェェ！！\n三枚おろしだぁぁぁああぁぁぁ！！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x470e"
  ],
  "who": "アジョー"
 },
 {
  "id": "s2052:015ba",
  "jp": "なんて不気味な男だ。\n一刻も早く倒さなければ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4728"
  ],
  "who": "フィービー"
 },
 {
  "id": "s2052:015e8",
  "jp": "その銃ぅぅ、実に興味深いぃぃぃぃ\nぃぃぃよこせぇぇぇぇ！！！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4812"
  ],
  "who": "アジョー"
 },
 {
  "id": "s2052:01624",
  "jp": "この銃はお父様からいただいた\n大切なもの！\n渡すわけがありません！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x482c"
  ],
  "who": "ユグドラ"
 },
 {
  "id": "s2052:01665",
  "jp": "キイィィィィィサアァァァァァ\nマアァァァァラアァァァァ！！！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4c8f"
  ],
  "voice": 1843,
  "who": "アジョー"
 },
 {
  "id": "s2052:016a5",
  "jp": "アジョー・グラフォー！？　\n追いかけてきやがったのか！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4ca8"
  ],
  "voice": 1844,
  "who": "イシュト"
 },
 {
  "id": "s2052:016df",
  "jp": "本当に先ほどの男なのか！？\nひ、酷い顔だな。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4cd9"
  ],
  "voice": 1845,
  "who": "フィービー"
 },
 {
  "id": "s2052:0170f",
  "jp": "怒りのあまりウィルが体から\nにじみ出てるよ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4d11"
  ],
  "voice": 1846,
  "who": "ロコモコ"
 },
 {
  "id": "s2052:0173f",
  "jp": "ひえぇ。課長バリに怖いっす！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4d49"
  ],
  "voice": 1847,
  "who": "ラズベリー"
 },
 {
  "id": "s2052:01760",
  "jp": "よくもよくもよくもよくもボクの\nむむむ娘めめめに傷をつぅけたな\nかかカカカカイボウ死て殺る！！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4d69"
  ],
  "voice": 1848,
  "who": "アジョー"
 },
 {
  "id": "s2052:017c1",
  "jp": "発明品を娘と言うか。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4d9a"
  ],
  "voice": 1849,
  "who": "ミネソタ"
 },
 {
  "id": "s2052:017da",
  "jp": "おいおいやべぇぞ、こいつぁとんだ\nプッツリさんだ！！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4dbf"
  ],
  "voice": 1850,
  "who": "ザザーランド"
 },
 {
  "id": "s2052:01812",
  "jp": "死ネシネシネ死ネシネシエイエイエ\nイエエェェェェェェェ！！！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4dd8"
  ],
  "voice": 1851,
  "who": "アジョー"
 },
 {
  "id": "s2052:01852",
  "jp": "おまたせぇ。ちょっとイイ男の相手\nしてたら遅れちゃった。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4f64"
  ],
  "voice": 1852,
  "who": "アンヌ"
 },
 {
  "id": "s2052:0188e",
  "jp": "物は売っても自分は売るな。と\nあれほど言ったのに、\n姉さんは悲しいですよ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4f7a"
  ],
  "voice": 1853,
  "who": "トレイシー"
 },
 {
  "id": "s2052:018db",
  "jp": "また増援！？　どれだけ増えるのよ\nってかあんたら姉妹だったの！？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4f98"
  ],
  "voice": 1854,
  "who": "エリーシャ"
 },
 {
  "id": "s2052:0191f",
  "jp": "これ以上時間を費やしている暇は\nないな。早く研究所に戻って修理を\n行わなければ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4932",
   "0x50f0"
  ],
  "voice": 1890,
  "who": "アジョー"
 },
 {
  "id": "s2052:01972",
  "jp": "まぁ、こんなものでしょうね。\nこれ以上やっても無駄だし、\n帰らせてもらうわよ、姉さん。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x49eb",
   "0x518b"
  ],
  "voice": 1889,
  "who": "アンヌ"
 },
 {
  "id": "s2052:019cb",
  "jp": "さぁ、教えてもらうぞ。\n古代ユーフォリア王家ってのは\nなんだ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x520e"
  ],
  "voice": 1855,
  "who": "イシュト"
 },
 {
  "id": "s2052:01a0c",
  "jp": "ウフフ、もう少し強くなってから、\n教えてあげますよ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5227"
  ],
  "voice": 1856,
  "who": "トレイシー"
 },
 {
  "id": "s2052:01a44",
  "jp": "な！　こいつ、やられたんじゃ！？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5240"
  ],
  "voice": 1857,
  "who": "イシュト"
 },
 {
  "id": "s2052:01a69",
  "jp": "私は商人ですよ？\n体を癒すものなんて、いくらでも\n持っています。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5259"
  ],
  "voice": 1858,
  "who": "トレイシー"
 },
 {
  "id": "s2052:01aac",
  "jp": "では、ごきげんよう。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x527a"
  ],
  "voice": 1859,
  "who": "トレイシー"
 },
 {
  "id": "s2052:01ac5",
  "jp": "待て！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5ac7"
  ],
  "voice": 1860,
  "who": "ピンガー"
 },
 {
  "id": "s2052:01ad0",
  "jp": "チッ！　逃げられたか！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5ae0"
  ],
  "voice": 1861,
  "who": "ザザーランド"
 },
 {
  "id": "s2052:01aeb",
  "jp": "風のカードも持ち逃げされた\nみたい……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5af9"
  ],
  "voice": 1862,
  "who": "ルルゥ"
 },
 {
  "id": "s2052:01b17",
  "jp": "フーッ！　フーッ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5b12"
  ],
  "voice": 1863,
  "who": "ピンガー"
 },
 {
  "id": "s2052:01b2e",
  "jp": "ピンガー、落ち着いて。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5b2b"
  ],
  "voice": 1864,
  "who": "ルルゥ"
 },
 {
  "id": "s2052:01b49",
  "jp": "……すいません。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5b41"
  ],
  "voice": 1865,
  "who": "ピンガー"
 },
 {
  "id": "s2052:01b5e",
  "jp": "ねぇ、ピンガー。話したくないなら\nいいんだけど……あの女、何者？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5b57"
  ],
  "voice": 1866,
  "who": "エリーシャ"
 },
 {
  "id": "s2052:01ba2",
  "jp": "……彼女の名はトレイシー。\n“開発者”と言われている\n悪徳商人です。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5b97"
  ],
  "voice": 1867,
  "who": "ピンガー"
 },
 {
  "id": "s2052:01be9",
  "jp": "商人なのに、開発者なの？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5bb0"
  ],
  "voice": 1868,
  "who": "ルルゥ"
 },
 {
  "id": "s2052:01c06",
  "jp": "商人には、商品を各地で調達する\nタイプと、自ら商品を作るタイプが\nいるんだ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5bc9"
  ],
  "voice": 1869,
  "who": "ザザーランド"
 },
 {
  "id": "s2052:01c55",
  "jp": "奴は錬金術の知識を持っていて。\nそういう、生み出す力に\n酔っているんです……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5be2"
  ],
  "voice": 1870,
  "who": "ピンガー"
 },
 {
  "id": "s2052:01ca6",
  "jp": "錬金術……。\nまだ残ってたんすね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5c06"
  ],
  "voice": 1871,
  "who": "ラズベリー"
 },
 {
  "id": "s2052:01ccc",
  "jp": "もしかして……その生み出す力で\n生まれたのがアンタだって言うの？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5c1c"
  ],
  "voice": 1872,
  "who": "エリーシャ"
 },
 {
  "id": "s2052:01d10",
  "jp": "そう。孤児だった“らしい”ボクは\n奴の作ろうとする商品の材料に\nなったわけです。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5c32"
  ],
  "voice": 1873,
  "who": "ピンガー"
 },
 {
  "id": "s2052:01d63",
  "jp": "人と獣の融合……。\n悪魔の所業としか思えないよ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5c4b"
  ],
  "voice": 1874,
  "who": "ロコモコ"
 },
 {
  "id": "s2052:01d97",
  "jp": "自分はてっきり、ただの獣人族の\n少女だと思っていたが……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5c80"
  ],
  "voice": 1875,
  "who": "ミネソタ"
 },
 {
  "id": "s2052:01dd5",
  "jp": "え！？　獣人族って、本当に\nこの世界にいるの！？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5c96"
  ],
  "voice": 1876,
  "who": "エリーシャ"
 },
 {
  "id": "s2052:01e09",
  "jp": "あぁ。現在は、人間の目に入らない\n小さな孤島に棲んでいるらしいが。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5cac"
  ],
  "voice": 1877,
  "who": "ミネソタ"
 },
 {
  "id": "s2052:01e4f",
  "jp": "ウンディーネ族と獣人族は、\n昔から交流が深い。\n私も何人かとは会ったことがある。",
