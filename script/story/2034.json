[
 {
  "id": "s2034:00028",
  "jp": "ここが“海王神殿”だよ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1579"
  ],
  "voice": 281,
  "who": "ルルゥ"
 },
 {
  "id": "s2034:00045",
  "jp": "名前どおり、水に囲まれてますね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x158f"
  ],
  "voice": 282,
  "who": "ピンガー"
 },
 {
  "id": "s2034:0006a",
  "jp": "行動範囲がかなり制限されるわね。\nやっかいだわぁ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x15a5"
  ],
  "voice": 283,
  "who": "エリーシャ"
 },
 {
  "id": "s2034:000a0",
  "jp": "う～ん……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x15be"
  ],
  "voice": 284,
  "who": "イシュト"
 },
 {
  "id": "s2034:000b1",
  "jp": "あれ？　どうしたの？　イシュト。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x15e5"
  ],
  "voice": 285,
  "who": "ルルゥ"
 },
 {
  "id": "s2034:000d6",
  "jp": "いやぁ、\nなんで俺が指名手配されてるのかが\nどうしても気になってな。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x15fe"
  ],
  "voice": 286,
  "who": "イシュト"
 },
 {
  "id": "s2034:0011d",
  "jp": "まぁ当然ですよね。\nいきなりでしたし。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1625"
  ],
  "voice": 287,
  "who": "ピンガー"
 },
 {
  "id": "s2034:00147",
  "jp": "エリーシャ、何か知らないか？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x163e"
  ],
  "voice": 288,
  "who": "イシュト"
 },
 {
  "id": "s2034:00168",
  "jp": "アンタ達って、何も知らないのね。\n呆れちゃうわ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1657"
  ],
  "voice": 289,
  "who": "エリーシャ"
 },
 {
  "id": "s2034:0019c",
  "jp": "なんだとぉ！？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x167e"
  ],
  "voice": 290,
  "who": "イシュト"
 },
 {
  "id": "s2034:001af",
  "jp": "コレだけの金額を出せる国なんて、\nこの世に一国しかないわ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1697"
  ],
  "voice": 291,
  "who": "エリーシャ"
 },
 {
  "id": "s2034:001ed",
  "jp": "……どこなんだよ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x16cc"
  ],
  "voice": 292,
  "who": "イシュト"
 },
 {
  "id": "s2034:00204",
  "jp": "世界最大最強の軍事国。\nルキア皇国よ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x16e2"
  ],
  "voice": 293,
  "who": "エリーシャ"
 },
 {
  "id": "s2034:0022e",
  "jp": "ルキア、皇国……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x16f8"
  ],
  "voice": 294,
  "who": "イシュト"
 },
 {
  "id": "s2034:00245",
  "jp": "世界最大最強の軍事国家ですか……\nぶっとんだ話ですねぇ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x170e"
  ],
  "voice": 295,
  "who": "ピンガー"
 },
 {
  "id": "s2034:00281",
  "jp": "ピンガーはあまり驚いてないの？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1724"
  ],
  "voice": 296,
  "who": "ルルゥ"
 },
 {
  "id": "s2034:002a4",
  "jp": "一周して冷静になりましたよ。\nにしても、とんでもない国が\n敵になってしまいましたよ、兄貴。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1756"
  ],
  "voice": 297,
  "who": "ピンガー"
 },
 {
  "id": "s2034:00301",
  "jp": "……まぁ、ルルゥと会えただけ\nよしとするか。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x176c"
  ],
  "voice": 298,
  "who": "イシュト"
 },
 {
  "id": "s2034:00331",
  "jp": "うん！\n私もイシュトと会えて嬉しいよ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1790"
  ],
  "voice": 299,
  "who": "ルルゥ"
 },
 {
  "id": "s2034:0035b",
  "jp": "グハァ！\nこれが……愛か！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x17a9"
  ],
  "voice": 300,
  "who": "イシュト"
 },
 {
  "id": "s2034:00379",
  "jp": "……兄貴はほっといて。\nルルゥは、どうしてクリスタルの\n場所を知っているんですか？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x17c2"
  ],
  "voice": 301,
  "who": "ピンガー"
 },
 {
  "id": "s2034:003ce",
  "jp": "違うよ。\nクリスタルから漏れてるウィルを\n探知してるの。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x17e6"
  ],
  "voice": 302,
  "who": "ルルゥ"
 },
 {
  "id": "s2034:00409",
  "jp": "離れた場所にあるウィルを\n探知できるんですか？\nすごいですねぇ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x17fc"
  ],
  "voice": 303,
  "who": "ピンガー"
 },
 {
  "id": "s2034:0044c",
  "jp": "ウィルの探知機なんて最近じゃ\nどこにでも出回ってるけどね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1812"
  ],
  "voice": 304,
  "who": "エリーシャ"
 },
 {
  "id": "s2034:0048a",
  "jp": "え、そうなんですか？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1828"
  ],
  "voice": 305,
  "who": "ピンガー"
 },
 {
  "id": "s2034:004a3",
  "jp": "まぁ、クリスタルのウィルを探る\nほどの探知機なんて、あるのか\nどうかわからないけどね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x183e"
  ],
  "voice": 306,
  "who": "エリーシャ"
 },
 {
  "id": "s2034:004fc",
  "jp": "よかったぁ……私の存在意義が\nなくなるところだった……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1854"
  ],
  "voice": 307,
  "who": "ルルゥ"
 },
 {
  "id": "s2034:00538",
  "jp": "俺の剣、クリスタル、ルキア皇国\nそして、ルルゥにグロリア海賊団。\n……濃いなぁ～。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1886"
  ],
  "voice": 308,
  "who": "イシュト"
 },
 {
  "id": "s2034:0058d",
  "jp": "そうですねぇ。\n昨日まで末端の海賊だったはず\nなんですけどねぇ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x189c"
  ],
  "voice": 309,
  "who": "ピンガー"
 },
 {
  "id": "s2034:005d0",
  "jp": "ごめんね……イシュト。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x18b2"
  ],
  "voice": 310,
  "who": "ルルゥ"
 },
 {
  "id": "s2034:005eb",
  "jp": "あ、いや、ルルゥ、\nそういうわけじゃなくてだなぁ！\n俺は、ルルゥがいて嬉しいぞ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x18e4"
  ],
  "voice": 311,
  "who": "イシュト"
 },
 {
  "id": "s2034:0063e",
  "jp": "うん、ありがとうイシュト。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x18fa"
  ],
  "voice": 312,
  "who": "ルルゥ"
 },
 {
  "id": "s2034:0065d",
  "jp": "……よし、走るぞ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1913"
  ],
  "voice": 313,
  "who": "イシュト"
 },
 {
  "id": "s2034:00674",
  "jp": "ええぇ！？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1948"
  ],
  "voice": 314,
  "who": "ルルゥ"
 },
 {
  "id": "s2034:00683",
  "jp": "ど、どうしたのよ急に……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1961"
  ],
  "voice": 315,
  "who": "エリーシャ"
 },
 {
  "id": "s2034:006a2",
  "jp": "溢れるせいよ……情熱が抑えられ\nないんじゃないですか？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1993"
  ],
  "voice": 316,
  "who": "ピンガー"
 },
 {
  "id": "s2034:006dc",
  "jp": "行くぞ！\nうおおおおおおぉ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x19ac"
  ],
  "voice": 317,
  "who": "イシュト"
 },
 {
  "id": "s2034:006fc",
  "jp": "走り出す青春も素晴らしいが、\nちょっと止まってもらおうか。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x19d2"
  ],
  "voice": 318,
  "who": "ブラックモア"
 },
 {
  "id": "s2034:0073a",
  "jp": "危ない！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x19e8"
  ],
  "voice": 319,
  "who": "エリーシャ"
 },
 {
  "id": "s2034:00747",
  "jp": "グアッ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1a75"
  ],
  "voice": 320,
  "who": "イシュト"
 },
 {
  "id": "s2034:00754",
  "jp": "兄貴！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1a95"
  ],
  "voice": 321,
  "who": "ピンガー"
 },
 {
  "id": "s2034:0075f",
  "jp": "誰！？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1aab"
  ],
  "voice": 322,
  "who": "ルルゥ"
 },
 {
  "id": "s2034:0076a",
  "jp": "“黒い牙”リーダー。ブラックモア\nベルガスの兄貴分だ。よろしく。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1bc7"
  ],
  "voice": 323,
  "who": "ブラックモア"
 },
 {
  "id": "s2034:007ae",
  "jp": "黒い牙！？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1be0"
  ],
  "voice": 324,
  "who": "エリーシャ"
 },
 {
  "id": "s2034:007bd",
  "jp": "エリーシャ、知ってるのか？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1c15"
  ],
  "voice": 325,
  "who": "イシュト"
 },
 {
  "id": "s2034:007dc",
  "jp": "因縁の仲よ……。\nフフ、ちょうどいいわ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1c2b"
  ],
  "voice": 326,
  "who": "エリーシャ"
 },
 {
  "id": "s2034:00808",
  "jp": "ブラックモア！\nアンタの命も今日までよ！\n覚悟しなさい！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1c44"
  ],
  "voice": 327,
  "who": "エリーシャ"
 },
 {
  "id": "s2034:00843",
  "jp": "ベルガス、後は任せた。\n俺は先に遺跡観光でもしてこよう。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1c5e"
  ],
  "voice": 328,
  "who": "ブラックモア"
 },
 {
  "id": "s2034:0087f",
  "jp": "了解！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1c77"
  ],
  "voice": 329,
  "who": "ベルガス"
 },
 {
  "id": "s2034:0088a",
  "jp": "ちょ、ちょっと！\n待ちなさいよ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1cad"
  ],
  "voice": 330,
  "who": "エリーシャ"
 },
 {
  "id": "s2034:008ae",
  "jp": "あん？　なによ。\n俺今忙しいんだけど……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1cc7"
  ],
  "voice": 331,
  "who": "ブラックモア"
 },
 {
  "id": "s2034:008dc",
  "jp": "観光してくるとか言ってた\nでしょうが！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1ce1"
  ],
  "voice": 332,
  "who": "エリーシャ"
 },
 {
  "id": "s2034:00906",
  "jp": "観光するのに忙しい。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1cfb"
  ],
  "voice": 333,
  "who": "ブラックモア"
 },
 {
  "id": "s2034:0091f",
  "jp": "ムキー！\n絶対にアンタをボコボコにして、\n奪われたものを取り返してやるわ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1d15"
  ],
  "voice": 334,
  "who": "エリーシャ"
 },
 {
  "id": "s2034:0096c",
  "jp": "船長を“もの”扱いかよ。\n愛されてねぇなぁ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1d2f"
  ],
  "voice": 335,
  "who": "ブラックモア"
 },
 {
  "id": "s2034:0099c",
  "jp": "俺なんかより、そっちの少年の方が\n今は大事なんじゃないか？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1d36"
  ],
  "voice": 336,
  "who": "ブラックモア"
 },
 {
  "id": "s2034:009da",
  "jp": "イシュト！　大丈夫！？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1d4d"
  ],
  "voice": 337,
  "who": "ルルゥ"
 },
 {
  "id": "s2034:009f5",
  "jp": "なんとかな……。\nにしてもいきなりすぎるだろ！\nクソッ！　皆、行くぞ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1d67"
  ],
  "voice": 338,
  "who": "イシュト"
 },
 {
  "id": "s2034:00a3e",
  "jp": "ここはお前に任せるぞ。\n俺はクリスタルを取る。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1e79"
  ],
  "voice": 339,
  "who": "ブラックモア"
 },
 {
  "id": "s2034:00a70",
  "jp": "任せてください！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1e8f"
  ],
  "voice": 340,
  "who": "ベルガス"
 },
 {
  "id": "s2034:00a85",
  "jp": "あ！　待ちなさい！\n……クッ！　逃げられた！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1ed7"
  ],
  "voice": 341,
  "who": "エリーシャ"
 },
 {
  "id": "s2034:00ab5",
  "jp": "イシュト！　このままじゃ\nクリスタルが取られちゃうよ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1ef2"
  ],
  "voice": 342,
  "who": "ルルゥ"
 },
 {
  "id": "s2034:00aef",
  "jp": "さっさと突破するぞ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1f0b"
  ],
  "voice": 343,
  "who": "イシュト"
 },
 {
  "id": "s2034:00b08",
  "jp": "お前はホンッットに\n俺の邪魔しかしねぇな！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x22f3"
  ],
  "voice": 344,
  "who": "イシュト"
 },
 {
  "id": "s2034:00b36",
  "jp": "るせぇ！\n俺はお前に勝たなきゃ\n死んでも死にきれねぇんだ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x230c"
  ],
  "voice": 345,
  "who": "ベルガス"
 },
 {
  "id": "s2034:00b73",
  "jp": "お前に用はねぇ。\n大人しくイシュトの陰に隠れてな。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x23f6"
  ],
  "who": "ベルガス"
 },
 {
  "id": "s2034:00ba5",
  "jp": "兄貴に勝ちたいなら、\nまずはボクを倒す事ですね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2410"
  ],
  "who": "ピンガー"
 },
 {
  "id": "s2034:00bd5",
  "jp": "アナタ、本当に悪い人なの？\n悪いウィルは感じられないのに……",
  "en": "",
  "status": "todo",
  "slots": [
   "0x24e4"
  ],
  "who": "ルルゥ"
 },
 {
  "id": "s2034:00c11",
  "jp": "な、何だコイツ？\nわけわかんねぇ事言いやがって……",
  "en": "",
  "status": "todo",
  "slots": [
   "0x24fd"
  ],
  "who": "ベルガス"
 },
 {
  "id": "s2034:00c43",
  "jp": "アンタ、ブラックモアがどんな奴か\n知ってて子分やってるわけ……？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x25d1"
  ],
  "who": "エリーシャ"
 },
 {
  "id": "s2034:00c83",
  "jp": "俺は強くなるんだ！\nその為なら、どんな奴の下にでも\nついてやらぁ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x25ea"
  ],
  "who": "ベルガス"
 },
 {
  "id": "s2034:00cc4",
  "jp": "クソッ。何で……。\nなんで勝てねぇんだ……クソォ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x279d"
  ],
  "voice": 346,
  "who": "ベルガス"
 },
 {
  "id": "s2034:00cfa",
  "jp": "イシュト、大丈夫？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2f09"
  ],
  "voice": 347,
  "who": "エリーシャ"
 },
 {
  "id": "s2034:00d11",
  "jp": "あぁ、もう痛みもない。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2f22"
  ],
  "voice": 348,
  "who": "イシュト"
 },
 {
  "id": "s2034:00d2c",
  "jp": "よかったぁ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2f49"
  ],
  "voice": 349,
