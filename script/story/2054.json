   "0x2a58"
  ],
  "voice": 1782,
  "who": "ルルゥ"
 },
 {
  "id": "s2054:0080d",
  "jp": "フフフ、だが心配はいらない。\nすぐにキミよりも強く、\n改造してあげるからさぁ！",
