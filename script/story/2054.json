  "status": "todo",
  "slots": [
   "0x19a7"
  ],
  "voice": 1747,
  "who": "#30"
 },
 {
  "id": "s2054:00156",
  "jp": "へ？　ル、ルルゥ？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x19d5"
  ],
  "voice": 1748,
  "who": "エリーシャ"
 },
 {
  "id": "s2054:0016d",
  "jp": "ルルゥさんなら食料を確保しに\n行きましたけど……。",
