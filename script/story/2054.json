  "status": "todo",
  "slots": [
   "0x1b38"
  ],
  "voice": 1753,
  "who": "ザザーランド"
 },
 {
  "id": "s2054:001f1",
  "jp": "ルルゥにそっくり。\nまさか、ルルゥも双子なの！？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1b6d"
  ],
  "voice": 1754,
  "who": "ロコモコ"
 },
 {
  "id": "s2054:00225",
  "jp": "いや、あの少女、どこか人間らしさ\nが感じられない……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1b86"
  ],
  "voice": 1755,
  "who": "ミネソタ"
 },
 {
  "id": "s2054:0025f",
  "jp": "みんな、大丈夫！？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1bbb"
  ],
  "voice": 1756,
  "who": "ルルゥ"
 },
 {
  "id": "s2054:00276",
  "jp": "オリジナルヲ発見。排除シマス。",
