  "status": "todo",
  "slots": [
   "0x1989"
  ],
  "voice": 1746,
  "who": "エリーシャ"
 },
 {
  "id": "s2054:0011a",
  "jp": "……グロリア海賊団、発見。\nアタックモードニ移行シマス。",
