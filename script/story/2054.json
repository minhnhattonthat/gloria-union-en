[
 {
  "id": "s2054:00028",
  "jp": "ここが土の遺跡“大地の槍”かぁ。\n来た瞬間に名前の由来がわかったな\nオイ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1926"
  ],
  "voice": 1742,
  "who": "イシュト"
 },
 {
  "id": "s2054:00075",
  "jp": "島全体が槍の形になってるん\nですね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x193c"
  ],
  "voice": 1743,
  "who": "ピンガー"
 },
 {
  "id": "s2054:0009d",
  "jp": "ここのどこかに土のクリスタルが\nあるのね……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1952"
  ],
  "voice": 1744,
  "who": "エリーシャ"
 },
 {
  "id": "s2054:000cf",
  "jp": "……目的地ニ到着シマシタ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1970"
  ],
  "voice": 1745,
  "who": "#30"
 },
 {
  "id": "s2054:000ee",
  "jp": "ん？　ルルゥ、なにボーッと\nしてるのよ。",
