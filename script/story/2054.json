  "slots": [
   "0x33b4"
  ],
  "who": "ピンガー"
 },
 {
  "id": "s2054:0090f",
  "jp": "ちょっとちょっと。\nキミの相手は僕じゃないよ。\nルルゥＭｋ－２だよ。",
