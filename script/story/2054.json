  ],
  "who": "アジョー"
 },
 {
  "id": "s2054:00aaa",
  "jp": "アジョー・グラフォー博士。\n噂はかねがね聞いてるよ。\n賛否両論だがね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2d7d"
