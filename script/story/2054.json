  "status": "todo",
  "slots": [
   "0x2b5b"
  ],
  "who": "アジョー"
 },
 {
  "id": "s2054:00952",
  "jp": "こういうのはねぇ、後ろを先に\n倒せばいいって決まってるのよ！",
