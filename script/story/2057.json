[
 {
  "id": "s2057:00028",
  "jp": "遂に見つけたぞグロリア海賊団！！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x20e5"
  ],
  "voice": 2152,
  "who": "カミュル"
 },
 {
  "id": "s2057:0004d",
  "jp": "うおっ！　なんだなんだ？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x217b"
  ],
  "voice": 2153,
  "who": "イシュト"
 },
 {
  "id": "s2057:0006a",
  "jp": "あの旗印、皇国軍だよ！？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2190"
  ],
  "voice": 2154,
  "who": "ロコモコ"
 },
 {
  "id": "s2057:00087",
  "jp": "あの船首で叫んでる人、\nまだ若いっすねぇ。\n新兵の方っすか？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x21a5"
  ],
  "voice": 2155,
  "who": "ラズベリー"
 },
 {
  "id": "s2057:000c6",
  "jp": "だとしたら相当図々しいわね。\n格好の的ってわからないのかしら？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x21ba"
  ],
  "voice": 2156,
  "who": "エリーシャ"
 },
 {
  "id": "s2057:00108",
  "jp": "単身乗り込んでくるとは、愚かな！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x21e2"
  ],
  "voice": 2157,
  "who": "フィービー"
 },
 {
  "id": "s2057:0012d",
  "jp": "面倒くさそうだから、\nもうここから狙撃しちゃえばぁ？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2211"
  ],
  "voice": 2158,
  "who": "パメラ"
 },
 {
  "id": "s2057:00165",
  "jp": "うふふ、殿方はあれぐらい元気が\nあったほうがいいですわ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2240"
  ],
  "voice": 2159,
  "who": "イータ"
 },
 {
  "id": "s2057:001a1",
  "jp": "皇国騎士団カミュルの豪槍！！\nその身に受けてみよおぉぉぉ！！！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x227c"
  ],
  "voice": 2160,
  "who": "カミュル"
 },
 {
  "id": "s2057:001e3",
  "jp": "あうぅ、耳をふさいでも\n聞こえてくるよぅ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2295"
  ],
  "voice": 2161,
  "who": "ルルゥ"
 },
 {
  "id": "s2057:00211",
  "jp": "うるさい人ですねぇ。心なしか\n波が高くなった気がします。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x22aa"
  ],
  "voice": 2162,
  "who": "ピンガー"
 },
 {
  "id": "s2057:0024d",
  "jp": "海の生物達も脅えていなくなって\nしまったぞ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x22d2"
  ],
  "voice": 2163,
  "who": "フィービー"
 },
 {
  "id": "s2057:0027d",
  "jp": "いい迷惑ね。\nさっさと追い払いましょう。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x22f5"
  ],
  "voice": 2164,
  "who": "エリーシャ"
 },
 {
  "id": "s2057:002a9",
  "jp": "ウヲオォォォォォォォ！！！\n総員！！　突撃ィィ！！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x230e"
  ],
  "voice": 2165,
  "who": "カミュル"
 },
 {
  "id": "s2057:002df",
  "jp": "イシュト、あの男、あんなんだが\nなかなかできそうだぞ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x242f"
  ],
  "voice": 2166,
  "who": "ザザーランド"
 },
 {
  "id": "s2057:00319",
  "jp": "突撃！　突撃！　突撃ダァァァ！！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2448"
  ],
  "voice": 2167,
  "who": "カミュル"
 },
 {
  "id": "s2057:0033e",
  "jp": "え？　なに？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2461"
  ],
  "voice": 2168,
  "who": "イシュト"
 },
 {
  "id": "s2057:0034f",
  "jp": "だから、あの男、印象とは違って\n強そうだぞ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x247f"
  ],
  "voice": 2169,
  "who": "ザザーランド"
 },
 {
  "id": "s2057:0037f",
  "jp": "ビアローフォーメーションを組め！\n敵を真正面からねじ伏せろおぉぉ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2498"
  ],
  "voice": 2170,
  "who": "カミュル"
 },
 {
  "id": "s2057:003c5",
  "jp": "え？　ごめん、聞こえない！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x24b1"
  ],
  "voice": 2171,
  "who": "イシュト"
 },
 {
  "id": "s2057:003e4",
  "jp": "……総員突撃！！！\nあの野郎の陣を粉砕しろ！！！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x24cf"
  ],
  "voice": 2172,
  "who": "ザザーランド"
 },
 {
  "id": "s2057:00418",
  "jp": "えッ！　りょ、了解！！\n……やべぇ、怒らせちまったかな？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x24fd"
  ],
  "voice": 2173,
  "who": "イシュト"
 },
 {
  "id": "s2057:00454",
  "jp": "兄貴のせいではないと思います。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x252e"
  ],
  "voice": 2174,
  "who": "ピンガー"
 },
 {
  "id": "s2057:00477",
  "jp": "粉骨！　砕身！　突撃ィ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5b60"
  ],
  "voice": 2175,
  "who": "カミュル"
 },
 {
  "id": "s2057:00494",
  "jp": "粉骨砕身は自分にかける言葉で\nあって、相手を粉々にすること\nじゃないんだぞ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5b75"
  ],
  "voice": 2176,
  "who": "イシュト"
 },
 {
  "id": "s2057:004e3",
  "jp": "ヌヌ！　猫の獣人だと！？\nこのぉ！　愛らしい姿でたぶらかす\n気だなぁ！！？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5c67"
  ],
  "voice": 2177,
  "who": "カミュル"
 },
 {
  "id": "s2057:00530",
  "jp": "なに勝手に顔赤らめてるんですか？\nあいにくボクには想い人がいるんで",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5c7c"
  ],
  "voice": 2178,
  "who": "ピンガー"
 },
 {
  "id": "s2057:00576",
  "jp": "なんと美しきご婦人よ！\nグロリアに攫われたのだな！？\nよぉし！　今助けるぞ！！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5d6e"
  ],
  "voice": 2179,
  "who": "カミュル"
 },
 {
  "id": "s2057:005c7",
  "jp": "うわぁ、あたしが一番苦手で嫌いな\nタイプだ……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5d83"
  ],
  "voice": 2180,
  "who": "エリーシャ"
 },
 {
  "id": "s2057:005fb",
  "jp": "うるさい人は嫌い！　あっち行って",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5e75"
  ],
  "voice": 2181,
  "who": "ルルゥ"
 },
 {
  "id": "s2057:00620",
  "jp": "うるさいのではない！！　\nこれは気合というものだ！！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5e8a"
  ],
  "voice": 2182,
  "who": "カミュル"
 },
 {
  "id": "s2057:00658",
  "jp": "俺ぁ空気の読めない奴が大嫌い\nなんだよ！！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5f83"
  ],
  "voice": 2183,
  "who": "ザザーランド"
 },
 {
  "id": "s2057:00686",
  "jp": "フハハ！　たしかに戦場の空気を\n読めない騎士など二流！！　だが、\nボクは空気の読める一流だ！！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5f98"
  ],
  "voice": 2184,
  "who": "カミュル"
 },
 {
  "id": "s2057:006e7",
  "jp": "……てめぇとはもう一生話さねぇ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5fad"
  ],
  "voice": 2185,
  "who": "ザザーランド"
 },
 {
  "id": "s2057:0070c",
  "jp": "気合があるのはいい事だが、\nあまりうるさすぎるのは\nマナー違反だぞ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x609e"
  ],
  "who": "ミネソタ"
 },
 {
  "id": "s2057:0074f",
  "jp": "なに！？\n戦闘しながら規律を気にする\n余裕があるとは……侮りがたし！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x60b3"
  ],
  "who": "カミュル"
 },
 {
  "id": "s2057:00792",
  "jp": "子供……？\nここは戦場だぞ！？\n早く逃げるんだ！！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x619d"
  ],
  "who": "カミュル"
 },
 {
  "id": "s2057:007c3",
  "jp": "む！\nロコモコはもう子供じゃないよ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x61b2"
  ],
  "who": "ロコモコ"
 },
 {
  "id": "s2057:007e7",
  "jp": "な、なんと禍々しい姿だ！\nこ、この悪魔めぇ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x629c"
  ],
  "who": "カミュル"
 },
 {
  "id": "s2057:00813",
  "jp": "おぉ～！\nは、初めて私を怖がってくれる\n人がいたっす！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x62b1"
  ],
  "who": "ラズベリー"
 },
 {
  "id": "s2057:00848",
  "jp": "ルキア皇国騎士団……！\nシャンティエの騎士の誇りに賭けて\n貴様を倒す！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x639b"
  ],
  "who": "フィービー"
 },
 {
  "id": "s2057:0088d",
  "jp": "シャンティエの騎士か……。\n面白い！　受けて立とう！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x63b0"
  ],
  "who": "カミュル"
 },
 {
  "id": "s2057:008c1",
  "jp": "賞金稼ぎが海賊とは、ミイラ取りが\nミイラとはこの事だな！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x649a"
  ],
  "who": "カミュル"
 },
 {
  "id": "s2057:008f9",
  "jp": "誰のせいでこうなったと\n思っているのですか！\nこの賞金首泥棒！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x64af"
  ],
  "who": "ユグドラ"
 },
 {
  "id": "s2057:00936",
  "jp": "な、なんだ？　この面妖な物体は。\nま、まさか、敵が用意した\n殺戮兵器か！？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x6599"
  ],
  "who": "カミュル"
 },
 {
  "id": "s2057:0097f",
  "jp": "ガーング。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x65ae"
  ],
  "who": "ガング"
 },
 {
  "id": "s2057:0098a",
  "jp": "そんなに気合入れて\n何が楽しいんだわさ。\nもっと気楽にできないのかしらねぇ",
  "en": "",
  "status": "todo",
  "slots": [
   "0x6692"
  ],
  "who": "パメラ"
 },
 {
  "id": "s2057:009d3",
  "jp": "戦場で気を抜くなど、戦士にとって\nあってはならぬ愚行！\n気楽になど、できるものか！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x66a7"
  ],
  "who": "カミュル"
 },
 {
  "id": "s2057:00a24",
  "jp": "なんという、なんという凄まじい力\nなんだ、グロリア海賊団……！\n我等では太刀打ちできない……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x685b"
  ],
  "voice": 2186,
  "who": "カミュル"
 },
 {
  "id": "s2057:00a85",
  "jp": "だが、得る物は確かにあった！\n総員！　拠点に戻り、将軍殿に\n情報を報告するぞ！　撤退！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x6870"
  ],
  "voice": 2187,
  "who": "カミュル"
 },
 {
  "id": "s2057:00ade",
  "jp": "申し訳ありませんメラニー将軍！！\n不肖カミュル！　\n敗北してしまいました！！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x6f29"
  ],
  "voice": 2188,
  "who": "カミュル"
 },
 {
  "id": "s2057:00b2d",
  "jp": "そうか、新米とはいえ、\n貴様ほどの腕を持つ騎士がやられる\nとは、グロリアもやるではないか。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x6f42"
  ],
  "voice": 2189,
  "who": "メラニー"
 },
 {
  "id": "s2057:00b8a",
  "jp": "はい！　それはもう！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x6f58"
  ],
  "voice": 2190,
  "who": "カミュル"
 },
 {
  "id": "s2057:00ba3",
  "jp": "しかし、よもや逃げ帰ってくるとは\n思わなかったぞ、この臆病者め。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x6f71"
  ],
  "voice": 2191,
  "who": "メラニー"
 },
 {
  "id": "s2057:00be7",
  "jp": "なッ！　ボ、ボクは、少しでも\nグロリアの情報をと……！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x6f8a"
  ],
  "voice": 2192,
  "who": "カミュル"
 },
 {
  "id": "s2057:00c21",
  "jp": "そんなものは密偵がやっている！\nなにより敵前逃亡は騎士の恥だ！\n粛清を加える、首を出せ……！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x6fa8"
  ],
  "voice": 2193,
  "who": "メラニー"
 },
 {
  "id": "s2057:00c80",
  "jp": "クッ……！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x6fc1"
  ],
  "voice": 2194,
  "who": "カミュル"
 },
 {
  "id": "s2057:00c8f",
  "jp": "逃がすな！　追え！",
  "en": "Don't let 'em get away! After 'em!",
  "status": "done",
  "slots": [
   "0x7013"
  ],
  "voice": 2195,
  "who": "メラニー"
 },
 {
  "id": "s2057:00ca6",
  "jp": "グロリア海賊団！？\nいい所に来てくれた！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x70d6"
  ],
  "voice": 2196,
  "who": "カミュル"
 },
 {
  "id": "s2057:00cd2",
  "jp": "お前はさっきの……！\nリベンジでもしに来たのか？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x70ef"
  ],
  "voice": 2197,
  "who": "イシュト"
 },
 {
  "id": "s2057:00d06",
  "jp": "そうではない！\nそうではなくて……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x7108"
  ],
  "voice": 2198,
  "who": "カミュル"
 },
 {
  "id": "s2057:00d2e",
  "jp": "……不肖カミュル、一世一代の恥を\n忍んで、貴殿等に助けを求めたい！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x710f"
  ],
  "voice": 2199,
  "who": "カミュル"
 },
 {
  "id": "s2057:00d74",
  "jp": "助け？\nどういうことだ……？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x7125"
  ],
  "voice": 2200,
  "who": "イシュト"
 },
 {
  "id": "s2057:00d94",
  "jp": "気になるな……。\n訳を聞いてやる、話せ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x713b"
  ],
  "voice": 2201,
  "who": "ザザーランド"
 },
 {
  "id": "s2057:00dc0",
  "jp": "はい！\n実は……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x7151"
  ],
  "voice": 2202,
  "who": "カミュル"
 },
 {
  "id": "s2057:00dd6",
  "jp": "――というわけで、\nボクは逃げてきた……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x718e"
  ],
  "voice": 2203,
  "who": "カミュル"
 },
 {
  "id": "s2057:00e04",
  "jp": "なるほど……死んだら元も子も\nないってのになぁ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x71a7"
  ],
  "voice": 2204,
  "who": "ザザーランド"
 },
 {
  "id": "s2057:00e38",
  "jp": "鬼将軍って感じだね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x71c0"
  ],
  "voice": 2205,
  "who": "ロコモコ"
 },
 {
  "id": "s2057:00e51",
  "jp": "所詮皇国の将軍、人の心は無いの\nだろうよ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x71e8"
  ],
  "voice": 2206,
  "who": "フィービー"
 },
 {
  "id": "s2057:00e7f",
  "jp": "敵とはいえ、\n少し同情してしまいますね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x721b"
  ],
  "voice": 2207,
  "who": "ユグドラ"
 },
 {
  "id": "s2057:00eab",
  "jp": "正直、アナタ達に助けを求めた\nところで、どうせ殺されるかと\n思っていましたが……。",
