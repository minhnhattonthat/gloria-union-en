  "status": "todo",
  "slots": [
   "0x3394"
  ],
  "who": "#60"
 },
 {
  "id": "s2071:01bc4",
  "jp": "コイツはたまたま浜に\n打ち上げられていたマンタで作った\nマントだ。",
