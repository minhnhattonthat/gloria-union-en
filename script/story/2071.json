[
 {
  "id": "s2071:00028",
  "jp": "ハァ……ハァ……ハァ……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x216f"
  ],
  "voice": 3244,
  "who": "ガリオレッド"
 },
 {
  "id": "s2071:00047",
  "jp": "大丈夫ですか？\nガリオレッド宰相。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x21fd"
  ],
  "voice": 3245,
  "who": "アシュレイ"
 },
 {
  "id": "s2071:0006d",
  "jp": "私の事などいい！\nそれよりも、お前のことだ……。\nウィルの調子はどうだ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2213"
  ],
  "voice": 3246,
  "who": "ガリオレッド"
 },
 {
  "id": "s2071:000b8",
  "jp": "好調です。\n今までで一番ウィルが高まって\nいますよ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2229"
  ],
  "voice": 3247,
  "who": "アシュレイ"
 },
 {
  "id": "s2071:000ef",
  "jp": "そうか……ククク。\nあと少しだ！　あと少しで……我が\nユーフォリア計画は成功するぞ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x223f"
  ],
  "voice": 3248,
  "who": "ガリオレッド"
 },
 {
  "id": "s2071:00146",
  "jp": "私が世界の王となり！\n真の平和が訪れるのだ！\n恐怖という、平和がなぁ！！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2254"
  ],
  "voice": 3249,
  "who": "ガリオレッド"
 },
 {
  "id": "s2071:00191",
  "jp": "そんな平和、いらねぇんだよ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x226c"
  ],
  "voice": 3250,
  "who": "ザザーランド"
 },
 {
  "id": "s2071:001b2",
  "jp": "敵です……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x23e0"
  ],
  "voice": 3251,
  "who": "アシュレイ"
 },
 {
  "id": "s2071:001c3",
  "jp": "グロリア海賊団……。\nエルマーレ連合国はどうした。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x23f9"
  ],
  "voice": 3252,
  "who": "ガリオレッド"
 },
 {
  "id": "s2071:001f9",
  "jp": "エリーは……死んだよ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2412"
  ],
  "voice": 3253,
  "who": "ザザーランド"
 },
 {
  "id": "s2071:00214",
  "jp": "そうか……。\nやはり、彼女の“犠牲”では、\n世界を平和にはできなかったのだ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x242b"
  ],
  "voice": 3254,
  "who": "ガリオレッド"
 },
 {
  "id": "s2071:00263",
  "jp": "できるさ……エリーの犠牲の上に\n立ち、俺達は、お前らを倒す。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2444"
  ],
  "voice": 3255,
  "who": "ザザーランド"
 },
 {
  "id": "s2071:002a3",
  "jp": "貴様も、平和の為には犠牲が\n必要だとでもいうのか？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x245d"
  ],
  "voice": 3256,
  "who": "ガリオレッド"
 },
 {
  "id": "s2071:002d9",
  "jp": "んなこと言わねぇよ。\n俺は……俺のしたいことをやる。\nただそれだけだ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2476"
  ],
  "voice": 3257,
  "who": "ザザーランド"
 },
 {
  "id": "s2071:00322",
  "jp": "何をしたくて、何をしたか。\nそうだよな、親父。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x248f"
  ],
  "voice": 3258,
  "who": "イシュト"
 },
 {
  "id": "s2071:00354",
  "jp": "あぁ、それが“自由”\nそれこそが、海賊だ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x24a8"
  ],
  "voice": 3259,
  "who": "ザザーランド"
 },
 {
  "id": "s2071:00382",
  "jp": "酷く曖昧で中途半端だな。\nそんなものに“力”は負けない。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x24dd"
  ],
  "voice": 3260,
  "who": "ガリオレッド"
 },
 {
  "id": "s2071:003be",
  "jp": "ガリオレッド宰相、カードを\n渡してください。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x24f6"
  ],
  "voice": 3261,
  "who": "アシュレイ"
 },
 {
  "id": "s2071:003ee",
  "jp": "手筈通りに動け。\nわかったな？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x250f"
  ],
  "voice": 3262,
  "who": "ガリオレッド"
 },
 {
  "id": "s2071:00410",
  "jp": "ハイ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2528"
  ],
  "voice": 3263,
  "who": "アシュレイ"
 },
 {
  "id": "s2071:0041b",
  "jp": "あ、あの人は！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2541"
  ],
  "voice": 3264,
  "who": "ルルゥ"
 },
 {
  "id": "s2071:0042e",
  "jp": "アシュレイ……！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x255a"
  ],
  "voice": 3265,
  "who": "イシュト"
 },
 {
  "id": "s2071:00443",
  "jp": "……ガリオレッド宰相。\n加勢しますか？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2573"
  ],
  "voice": 3266,
  "who": "アシュレイ"
 },
 {
  "id": "s2071:0046d",
  "jp": "アシュレイ……アシュレイ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x258c"
  ],
  "voice": 3267,
  "who": "イシュト"
 },
 {
  "id": "s2071:0048c",
  "jp": "指示に変更はない。\n貴様の様な人形が、自分の考えで\n動こうとするな！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x25c8"
  ],
  "voice": 3268,
  "who": "ガリオレッド"
 },
 {
  "id": "s2071:004d3",
  "jp": "……はい。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x25e1"
  ],
  "voice": 3269,
  "who": "アシュレイ"
 },
 {
  "id": "s2071:004e2",
  "jp": "クソッ、待ちやがれ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x25fa"
  ],
  "voice": 3270,
  "who": "イシュト"
 },
 {
  "id": "s2071:004fb",
  "jp": "急に張り切りだしたな。\nどうした？\nそんなに兄を殺したいのか？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2613"
  ],
  "voice": 3271,
  "who": "ガリオレッド"
 },
 {
  "id": "s2071:0053c",
  "jp": "フン、恩知らずもいいところだな。\nキミを城から逃がしたのは、\n他ならぬアシュレイだというのに。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x261d"
  ],
  "voice": 3272,
  "who": "ガリオレッド"
 },
 {
  "id": "s2071:0059d",
  "jp": "なに……！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x263d"
  ],
  "voice": 3273,
  "who": "イシュト"
 },
 {
  "id": "s2071:005ac",
  "jp": "早く行け人形！\nまた壊されたいのか！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2769"
  ],
  "voice": 3274,
  "who": "ガリオレッド"
 },
 {
  "id": "s2071:005d4",
  "jp": "ッ！\n……わかりました。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2782"
  ],
  "voice": 3275,
  "who": "アシュレイ"
 },
 {
  "id": "s2071:005f0",
  "jp": "あ！　待ちやがれ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x27d6"
  ],
  "voice": 3276,
  "who": "イシュト"
 },
 {
  "id": "s2071:00607",
  "jp": "通りたければ私を倒してみろ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x27ef"
  ],
  "voice": 3277,
  "who": "ガリオレッド"
 },
 {
  "id": "s2071:00628",
  "jp": "ヘ、メギドを持ってない\nお前なんかにゃ負けねぇよ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2808"
  ],
  "voice": 3278,
  "who": "イシュト"
 },
 {
  "id": "s2071:0065e",
  "jp": "メギドがなくなったところで、\n私の力は変わらんよ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2821"
  ],
  "voice": 3279,
  "who": "ガリオレッド"
 },
 {
  "id": "s2071:00694",
  "jp": "お前は、覚えてるか？\n昔の、三人つるんでた時のこと。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3963"
  ],
  "voice": 3280,
  "who": "ザザーランド"
 },
 {
  "id": "s2071:006cc",
  "jp": "憶えているさ。\n穢れなき黄金の記憶だ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x397c"
  ],
  "voice": 3281,
  "who": "ガリオレッド"
 },
 {
  "id": "s2071:006f6",
  "jp": "あんなことがなけりゃあ、\n今頃は行きつけの酒場で\n酒でも飲んでいたのかもな。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3996"
  ],
  "voice": 3282,
  "who": "ザザーランド"
 },
 {
  "id": "s2071:00745",
  "jp": "もしもの話は嫌いじゃないが、\n後悔は好きではない。\nだから、俺は後悔していないよ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x39af"
  ],
  "voice": 3283,
  "who": "ガリオレッド"
 },
 {
  "id": "s2071:0079a",
  "jp": "そうかい。\nなら、決着をつけようぜ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x39c9"
  ],
  "voice": 3284,
  "who": "ザザーランド"
 },
 {
  "id": "s2071:007c2",
  "jp": "あぁ……。\n昔の俺と思えば死ぬぞ。\n全力で来い！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x39e2"
  ],
  "voice": 3285,
  "who": "ガリオレッド"
 },
 {
  "id": "s2071:007f5",
  "jp": "１７年間思い続けたこの意思！\n貴様の様な若輩に、破れるものか！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x353e"
  ],
  "who": "ガリオレッド"
 },
 {
  "id": "s2071:00833",
  "jp": "意思の強さに年月は関係ねぇ！\n俺の意思はお前を超え！\nアシュレイを超え！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3558"
  ],
  "who": "イシュト"
 },
 {
  "id": "s2071:0087a",
  "jp": "親父を超えるんだ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3562"
  ],
  "who": "イシュト"
 },
 {
  "id": "s2071:0088d",
  "jp": "そんなに目をギラつかせて、\nどこが宰相っていうんですか……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3636"
  ],
  "who": "ピンガー"
 },
 {
  "id": "s2071:008c9",
  "jp": "宰相だったら、\n大人しく机にかじりついてて\nくださいよ。まったく。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3648"
  ],
  "who": "ピンガー"
 },
 {
  "id": "s2071:0090a",
  "jp": "この人、闇のカードがなくても\n充分に強い……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x371c"
  ],
  "who": "ルルゥ"
 },
 {
  "id": "s2071:00938",
  "jp": "って、気圧されちゃダメ……！\n私達だって成長したんだもん。\n負けられないよ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3731"
  ],
  "who": "ルルゥ"
 },
 {
  "id": "s2071:00983",
  "jp": "………。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x380c"
  ],
  "who": "エリーシャ"
 },
 {
  "id": "s2071:0098c",
  "jp": "フン、随分と覇気がないな。\n母が死んだ事がそんなに辛いか。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3825"
  ],
  "who": "ガリオレッド"
 },
 {
  "id": "s2071:009c6",
  "jp": "そう、知らないのね。\n残念だわ……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x383f"
  ],
  "who": "エリーシャ"
 },
 {
  "id": "s2071:009ea",
  "jp": "ん？　どういうことだ……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3858"
  ],
  "who": "ガリオレッド"
 },
 {
  "id": "s2071:00a05",
  "jp": "ま、いいわ。\nこれで躊躇いは無くなった……。\nバイバイ、お父さん。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3872"
  ],
  "who": "エリーシャ"
 },
 {
  "id": "s2071:00a46",
  "jp": "力への執着。\nただひたすらに強さを求めた男か。\n恐ろしいものだな……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3abd"
  ],
  "who": "ミネソタ"
 },
 {
  "id": "s2071:00a8b",
  "jp": "何がこうまで、彼を変えて\nしまったというのか……！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3ac7"
  ],
  "who": "ミネソタ"
 },
 {
  "id": "s2071:00abd",
  "jp": "大人の考える事って、わからないよ",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3b8d"
  ],
  "who": "ロコモコ"
 },
 {
  "id": "s2071:00ade",
  "jp": "こんなに自由な人達を、どうして\n支配なんてしようとするの？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3b97"
  ],
  "who": "ロコモコ"
 },
 {
  "id": "s2071:00b18",
  "jp": "ロコモコ、わかんないよ……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3ba1"
  ],
  "who": "ロコモコ"
 },
 {
  "id": "s2071:00b35",
  "jp": "アナタとの戦いも、\nこれで最後っすね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3c67"
  ],
  "who": "ラズベリー"
 },
 {
  "id": "s2071:00b5b",
  "jp": "ま、黄泉の国はいい所っすから、\n安心してくださいね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3c71"
  ],
  "who": "ラズベリー"
 },
 {
  "id": "s2071:00b8f",
  "jp": "ルキア皇国の悪行もここまでだ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3d37"
  ],
  "who": "フィービー"
 },
 {
  "id": "s2071:00bae",
  "jp": "我が槍で貴様を穿ち！\nシャンティエとルキアの百年を\n終わらせてやる！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3d41"
  ],
  "who": "フィービー"
 },
 {
  "id": "s2071:00bf1",
  "jp": "ガガガ、ガンガグガ、グガグ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3e07"
  ],
  "who": "ガング"
 },
 {
  "id": "s2071:00c0e",
  "jp": "私の正義は私の中にある。\n私は私の正義の為、アナタを倒す！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3ed4"
  ],
  "who": "ユグドラ"
 },
 {
  "id": "s2071:00c48",
  "jp": "この世の理は所詮戦だ。\n勝った者が、正義なのだよ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3ee9"
  ],
  "who": "ガリオレッド"
 },
 {
  "id": "s2071:00c7a",
  "jp": "裏切り者が。\n煩わしいが、私が引導を\n渡してやろう……！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3fd3"
  ],
  "who": "ガリオレッド"
 },
 {
  "id": "s2071:00cb1",
  "jp": "裏切りがなんだ！\n僕は本当に強くなる為に\nグロリア海賊団に入ったのだ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3fed"
  ],
  "who": "カミュル"
 },
 {
  "id": "s2071:00cf6",
  "jp": "僕は、負けない！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3ff7"
  ],
  "who": "カミュル"
 },
 {
  "id": "s2071:00d07",
  "jp": "世界を支配なんて、つまらないわ。\nだって、それで全部終わっちゃう\nじゃない。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x40cb"
  ],
  "who": "アンヌ"
 },
 {
  "id": "s2071:00d52",
  "jp": "終わりが無いからこそ、\nこの世は楽しいってものよ？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x40e0"
  ],
  "who": "アンヌ"
 },
 {
  "id": "s2071:00d84",
  "jp": "結局、世界征服なんて企んでる奴は\nみんな死んじゃうのよ？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x41ad"
  ],
  "who": "パメラ"
 },
 {
  "id": "s2071:00dbc",
  "jp": "下手な変革なんて、この世界は\n必要ないんだわさ。\nアンタの行いは、無駄なんだわさ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x41b7"
  ],
  "who": "パメラ"
 },
 {
  "id": "s2071:00e0d",
  "jp": "私、悲しい詩は好きでは\nありませんの。",
  "en": "",
  "status": "todo",
  "slots": [
