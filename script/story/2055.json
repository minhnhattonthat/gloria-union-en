  "status": "todo",
  "slots": [
   "0x413b"
  ],
  "who": "エリーシャ"
 },
 {
  "id": "s2055:01315",
  "jp": "悪いけど、黙っててもらうわよ。\nあたしの双銃でね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4150"
  ],
  "who": "エリーシャ"
 },
 {
  "id": "s2055:01347",
  "jp": "うおおおおおぉぉぉぉ！！！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x423a"
  ],
  "who": "アジョー"
 },
 {
  "id": "s2055:01362",
  "jp": "チッ！\n無闇やたらに突っ込んでくる奴ほど\n怖いもんもねぇぜ。ったく。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4254"
  ],
  "who": "ザザーランド"
 },
 {
  "id": "s2055:013a5",
  "jp": "殺す殺す殺すころおぉぉぉす！！\nクケケケケケ！！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x433e"
  ],
  "who": "アジョー"
 },
 {
  "id": "s2055:013d5",
  "jp": "……自分は、あぁならないように\nしないとな。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4358"
  ],
  "who": "ミネソタ"
 },
 {
  "id": "s2055:01401",
  "jp": "子供とか関係ねぇぇぇ！\n全員解体だぁぁぁ！！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4442"
  ],
  "who": "アジョー"
 },
 {
  "id": "s2055:0142d",
  "jp": "ふえぇ～ん！\n怖いよぉ～！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x445c"
  ],
  "who": "ロコモコ"
 },
 {
  "id": "s2055:01447",
  "jp": "吸血鬼の体ァァアァアハハハハ！！\n興味深い！　興味深いぞぉぉ！！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4546"
  ],
  "who": "アジョー"
 },
 {
  "id": "s2055:01487",
  "jp": "わ、私なんか食べても\n美味しくもなんともないっすよぉ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4560"
  ],
  "who": "ラズベリー"
 },
 {
  "id": "s2055:014bd",
  "jp": "ウンディィィィィネェェ！！\n三枚おろしだぁぁぁああぁぁぁ！！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x464a"
  ],
  "who": "アジョー"
 },
 {
  "id": "s2055:014f9",
  "jp": "なんて不気味な男だ。\n一刻も早く倒さなければ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4664"
  ],
  "who": "フィービー"
 },
 {
  "id": "s2055:01527",
  "jp": "ききき貴様をぉぉ、\nルルゥＭｋ－２のパーーーツに\nしてやるぅぅぅ！！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x474e"
  ],
  "who": "アジョー"
 },
 {
  "id": "s2055:0156a",
  "jp": "ガ、ガガガ！？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4768"
  ],
  "who": "ガング"
 },
 {
  "id": "s2055:01579",
  "jp": "ミイイイイィィィツウウゥゥ\nケエエエェェエェタアァアァ！！！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4bcb"
  ],
  "voice": 1935,
  "who": "アジョー"
 },
 {
  "id": "s2055:015b9",
  "jp": "アジョー・グラフォー！？\nな、なんつー顔だ……。",
