  "status": "todo",
  "slots": [
   "0x4cd6"
  ],
  "voice": 1941,
  "who": "ミネソタ"
 },
 {
  "id": "s2055:0170a",
  "jp": "完全にイカレてやがる。\nこいつぁやっかいだぞ！",
