[
 {
  "id": "s2055:00028",
  "jp": "あら、随分と時間がかかったのね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2331"
  ],
  "voice": 1897,
  "who": "トレイシー"
 },
 {
  "id": "s2055:0004d",
  "jp": "先客、か……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2347"
  ],
  "voice": 1898,
  "who": "イシュト"
 },
 {
  "id": "s2055:00060",
  "jp": "そうよ。\nアナタ達の敵、と言えば\nわかりやすいかしら。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2367"
  ],
  "voice": 1899,
  "who": "トレイシー"
 },
 {
  "id": "s2055:00099",
  "jp": "やっぱり、\n先を越されていたようね……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2380"
  ],
  "voice": 1900,
  "who": "エリーシャ"
 },
 {
  "id": "s2055:000c5",
  "jp": "敵を目の前にして\n武器も構えないとは……\n余裕のつもりか？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x23ac"
  ],
  "voice": 1901,
  "who": "フィービー"
 },
 {
  "id": "s2055:00102",
  "jp": "ウフフ。さて、これは一体\nなんでしょうね？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x23d3"
  ],
  "voice": 1902,
  "who": "トレイシー"
 },
 {
  "id": "s2055:00130",
  "jp": "うひゃあ！　な、なんっすか！？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2449"
  ],
  "voice": 1903,
  "who": "ラズベリー"
 },
 {
  "id": "s2055:00153",
  "jp": "土のカードが……なんで！？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2462"
  ],
  "voice": 1904,
  "who": "ルルゥ"
 },
 {
  "id": "s2055:00172",
  "jp": "皇国軍はいないはずじゃあ……！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2489"
  ],
  "voice": 1905,
  "who": "イシュト"
 },
 {
  "id": "s2055:00195",
  "jp": "兵がいないところを見ると。\nやつらは既に風神の道に向かってる\nってのか……チクショウ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x24a2"
  ],
  "voice": 1906,
  "who": "ザザーランド"
 },
 {
  "id": "s2055:001ee",
  "jp": "そんな……。\nバーストウィングまで……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x24e5"
  ],
  "voice": 1907,
  "who": "ルルゥ"
 },
 {
  "id": "s2055:0021a",
  "jp": "精確ではない探知でもこの差……。\n完全に船の性能差ね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x24fe"
  ],
  "voice": 1908,
  "who": "エリーシャ"
 },
 {
  "id": "s2055:00254",
  "jp": "まさか、ここまで性能に差が\n出てるとはな……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x252c"
  ],
  "voice": 1909,
  "who": "ザザーランド"
 },
 {
  "id": "s2055:00286",
  "jp": "少なくとも、皇国の科学力は\n十年先を行ってるようですね……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2542"
  ],
  "voice": 1910,
  "who": "ピンガー"
 },
 {
  "id": "s2055:002c6",
  "jp": "ウフフ、残念でした。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2562"
  ],
  "voice": 1911,
  "who": "トレイシー"
 },
 {
  "id": "s2055:002df",
  "jp": "で、でも、アナタには、カードを\n使えるだけのウィルはないよ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x257b"
  ],
  "voice": 1912,
  "who": "ルルゥ"
 },
 {
  "id": "s2055:0031f",
  "jp": "そうですね。\n私は、古代ユーフォリア王家の末裔\nではありませんから。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2594"
  ],
  "voice": 1913,
  "who": "トレイシー"
 },
 {
  "id": "s2055:00366",
  "jp": "古代ユーフォリア王家の、末裔？\nなんのことだ？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x25d7"
  ],
  "voice": 1914,
  "who": "イシュト"
 },
 {
  "id": "s2055:00398",
  "jp": "あら、知らないのですか？\n彼らに聞いたとおりですね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x25f0"
  ],
  "voice": 1915,
  "who": "トレイシー"
 },
 {
  "id": "s2055:003d0",
  "jp": "お前……いったい何者だ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2609"
  ],
  "voice": 1916,
  "who": "イシュト"
 },
 {
  "id": "s2055:003ed",
  "jp": "申し遅れました。私の名前は",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2622"
  ],
  "voice": 1917,
  "who": "トレイシー"
 },
 {
  "id": "s2055:0040c",
  "jp": "トレイシー……だよね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x263b"
  ],
  "voice": 1918,
  "who": "ピンガー"
 },
 {
  "id": "s2055:00427",
  "jp": "……あら、憶えていたのね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2651"
  ],
  "voice": 1919,
  "who": "トレイシー"
 },
 {
  "id": "s2055:00446",
  "jp": "憶えてるさ。忘れるわけないだろ。\nアナタは人間のボクを殺した人\nだから……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2678"
  ],
  "voice": 1920,
  "who": "ピンガー"
 },
 {
  "id": "s2055:00495",
  "jp": "え……？\n“人間のボク”って……。\nどういうことよ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2691"
  ],
  "voice": 1921,
  "who": "エリーシャ"
 },
 {
  "id": "s2055:004cc",
  "jp": "そうか、そいつが……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x26aa"
  ],
  "voice": 1922,
  "who": "イシュト"
 },
 {
  "id": "s2055:004e7",
  "jp": "彼女は、\nボクを人から獣人に改造した女……\nトレイシーだ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x26c3"
  ],
  "voice": 1923,
  "who": "ピンガー"
 },
 {
  "id": "s2055:00524",
  "jp": "トレイシー……。聞いた事がある。\n“レバレッジ商団”の\n女団長だったな。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2817"
  ],
  "voice": 1924,
  "who": "ザザーランド"
 },
 {
  "id": "s2055:0056f",
  "jp": "ご存知なのですか？\n私も有名になりましたね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2830"
  ],
  "voice": 1925,
  "who": "トレイシー"
 },
 {
  "id": "s2055:0059f",
  "jp": "そうだな。\n金の為ならどんな商売でもするって\n有名だよ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x284e"
  ],
  "voice": 1926,
  "who": "ザザーランド"
 },
 {
  "id": "s2055:005da",
  "jp": "あら、お厳しいのね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2867"
  ],
  "voice": 1927,
  "who": "トレイシー"
 },
 {
  "id": "s2055:005f3",
  "jp": "そこで待ってろ。\nすぐに倒してやるからな。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2880"
  ],
  "voice": 1928,
  "who": "イシュト"
 },
 {
  "id": "s2055:00621",
  "jp": "兄貴、アイツの相手は\nボクがします！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2899"
  ],
  "voice": 1929,
  "who": "ピンガー"
 },
 {
  "id": "s2055:00649",
  "jp": "そんなに殺気立たれると、ウフフ。\n震えてしまいますわ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x28b2"
  ],
  "voice": 1930,
  "who": "トレイシー"
 },
 {
  "id": "s2055:00683",
  "jp": "アナタがピンガーを拾ったのね。\n面白いものね、運命って。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x29f9"
  ],
  "voice": 1931,
  "who": "トレイシー"
 },
 {
  "id": "s2055:006bf",
  "jp": "拾ったんじゃねぇ、出会ったんだ。\n人の子分を、モノみてぇに\n扱うんじゃねぇよ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2a13"
  ],
  "voice": 1932,
  "who": "イシュト"
 },
 {
  "id": "s2055:00710",
  "jp": "ピンガー。アナタは私の数少ない\n成功例の一つです。\n感謝していますよ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2b05"
  ],
  "voice": 1933,
  "who": "トレイシー"
 },
 {
  "id": "s2055:00759",
  "jp": "アンタはボクが倒す。\n覚悟してくださいね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2b1f"
  ],
  "voice": 1934,
  "who": "ピンガー"
 },
 {
  "id": "s2055:00787",
  "jp": "アナタ、どうしてそんなに\n詳しいの？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2bf3"
  ],
  "who": "ルルゥ"
 },
 {
  "id": "s2055:007ab",
  "jp": "こんなこと、限られた人しか\n知らないはずなのに。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2bfd"
  ],
  "who": "ルルゥ"
 },
 {
  "id": "s2055:007db",
  "jp": "それは、私がその限られた人の\n一人だからですよ。\nウフフ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2c16"
  ],
  "who": "トレイシー"
 },
 {
  "id": "s2055:00814",
  "jp": "ピンガーがアソコまで\n取り乱すなんて。\nアンタ、相当悪い奴みたいね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2cea"
  ],
  "who": "エリーシャ"
 },
 {
  "id": "s2055:00857",
  "jp": "だからどうしたというのですか？\n私は私のしたいようにやった。\nそれだけです。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2d03"
  ],
  "who": "トレイシー"
 },
 {
  "id": "s2055:008a2",
  "jp": "有名商団の団長さんが、こんな所で\nどんな商売をしようってんだ？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2dd7"
  ],
  "who": "ザザーランド"
 },
 {
  "id": "s2055:008e0",
  "jp": "今回はただの私欲ですよ。\nお金を抜きにしても、これほど\n美味しい話はありませんでしたから",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2df0"
  ],
  "who": "トレイシー"
 },
 {
  "id": "s2055:00937",
  "jp": "レバレッジ商団の行動は前々から\n商人として逸脱しているという事で\n話題になっていたが。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2ec4"
  ],
  "who": "ミネソタ"
 },
 {
  "id": "s2055:0098c",
  "jp": "まさか、こんなことになるとはな。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2ece"
  ],
  "who": "ミネソタ"
 },
 {
  "id": "s2055:009ad",
  "jp": "レバレッジ商団はあくまで\n私の目的を叶える為の外殻でしか\nありませんから。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2ee7"
  ],
  "who": "トレイシー"
 },
 {
  "id": "s2055:009f6",
  "jp": "考古学者が世間の噂に左右されては\nいけませんよ？\nウフフ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2ef1"
  ],
  "who": "トレイシー"
 },
 {
  "id": "s2055:00a2f",
  "jp": "いつかの恨み！\nここで晴らしてやるんだから！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2fc5"
  ],
  "who": "ロコモコ"
 },
 {
  "id": "s2055:00a5b",
  "jp": "用があったのはアナタの\n探知能力だけなので、アナタはもう\n用済みです。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2fde"
  ],
  "who": "トレイシー"
 },
 {
  "id": "s2055:00aa0",
  "jp": "退却を願いたいですね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2fe8"
  ],
  "who": "トレイシー"
 },
 {
  "id": "s2055:00ab7",
  "jp": "あくどい商売もいいっすけど。\nあまりやりすぎると、罪人課の\n世話になってしまいますよ？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x30bc"
  ],
  "who": "ラズベリー"
 },
 {
  "id": "s2055:00b0c",
  "jp": "人は生まれながらに罪を背負う\n生き物です。\nどうしようもありませんよ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x30d5"
  ],
  "who": "トレイシー"
 },
 {
  "id": "s2055:00b51",
  "jp": "ウンディーネ。\n確か、アナタ方の血は万病に効くと\n云われていますね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x31bf"
  ],
  "who": "トレイシー"
 },
 {
  "id": "s2055:00b94",
  "jp": "本当なのですか？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x31c6"
  ],
  "who": "トレイシー"
 },
 {
  "id": "s2055:00ba5",
  "jp": "それは、ルキア皇国が\nシャンティエを滅ぼす為に流した\nデマだ。本気にすることはない。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x31e0"
  ],
  "who": "フィービー"
 },
 {
  "id": "s2055:00bf8",
  "jp": "そうですか。\nフフ、残念。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x31f9"
  ],
  "who": "トレイシー"
 },
 {
  "id": "s2055:00c12",
  "jp": "古代遺跡の守護者、ですか。\nフフフ、いい商品になりそう\nですね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x32e3"
  ],
  "who": "トレイシー"
 },
 {
  "id": "s2055:00c51",
  "jp": "ガ、ガガガーー！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x32fd"
  ],
  "who": "ガング"
 },
 {
  "id": "s2055:00c62",
  "jp": "悪徳商人に強欲海賊か。\nヘッ、似たもの姉妹だな！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x33d8"
  ],
  "who": "イシュト"
 },
 {
  "id": "s2055:00c92",
  "jp": "強欲である事が海賊の定義なのよ。\nま、お子ちゃまにはわからない\nでしょうけどね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x33f1"
  ],
  "who": "アンヌ"
 },
 {
  "id": "s2055:00ce1",
  "jp": "最初見た時からまさかとは\n思ってたけど。\nへぇ、アナタが……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x34db"
  ],
  "who": "アンヌ"
 },
 {
  "id": "s2055:00d1e",
  "jp": "なんですか、人の顔をジロジロと。\n気持ち悪いですね……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x34f5"
  ],
  "who": "ピンガー"
 },
 {
  "id": "s2055:00d56",
  "jp": "私ってば、\nやっぱりツイてるのかしら？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x35e6"
  ],
  "who": "アンヌ"
 },
 {
  "id": "s2055:00d7c",
  "jp": "こんな所に、一攫千金があるなんて",
  "en": "",
  "status": "todo",
  "slots": [
   "0x35fb"
  ],
  "who": "アンヌ"
 },
 {
  "id": "s2055:00d9d",
  "jp": "もう捕まるのは嫌だし、\n捕まる気もないんだから！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3615"
  ],
  "who": "ルルゥ"
 },
 {
  "id": "s2055:00dcd",
  "jp": "アンタって、そうやって毎日雇い主\n変えてるわけ？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x36fe"
  ],
  "who": "エリーシャ"
 },
 {
  "id": "s2055:00dfd",
  "jp": "呆れた尻軽女ね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3713"
  ],
  "who": "エリーシャ"
 },
 {
  "id": "s2055:00e0e",
  "jp": "そう……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x372c"
  ],
  "who": "アンヌ"
 },
 {
  "id": "s2055:00e19",
  "jp": "じゃあアナタは、どっしりとした\n重～～～いお尻ってわけね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3733"
  ],
  "who": "アンヌ"
 },
 {
  "id": "s2055:00e53",
  "jp": "なんですってぇ！？\nキィー！　もう許さないんだから！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x374d"
  ],
  "who": "エリーシャ"
 },
 {
  "id": "s2055:00e87",
  "jp": "なんだ？\nこの前は逃げ出したってのに、\n随分とやる気じゃねぇか。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3836"
  ],
  "who": "ザザーランド"
 },
 {
  "id": "s2055:00ec6",
  "jp": "これだけの人数差よ？\n気持ちも大きくなるってものだわ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x384f"
  ],
  "who": "アンヌ"
 },
 {
  "id": "s2055:00efc",
  "jp": "細切れにしてあげるわ。\n大海賊さん？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3864"
  ],
  "who": "アンヌ"
 },
 {
  "id": "s2055:00f20",
  "jp": "約束の時間に遅れるとは、\n何たるマナー違反だ！\n粛清してくれる！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x393f"
  ],
  "who": "ミネソタ"
 },
 {
  "id": "s2055:00f5f",
  "jp": "な、なんなのこの人。\nスゴイ気迫なんだけど。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3958"
  ],
  "who": "アンヌ"
 },
 {
  "id": "s2055:00f8b",
  "jp": "っていうか、怒る所ってそこ？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3962"
  ],
  "who": "アンヌ"
 },
 {
  "id": "s2055:00fa8",
  "jp": "お姉ちゃんもあの商人の仲間なの？\nじゃあ、ロコモコの敵だねっ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3a36"
  ],
  "who": "ロコモコ"
 },
 {
  "id": "s2055:00fe6",
  "jp": "あらあら、小さい子ねぇ。\n遊んでほしいの？　ウフフ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3a4f"
  ],
  "who": "アンヌ"
 },
 {
  "id": "s2055:0101a",
  "jp": "なに？　その羽。\nイカしたデザインね。\nちょっと触らせてよ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3b39"
  ],
  "who": "アンヌ"
 },
 {
  "id": "s2055:01055",
  "jp": "これは私が初給料で買った\n黄泉最新モデルのウィングっす！\nそう易々と触らせはしないっす！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3b53"
  ],
  "who": "ラズベリー"
 },
 {
  "id": "s2055:010ac",
  "jp": "いいわよねぇ。ウンディーネって。\n永遠にその姿のままなんて、\nズルイと思わない？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3c3d"
  ],
  "who": "アンヌ"
 },
 {
  "id": "s2055:010fb",
  "jp": "この体はいつまでも国の力と\nなれる為に若さを保っているのだ！\nそんな不純な目で見るな！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3c57"
  ],
  "who": "フィービー"
 },
 {
  "id": "s2055:01150",
  "jp": "なに？　この機械。\n珍しいわね……。\nまさか、お宝！？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3d41"
  ],
  "who": "アンヌ"
 },
 {
  "id": "s2055:01185",
  "jp": "ガ、ガガンガガン！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3d5b"
  ],
  "who": "ガング"
 },
 {
  "id": "s2055:01198",
  "jp": "ここここののうらうら恨み！\n晴らさでおおおおおくべきか！！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3e45"
  ],
  "who": "アジョー"
 },
 {
  "id": "s2055:011d2",
  "jp": "うお、すげぇ気迫だな。\n面白ぇ、受けて立つぜ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3e5f"
  ],
  "who": "イシュト"
 },
 {
  "id": "s2055:01200",
  "jp": "うがああああぁぁぁ！！！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3f49"
  ],
  "who": "アジョー"
 },
 {
  "id": "s2055:01219",
  "jp": "ものすごい咆哮ですね。\nボクよりも獣っぽいんじゃ\nないですか？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3f63"
  ],
  "who": "ピンガー"
 },
 {
  "id": "s2055:01256",
  "jp": "バラバラバラバラしてやる！！\n貴様のかかか体だだ！　隅々まで\n研究しつくしてやるぁぁあ！！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x404d"
  ],
  "who": "アジョー"
 },
 {
  "id": "s2055:012af",
  "jp": "うぅ、スゴイ禍々しいウィル。\n思わず体が竦んじゃうよ……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4067"
  ],
  "who": "ルルゥ"
 },
 {
  "id": "s2055:012e9",
  "jp": "まったく、厄介な男に目を\nつけられたものね。",
