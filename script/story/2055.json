  "status": "todo",
  "slots": [
   "0x5a68"
  ],
  "voice": 1953,
  "who": "ザザーランド"
 },
 {
  "id": "s2055:01a02",
  "jp": "土のカードも持ち逃げされた\nみたい……。",
