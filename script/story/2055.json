  "status": "todo",
  "slots": [
   "0x5a4f"
  ],
  "voice": 1952,
  "who": "ピンガー"
 },
 {
  "id": "s2055:019d2",
  "jp": "チッ、あらかじめ船を\n用意していたのか……。",
