  "status": "todo",
  "slots": [
   "0x5c1e"
  ],
  "voice": 1968,
  "who": "エリーシャ"
 },
 {
  "id": "s2055:01d89",
  "jp": "あぁ。記録も残っている。\nつい最近のがな。",
