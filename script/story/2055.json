  "status": "todo",
  "slots": [
   "0x4cfb"
  ],
  "voice": 1942,
  "who": "ザザーランド"
 },
 {
  "id": "s2055:0173c",
  "jp": "ブッコロス！　ブッコロシテ\nヤルアァァァァァ！！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4d14"
  ],
  "voice": 1943,
  "who": "アジョー"
 },
 {
  "id": "s2055:01770",
  "jp": "おまたせぇ。ちょっと潮風に\n当たってたら遅れちゃった。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4ea0"
  ],
  "voice": 1944,
  "who": "アンヌ"
 },
 {
  "id": "s2055:017aa",
  "jp": "潮風は体に毒ですよ。\n姉さんを心配させないで下さい。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4eb6"
  ],
  "voice": 1945,
  "who": "トレイシー"
 },
 {
  "id": "s2055:017e2",
  "jp": "アンヌ・コーマック！？\nってかあんたら姉妹だったの！？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4ed4"
  ],
  "voice": 1946,
  "who": "エリーシャ"
 },
 {
  "id": "s2055:0181c",
  "jp": "これ以上時間を費やしている暇は\nないな。早く研究所に戻って\n修理を行わなければ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x486e",
   "0x502c"
  ],
  "voice": 1982,
  "who": "アジョー"
 },
 {
  "id": "s2055:0186f",
  "jp": "まぁ、こんなものでしょうね。\nこれ以上やっても無駄だし、\n帰らせてもらうわよ、姉さん。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4927",
   "0x50e1"
  ],
  "voice": 1981,
  "who": "アンヌ"
 },
 {
  "id": "s2055:018c8",
  "jp": "古代ユーフォリア王家ってのは\nなんだ！　言え！！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5180"
  ],
  "voice": 1947,
  "who": "イシュト"
 },
 {
  "id": "s2055:018fc",
  "jp": "それを教えるのは、アナタが\nもう少し強くなってからです。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5199"
  ],
  "voice": 1948,
  "who": "トレイシー"
 },
 {
  "id": "s2055:01938",
  "jp": "な！　こいつ、怪我はどうした！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x51b2"
  ],
  "voice": 1949,
  "who": "イシュト"
 },
 {
  "id": "s2055:0195b",
  "jp": "私は商人ですよ？\nアイテムなんていくらでも\nありますよ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x51cb"
  ],
  "voice": 1950,
  "who": "トレイシー"
 },
 {
  "id": "s2055:01996",
  "jp": "では、そろそろお暇しましょうか。",
