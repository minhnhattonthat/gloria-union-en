  "status": "todo",
  "slots": [
   "0x4be4"
  ],
  "voice": 1936,
  "who": "イシュト"
 },
 {
  "id": "s2055:015ed",
  "jp": "この世の全ての憎悪を\n体現したような顔つきだ。",
