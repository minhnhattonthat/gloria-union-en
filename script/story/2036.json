  "slots": [
   "0x42fe"
  ],
  "voice": 552,
  "who": "イシュト"
 },
 {
  "id": "s2036:0279e",
  "jp": "さぁ、早くエリーシャさんの\n用事をすませましょう。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4314"
  ],
  "voice": 553,
  "who": "ピンガー"
 },
 {
  "id": "s2036:027d4",
  "jp": "エリーシャ。寄る所って、どこ？",
