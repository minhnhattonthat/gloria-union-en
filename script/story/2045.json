[
 {
  "id": "s2045:00028",
  "jp": "ここが……ボルドレーゼ島か。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x16f4"
  ],
  "voice": 1203,
  "who": "イシュト"
 },
 {
  "id": "s2045:00049",
  "jp": "どこを見てもタル、タル、タル。\nタルって言葉の意味がわからなく\nなるぐらいにタルだらけですね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x170a"
  ],
  "voice": 1204,
  "who": "ピンガー"
 },
 {
  "id": "s2045:000aa",
  "jp": "ここのどこかに、お宝があるのね？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x177d"
  ],
  "voice": 1205,
  "who": "エリーシャ"
 },
 {
  "id": "s2045:000cf",
  "jp": "ボルドレーゼ島の民は、タルに物を\n保管する習わしがあったらしい。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1796"
  ],
  "voice": 1206,
  "who": "ザザーランド"
 },
 {
  "id": "s2045:00113",
  "jp": "なるほど、じゃあそのタルの中に\nお宝は眠っているのね？\nって、こんなことしてていいの？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x17af"
  ],
  "voice": 1207,
  "who": "エリーシャ"
 },
 {
  "id": "s2045:0016c",
  "jp": "このまま行くと金が尽きる。\nクリスタル探しも重要だが、\n金も重要ってことだ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x17c5"
  ],
  "voice": 1208,
  "who": "ザザーランド"
 },
 {
  "id": "s2045:001bb",
  "jp": "それなら、早く見つけようぜ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x17db"
  ],
  "voice": 1209,
  "who": "イシュト"
 },
 {
  "id": "s2045:001dc",
  "jp": "どれに入ってるの？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1810"
  ],
  "voice": 1210,
  "who": "ルルゥ"
 },
 {
  "id": "s2045:001f3",
  "jp": "それは知らん",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1829"
  ],
  "voice": 1211,
  "who": "ザザーランド"
 },
 {
  "id": "s2045:00204",
  "jp": "なんともまぁ、無責任な。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1857"
  ],
  "voice": 1212,
  "who": "ミネソタ"
 },
 {
  "id": "s2045:00221",
  "jp": "適当っすねぇ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1883"
  ],
  "voice": 1213,
  "who": "ラズベリー"
 },
 {
  "id": "s2045:00234",
  "jp": "船長ならば、ビシッと決めて\nもらいたいな。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x18b6"
  ],
  "voice": 1214,
  "who": "フィービー"
 },
 {
  "id": "s2045:00262",
  "jp": "おやじ、かっこ悪い。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x18e9"
  ],
  "voice": 1215,
  "who": "ロコモコ"
 },
 {
  "id": "s2045:0027b",
  "jp": "あーうっせぇな！\n噂程度に聞いたんだから、\nしょうがねぇだろ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1909"
  ],
  "voice": 1216,
  "who": "ザザーランド"
 },
 {
  "id": "s2045:002bc",
  "jp": "どうやら、手当たり次第に探すしか\nなさそうね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1922"
  ],
  "voice": 1217,
  "who": "エリーシャ"
 },
 {
  "id": "s2045:002ee",
  "jp": "うへ～。この数をかよ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1938"
  ],
  "voice": 1218,
  "who": "イシュト"
 },
 {
  "id": "s2045:00309",
  "jp": "うっさい！　つべこべ言わずに\nさっさと動く！　撃つわよ！？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1958"
  ],
  "voice": 1219,
  "who": "エリーシャ"
 },
 {
  "id": "s2045:00347",
  "jp": "わかったよ！　\nこのカルシウム不足！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1971"
  ],
  "voice": 1220,
  "who": "イシュト"
 },
 {
  "id": "s2045:0036f",
  "jp": "よぉっしゃあ！　まずは一個目！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1978"
  ],
  "voice": 1221,
  "who": "イシュト"
 },
 {
  "id": "s2045:00392",
  "jp": "ケー！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1b08"
  ],
  "voice": 1222,
  "who": "#50"
 },
 {
  "id": "s2045:0039d",
  "jp": "ぎょええええええええ！！\nな、なんだこいつ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1b28"
  ],
  "voice": 1223,
  "who": "イシュト"
 },
 {
  "id": "s2045:003cd",
  "jp": "恐らく、ボルドレーゼの民だろうな",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1b43"
  ],
  "voice": 1224,
  "who": "ミネソタ"
 },
 {
  "id": "s2045:003f2",
  "jp": "なるほど、棺桶もタルってわけか。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1b5c"
  ],
  "voice": 1225,
  "who": "ザザーランド"
 },
 {
  "id": "s2045:00417",
  "jp": "何でも入れればいいってもんでも\nないでしょうに……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1b75"
  ],
  "voice": 1226,
  "who": "エリーシャ"
 },
 {
  "id": "s2045:0044f",
  "jp": "ぎょえええ！　だって、ぷふ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1b8e"
  ],
  "voice": 1227,
  "who": "ルルゥ"
 },
 {
  "id": "s2045:00470",
  "jp": "笑わないでくれルルゥ、ただでさえ\n心にヒビがはいってるんだから。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1bd1"
  ],
  "voice": 1228,
  "who": "イシュト"
 },
 {
  "id": "s2045:004b4",
  "jp": "ケー！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1bea"
  ],
  "voice": 1229,
  "who": "#50"
 },
 {
  "id": "s2045:004bf",
  "jp": "ケー！　じゃねぇ！　こんの野郎ぉ\nもう一度棺桶に突っ込んでやる！！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1c03"
  ],
  "voice": 1230,
  "who": "イシュト"
 },
 {
  "id": "s2045:00505",
  "jp": "なに？　今の奇妙な叫び声は……！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1cf0"
  ],
  "voice": 1231,
  "who": "アンヌ"
 },
 {
  "id": "s2045:0052a",
  "jp": "お宝だと思って開けたら骸骨に\n襲われるし……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1d05"
  ],
  "voice": 1232,
  "who": "アンヌ"
 },
 {
  "id": "s2045:0055c",
  "jp": "いくらアタシでも……怖いものは\nあるのよぉ……グスン。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1d0c"
  ],
  "voice": 1233,
  "who": "アンヌ"
 },
 {
  "id": "s2045:00596",
  "jp": "あ！　お前はいつぞやの！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1d25"
  ],
  "voice": 1234,
  "who": "イシュト"
 },
 {
  "id": "s2045:005b3",
  "jp": "あら、お久しぶり。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1d4c"
  ],
  "voice": 1235,
  "who": "アンヌ"
 },
 {
  "id": "s2045:005ca",
  "jp": "あなたもお宝探しですか？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1d67"
  ],
  "voice": 1236,
  "who": "ピンガー"
 },
 {
  "id": "s2045:005e7",
  "jp": "えぇ。そうよ。でも、骸骨が出て\nきたり、奇妙な叫び声が聞こえたり\nで、正直うんざりしてるわ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1d7d"
  ],
  "voice": 1237,
  "who": "アンヌ"
 },
 {
  "id": "s2045:00646",
  "jp": "奇妙な叫び声……フ、フフフ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1da9"
  ],
  "voice": 1238,
  "who": "ルルゥ"
 },
 {
  "id": "s2045:00667",
  "jp": "ルルゥ。思い出し笑いはいいが、\n俺の聞こえないところで笑ってくれ",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1dc2"
  ],
  "voice": 1239,
  "who": "イシュト"
 },
 {
  "id": "s2045:006ab",
  "jp": "怖いならさっさと出て行けば？\nま、あたし達はお宝もらうけど。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1dee"
  ],
  "voice": 1240,
  "who": "エリーシャ"
 },
 {
  "id": "s2045:006eb",
  "jp": "あ、今の。ちょっとカチーンと\nきちゃったわよ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1e07"
  ],
  "voice": 1241,
  "who": "アンヌ"
 },
 {
  "id": "s2045:0071d",
  "jp": "だったらなんだってのよ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1e25"
  ],
  "voice": 1242,
  "who": "エリーシャ"
 },
 {
  "id": "s2045:0073a",
  "jp": "勝負よ！　どちらが先にお宝を\n見つけられるか！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1e3e"
  ],
  "voice": 1243,
  "who": "アンヌ"
 },
 {
  "id": "s2045:0076c",
  "jp": "上等よ！　負けた方は勝った方の\n傘下に入るでいいわね！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1e5c"
  ],
  "voice": 1244,
  "who": "エリーシャ"
 },
 {
  "id": "s2045:007a6",
  "jp": "お、おいエリーシャそんな勝手に。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1e75"
  ],
  "voice": 1245,
  "who": "イシュト"
 },
 {
  "id": "s2045:007cb",
  "jp": "あ゛ぁん？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1ea1"
  ],
  "voice": 1246,
  "who": "エリーシャ"
 },
 {
  "id": "s2045:007da",
  "jp": "なんでもないです……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1eba"
  ],
  "voice": 1247,
  "who": "イシュト"
 },
 {
  "id": "s2045:007f5",
  "jp": "フフ、あのグロリア海賊団がアタシ\nの傘下に……面白いじゃない。\nやってやるわ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1ed3"
  ],
  "voice": 1248,
  "who": "アンヌ"
 },
 {
  "id": "s2045:00846",
  "jp": "後でたっぷり後悔させてあげるわ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1ef1"
  ],
  "voice": 1249,
  "who": "エリーシャ"
 },
 {
  "id": "s2045:0086b",
  "jp": "アーッハッハ！　どうやらあたしの\n勝ちのようね！　大人しく傘下に\nなりなさい！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x535e"
  ],
  "voice": 1250,
  "who": "エリーシャ"
 },
 {
  "id": "s2045:008bc",
  "jp": "男に二言はないけど、\n女に二言はあるのよ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x537b"
  ],
  "voice": 1251,
  "who": "アンヌ"
 },
 {
  "id": "s2045:008ea",
  "jp": "あ！　逃げた！　卑怯者ー！！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5a61"
  ],
  "voice": 1252,
  "who": "エリーシャ"
 },
 {
  "id": "s2045:0090b",
  "jp": "……追いますか？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5a7a"
  ],
  "voice": 1253,
  "who": "ピンガー"
 },
 {
  "id": "s2045:00920",
  "jp": "アホか。ほっとけ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5a90"
  ],
  "voice": 1254,
  "who": "イシュト"
 },
 {
  "id": "s2045:00937",
  "jp": "ですよね～。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5aa6"
  ],
  "voice": 1255,
  "who": "ピンガー"
 },
 {
  "id": "s2045:00948",
  "jp": "くぅ～、いつかあの傲慢な頭を\n下げさせてやるわ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5abf"
  ],
  "voice": 1256,
  "who": "エリーシャ"
 },
 {
  "id": "s2045:0097c",
  "jp": "私は“海の平和を守る会”の一人。\nアナタの輝く瞳に平和を見ました。\nよってこれを差し上げます！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x340f"
  ],
  "who": "#70"
 },
 {
  "id": "s2045:009d9",
  "jp": "平和はいつでも僕らの胸に！\n海の平和を守る会をよろしく！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3468"
  ],
  "who": "#70"
 },
 {
  "id": "s2045:00a11",
  "jp": "平和はいつでも僕らの胸に！\n海の平和を守る会をよろしく！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3480"
  ],
  "who": "#70"
 },
 {
  "id": "s2045:00a49",
  "jp": "戦闘というのは、何も力だけが\nモノを言うわけではない。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3514"
  ],
  "who": "#62"
 },
 {
  "id": "s2045:00a7f",
  "jp": "戦闘陣形や用兵術を駆使すれば、\n相手がルキア皇国だろうが\n問題なく撃破することができる。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x351b"
  ],
  "who": "#62"
 },
 {
  "id": "s2045:00ad6",
  "jp": "この本にはそのことが\n事細かに載っている。\n参考にしたまえ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3593"
  ],
  "who": "#62"
 },
 {
  "id": "s2045:00b11",
  "jp": "戦場を蹂躙する猛将もいいが、\n戦場を掻き回す策士というのも\nいいものだろう？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x35ab"
  ],
  "who": "#62"
 },
 {
  "id": "s2045:00b5c",
  "jp": "ん～、このコート。\nなんか嫌な感じがするなぁ。\nこう、違和感っていうの？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x363f"
  ],
  "who": "#61"
 },
 {
  "id": "s2045:00ba3",
  "jp": "あ、丁度いい所に来たねアンタ。\nどうだいこのコート。\n格安で買わないかい？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3646"
  ],
  "who": "#61"
 },
 {
  "id": "s2045:00bec",
  "jp": "お、気前がいいねぇ。\n毎度あり！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x364d"
  ],
  "who": "#61"
 },
 {
  "id": "s2045:00c0c",
  "jp": "あ、なんだか清々しくなった\n気分だな。\n本当になんだったんだあのコート。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x36bc"
  ],
  "who": "#61"
 },
 {
  "id": "s2045:00c53",
  "jp": "……あれ？\nそもそも俺、あんな商品調達\nしたか……？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x36d4"
  ],
  "who": "#61"
 },
 {
  "id": "s2045:00c86",
  "jp": "あら、あなた。\n中々いい体してるわね！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3783"
  ],
  "who": "#72"
 },
 {
  "id": "s2045:00cac",
  "jp": "あなたなら、\nきっと世界が狙えるわ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x378a"
  ],
  "who": "#72"
 },
 {
  "id": "s2045:00cd0",
  "jp": "これは餞別よ！\nお互い、頑張りましょう！\n世界一のスイマーを目指すのよ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x37f9"
  ],
  "who": "#72"
 },
 {
  "id": "s2045:00d17",
  "jp": "あぁ～男の人はいいわねぇ。\n筋肉がつきやすいから\nタイムも早いわ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x381f"
  ],
  "who": "#72"
 },
 {
  "id": "s2045:00d58",
  "jp": "……は！　いけないいけない！\n弱気になった時点で私の負けよ！\n頑張れ、私！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3826"
  ],
  "who": "#72"
 },
 {
  "id": "s2045:00da1",
  "jp": "私は、世界一のスイマーに\nなるんだから！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x382d"
  ],
  "who": "#72"
 },
 {
  "id": "s2045:00dc9",
  "jp": "そうと決まったら特訓よぉ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3845"
  ],
  "who": "#72"
 },
 {
  "id": "s2045:00de4",
  "jp": "驚いたじゃろ？\nここまで多くの樽を見て。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x38dc"
  ],
  "who": "#68"
 },
 {
  "id": "s2045:00e0c",
  "jp": "この島は、樽の原料となる\nオーク木が大量に生えてての。\nそれはもう大量だったんじゃ。",
