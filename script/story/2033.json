[
 {
  "id": "s2033:00028",
  "jp": "最初に向かうのは\n“海王神殿”だよ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x12f1"
  ],
  "voice": 211,
  "who": "ルルゥ"
 },
 {
  "id": "s2033:00050",
  "jp": "おぉ、偶然ですね。\nボク達もそこを目指して\nいたんですよ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1307"
  ],
  "voice": 212,
  "who": "ピンガー"
 },
 {
  "id": "s2033:0008d",
  "jp": "ほぉら！\n俺の方が正しかったじゃねぇか。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1324"
  ],
  "voice": 213,
  "who": "イシュト"
 },
 {
  "id": "s2033:000b9",
  "jp": "はいはい、すごいですねー。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x133a"
  ],
  "voice": 214,
  "who": "ピンガー"
 },
 {
  "id": "s2033:000d8",
  "jp": "こんの……ハァ、もういい。\nルルゥ、方角を教えてくれ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1353"
  ],
  "voice": 215,
  "who": "イシュト"
 },
 {
  "id": "s2033:00112",
  "jp": "あっち！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x136c"
  ],
  "voice": 216,
  "who": "ルルゥ"
 },
 {
  "id": "s2033:0011f",
  "jp": "漠然としてますねー。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1389"
  ],
  "voice": 217,
  "who": "ピンガー"
 },
 {
  "id": "s2033:00138",
  "jp": "海を越えるのかぁ。\nよし、そんじゃあ船に乗り込もう。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x13a5"
  ],
  "voice": 218,
  "who": "イシュト"
 },
 {
  "id": "s2033:00170",
  "jp": "あの筏なら、もう海の底よん。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x13ba"
  ],
  "voice": 219,
  "who": "アンヌ"
 },
 {
  "id": "s2033:00191",
  "jp": "はぁ？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1596"
  ],
  "voice": 220,
  "who": "イシュト"
 },
 {
  "id": "s2033:0019c",
  "jp": "あぁ！\n兄貴、船が海の藻屑に！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x15c0"
  ],
  "voice": 221,
  "who": "ピンガー"
 },
 {
  "id": "s2033:001be",
  "jp": "え？　あれって丸太じゃ……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1618"
  ],
  "voice": 222,
  "who": "ルルゥ"
 },
 {
  "id": "s2033:001df",
  "jp": "テメェ！　俺のお手製海賊船を！\n何者だ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1631"
  ],
  "voice": 223,
  "who": "イシュト"
 },
 {
  "id": "s2033:0020b",
  "jp": "“シャルム海賊団”船長。\nアンヌ・コーマック！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1658"
  ],
  "voice": 224,
  "who": "アンヌ"
 },
 {
  "id": "s2033:0023d",
  "jp": "イシュト君。\nアナタの首、頂くわね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x166d"
  ],
  "voice": 225,
  "who": "アンヌ"
 },
 {
  "id": "s2033:00265",
  "jp": "な！　も、もしかして、指名手配を\n見て来たのか！？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1686"
  ],
  "voice": 226,
  "who": "イシュト"
 },
 {
  "id": "s2033:0029b",
  "jp": "そうよ。\nイシュトなんて無名の海賊に、\n普通じゃ考えられない高額の懸賞金",
  "en": "",
  "status": "todo",
  "slots": [
   "0x16ad"
  ],
  "voice": 227,
  "who": "アンヌ"
 },
 {
  "id": "s2033:002e6",
  "jp": "狙わない方がおかしいってものよ？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x16b4"
  ],
  "voice": 228,
  "who": "アンヌ"
 },
 {
  "id": "s2033:0030b",
  "jp": "シャルム海賊団っていえば\nなかなかに名の知れた海賊ですよ？\n……どうしますか？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x16ca"
  ],
  "voice": 229,
  "who": "ピンガー"
 },
 {
  "id": "s2033:0035c",
  "jp": "イシュトぉ……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x16e3"
  ],
  "voice": 230,
  "who": "ルルゥ"
 },
 {
  "id": "s2033:00371",
  "jp": "船が壊された。\nこの小さい島じゃ逃げ場もない。\n戦うしかないだろ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1718"
  ],
  "voice": 231,
  "who": "イシュト"
 },
 {
  "id": "s2033:003b6",
  "jp": "あらぁ？\n果敢と無謀は違うわよ？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1731"
  ],
  "voice": 232,
  "who": "アンヌ"
 },
 {
  "id": "s2033:003da",
  "jp": "行くぞピンガー！\n悪いルルゥ、後ろに下がっておいて\nくれ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x174a"
  ],
  "voice": 233,
  "who": "イシュト"
 },
 {
  "id": "s2033:00417",
  "jp": "うぅん。私も戦うよ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1763"
  ],
  "voice": 234,
  "who": "ルルゥ"
 },
 {
  "id": "s2033:00430",
  "jp": "え゛？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1798"
  ],
  "voice": 235,
  "who": "イシュト"
 },
 {
  "id": "s2033:0043b",
  "jp": "ふふん。私をただの女の子とは\n思わないほうがいいよ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x17b1"
  ],
  "voice": 236,
  "who": "ルルゥ"
 },
 {
  "id": "s2033:00473",
  "jp": "えぇ～……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x17d8"
  ],
  "voice": 237,
  "who": "イシュト"
 },
 {
  "id": "s2033:00484",
  "jp": "兄貴、只でさえ不利なんですから。\n協力してもらいましょう！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x17f1"
  ],
  "voice": 238,
  "who": "ピンガー"
 },
 {
  "id": "s2033:004c2",
  "jp": "ん～、わかった！\n頼むぞ、ルルゥ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x180a"
  ],
  "voice": 239,
  "who": "イシュト"
 },
 {
  "id": "s2033:004e8",
  "jp": "うん！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1823"
  ],
  "voice": 240,
  "who": "ルルゥ"
 },
 {
  "id": "s2033:004f3",
  "jp": "フフフ、大人の実力、\nじっくり見せてあげるわ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x190f"
  ],
  "voice": 241,
  "who": "アンヌ"
 },
 {
  "id": "s2033:00525",
  "jp": "思った以上にやるわね……。\nアンタ達！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2647"
  ],
  "voice": 242,
  "who": "アンヌ"
 },
 {
  "id": "s2033:0054f",
  "jp": "クソ！　このままじゃジリ貧だ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2742"
  ],
  "voice": 243,
  "who": "イシュト"
 },
 {
  "id": "s2033:00572",
  "jp": "実力が拮抗している分、\n数の差が出ますね……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2760"
  ],
  "voice": 244,
  "who": "ピンガー"
 },
 {
  "id": "s2033:005a4",
  "jp": "疲れて、力が入らないよ……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2785"
  ],
  "voice": 245,
  "who": "ルルゥ"
 },
 {
  "id": "s2033:005c5",
  "jp": "ねぇ？　よかったら、\n助けてあげようか？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x287c"
  ],
  "voice": 246,
  "who": "エリーシャ"
 },
 {
  "id": "s2033:005f1",
  "jp": "今度はだぁれだよぉ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2891"
  ],
  "voice": 247,
  "who": "イシュト"
 },
 {
  "id": "s2033:0060a",
  "jp": "“グロリア海賊団”副船長。\nエリーシャ！\nとその他。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x28d8"
  ],
  "voice": 248,
  "who": "エリーシャ"
 },
 {
  "id": "s2033:00641",
  "jp": "自分以外はテキトーだ……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x28ed"
  ],
  "voice": 249,
  "who": "ピンガー"
 },
 {
  "id": "s2033:00660",
  "jp": "グロリア海賊団！？\n超ビッグネームじゃねぇか！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2910"
  ],
  "voice": 250,
  "who": "イシュト"
 },
 {
  "id": "s2033:00692",
  "jp": "な、なんでこんな所に……。\nえぇい、考えてる暇はありません。\nここは素直に受け入れましょう！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2925"
  ],
  "voice": 251,
  "who": "ピンガー"
 },
 {
  "id": "s2033:006f1",
  "jp": "助けてぇ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2937"
  ],
  "voice": 252,
  "who": "ルルゥ"
 },
 {
  "id": "s2033:00700",
  "jp": "はぁ……\nなぁんで親父はこんな奴らを\n擁護するのかしらねぇ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2a70"
  ],
  "voice": 253,
  "who": "エリーシャ"
 },
 {
  "id": "s2033:0073f",
  "jp": "ユーフォリアの鍵、羅針盤、末裔。\nとてもそんな風には見えないわね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2b71"
  ],
  "voice": 254,
  "who": "エリーシャ"
 },
 {
  "id": "s2033:00785",
  "jp": "ん？　何か言ったか？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2b8c"
  ],
  "voice": 255,
  "who": "イシュト"
 },
 {
  "id": "s2033:0079e",
  "jp": "なんでもないわよ。\nハイちゃんと前見て！　来るわよ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2ba5"
  ],
  "voice": 256,
  "who": "エリーシャ"
 },
 {
  "id": "s2033:007d6",
  "jp": "ダルそうっすねぇ……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2bc0"
  ],
  "voice": 257,
  "who": "ピンガー"
 },
 {
  "id": "s2033:007f1",
  "jp": "グロリア海賊団の副船長さん。\n船長さんはお元気かしら？\nウフフ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x21b5"
  ],
  "voice": 258,
  "who": "アンヌ"
 },
 {
  "id": "s2033:00834",
  "jp": "なんでアンタがそのことを……\nまさか！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x21ca"
  ],
  "voice": 259,
  "who": "エリーシャ"
 },
 {
  "id": "s2033:0085e",
  "jp": "ウフフ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x21df"
  ],
  "voice": 260,
  "who": "アンヌ"
 },
 {
  "id": "s2033:0086b",
  "jp": "アナタを倒せば、\nアタシは大金持ちよぉ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x22c9"
  ],
  "who": "アンヌ"
 },
 {
  "id": "s2033:00893",
  "jp": "そう簡単にやられるかよ！\n俺の剣を受けてみろ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x22e3"
  ],
  "who": "イシュト"
 },
 {
  "id": "s2033:008c1",
  "jp": "ウフフ、可愛いネコちゃん。\n遊んであげるわ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x23d4"
  ],
  "who": "アンヌ"
 },
 {
  "id": "s2033:008ed",
  "jp": "そうですか、では……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x23ee"
  ],
  "who": "ピンガー"
 },
 {
  "id": "s2033:00904",
  "jp": "ボクに遊ばれないように\n注意してくださいね！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2403"
  ],
  "who": "ピンガー"
 },
 {
  "id": "s2033:00930",
  "jp": "アナタ、本当に戦えるの？\n一撃で倒れたら承知しないわよ？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x24f4"
  ],
  "who": "アンヌ"
 },
 {
  "id": "s2033:00968",
  "jp": "ふふん。\n余裕でいられるのも今の内だよ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x250e"
  ],
  "who": "ルルゥ"
 },
 {
  "id": "s2033:00990",
  "jp": "さっきとは状況が逆ね……。\n退くわよ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2cf1"
  ],
  "voice": 261,
  "who": "アンヌ"
 },
 {
  "id": "s2033:009ba",
  "jp": "ハァ、ハァ、ふいー！\n助かったぁ～！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3448"
  ],
  "voice": 262,
  "who": "イシュト"
 },
 {
  "id": "s2033:009e2",
  "jp": "も、もう、動けないよ……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3461"
  ],
  "voice": 263,
  "who": "ルルゥ"
 },
 {
  "id": "s2033:00a01",
  "jp": "エリーシャさん、でしたっけ？\nありがとうございました。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3488"
  ],
  "voice": 264,
  "who": "ピンガー"
 },
 {
  "id": "s2033:00a3b",
  "jp": "助けたくて助けたわけじゃないわ。\n親父がアンタ達を仲間にしたいって\n言ってたから助けただけよ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x349e"
  ],
  "voice": 265,
  "who": "エリーシャ"
 },
 {
  "id": "s2033:00a9c",
  "jp": "仲間？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x34b4"
  ],
  "voice": 266,
  "who": "イシュト"
 },
 {
  "id": "s2033:00aa7",
  "jp": "そ。利害は一致してるはずよ。\n断る理由は、ないんじゃない？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x34e6"
  ],
  "voice": 267,
  "who": "エリーシャ"
 },
 {
  "id": "s2033:00ae5",
  "jp": "確かに、賞金首にされた以上。\nグロリア海賊団に入るってのは\nいい手だな。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x34fc"
  ],
  "voice": 268,
  "who": "イシュト"
 },
 {
  "id": "s2033:00b30",
  "jp": "船もなくなっちゃいましたしね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3520"
  ],
  "voice": 269,
  "who": "ピンガー"
 },
 {
  "id": "s2033:00b53",
  "jp": "イシュト、どうするの？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3536"
  ],
  "voice": 270,
  "who": "ルルゥ"
 },
 {
  "id": "s2033:00b6e",
  "jp": "……よし、入る！\nよろしくな、エリーシャ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x354f"
  ],
  "voice": 271,
  "who": "イシュト"
 },
 {
  "id": "s2033:00b9c",
  "jp": "えぇ、よろしく。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3584"
  ],
  "voice": 272,
  "who": "エリーシャ"
 },
 {
  "id": "s2033:00bb1",
  "jp": "計画通り……！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3596"
  ],
  "voice": 273,
  "who": "エリーシャ"
 },
 {
  "id": "s2033:00bc4",
  "jp": "え？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x35ba"
  ],
  "voice": 274,
  "who": "イシュト"
 },
 {
  "id": "s2033:00bcd",
  "jp": "な、なんでもないわよ。\nそれじゃあ、チャッチャと\n行くわよ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x35d3"
  ],
  "voice": 275,
  "who": "エリーシャ"
 },
 {
  "id": "s2033:00c0c",
  "jp": "そ、そうだな。\nルルゥ、頼む。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x35e9"
  ],
  "voice": 276,
  "who": "イシュト"
 },
 {
  "id": "s2033:00c2e",
  "jp": "うん！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3602"
  ],
  "voice": 277,
  "who": "ルルゥ"
 },
 {
  "id": "s2033:00c3c",
  "jp": "キュー！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1a0a"
  ],
  "who": "#64"
 },
 {
  "id": "s2033:00c45",
  "jp": "よし、それじゃあ早速\n牛から乳を搾るのを手伝ってくれ！\n頼んだぞ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1a1c"
  ],
  "who": "#70"
 },
 {
