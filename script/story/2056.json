  "en": "",
  "status": "todo",
  "slots": [
   "0x150c"
  ],
  "voice": 2089,
  "who": "エリーシャ"
 },
 {
  "id": "s2056:000c0",
  "jp": "誰だ！\nこの世で最も人から避けられる\n二文字を言った奴は！",
