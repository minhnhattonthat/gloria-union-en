  "status": "todo",
  "slots": [
   "0x15fa"
  ],
  "voice": 2096,
  "who": "エリーシャ"
 },
 {
  "id": "s2056:0021e",
  "jp": "だから違うってぇ！\nそして銃をむけるな！\nエリーシャ、お前もだ！",
