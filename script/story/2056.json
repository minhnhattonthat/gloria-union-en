  "status": "todo",
  "slots": [
   "0x14e8"
  ],
  "voice": 2087,
  "who": "ルルゥ"
 },
 {
  "id": "s2056:00094",
  "jp": "いやぁ、むしろ嬉しかったって。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x14fa"
  ],
  "voice": 2088,
  "who": "イシュト"
 },
 {
  "id": "s2056:000b7",
