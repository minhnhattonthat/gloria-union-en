  "slots": [
   "0x1550"
  ],
  "voice": 2091,
  "who": "ユグドラ"
 },
 {
  "id": "s2056:0011c",
  "jp": "んなわけないだろ！\nなんで真顔でそんなこと聞くんだ！",
