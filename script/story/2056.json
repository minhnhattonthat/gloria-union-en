[
 {
  "id": "s2056:00028",
  "jp": "俺がルルゥに会ってから、\nもうだいぶ月日が流れたなぁ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x14d6"
  ],
  "voice": 2086,
  "who": "イシュト"
 },
 {
  "id": "s2056:00062",
  "jp": "あの時はごめんね。\nいきなり押しかけちゃって。",
