[
 {
  "id": "s2061:00028",
  "jp": "ここが、腐海……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2909"
  ],
  "voice": 2538,
  "who": "エリーシャ"
 },
 {
  "id": "s2061:0003f",
  "jp": "皇国軍と数百年も戦争をし続け\n未だに決着がつかない、かつての\n麗水都市シャンティエ……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x291b"
  ],
  "voice": 2539,
  "who": "ピンガー"
 },
 {
  "id": "s2061:0009a",
  "jp": "その成れの果てか……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x292d"
  ],
  "voice": 2540,
  "who": "イシュト"
 },
 {
  "id": "s2061:000b5",
  "jp": "この海には、何千のウンディーネが\n眠っているんだね……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2950"
  ],
  "voice": 2541,
  "who": "ルルゥ"
 },
 {
  "id": "s2061:000f1",
  "jp": "これが、本物の戦場ってやつさ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2965"
  ],
  "voice": 2542,
  "who": "ザザーランド"
 },
 {
  "id": "s2061:00114",
  "jp": "この長きに亘る戦争を止めるため、\n私は増援を求め海へと旅立った。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2995"
  ],
  "voice": 2543,
  "who": "フィービー"
 },
 {
  "id": "s2061:00158",
  "jp": "そして、俺達と出会ったのか。\n最初は敵だったのに、\n今は随分と仲良くなったよな。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x29ab"
  ],
  "voice": 2544,
  "who": "イシュト"
 },
 {
  "id": "s2061:001ab",
  "jp": "フ、そうだな。\nしかし、私は自分の使命を\n忘れてはいない。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x29c1"
  ],
  "voice": 2545,
  "who": "フィービー"
 },
 {
  "id": "s2061:001e8",
  "jp": "悪いけど、今のあたし達じゃ……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x29d7"
  ],
  "voice": 2546,
  "who": "エリーシャ"
 },
 {
  "id": "s2061:0020d",
  "jp": "付いてきたのは私の勝手だ。\n気にするな。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x29ed"
  ],
  "voice": 2547,
  "who": "フィービー"
 },
 {
  "id": "s2061:00239",
  "jp": "フィービー……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2a03"
  ],
  "voice": 2548,
  "who": "エリーシャ"
 },
 {
  "id": "s2061:0024e",
  "jp": "フィービーおねえちゃん。\nどこかにいっちゃうの？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2a15"
  ],
  "voice": 2549,
  "who": "ロコモコ"
 },
 {
  "id": "s2061:00282",
  "jp": "いや、もうしばらくいよう。\nここにいれば、援軍を探すよりも\n大きなことができるかもしれない。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2a2b"
  ],
  "voice": 2550,
  "who": "フィービー"
 },
 {
  "id": "s2061:002e1",
  "jp": "でかいことっすか……。\n皇国軍を壊滅させる、とかっすか？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2a4f"
  ],
  "voice": 2551,
  "who": "ラズベリー"
 },
 {
  "id": "s2061:0031d",
  "jp": "ハハハ、それは大きいな。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2a65"
  ],
  "voice": 2552,
  "who": "フィービー"
 },
 {
  "id": "s2061:0033a",
  "jp": "できるさ、俺達なら。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2a7e"
  ],
  "voice": 2553,
  "who": "イシュト"
 },
 {
  "id": "s2061:00353",
  "jp": "やるのは主にお前らだけどな。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2a93"
  ],
  "voice": 2554,
  "who": "ザザーランド"
 },
 {
  "id": "s2061:00374",
  "jp": "働けダメ親父……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2ab6"
  ],
  "voice": 2555,
  "who": "エリーシャ"
 },
 {
  "id": "s2061:0038b",
  "jp": "増援ではなく、仲間を得たか。\nいいことではないか。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2ad9"
  ],
  "voice": 2556,
  "who": "ミネソタ"
 },
 {
  "id": "s2061:003c1",
  "jp": "あぁ、まったくだ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2aef"
  ],
  "voice": 2557,
  "who": "フィービー"
 },
 {
  "id": "s2061:003d8",
  "jp": "待たれよ。海賊達よ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2b2d"
  ],
  "voice": 2558,
  "who": "ジゼル"
 },
 {
  "id": "s2061:003f1",
  "jp": "誰だ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2b42"
  ],
  "voice": 2559,
  "who": "イシュト"
 },
 {
  "id": "s2061:003fc",
  "jp": "あ、あなた様は……！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2bfa"
  ],
  "voice": 2560,
  "who": "フィービー"
 },
 {
  "id": "s2061:00415",
  "jp": "我が名はジゼル。\n麗水都市シャンティエの女王だ。\n貴様ら、グロリア海賊団じゃな？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2c1a"
  ],
  "voice": 2561,
  "who": "ジゼル"
 },
 {
  "id": "s2061:00468",
  "jp": "あぁ、そうだが？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2c33"
  ],
  "voice": 2562,
  "who": "ザザーランド"
 },
 {
  "id": "s2061:0047d",
  "jp": "よし、ならばすまぬが、早々に\nその首を差し出してもらおう。\n総員、構え！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2c4c"
  ],
  "voice": 2563,
  "who": "ジゼル"
 },
 {
  "id": "s2061:004c8",
  "jp": "同志達……！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2ea3"
  ],
  "voice": 2564,
  "who": "フィービー"
 },
 {
  "id": "s2061:004d9",
  "jp": "敵兵！？　まったく。\nなんなのよいきなり！！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2ec3"
  ],
  "voice": 2565,
  "who": "エリーシャ"
 },
 {
  "id": "s2061:00509",
  "jp": "すまんの。皇国軍が言うてきた\nのじゃ。グロリアを滅ぼせば\n戦争を止める、とな。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2edc"
  ],
  "voice": 2566,
  "who": "ジゼル"
 },
 {
  "id": "s2061:0055a",
  "jp": "皇国軍が……！？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2f0f"
  ],
  "voice": 2567,
  "who": "カミュル"
 },
 {
  "id": "s2061:0056f",
  "jp": "そんな……それは、皇国の命に従う\nということですよ！？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2f49"
  ],
  "voice": 2568,
  "who": "フィービー"
 },
 {
  "id": "s2061:005a9",
  "jp": "私はもう百年耐えた……。\nこれ以上、娘の死ぬ姿は見たくない\nのだ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2f62"
  ],
  "voice": 2569,
  "who": "ジゼル"
 },
 {
  "id": "s2061:005ee",
  "jp": "降伏するってぇのか……？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2f89"
  ],
  "voice": 2570,
  "who": "ザザーランド"
 },
 {
  "id": "s2061:0060b",
  "jp": "黙りなさい！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2fa2"
  ],
  "voice": 2571,
  "who": "ジゼル"
 },
 {
  "id": "s2061:0061c",
  "jp": "落ち着いてください。陛下！\n皇国は人の心を利用する悪党。\n騙されているんです！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2fc9"
  ],
  "voice": 2572,
  "who": "フィービー"
 },
 {
  "id": "s2061:0066d",
  "jp": "ならばどうしろというのですか。\n皇国との強さの差は歴然。このまま\nジリ貧になるならいっそ……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2fe2"
  ],
  "voice": 2573,
  "who": "ジゼル"
 },
 {
  "id": "s2061:006ce",
  "jp": "あの女王様、心が折れかかってる。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3009"
  ],
  "voice": 2574,
  "who": "エリーシャ"
 },
 {
  "id": "s2061:006f3",
  "jp": "陛下……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x302d"
  ],
  "voice": 2575,
  "who": "フィービー"
 },
 {
  "id": "s2061:00702",
  "jp": "こっちは連戦続きで\nほとんど兵糧が残ってない……。\n今戦うとマズイな。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3054"
  ],
  "voice": 2576,
  "who": "イシュト"
 },
 {
  "id": "s2061:0074b",
  "jp": "海の性質のせいで\n船底の腐食も速くなってやがる。\nまともに戦ってる暇はねぇ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3077"
  ],
  "voice": 2577,
  "who": "ザザーランド"
 },
 {
  "id": "s2061:0079a",
  "jp": "逃がすと思うたか？\n“ダイヤモンドダスト”！！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3090"
  ],
  "voice": 2578,
  "who": "ジゼル"
 },
 {
  "id": "s2061:007cc",
  "jp": "う、海が……！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x30f4"
  ],
  "voice": 2579,
  "who": "ピンガー"
 },
 {
  "id": "s2061:007df",
  "jp": "凍っちゃったよーーー！！！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3109"
  ],
  "voice": 2580,
  "who": "ルルゥ"
 },
 {
  "id": "s2061:007fe",
  "jp": "これだけの規模を一瞬で凍らせる\nなんて……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x311e"
  ],
  "voice": 2581,
  "who": "ラズベリー"
 },
 {
  "id": "s2061:0082e",
  "jp": "さすがはウンディーネの始祖、\nということか。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x314f"
  ],
  "voice": 2582,
  "who": "ミネソタ"
 },
 {
  "id": "s2061:0085e",
  "jp": "我がダイヤモンドダストからは、\n逃げられんぞ！\nさぁ、覚悟しろ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3168"
  ],
  "voice": 2583,
  "who": "ジゼル"
 },
 {
  "id": "s2061:008a1",
  "jp": "陛下……不肖フィービー。\n一度だけ、陛下に逆らわせて\n頂きます！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3231"
  ],
  "voice": 2584,
  "who": "フィービー"
 },
 {
  "id": "s2061:008e4",
  "jp": "愚かな娘よ、シャンティエの誇りに\n逆らうか……！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x324a"
  ],
  "voice": 2585,
  "who": "ジゼル"
 },
 {
  "id": "s2061:00918",
  "jp": "誇りはいつでもこの胸に！\nしかし！　今は一人のウンディーネ\nとして、アナタを止める！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3268"
  ],
  "voice": 2586,
  "who": "フィービー"
 },
 {
  "id": "s2061:0096f",
  "jp": "海が凍ったせいで船が動かせねぇ。\nなんとしても敵の攻撃を防ぐんだ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x328f"
  ],
  "voice": 2587,
  "who": "イシュト"
 },
 {
  "id": "s2061:009b5",
  "jp": "御止めください陛下！\n皇国の命令に従うのですか！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x555d"
  ],
  "voice": 2588,
  "who": "フィービー"
 },
 {
  "id": "s2061:009e9",
  "jp": "私はシャンティエの平和を第一に\n考えています。戦争が終わるなら、\n私は敵にさえ従いましょう！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5576"
  ],
  "voice": 2589,
  "who": "ジゼル"
 },
 {
  "id": "s2061:00a48",
  "jp": "陛下……おのれ……おのれ\n皇国軍！！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5590"
  ],
  "voice": 2590,
  "who": "フィービー"
 },
 {
  "id": "s2061:00a70",
  "jp": "さぁ、海の底へと沈むがよい！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4e5c"
  ],
  "who": "ジゼル"
 },
 {
  "id": "s2061:00a8d",
  "jp": "ウンディーネの始祖だかなんだか\n知らないが、そう簡単にやられて\nたまるかよ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4e76"
  ],
  "who": "イシュト"
 },
 {
  "id": "s2061:00ad8",
  "jp": "貴様、獣人……ではないな。\n紛い物か。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4f60"
  ],
  "who": "ジゼル"
 },
 {
  "id": "s2061:00afe",
  "jp": "紛い物だって立派な獣人ですよ。\n油断してると、怪我しますよ？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4f7a"
  ],
  "who": "ピンガー"
 },
 {
  "id": "s2061:00b3a",
  "jp": "シャンティエの為に、\nここで果ててゆけ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5064"
  ],
  "who": "ジゼル"
 },
 {
  "id": "s2061:00b62",
  "jp": "気の毒だけど、\n私達だってここで負けるわけには\nいかないのよ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x507e"
  ],
  "who": "エリーシャ"
 },
 {
  "id": "s2061:00b9f",
  "jp": "うへぇ。氷上は歩きづらいねぇ。\n足がツルツルすべらぁ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5152"
  ],
  "who": "ザザーランド"
 },
 {
  "id": "s2061:00bd5",
  "jp": "グロリア海賊団船長ザザーランド。\n貴様を討てば、シャンティエは\n平和になるのだ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x516b"
  ],
  "who": "ジゼル"
 },
 {
  "id": "s2061:00c24",
  "jp": "グロリア海賊団といた以上、\n貴様も我等の敵だ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5255"
  ],
  "who": "ジゼル"
 },
 {
  "id": "s2061:00c52",
  "jp": "ウンディーネの女王か……。\n侮れぬ相手だな。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x526f"
  ],
  "who": "ミネソタ"
 },
 {
  "id": "s2061:00c7e",
  "jp": "すまないな、童女よ。\nこれも、シャンティエの平和の為。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5359"
  ],
  "who": "ジゼル"
 },
 {
  "id": "s2061:00cb4",
  "jp": "心配しなくてもいいよ。\nロコモコ、負けないから！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5373"
  ],
  "who": "ロコモコ"
 },
 {
  "id": "s2061:00ce4",
  "jp": "黄泉の国の者か……。\nフン、飽きもせずよく来るものだ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x545d"
  ],
  "who": "ジゼル"
 },
 {
  "id": "s2061:00d1a",
  "jp": "ここは世界で最も死人が\n多い所っすからねぇ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5477"
  ],
  "who": "ラズベリー"
 },
 {
  "id": "s2061:00d46",
  "jp": "これ以上、仕事を増やさないで\nくださいっすよ？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5481"
  ],
  "who": "ラズベリー"
 },
 {
  "id": "s2061:00d74",
  "jp": "その体では、\n一度沈めば充分じゃろう。\nさぁ、沈むがよい！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x567a"
  ],
  "who": "ジゼル"
 },
 {
  "id": "s2061:00dad",
  "jp": "ガガガンガ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5694"
  ],
  "who": "ガング"
 },
 {
  "id": "s2061:00dba",
  "jp": "氷上では、その重い銃は上手く\n扱えまい！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x577e"
  ],
  "who": "ジゼル"
 },
 {
  "id": "s2061:00de2",
  "jp": "この程度の氷上で扱えなくなるほど\n私は柔ではありませんよ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5798"
  ],
  "who": "ユグドラ"
 },
 {
  "id": "s2061:00e1c",
  "jp": "皇国軍！？\n何故、このような所に……！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5889"
  ],
  "who": "ジゼル"
 },
 {
  "id": "s2061:00e42",
  "jp": "僕はもう皇国軍の兵士ではない。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x58a3"
  ],
  "who": "カミュル"
 },
 {
  "id": "s2061:00e61",
  "jp": "僕は、誇り高き海の戦士だ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x58ad"
  ],
  "who": "カミュル"
 },
 {
  "id": "s2061:00e7c",
  "jp": "グロリア海賊団！\n我が槍に沈め！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x599e"
  ],
  "who": "ジゼル"
 },
 {
  "id": "s2061:00e9c",
  "jp": "女王様って言っても、\n煌びやかなモンでもないのねぇ。\nやっぱり海賊が一番だわ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x59b8"
  ],
  "who": "アンヌ"
 },
 {
  "id": "s2061:00ee9",
  "jp": "悲劇の女王様ねぇ。\nよくある話だわさ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5a8c"
  ],
  "who": "パメラ"
 },
 {
  "id": "s2061:00f0f",
  "jp": "そうだ。だからこの話は\nここで終わらせる。\nシャンティエは、平和になるのだ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5aa5"
  ],
  "who": "ジゼル"
 },
 {
  "id": "s2061:00f5a",
  "jp": "シャンティエの平和の糧となれ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5b96"
  ],
  "who": "ジゼル"
 },
 {
  "id": "s2061:00f79",
  "jp": "アナタの奏でる詩は、語るには\n悲しすぎますわ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5bb0"
  ],
  "who": "イータ"
 },
 {
  "id": "s2061:00fa7",
  "jp": "だから、ここで終わらせます。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5bc5"
  ],
  "who": "イータ"
 },
 {
  "id": "s2061:00fc4",
  "jp": "シャンティエに……平和を……！\nうぅ……！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5e9c"
  ],
  "voice": 2591,
  "who": "ジゼル"
 },
 {
  "id": "s2061:00ff2",
  "jp": "陛下……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x670c"
  ],
  "voice": 2592,
  "who": "フィービー"
 },
 {
  "id": "s2061:01001",
  "jp": "百年もの間戦い続けていたアナタが\n……何故今になって、こんな……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x672c"
  ],
  "voice": 2593,
  "who": "ミネソタ"
 },
 {
  "id": "s2061:01047",
  "jp": "近年、急に強くなった皇国軍に、\nシャンティエは窮地に立たされた。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x6742"
  ],
  "voice": 2594,
  "who": "ジゼル"
 },
 {
  "id": "s2061:0108b",
  "jp": "急に……？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x675b"
  ],
  "voice": 2595,
  "who": "イシュト"
 },
 {
  "id": "s2061:0109a",
  "jp": "初めての絶望感だった……。\nそう戦っても勝てぬ相手に、\n私の心は簡単に打ち砕かれた。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x6774"
  ],
  "voice": 2596,
  "who": "ジゼル"
 },
 {
  "id": "s2061:010f1",
  "jp": "その心の隙間を、皇国軍に突かれた\nってわけね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x678a"
  ],
  "voice": 2597,
  "who": "エリーシャ"
 },
 {
  "id": "s2061:01123",
  "jp": "ルキア皇国が、そのような……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x67b3"
  ],
  "voice": 2598,
  "who": "カミュル"
 },
 {
  "id": "s2061:01146",
  "jp": "知らなかったのか？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x67c5"
  ],
  "voice": 2599,
  "who": "ミネソタ"
 },
 {
  "id": "s2061:0115d",
  "jp": "恐らく、一般兵は誰も知らない。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x67d7"
  ],
  "voice": 2600,
  "who": "カミュル"
 },
 {
  "id": "s2061:01180",
  "jp": "強くなったことを\n隠蔽しているのか……。\nこれは何かありそうだな。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x67e9"
  ],
  "voice": 2601,
  "who": "ミネソタ"
 },
 {
  "id": "s2061:011c5",
  "jp": "情けない……。\n私は、全ウンディーネの母として、\n本当に情けないことをした……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x6806"
  ],
  "voice": 2602,
  "who": "ジゼル"
 },
 {
  "id": "s2061:01218",
  "jp": "娘よ、申し訳ないことをした。\n情けない母を、叱ってくれ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x6820"
  ],
  "voice": 2603,
  "who": "ジゼル"
 },
 {
  "id": "s2061:01254",
  "jp": "……陛下。まだ間に合いますよ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x6836"
  ],
  "voice": 2604,
  "who": "フィービー"
 },
 {
  "id": "s2061:01277",
  "jp": "なに……？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x684c"
  ],
  "voice": 2605,
  "who": "ジゼル"
 },
 {
  "id": "s2061:01286",
  "jp": "実は、私も一度、陛下と同じに\nなった時がありました。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x6862"
  ],
  "voice": 2606,
  "who": "フィービー"
 },
 {
  "id": "s2061:012be",
  "jp": "しかし私は立ち直りました。\n新たな仲間を得て。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x6869"
  ],
  "voice": 2607,
  "who": "フィービー"
 },
 {
  "id": "s2061:012f0",
  "jp": "仲間……ですか。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x687f"
  ],
  "voice": 2608,
  "who": "ジゼル"
 },
 {
  "id": "s2061:01305",
  "jp": "まだ手はありますよ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x68b8"
  ],
  "voice": 2609,
  "who": "ピンガー"
 },
 {
  "id": "s2061:0131e",
  "jp": "え……？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x68ce"
  ],
  "voice": 2610,
  "who": "ジゼル"
 },
 {
  "id": "s2061:0132b",
  "jp": "エルマーレ連合国という国がある。\nルキア皇国を滅ぼすために\n作られた国だ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x68eb"
  ],
  "voice": 2611,
  "who": "ザザーランド"
 },
 {
  "id": "s2061:01378",
  "jp": "なるほど、そこに入れば、\n援軍も仲間も手に入るわね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x6904"
  ],
  "voice": 2612,
  "who": "エリーシャ"
 },
 {
  "id": "s2061:013b0",
  "jp": "そのような組織が……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x691a"
  ],
  "voice": 2613,
  "who": "ジゼル"
 },
 {
  "id": "s2061:013cb",
  "jp": "よかったね。ジゼルさん。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x6937"
  ],
  "voice": 2614,
  "who": "ルルゥ"
 },
 {
  "id": "s2061:013e8",
  "jp": "行きましょう、陛下。\n同志達が、待っていますよ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x696a"
  ],
  "voice": 2615,
  "who": "フィービー"
 },
 {
  "id": "s2061:0141c",
  "jp": "フィービー。あなたには、\nあなたの仲間がいるのでしょう。\n私は、もう一人でも大丈夫です。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x6983"
  ],
  "voice": 2616,
  "who": "ジゼル"
 },
 {
  "id": "s2061:01477",
  "jp": "……はい、お元気で、陛下。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x6999"
  ],
  "voice": 2617,
  "who": "フィービー"
 },
 {
  "id": "s2061:01496",
  "jp": "……ありがとう。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x69cb"
  ],
  "voice": 2618,
  "who": "ジゼル"
 },
 {
  "id": "s2061:014ab",
  "jp": "あなた達には感謝しています。\nいずれまたどこかでお会いしたら、\nお礼をさせてください。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x69dd"
  ],
  "voice": 2619,
  "who": "ジゼル"
 },
 {
  "id": "s2061:01504",
  "jp": "そん時は、綺麗なシャンティエを\n見せてくれよ？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x69f3"
  ],
  "voice": 2620,
  "who": "イシュト"
 },
 {
  "id": "s2061:01536",
  "jp": "鯛や平目の踊り食いも\n見せてくださいね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x6a17"
  ],
  "voice": 2621,
  "who": "ピンガー"
 },
 {
  "id": "s2061:01562",
  "jp": "舞い踊りでしょ。\n踊り食ってどうするのよ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x6a2d"
  ],
  "voice": 2622,
  "who": "エリーシャ"
 },
 {
  "id": "s2061:01590",
  "jp": "それでは、お元気で。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x6a43"
  ],
  "voice": 2623,
  "who": "ジゼル"
 },
 {
  "id": "s2061:015a9",
  "jp": "よっしゃあ！　\n俺達も行くとするか！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x6aaa"
  ],
  "voice": 2624,
  "who": "ザザーランド"
 },
 {
  "id": "s2061:015d1",
  "jp": "おう！　やる気全開だぜ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x6ac3"
  ],
  "voice": 2625,
  "who": "イシュト"
 },
 {
  "id": "s2061:015ee",
  "jp": "陛下、同志達。ご武運を祈ります。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x6b47"
  ],
  "voice": 2626,
  "who": "フィービー"
 },
 {
  "id": "s2061:01614",
  "jp": "ここには、数多くの同志達が\n眠っている。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x34b0"
  ],
  "who": "#42"
 },
 {
  "id": "s2061:0163c",
  "jp": "皆、明日の光を夢見て、死んだ。\nルキア皇国を破るという、明日を。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x34b7"
  ],
  "who": "#42"
 },
 {
  "id": "s2061:0167c",
  "jp": "恥を忍んで頼む……女王陛下を……\n倒してくれ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x34be"
  ],
  "who": "#42"
 },
 {
  "id": "s2061:016aa",
  "jp": "私は、もう、ボロボロになっていく\n女王陛下を見たくはない……。\n頼む……！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x352d"
  ],
  "who": "#42"
 },
 {
  "id": "s2061:016f3",
  "jp": "ルキア皇国に敗れて駒になるぐらい\nならいっそ……と思ったのだ。\nすまないな。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3545"
  ],
  "who": "#42"
 },
 {
  "id": "s2061:0173e",
  "jp": "ここにはかつて村があった。\n小さくとも、明るく平和な村だ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x35d2"
  ],
  "who": "#55"
 },
 {
  "id": "s2061:01778",
  "jp": "滅びた理由は……言わなくても\nわかるな。\nそうだ、ルキア皇国にやられたのだ",
  "en": "",
  "status": "todo",
  "slots": [
   "0x35d9"
  ],
  "who": "#55"
 },
 {
  "id": "s2061:017c1",
  "jp": "かくいう私も、ここに住んでいた\nウンディーネの一人だ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x35e0"
  ],
  "who": "#55"
 },
 {
  "id": "s2061:017f7",
  "jp": "私は、幽霊となって、\nある人物を待っていた……お前だ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x35e7"
  ],
  "who": "#55"
 },
 {
  "id": "s2061:0182d",
  "jp": "お前なら、ルキア皇国軍を滅ぼせる\nそう確信した。\n安心しろ、私の勘は当たるんだ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3656"
  ],
  "who": "#55"
 },
 {
  "id": "s2061:0187c",
  "jp": "頼んだぞ……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x365d"
  ],
  "who": "#55"
 },
 {
  "id": "s2061:0188b",
  "jp": "誰もいないようだ……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3675"
  ],
  "who": "イシュト"
 },
 {
  "id": "s2061:018a2",
  "jp": "女王陛下は、責任を感じている……\n数百年前の責任を。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3708"
  ],
  "who": "#42"
 },
 {
  "id": "s2061:018d6",
  "jp": "美しい女王陛下に一目惚れした\n皇帝の婚約の申し出を、\n女王陛下が断った……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x370f"
  ],
  "who": "#42"
 },
 {
  "id": "s2061:01921",
  "jp": "たったそれだけの理由で、戦争が\n起こった……それだけの理由だから\nこそ、責任を感じておられる……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3716"
  ],
  "who": "#42"
 },
 {
  "id": "s2061:01982",
  "jp": "女王陛下は今、自らの意思を犠牲に\nして、戦争を止めようとしている\nのだ……うぅ……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x371d"
  ],
  "who": "#42"
 },
 {
  "id": "s2061:019d5",
  "jp": "これは……",
  "en": "",
  "status": "todo",
  "slots": [
   "0x37d5"
  ],
  "who": "イシュト"
 },
 {
  "id": "s2061:019e0",
  "jp": "このウンディーネが持っていた物か\n……悪いけど、借りてくぜ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x382b"
  ],
  "who": "イシュト"
 },
 {
  "id": "s2061:01a1c",
  "jp": "本当に……死体が多いんですね。\nここは。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x387e"
  ],
  "who": "ピンガー"
 },
 {
  "id": "s2061:01a44",
  "jp": "勝手に形見にさせてもらいますよ。\n知らないウンディーネさん。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x38c9"
  ],
  "who": "ピンガー"
 },
 {
  "id": "s2061:01a80",
  "jp": "……ごめんね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3915"
  ],
  "who": "ルルゥ"
 },
 {
  "id": "s2061:01a8f",
  "jp": "絶対に、止めてみせるから……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3960"
  ],
  "who": "ルルゥ"
 },
 {
  "id": "s2061:01aae",
  "jp": "コレさえあれば戦況が有利に\nなるの……ごめんね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x39ac"
  ],
  "who": "エリーシャ"
 },
 {
  "id": "s2061:01ade",
  "jp": "……行くわよ、アンタ達。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x39f7"
  ],
  "who": "エリーシャ"
 },
 {
  "id": "s2061:01af7",
  "jp": "俺はアンタの名前は知らないし\n顔も知らねぇ。\n悪いが、もらっていくぜ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3a43"
  ],
  "who": "ザザーランド"
 },
 {
  "id": "s2061:01b3c",
  "jp": "綺麗でなんていられるかよ。\n戦争じゃ、死人でさえ道具の一つだ",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3a8e"
  ],
  "who": "ザザーランド"
 },
 {
  "id": "s2061:01b78",
  "jp": "アクエリアス。\n水辺で地形スキルを使うための\n道具か。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3ada"
  ],
  "who": "ミネソタ"
 },
 {
  "id": "s2061:01bad",
  "jp": "もらっておくよ。\n俺達も、負けられないんでね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3b25"
  ],
  "who": "ミネソタ"
 },
 {
  "id": "s2061:01bdb",
  "jp": "お姉ちゃん、ごめんね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3b71"
  ],
  "who": "ロコモコ"
 },
 {
  "id": "s2061:01bf2",
  "jp": "ロコモコ、お姉ちゃんの分まで\n頑張るから。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3bbc"
  ],
  "who": "ロコモコ"
 },
 {
  "id": "s2061:01c1c",
