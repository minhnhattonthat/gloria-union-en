  "slots": [
   "0x2cc8"
  ],
  "who": "アジョー"
 },
 {
  "id": "s2051:00a33",
  "jp": "アジョー・グラフォー博士。\n噂はかねがね聞いてるよ。\n賛否両論だがね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2ce2"
  ],
  "who": "ミネソタ"
 },
 {
  "id": "s2051:00a78",
  "jp": "他人の評価なんて興味ないよ。\nさぁ、僕の研究成果を\n見てもらおうか！",
