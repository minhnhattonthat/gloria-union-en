   "0x31f8"
  ],
  "voice": 1718,
  "who": "イシュト"
 },
 {
  "id": "s2051:006e2",
  "jp": "おや？　キミ珍しい身体してるね。\nちょっと身体の中を見せてくれない\nかな？",
