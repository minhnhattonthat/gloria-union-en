  "status": "todo",
  "slots": [
   "0x330f"
  ],
  "who": "ピンガー"
 },
 {
  "id": "s2051:00898",
  "jp": "ちょっとちょっと。\nキミの相手は僕じゃないよ。\nルルゥＭｋ－２だよ。",
