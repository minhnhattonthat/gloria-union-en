  "status": "todo",
  "slots": [
   "0x2ac0"
  ],
  "who": "アジョー"
 },
 {
  "id": "s2051:008db",
  "jp": "こういうのはねぇ、後ろを先に\n倒せばいいって決まってるのよ！",
