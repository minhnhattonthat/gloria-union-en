[
 {
  "id": "s2041:00028",
  "jp": "なんだか薄気味悪い島ね……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x10de"
  ],
  "voice": 911,
  "who": "エリーシャ"
 },
 {
  "id": "s2041:00049",
  "jp": "ウィルが濃厚すぎる。\nおかげでクリスタルのウィルが\n探知できないよ……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x10f4"
  ],
  "voice": 912,
  "who": "ルルゥ"
 },
 {
  "id": "s2041:00094",
  "jp": "おいおい、そりゃあヤバイな。\n早いとこ通り過ぎちまおうぜ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x110a"
  ],
  "voice": 913,
  "who": "イシュト"
 },
 {
  "id": "s2041:000d2",
  "jp": "ウィルが濃厚なところは総じて\n怪奇現象が起こるらしい。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1123"
  ],
  "voice": 914,
  "who": "ミネソタ"
 },
 {
  "id": "s2041:0010c",
  "jp": "あぁ～、そんな雰囲気ありますね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x113c"
  ],
  "voice": 915,
  "who": "ピンガー"
 },
 {
  "id": "s2041:00131",
  "jp": "怖いこと言わないでよぉ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1168"
  ],
  "voice": 916,
  "who": "ロコモコ"
 },
 {
  "id": "s2041:0014e",
  "jp": "魔女はこういうところが\n好きなのではないのか？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1181"
  ],
  "voice": 917,
  "who": "ミネソタ"
 },
 {
  "id": "s2041:00180",
  "jp": "好きじゃないよ！\n好きになるわけないでしょおバカ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x11a8"
  ],
  "voice": 918,
  "who": "ロコモコ"
 },
 {
  "id": "s2041:001b6",
  "jp": "趣味趣向は普通の女の子と\n変わらないのか、失礼した。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x11cf"
  ],
  "voice": 919,
  "who": "ミネソタ"
 },
 {
  "id": "s2041:001ee",
  "jp": "毒沼もそこかしこにあるな……。\nこんなところで生活なんて\nできるのか？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x11f6"
  ],
  "voice": 920,
  "who": "ザザーランド"
 },
 {
  "id": "s2041:00237",
  "jp": "飛べばいいんじゃないですか？\nこう、パタパタと。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x120f"
  ],
  "voice": 921,
  "who": "ピンガー"
 },
 {
  "id": "s2041:0026b",
  "jp": "んなことできるかぁ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x126e"
  ],
  "voice": 922,
  "who": "エリーシャ"
 },
 {
  "id": "s2041:00284",
  "jp": "……飛んでる。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1284"
  ],
  "voice": 923,
  "who": "イシュト"
 },
 {
  "id": "s2041:00297",
  "jp": "え？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x129a"
  ],
  "voice": 924,
  "who": "エリーシャ"
 },
 {
  "id": "s2041:002a0",
  "jp": "人が……飛んでる。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x12b0"
  ],
  "voice": 925,
  "who": "イシュト"
 },
 {
  "id": "s2041:002b7",
  "jp": "兄貴……ボク、兄貴に苦労させて\nたんだね。ごめんなさい。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x12c6"
  ],
  "voice": 926,
  "who": "ピンガー"
 },
 {
  "id": "s2041:002f3",
  "jp": "ストレスからくる幻覚じゃねぇよ！\nホントに飛んでるんだって！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x12df"
  ],
  "voice": 927,
  "who": "イシュト"
 },
 {
  "id": "s2041:00333",
  "jp": "……あ！　ホントだ！\nこっちに近づいてくるよ！？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1306"
  ],
  "voice": 928,
  "who": "ルルゥ"
 },
 {
  "id": "s2041:00367",
  "jp": "くぅおらぁ！　アンタ達！！\nやぁっと見つけたっす！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1323"
  ],
  "voice": 929,
  "who": "ラズベリー"
 },
 {
  "id": "s2041:0039d",
  "jp": "え？　なになに？　なんなの？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x133c"
  ],
  "voice": 930,
  "who": "エリーシャ"
 },
 {
  "id": "s2041:003be",
  "jp": "黄泉の国、悪魔局死人管理部罪人課\nのラズベリーっす！　あなた達を\n罪人逃走補助罪で、逮捕するっす！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1492"
  ],
  "voice": 931,
  "who": "ラズベリー"
 },
 {
  "id": "s2041:00423",
  "jp": "……こいつも、苦労してるのか？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x14ab"
  ],
  "voice": 932,
  "who": "イシュト"
 },
 {
  "id": "s2041:00446",
  "jp": "虚言癖じゃないっす！\nストレスはありまっすが、\n主に課長のせいで。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x14c4"
  ],
  "voice": 933,
  "who": "ラズベリー"
 },
 {
  "id": "s2041:0048b",
  "jp": "ダメな上司を持つと苦労しますね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x14dd"
  ],
  "voice": 934,
  "who": "ピンガー"
 },
 {
  "id": "s2041:004b0",
  "jp": "そこで俺を見られると非常に\n困るんだけどな。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x14f6"
  ],
  "voice": 935,
  "who": "ザザーランド"
 },
 {
  "id": "s2041:004e0",
  "jp": "と、とにかく！\n潔く私の槍の錆になるっす！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x150c"
  ],
  "voice": 936,
  "who": "ラズベリー"
 },
 {
  "id": "s2041:0050e",
  "jp": "おいおい、槍を片手に\n突っ込んでくるぞあの娘！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1525"
  ],
  "voice": 937,
  "who": "ミネソタ"
 },
 {
  "id": "s2041:00540",
  "jp": "ゲゲッ！\nこんな所で怪我してたまるか！\nお前ら、迎え撃て！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x153e"
  ],
  "voice": 938,
  "who": "ザザーランド"
 },
 {
  "id": "s2041:0057d",
  "jp": "うぅ……探知能力が完全に麻痺\nしてる。あの沼から出てるウィルの\nせいだ……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1633"
  ],
  "voice": 939,
  "who": "ルルゥ"
 },
 {
  "id": "s2041:005cc",
  "jp": "毒沼はウィルも毒なのね……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x164e"
  ],
  "voice": 940,
  "who": "エリーシャ"
 },
 {
  "id": "s2041:005ed",
  "jp": "今だけは、ウィルを探知できない\n事に感謝だな。\nお前ら、気をつけろよ！？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1669"
  ],
  "voice": 941,
  "who": "ザザーランド"
 },
 {
  "id": "s2041:00638",
  "jp": "吸血鬼の私には最高の環境っすよ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1682"
  ],
  "voice": 942,
  "who": "ラズベリー"
 },
 {
  "id": "s2041:0065d",
  "jp": "くっそー！\nいいよなぁ飛べる奴は！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x169b"
  ],
  "voice": 943,
  "who": "イシュト"
 },
 {
  "id": "s2041:00683",
  "jp": "なんの！　\nあたしの銃で撃ち落してやるわ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x16b9"
  ],
  "voice": 944,
  "who": "エリーシャ"
 },
 {
  "id": "s2041:006b1",
  "jp": "待て！　俺達の話を聞け！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1db6"
  ],
  "voice": 945,
  "who": "イシュト"
 },
 {
  "id": "s2041:006ce",
  "jp": "こっちは上司にどやされてるんす！\nそんな暇ないんすよ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1dcf"
  ],
  "voice": 946,
  "who": "ラズベリー"
 },
 {
  "id": "s2041:00708",
  "jp": "いいなぁその羽。かっこいー！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1eac"
  ],
  "voice": 947,
  "who": "ピンガー"
 },
 {
  "id": "s2041:00729",
  "jp": "エヘン！　黄泉の最新モデルっす！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1ec2"
  ],
  "voice": 948,
  "who": "ラズベリー"
 },
 {
  "id": "s2041:0074e",
  "jp": "ええぇ！？　\n生えてるんじゃないんだ！！？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1ed4"
  ],
  "voice": 949,
  "who": "ピンガー"
 },
 {
  "id": "s2041:0077c",
  "jp": "あなたのウィル、\nなんか変な感じがする。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1fb1"
  ],
  "voice": 950,
  "who": "ルルゥ"
 },
 {
  "id": "s2041:007a8",
  "jp": "棲む世界が違うっすからね。\n大人しく捕まってくれれば、\n案内してあげるっす！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1fc7"
  ],
  "voice": 951,
  "who": "ラズベリー"
 },
 {
  "id": "s2041:007f7",
  "jp": "お前さんよぉ、まずは人の話を\n聞いてみないか！？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x209d"
  ],
  "voice": 952,
  "who": "ザザーランド"
 },
 {
  "id": "s2041:0082b",
  "jp": "そういうのは大抵罠だと課長から\n学んだので、それはできないっす！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x20b3"
  ],
  "voice": 953,
  "who": "ラズベリー"
 },
 {
  "id": "s2041:0086f",
  "jp": "いきなり斬りかかるとは……。\nマナー違反である！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2189"
  ],
  "voice": 954,
  "who": "ミネソタ"
 },
 {
  "id": "s2041:008a3",
  "jp": "そんなの気にしたら、罪人課では\n働けないっすよ！！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x219f"
  ],
  "voice": 955,
  "who": "ラズベリー"
 },
 {
  "id": "s2041:008d9",
  "jp": "あいてててぇ。\nちょっとぉ、いくらなんでも\n酷すぎるっすよぉ～。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x23aa"
  ],
  "voice": 956,
  "who": "ラズベリー"
 },
 {
  "id": "s2041:0091c",
  "jp": "先に仕掛けてきたのはそっちだろ。\nいいから、俺達の話を聞いてくれ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x23c3"
  ],
  "voice": 957,
  "who": "イシュト"
 },
 {
  "id": "s2041:00962",
  "jp": "なぁんだ。人違いだったっすか。\nごぉめんなさいっす。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2a4b"
  ],
  "voice": 958,
  "who": "ラズベリー"
 },
 {
  "id": "s2041:0099a",
  "jp": "弁明する余地もなく攻撃とは……\nマナー違反である。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2a66"
  ],
  "voice": 959,
  "who": "ミネソタ"
 },
 {
  "id": "s2041:009d0",
  "jp": "お前、何者だ？　\n黄泉の国ってなんだ……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2a81"
  ],
  "voice": 960,
  "who": "ザザーランド"
 },
 {
  "id": "s2041:009fe",
  "jp": "黄泉の国ってのは、人が死んだ後に\n行く世界のことっす。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2a97"
  ],
  "voice": 961,
  "who": "ラズベリー"
 },
 {
  "id": "s2041:00a38",
  "jp": "ロコモコの住んでる世界とは\nお隣さんだね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2ac5"
  ],
  "voice": 962,
  "who": "ロコモコ"
 },
 {
  "id": "s2041:00a66",
  "jp": "魔法の国のご出身っすか？\nお会いできて光栄っす。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2adb"
  ],
  "voice": 963,
  "who": "ラズベリー"
 },
 {
  "id": "s2041:00a9a",
  "jp": "……まぁ、ここは納得しておこう。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2aff"
  ],
  "voice": 964,
  "who": "イシュト"
 },
 {
  "id": "s2041:00abf",
  "jp": "悪魔局死人管理部罪人課は、\nその名の通り、悪魔が生前に\n罪を犯した死人を管理する所っす。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2b15"
  ],
  "voice": 965,
  "who": "ラズベリー"
 },
 {
  "id": "s2041:00b1a",
  "jp": "……なんだか物騒なところね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2b30"
  ],
  "voice": 966,
  "who": "エリーシャ"
 },
 {
  "id": "s2041:00b3b",
  "jp": "いや、管理するのはとても重要だ。\n罪人なら尚更な。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2b4b"
  ],
  "voice": 967,
  "who": "ミネソタ"
 },
 {
  "id": "s2041:00b71",
  "jp": "そこでつい最近、ある事件が\n起こったっす！　なんと罪人が一人\n逃げ出してしまったんす！！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2b61"
  ],
  "voice": 968,
  "who": "ラズベリー"
 },
 {
  "id": "s2041:00bcc",
  "jp": "な、なんだってーーー！！？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2b94"
  ],
  "voice": 969,
  "who": "ピンガー"
 },
 {
  "id": "s2041:00beb",
  "jp": "あぁ、その事件なら\nお母さんから聞いたよ！　\n罪人が一人、突然消えたって！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2bc5"
  ],
  "voice": 970,
  "who": "ロコモコ"
 },
 {
  "id": "s2041:00c38",
  "jp": "脱走ではなく消えたのか。\n誰かが意図して逃がしたのであれば\nそれは確かに大事だな。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2be3"
  ],
  "voice": 971,
  "who": "ミネソタ"
 },
 {
  "id": "s2041:00c8d",
  "jp": "そんで罪人……ローガンさんって\nいうんすけど。その人のウィルを\n追ってたら、ここに着いたんっす。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2c03"
  ],
  "voice": 972,
  "who": "ラズベリー"
 },
 {
  "id": "s2041:00cf0",
  "jp": "たしかに、ここに入ってから妙な\nウィルを感じてはいるけど……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2c2f"
  ],
  "voice": 973,
  "who": "ルルゥ"
 },
 {
  "id": "s2041:00d32",
  "jp": "ローガンさーん！\n出てきてくださーい！！",
