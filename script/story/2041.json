  "status": "todo",
  "slots": [
   "0x2c56"
  ],
  "voice": 974,
  "who": "ラズベリー"
 },
 {
  "id": "s2041:00d5e",
  "jp": "そんなんで、そのローガンってのが\n出てくるわけないだろ",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2c73"
  ],
  "voice": 975,
  "who": "イシュト"
 },
 {
  "id": "s2041:00d98",
  "jp": "誰だ！！！！！！　\n私の名を呼び捨てにした愚か者は！",
