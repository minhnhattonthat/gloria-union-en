[
 {
  "id": "s2032:00028",
  "jp": "兄貴、本当にここにクリスタルが\nあるんですか？",
  "en": "",
  "status": "todo",
  "slots": [
   "0xfc8"
  ],
  "voice": 143,
  "who": "ピンガー"
 },
 {
  "id": "s2032:0005a",
  "jp": "あぁ、この近くに、“海王神殿”\nとかいう古代遺跡があるらしい。\nそれが怪しいと俺はみたね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0xfdf"
  ],
  "voice": 144,
  "who": "イシュト"
 },
 {
  "id": "s2032:000b7",
  "jp": "あぁ、そんな噂もありましたね。\n信憑性は皆無ですが……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0xff6"
  ],
  "voice": 145,
  "who": "ピンガー"
 },
 {
  "id": "s2032:000f3",
  "jp": "るっせぇ！　\n子分なら俺に付いて来い！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1010"
  ],
  "voice": 146,
  "who": "イシュト"
 },
 {
  "id": "s2032:0011d",
  "jp": "へーい。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x102a"
  ],
  "voice": 147,
  "who": "ピンガー"
 },
 {
  "id": "s2032:0012a",
  "jp": "おっと、悪いがここは通行止めだ。\nイシュト海賊団さんよ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x105b"
  ],
  "voice": 148,
  "who": "ベルガス"
 },
 {
  "id": "s2032:00166",
  "jp": "ベルガス……またお前か。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x11c9"
  ],
  "voice": 149,
  "who": "イシュト"
 },
 {
  "id": "s2032:00183",
  "jp": "また邪魔しに来たんですか？\nいい加減、付きまとうのは止めて\n欲しいんですけどね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x11e3"
  ],
  "voice": 150,
  "who": "ピンガー"
 },
 {
  "id": "s2032:001d6",
  "jp": "俺達はクリスタル探しで\n忙しいんだから、同郷の好で、な？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x11fd"
  ],
  "voice": 151,
  "who": "イシュト"
 },
 {
  "id": "s2032:00212",
  "jp": "そうはいかねぇ！\n……これを見ろぉ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1217"
  ],
  "voice": 152,
  "who": "ベルガス"
 },
 {
  "id": "s2032:0023a",
  "jp": "ウォンテッド……指名手配書？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1254"
  ],
  "voice": 153,
  "who": "イシュト"
 },
 {
  "id": "s2032:0025b",
  "jp": "あの写真、兄貴じゃないですか！？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x126e"
  ],
  "voice": 154,
  "who": "ピンガー"
 },
 {
  "id": "s2032:00280",
  "jp": "その通り！\nお前の手配書だ、イシュト。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1288"
  ],
  "voice": 155,
  "who": "ベルガス"
 },
 {
  "id": "s2032:002aa",
  "jp": "なんで俺の手配書が……！\n俺は何もしてねぇぞ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x12a2"
  ],
  "voice": 156,
  "who": "イシュト"
 },
 {
  "id": "s2032:002dc",
  "jp": "現にこうやって手配書が\n配られてるんだ。\n大人しく、捕まってもらうぜ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x12bc"
  ],
  "voice": 157,
  "who": "ベルガス"
 },
 {
  "id": "s2032:00325",
  "jp": "な、なんで……俺に？\n俺は、賞金首になるようなこと\nなんてしたことねぇぞ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x138c"
  ],
  "voice": 158,
  "who": "イシュト"
 },
 {
  "id": "s2032:00372",
  "jp": "兄貴、嘆いてる暇はありません！\n攻撃の準備を！\n攻撃方法、覚えてますよね？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x13a6"
  ],
  "voice": 159,
  "who": "ピンガー"
 },
 {
  "id": "s2032:003bf",
  "jp": "……念のため聞いておくか。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x13bd"
  ],
  "voice": 160,
  "who": "イシュト"
 },
 {
  "id": "s2032:003de",
  "jp": "忘れてたんですか……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x13d7"
  ],
  "voice": 161,
  "who": "ピンガー"
 },
 {
  "id": "s2032:003f9",
  "jp": "こんなもんですかね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1451"
  ],
  "voice": 162,
  "who": "ピンガー"
 },
 {
  "id": "s2032:00412",
  "jp": "あぁ！　サンキューピンガー。\nよっしゃあ！　久々の戦闘だ！\n暴れてやるぜ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x146b"
  ],
  "voice": 163,
  "who": "イシュト"
 },
 {
  "id": "s2032:0045f",
  "jp": "よし、敵が来た。陣形をたてなおし\n迎撃しろ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1485"
  ],
  "voice": 164,
  "who": "ベルガス"
 },
 {
  "id": "s2032:0048f",
  "jp": "一気に駆け抜けるぞ！　\n目指すは奴らの向こう側だ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x14a2"
  ],
  "voice": 165,
  "who": "イシュト"
 },
 {
  "id": "s2032:004c5",
  "jp": "今日こそお前を倒す！\n覚悟しやがれ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x19e5"
  ],
  "voice": 166,
  "who": "ベルガス"
 },
 {
  "id": "s2032:004ed",
  "jp": "その台詞は聞き飽きた！\nお前ほど有言実行が似合わない男は\nいねぇな、ベルガス！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x19ff"
  ],
  "voice": 167,
  "who": "イシュト"
 },
 {
  "id": "s2032:0053e",
  "jp": "ピンガー、あんなバカと何時までも\n一緒にいるこたぁねぇ。\n俺と来いよ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1aef"
  ],
  "voice": 168,
  "who": "ベルガス"
 },
 {
  "id": "s2032:00587",
  "jp": "悪いけど、ボクはアナタを兄貴とは\n呼びたくないね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1b09"
  ],
  "voice": 169,
  "who": "ピンガー"
 },
 {
  "id": "s2032:005bd",
  "jp": "そうかよ。\n……よし、なら仲間は止めだ。\nてめぇはペットにするぞ、獣人。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1b22"
  ],
  "voice": 170,
  "who": "ベルガス"
 },
 {
  "id": "s2032:00608",
  "jp": "チィ。やはり兵の熟練度は段違いか\n退くぞ、テメェら！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1e69"
  ],
  "voice": 171,
  "who": "ベルガス"
 },
 {
  "id": "s2032:00640",
  "jp": "ハハッ。まぁ今回も余裕だったな。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x258b"
  ],
  "voice": 172,
  "who": "イシュト"
 },
 {
  "id": "s2032:00665",
  "jp": "はいはい、わかりましたから鼻血\n拭いてください。汚いので。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x25a1"
  ],
  "voice": 173,
  "who": "ピンガー"
 },
 {
  "id": "s2032:006a3",
  "jp": "俺は時々お前が子分に見えない\nことがある。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x25be"
  ],
  "voice": 174,
  "who": "イシュト"
 },
 {
  "id": "s2032:006d1",
  "jp": "猫は気まぐれですからにゃー。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x25d4"
  ],
  "voice": 175,
  "who": "ピンガー"
 },
 {
  "id": "s2032:006f2",
  "jp": "う、うぜぇ\n……そんじゃあ、気を取り直して、\nクリスタル探しでも！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x25f1"
  ],
  "voice": 176,
  "who": "イシュト"
 },
 {
  "id": "s2032:00737",
  "jp": "そうですね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2607"
  ],
  "voice": 177,
  "who": "ピンガー"
 },
 {
  "id": "s2032:00748",
  "jp": "……ん？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x263c"
  ],
  "voice": 178,
  "who": "ピンガー"
 },
 {
  "id": "s2032:00755",
  "jp": "あ、兄貴……上！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x267e"
  ],
  "voice": 179,
  "who": "ピンガー"
 },
 {
  "id": "s2032:0076a",
  "jp": "上？\n……な！　なんだあれ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2697"
  ],
  "voice": 180,
  "who": "イシュト"
 },
 {
  "id": "s2032:0078a",
  "jp": "落ちてきますよ！？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x26b0"
  ],
  "voice": 181,
  "who": "ピンガー"
 },
 {
  "id": "s2032:007a1",
  "jp": "おわあぁぁ！　本当に落ちてきた！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2766"
  ],
  "voice": 182,
  "who": "イシュト"
 },
 {
  "id": "s2032:007c6",
  "jp": "ゲホゲホ……！\n浜辺の砂埃がこっちにまで……！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x277f"
  ],
  "voice": 183,
  "who": "ピンガー"
 },
 {
  "id": "s2032:007f8",
  "jp": "……浜辺に落ちたのか。\nよし、見に行くぞ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2798"
  ],
  "voice": 184,
  "who": "イシュト"
 },
 {
  "id": "s2032:00826",
  "jp": "あいあいさ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x27aa"
  ],
  "voice": 185,
  "who": "ピンガー"
 },
 {
  "id": "s2032:00837",
  "jp": "こ、こいつぁ……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2862"
  ],
  "voice": 186,
  "who": "イシュト"
 },
 {
  "id": "s2032:0084e",
  "jp": "綺麗な女の子ですねぇ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2878"
  ],
  "voice": 187,
  "who": "ピンガー"
 },
 {
  "id": "s2032:00869",
  "jp": "あぁ……本当に……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x288e"
  ],
  "voice": 188,
  "who": "イシュト"
 },
 {
  "id": "s2032:00882",
  "jp": "おわぁ！　な、なんだぁ！？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x28ed"
  ],
  "voice": 189,
  "who": "イシュト"
 },
 {
  "id": "s2032:008a1",
  "jp": "扉が開いた……って、なんで？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2906"
  ],
  "voice": 190,
  "who": "ピンガー"
 },
 {
  "id": "s2032:008c2",
  "jp": "……ん、んん。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2981"
  ],
  "voice": 191,
  "who": "ルルゥ"
 },
 {
  "id": "s2032:008d5",
  "jp": "美しい……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x299a"
  ],
  "voice": 192,
  "who": "イシュト"
 },
 {
  "id": "s2032:008e6",
  "jp": "兄貴、言葉遣いが\nおかしくなってますよ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x29cc"
  ],
  "voice": 193,
  "who": "ピンガー"
 },
 {
  "id": "s2032:00912",
  "jp": "あぁ、つい。\n……キ、キミ、だ、大丈夫かな？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x29e2"
  ],
  "voice": 194,
  "who": "イシュト"
 },
 {
  "id": "s2032:00942",
  "jp": "私の名前はルルゥ。\nユーフォリアの鍵の所持者を\nクリスタルへ導く者。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2add"
  ],
  "voice": 195,
  "who": "ルルゥ"
 },
 {
  "id": "s2032:00989",
  "jp": "クリスタル！？\nクリスタルって……。\n古代ユーフォリアの遺産の？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2b0f"
  ],
  "voice": 196,
  "who": "イシュト"
 },
 {
  "id": "s2032:009cc",
  "jp": "あるかどうかもわからなすぎて\n値段が上がり続けてるっていう、\nあのクリスタルですか？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2b25"
  ],
  "voice": 197,
  "who": "ピンガー"
 },
 {
  "id": "s2032:00a23",
  "jp": "う、うん。そうだよ。\n鍵は、彼の持ってる剣のことだよ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2c18"
  ],
  "voice": 198,
  "who": "ルルゥ"
 },
 {
  "id": "s2032:00a5d",
  "jp": "へぇ、兄貴の剣、前々から珍しいと\n思っていましたが……。\nそんな秘密があったとは。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2c3c"
  ],
  "voice": 199,
  "who": "ピンガー"
 },
 {
  "id": "s2032:00ab2",
  "jp": "フ、フフハハ。\nピンガー、とうとう俺にも運が\n回ってきたみたいだぜぇ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2c55"
  ],
  "voice": 200,
  "who": "イシュト"
 },
 {
  "id": "s2032:00afb",
  "jp": "今こそ、誰も手に入れたことのない\n古代ユーフォリアの秘宝を、\n手に入れる時だ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2c6a"
  ],
  "voice": 201,
  "who": "イシュト"
 },
 {
  "id": "s2032:00b4c",
  "jp": "え、信用するんですか？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2c83"
  ],
  "voice": 202,
  "who": "ピンガー"
 },
 {
  "id": "s2032:00b67",
  "jp": "かわいいこうそつかない！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2c99"
  ],
  "voice": 203,
  "who": "イシュト"
 },
 {
  "id": "s2032:00b84",
  "jp": "素直に出しても下心は下心ですよ。\n……ハァ、わかりましたよ。\nルルゥ、お願いします。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2caf"
  ],
  "voice": 204,
  "who": "ピンガー"
 },
 {
  "id": "s2032:00bdb",
  "jp": "うん！\nじゃあ案内するから、付いてきて。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2cc5"
  ],
  "voice": 205,
  "who": "ルルゥ"
 },
 {
  "id": "s2032:00c07",
  "jp": "おう！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2cde"
  ],
  "voice": 206,
  "who": "イシュト"
 },
 {
  "id": "s2032:00c14",
  "jp": "お？　これ、もしかして……",
  "en": "",
  "status": "todo",
  "slots": [
   "0x166f"
  ],
  "who": "イシュト"
 },
 {
  "id": "s2032:00c2f",
  "jp": "四葉のクローバーじゃねぇか！\nヘヘ、縁起がいいぜ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x16c5"
  ],
  "who": "イシュト"
 },
 {
  "id": "s2032:00c61",
  "jp": "にゃ？\nおや、これは……",
  "en": "",
  "status": "todo",
  "slots": [
   "0x171f"
  ],
  "who": "ピンガー"
 },
 {
  "id": "s2032:00c79",
  "jp": "四葉のクローバーですか。\n縁起がいいですね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1775"
  ],
  "who": "ピンガー"
 },
 {
  "id": "s2032:00ca5",
  "jp": "お、畑発見。\nちょうど腹減ってたんだよなぁ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1818"
  ],
  "who": "イシュト"
 },
 {
  "id": "s2032:00cd1",
  "jp": "こいつはいいプロテイモだぜ！\nいただきまーす！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1863"
  ],
  "who": "イシュト"
 },
 {
  "id": "s2032:00cff",
  "jp": "お、野菜畑ですか。\n丁度よかったですね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x18af"
  ],
  "who": "ピンガー"
 },
 {
  "id": "s2032:00d27",
  "jp": "ま、ボクは優しいですから、\n一個で我慢してあげましょう。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x18fa"
  ],
  "who": "ピンガー"
 },
