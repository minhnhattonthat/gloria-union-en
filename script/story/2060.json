  "id": "s2060:00c8c",
  "jp": "ここで会ったが百年目！\nグロリア海賊団！　覚悟しやがれ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4f13"
  ],
  "voice": 2513,
  "who": "#43"
 },
 {
  "id": "s2060:00cc8",
  "jp": "黒い牙の残党！？\nもぉ～！　\n結局戦闘になっちゃうんだから！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4f31"
  ],
  "voice": 2514,
  "who": "ルルゥ"
 },
 {
  "id": "s2060:00d07",
  "jp": "さっさと倒して先に進もう！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4f38"
  ],
  "voice": 2515,
  "who": "ルルゥ"
 },
 {
  "id": "s2060:00d26",
  "jp": "お、あったあった。\n親父ぃ、見つけたわよぉ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x64d7"
  ],
  "voice": 2516,
  "who": "エリーシャ"
 },
 {
  "id": "s2060:00d56",
  "jp": "よぉし、じゃあ船に乗れ。\n海流に乗って次の島まで行くぞぉ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x64e9"
  ],
  "voice": 2517,
  "who": "ザザーランド"
 },
 {
  "id": "s2060:00d94",
  "jp": "まっくらで前がみえないよぉ～。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x64fb"
  ],
  "voice": 2518,
  "who": "ロコモコ"
 },
 {
  "id": "s2060:00db7",
  "jp": "はいはぁい、\n手を握っててあげるっすよ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x650d"
  ],
  "voice": 2519,
  "who": "ラズベリー"
 },
 {
  "id": "s2060:00de3",
  "jp": "ラズベリーは暗くないの？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x651f"
  ],
  "voice": 2520,
  "who": "ルルゥ"
 },
 {
  "id": "s2060:00e00",
  "jp": "これでも吸血鬼っすから、\n暗視はデフォルトっすよ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x6531"
  ],
  "voice": 2521,
  "who": "ラズベリー"
 },
 {
  "id": "s2060:00e36",
  "jp": "へぇ～便利ねぇ。羨ましいわ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x6543"
  ],
  "voice": 2522,
  "who": "エリーシャ"
 },
 {
  "id": "s2060:00e57",
  "jp": "ラズベリーおねえちゃん\nすご～い！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x6578"
  ],
  "voice": 2523,
  "who": "ロコモコ"
 },
 {
  "id": "s2060:00e7d",
  "jp": "いやぁ、ハハ。照れるっす。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x658a"
  ],
  "voice": 2524,
  "who": "ラズベリー"
 },
 {
  "id": "s2060:00e9c",
  "jp": "それにしても……。\n早めに行動して正解だった。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x659c"
  ],
  "voice": 2525,
  "who": "イシュト"
 },
 {
  "id": "s2060:00ece",
  "jp": "えぇ、彼女に構ってたら、\nお宝探しどころじゃ\nなくなってましたよ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x65c3"
  ],
  "voice": 2526,
  "who": "ピンガー"
 },
 {
  "id": "s2060:00f13",
  "jp": "でも、悪いことしたかなぁ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x65d5"
  ],
  "voice": 2527,
  "who": "ルルゥ"
 },
 {
  "id": "s2060:00f32",
  "jp": "いいのよ、\nあぁいう怪しいのに関わってたら、\n碌なことにならないわ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x65e7"
  ],
  "voice": 2528,
  "who": "エリーシャ"
 },
 {
  "id": "s2060:00f79",
  "jp": "急ぎの旅であるしな。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x65f9"
  ],
  "voice": 2529,
  "who": "ミネソタ"
 },
 {
  "id": "s2060:00f92",
  "jp": "君子危うきに近寄らず。\nスルーして正解だろう。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x662c"
  ],
  "voice": 2530,
  "who": "フィービー"
 },
 {
  "id": "s2060:00fc4",
  "jp": "チッ、根性なしどもが。せっかく\n俺が試してやったってのによ……。\nお前ら、引き揚げるぞ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x6694"
  ],
  "voice": 2531,
  "who": "#15"
 },
 {
  "id": "s2060:0101f",
  "jp": "ヘイ！　旦那の姉さん！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x66aa"
  ],
  "voice": 2532,
  "who": "#39"
 },
 {
  "id": "s2060:0103a",
  "jp": "紛らわしいからその呼び方止めろ。\n……さて、久々に、\nあのオカマにでも会いに行くか。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x66c0"
  ],
  "voice": 2533,
  "who": "#15"
 },
 {
  "id": "s2060:01091",
  "jp": "しょうがねぇ。\n無視するわけにもいかねぇからな。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3ed6"
  ],
  "who": "イシュト"
 },
 {
  "id": "s2060:010c1",
  "jp": "な、なんだテメェは！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3eef"
  ],
  "who": "#39"
 },
 {
  "id": "s2060:010d6",
  "jp": "テメェらなんかに名乗るほど、\n俺の名は安くねぇよ！\nさっさと寝ろ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3f09"
  ],
  "who": "イシュト"
 },
 {
  "id": "s2060:01117",
  "jp": "正義のネコ。\nピンガー仮面参上！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3fe4"
  ],
  "who": "ピンガー"
 },
 {
  "id": "s2060:01137",
  "jp": "な、なんだテメェは！\n仮面なんてつけてねぇじゃねぇか！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3ffd"
  ],
  "who": "#39"
 },
 {
  "id": "s2060:0116d",
  "jp": "問答無用！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4017"
  ],
  "who": "ピンガー"
 },
 {
  "id": "s2060:01178",
  "jp": "お姉さん！　今助けるよ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x40eb"
  ],
  "who": "ルルゥ"
 },
 {
  "id": "s2060:01191",
  "jp": "ヘッ！　小娘一人で何ができる！\nテメェラ、やっちまえ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4104"
  ],
  "who": "#39"
 },
 {
  "id": "s2060:011c7",
  "jp": "ま、しょうがないわね。\n助けてあげましょう。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x41df"
  ],
  "who": "エリーシャ"
 },
 {
  "id": "s2060:011f3",
  "jp": "なんだお前は！\n……ってなんだ、女か。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x41f8"
  ],
  "who": "#39"
 },
 {
  "id": "s2060:01219",
  "jp": "女だからって安心するんだ。\nそれって、三流以下のすることよ？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4212"
  ],
  "who": "エリーシャ"
 },
 {
  "id": "s2060:01255",
  "jp": "ま、ゴロツキなんて\nみんなそんなもんか。",
  "en": "",
  "status": "todo",
  "slots": []
 },
 {
  "id": "s2060:0127d",
  "jp": "な、なななんだて、テメェは！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4303"
  ],
  "who": "#39"
 },
 {
  "id": "s2060:0129a",
  "jp": "あぁ～、悪いようにはしねぇから、\nさっさとどっか行け。な？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x431d"
  ],
  "who": "ザザーランド"
 },
 {
  "id": "s2060:012d4",
  "jp": "淑女を狙うマナー違反の輩め。\n成敗してくれる！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x43f1"
  ],
  "who": "ミネソタ"
 },
 {
  "id": "s2060:01302",
  "jp": "うるせぇ野郎だ！\n黙らせてやる！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x440a"
  ],
  "who": "#39"
 },
 {
  "id": "s2060:01322",
  "jp": "女の人を傷つけるのはダメって\nお姉ちゃんが言ってたよ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x44de"
  ],
  "who": "ロコモコ"
 },
 {
  "id": "s2060:01358",
  "jp": "うるせぇガキ！\nガキは帰って飴でも舐めてやがれ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x44f7"
  ],
  "who": "#39"
 },
 {
  "id": "s2060:01388",
  "jp": "こらこら、あまり悪行が過ぎると\n地獄に落ちてしまうっすよ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x45cb"
  ],
  "who": "ラズベリー"
 },
 {
  "id": "s2060:013c2",
  "jp": "あぁ？　なんだこの女。\n地獄に落ちるとか、電波系か？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x45e4"
  ],
  "who": "#39"
 },
 {
  "id": "s2060:013f6",
  "jp": "貴様等の様な輩が海を汚すのだ。\n早々にこの場を立ち去れ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x46b8"
  ],
  "who": "フィービー"
 },
 {
  "id": "s2060:0142e",
  "jp": "やれるもんならやってみやがれ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x46d1"
  ],
  "who": "#39"
 },
 {
  "id": "s2060:0144d",
  "jp": "なんてわかりやすい悪！\nフフフ、腕が鳴るわ……！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x47a5"
  ],
  "who": "ユグドラ"
 },
 {
  "id": "s2060:0147d",
  "jp": "な、なんだコイツ……危ねぇ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x47be"
  ],
  "who": "#39"
 },
 {
  "id": "s2060:0149a",
  "jp": "ガンガー！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4892"
  ],
  "who": "ガング"
 },
 {
  "id": "s2060:014a5",
  "jp": "な、なんだぁ？\nこの人形は？\nってわぁぁ！　襲ってきたぁ！？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x48ab"
  ],
  "who": "#39"
 },
 {
  "id": "s2060:014e0",
  "jp": "麗しき婦女子を襲うなど、\n男の風上にも置けぬ奴等よ！\n覚悟せよ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x497f"
  ],
  "who": "カミュル"
 },
 {
  "id": "s2060:0151f",
  "jp": "ヘッ！　騎士気取りのお坊ちゃんは\n帰って素振りでもしてな！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4998"
  ],
  "who": "#39"
 },
 {
  "id": "s2060:01559",
  "jp": "その身のこなし……。\nただのゴロツキじゃないようね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4a6c"
  ],
  "who": "アンヌ"
 },
 {
  "id": "s2060:0158d",
  "jp": "ヘッヘッヘ。\n女だからって容赦しないぜ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4a85"
  ],
  "who": "#39"
 },
 {
  "id": "s2060:015b5",
  "jp": "あのねぇ。\n演技するなら、もっとマシな\n演技をするんだわさ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4b59"
  ],
  "who": "パメラ"
 },
 {
  "id": "s2060:015f0",
  "jp": "ギクッ！\nな……なんのことやら？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4b72"
  ],
  "who": "#39"
 },
 {
  "id": "s2060:01610",
  "jp": "お嬢さん。\n俺が来たからにはもう大丈夫だ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3b3e"
  ],
  "who": "イシュト"
 },
 {
  "id": "s2060:0163a",
  "jp": "あ、あなたは……！？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3b57"
  ],
  "who": "イータ"
 },
 {
  "id": "s2060:0164f",
  "jp": "俺の名はイシュト！\n通りすがりの……正義の味方さ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3b75"
  ],
  "who": "イシュト"
 },
 {
  "id": "s2060:01681",
  "jp": "……きまった！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3b7c"
  ],
  "who": "イシュト"
 },
 {
  "id": "s2060:01690",
  "jp": "おー！　イシュト、かっこいいー！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3b9a"
  ],
  "who": "ルルゥ"
 },
 {
  "id": "s2060:016b1",
  "jp": "そ、そうか？　ヘヘッ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3bb8"
  ],
  "who": "イシュト"
 },
 {
  "id": "s2060:016c8",
  "jp": "はいはい。満足したなら、\n早くイータさんを助けますよ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3bd6"
  ],
  "who": "ピンガー"
 },
 {
  "id": "s2060:016fe",
  "jp": "おう！",
  "en": "You got it!",
  "status": "done",
  "slots": [
   "0x3bf4"
  ],
  "who": "イシュト"
 },
 {
  "id": "s2060:01705",
  "jp": "もう、バカなんだから……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3c12"
  ],
  "who": "エリーシャ"
 },
 {
  "id": "s2060:01720",
  "jp": "ここコンチェル地域では、\n音楽が生活の一部になっていてね。\n年中音楽が鳴り止まない土地なのさ",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2aa4"
  ],
  "who": "#70"
 },
 {
  "id": "s2060:0177b",
  "jp": "音楽に包まれた生活、素晴らしいと\n思わないかい？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2aab"
  ],
  "who": "#70"
 },
 {
  "id": "s2060:017ab",
  "jp": "少しよろしいか？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2b6d"
  ],
  "who": "#68"
 },
 {
  "id": "s2060:017bc",
  "jp": "おぬし、いい目をしておるの。\nこれをやろう。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2b74"
  ],
  "who": "#68"
 },
 {
  "id": "s2060:017e8",
  "jp": "このベルは、心が綺麗であれば\nあるほど美しい音色が鳴ると\nいわれている。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2be3"
  ],
  "who": "#68"
 },
 {
  "id": "s2060:0182f",
  "jp": "おぬしなら、さぞいい音色が\n出るじゃろう。\nホッホッホ。ではの。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2bea"
  ],
  "who": "#68"
 },
 {
  "id": "s2060:0186e",
  "jp": "この世は音で溢れておる。\nよぉく耳を傾けるんじゃぞ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2c02"
  ],
  "who": "#68"
 },
 {
  "id": "s2060:018a2",
  "jp": "いいね……いいねキミ！\nキミだよ、そこのキミ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2c26"
  ],
  "who": "#75"
 },
 {
  "id": "s2060:018d0",
  "jp": "キミみたいな悪魔役を\nボクは探してたんだ！\nもうボクはキミしか見えてないよ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2c95"
  ],
  "who": "#75"
 },
 {
  "id": "s2060:0191b",
  "jp": "公演は昼からだ！\n是非来てくれたまえよぉ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2c9c"
  ],
  "who": "#75"
 },
 {
  "id": "s2060:01945",
  "jp": "なにをしているんだい！\nもうすぐ公演が始まるよ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2cb4"
  ],
  "who": "#75"
 },
 {
  "id": "s2060:01975",
  "jp": "あぁ、あの素晴らしい吟遊詩人は\nいったい誰だったのかしら。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2d4f"
  ],
  "who": "#72"
 },
 {
  "id": "s2060:019af",
  "jp": "あの人の詩を聞いてから、私の心は\nあの人を追っていってしまったわ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2d56"
  ],
  "who": "#72"
 },
 {
  "id": "s2060:019f1",
  "jp": "あなた、あの吟遊詩人さんと\nお知り合い？\nならば、これを……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2d5d"
  ],
  "who": "#72"
 },
 {
  "id": "s2060:01a2e",
  "jp": "あの人が持っていた楽譜です。\nあの人に返してあげてください。\nお願いしますね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2dcc"
  ],
  "who": "#72"
 },
