[
 {
  "id": "s2075:00028",
  "jp": "私が目覚めたということは……\nそうか、念願が叶ったのか。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2006"
  ],
  "voice": 3546,
  "who": "キーラ"
 },
 {
  "id": "s2075:00064",
  "jp": "ッ！？　誰だお前は！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x201f"
  ],
  "voice": 3547,
  "who": "イシュト"
 },
 {
  "id": "s2075:0007d",
  "jp": "私はキーラ。\nユーフォリアの全てを知る者だ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2038"
  ],
  "voice": 3548,
  "who": "キーラ"
 },
 {
  "id": "s2075:000ad",
  "jp": "ユーフォリアの、全てを……？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2051"
  ],
  "voice": 3549,
  "who": "ルルゥ"
 },
 {
  "id": "s2075:000ce",
  "jp": "いやいや、お前は知らなければ\nおかしいだろう。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x206a"
  ],
  "voice": 3550,
  "who": "キーラ"
 },
 {
  "id": "s2075:00100",
  "jp": "ご、ごめんなさい。\nそれが、私に戻った時に\nまた忘れちゃって……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2083"
  ],
  "voice": 3551,
  "who": "ルルゥ"
 },
 {
  "id": "s2075:00145",
  "jp": "緊急モードのままなのか！？\n燃費が悪いだろうに……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x209c"
  ],
  "voice": 3552,
  "who": "キーラ"
 },
 {
  "id": "s2075:0017d",
  "jp": "なぁおい。なんで、アンタが\nそんなこと知ってるんだ？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x20b5"
  ],
  "voice": 3553,
  "who": "イシュト"
 },
 {
  "id": "s2075:001b5",
  "jp": "ところで、私は一つ不可解なことが\nあるのだが。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x20ce"
  ],
  "voice": 3554,
  "who": "キーラ"
 },
 {
  "id": "s2075:001e7",
  "jp": "え？　無視？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x20e7"
  ],
  "voice": 3555,
  "who": "イシュト"
 },
 {
  "id": "s2075:001f8",
  "jp": "何故、王族のウィルが\n二つあるのだ……？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2100"
  ],
  "voice": 3556,
  "who": "キーラ"
 },
 {
  "id": "s2075:00224",
  "jp": "イシュトはアシュレイと双子だ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x213c"
  ],
  "voice": 3557,
  "who": "ザザーランド"
 },
 {
  "id": "s2075:00247",
  "jp": "双子、か……。\nなんとも面白い展開に\nなっているな。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2155"
  ],
  "voice": 3558,
  "who": "キーラ"
 },
 {
  "id": "s2075:0027e",
  "jp": "まったくだ……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x217c"
  ],
  "voice": 3559,
  "who": "ザザーランド"
 },
 {
  "id": "s2075:00293",
  "jp": "兄貴がユーフォリア王家の\n末裔ってのはわかってるけど……。\n王家ってのはなんですか？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x21a3"
  ],
  "voice": 3560,
  "who": "ピンガー"
 },
 {
  "id": "s2075:002ea",
  "jp": "末裔ではなく転生体なのだがな。\n王族というのはそのままの通り、\n前世が王族の者、という意味だ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x21b9"
  ],
  "voice": 3561,
  "who": "キーラ"
 },
 {
  "id": "s2075:0034b",
  "jp": "古代ユーフォリアは王制国家\nだったのか……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x21cf"
  ],
  "voice": 3562,
  "who": "ミネソタ"
 },
 {
  "id": "s2075:0037b",
  "jp": "俺達は、アイツを止めなきゃ\nならないんだ！\nそこを退いてくれ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x21fd"
  ],
  "voice": 3563,
  "who": "イシュト"
 },
 {
  "id": "s2075:003bc",
  "jp": "止める？　何故だ？\n彼は、ユーフォリアを復活させよう\nとしているのだぞ？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2216"
  ],
  "voice": 3564,
  "who": "キーラ"
 },
 {
  "id": "s2075:00407",
  "jp": "だからじゃない！\n皇国軍なんかに、ユーフォリアを\n渡すわけにはいかないわ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x222c"
  ],
  "voice": 3565,
  "who": "エリーシャ"
 },
 {
  "id": "s2075:00454",
  "jp": "ルキア皇国が何かは知らないが、\n止めるというなら、私はキミ達を\n通すわけにはいかない。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2242"
  ],
  "voice": 3566,
  "who": "キーラ"
 },
 {
  "id": "s2075:004ad",
  "jp": "何！？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2269"
  ],
  "voice": 3567,
  "who": "イシュト"
 },
 {
  "id": "s2075:004b8",
  "jp": "ユーフォリアが滅んだ年。\n私は故郷の復活を願う為にあらゆる\n手段を取った。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2282"
  ],
  "voice": 3568,
  "who": "キーラ"
 },
 {
  "id": "s2075:00505",
  "jp": "そ、それじゃあ……ユーフォリアを\n封印して、カードとルルゥを作った\nのって……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x229b"
  ],
  "voice": 3569,
  "who": "エリーシャ"
 },
 {
  "id": "s2075:00558",
  "jp": "いかにも、私だ。\n正確には全盛期の私なのだがな。\n今は体が鈍ってしょうがない。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x22b4"
  ],
  "voice": 3570,
  "who": "キーラ"
 },
 {
  "id": "s2075:005a9",
  "jp": "どうしますか……？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x22cd"
  ],
  "voice": 3571,
  "who": "ピンガー"
 },
 {
  "id": "s2075:005c0",
  "jp": "どうするも何も、\n突破するしかねぇだろ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x22e6"
  ],
  "voice": 3572,
  "who": "イシュト"
 },
 {
  "id": "s2075:005ec",
  "jp": "二振りの剣……王族達はこのことを\n暗示していたのかもしれないな。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3474"
  ],
  "voice": 3573,
  "who": "キーラ"
 },
 {
  "id": "s2075:00630",
  "jp": "そういえば、この剣のこともよく\nわからねぇんだよな……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x348e"
  ],
  "voice": 3574,
  "who": "イシュト"
 },
 {
  "id": "s2075:0066c",
  "jp": "そうか。\nならそうだな……勝ったら教えて\nやる。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x34ab"
  ],
  "voice": 3575,
  "who": "キーラ"
 },
 {
  "id": "s2075:0069f",
  "jp": "古代人ねぇ……。\nとてもそんな風にはみえませんね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x358d"
  ],
  "who": "ピンガー"
 },
 {
  "id": "s2075:006d1",
  "jp": "私の服装は、\nその時代に合う形に変化する様に\nプログラムされていてな。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x35a6"
  ],
  "who": "キーラ"
 },
 {
  "id": "s2075:00716",
  "jp": "これでも、流行には敏感なのだよ。\nフフフ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x35bb"
  ],
  "who": "キーラ"
 },
 {
  "id": "s2075:00740",
  "jp": "わざわざ緊急プログラムに戻すとは\nなんと無駄な事を……。\n呆れてものも言えないな。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x36b3"
  ],
  "who": "キーラ"
 },
 {
  "id": "s2075:00791",
  "jp": "でも、これが本当の私だって\n私は思うから！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x36cd"
  ],
  "who": "ルルゥ"
 },
 {
  "id": "s2075:007bb",
  "jp": "……まぁ、こんなポヤーっとした\nプログラムを組んだのも私なんだ。\nしょうがない、かな。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x36e6"
  ],
  "who": "キーラ"
 },
 {
  "id": "s2075:00810",
  "jp": "鎌なんて、今時珍しい武器を\n使うのね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x37c1"
  ],
  "who": "エリーシャ"
 },
 {
  "id": "s2075:00836",
  "jp": "そうか？\n私が生きていた頃は、\n結構、主流だったのだがな。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x37da"
  ],
  "who": "キーラ"
 },
 {
  "id": "s2075:0086f",
  "jp": "まぁ、物珍しいなら好都合だ。\n負ける可能性が低くなる。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x37e4"
  ],
  "who": "キーラ"
 },
 {
  "id": "s2075:008a5",
  "jp": "どうやら、\nお前がこの団体のリーダーと\n見受けられる。違うか？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x38dc"
  ],
  "who": "キーラ"
 },
 {
  "id": "s2075:008e2",
  "jp": "ほぉ、見る目があるじゃねぇの。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x38f6"
  ],
  "who": "ザザーランド"
 },
 {
  "id": "s2075:00901",
  "jp": "いかにも、\n俺がこのグロリア海賊団船長の、\nザザーランドだ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x390b"
  ],
  "who": "ザザーランド"
 },
 {
  "id": "s2075:0093c",
  "jp": "つまり、お前を倒せばこちらが\n有利となるわけだ……いくぞ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3924"
  ],
  "who": "キーラ"
 },
 {
  "id": "s2075:00976",
  "jp": "一つだけ聞きたい。\n現代の学問は、数千年前の学問に\nどれ程までに近づいている？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3a0d"
  ],
  "who": "ミネソタ"
 },
 {
  "id": "s2075:009c3",
  "jp": "そうだな。\nお前達の姿を見るに……。\n１２０％と言った所か。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3a26"
  ],
  "who": "キーラ"
 },
 {
  "id": "s2075:009fe",
  "jp": "何！？\n現代は、既に古代ユーフォリアを\n上回っているということか！？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3a40"
  ],
  "who": "ミネソタ"
 },
 {
  "id": "s2075:00a41",
  "jp": "古代ユーフォリアの学問は、\nウィルの一点張りだったからなぁ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3a59"
  ],
  "who": "キーラ"
 },
 {
  "id": "s2075:00a7d",
  "jp": "総合的に見ると、\nお前らの技術は古代ユーフォリアを\n遥かに上回っている。よかったな。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3a63"
  ],
  "who": "キーラ"
 },
 {
  "id": "s2075:00ad0",
  "jp": "ほぉ、魔法か。懐かしいな。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3b5b"
  ],
  "who": "キーラ"
 },
 {
  "id": "s2075:00aeb",
  "jp": "え！？　魔法を知ってるの！？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3b75"
  ],
  "who": "ロコモコ"
 },
 {
  "id": "s2075:00b08",
  "jp": "ユーフォリアの最終兵器。\nシンフォニアに対抗する為に\n作られた特殊技法。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3b8e"
  ],
  "who": "キーラ"
 },
 {
  "id": "s2075:00b4f",
  "jp": "それが、魔法だよ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3b98"
  ],
  "who": "キーラ"
 },
 {
  "id": "s2075:00b62",
  "jp": "そ、そうだったんだ……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3bb2"
  ],
  "who": "ロコモコ"
 },
 {
  "id": "s2075:00b7b",
  "jp": "さて、お喋りはここまでだ。\nいくぞ。小さな魔法使いよ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3bcb"
  ],
  "who": "キーラ"
 },
 {
  "id": "s2075:00bb1",
  "jp": "その羽……お前、黄泉の者か？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3cc3"
  ],
  "who": "キーラ"
 },
 {
  "id": "s2075:00bce",
  "jp": "え！　わかるんすか？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3cdd"
  ],
  "who": "ラズベリー"
 },
 {
  "id": "s2075:00be3",
  "jp": "一人知り合いがいてな。\nフッ、懐かしいものだ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3cf6"
  ],
  "who": "キーラ"
 },
 {
  "id": "s2075:00c11",
  "jp": "ウンディーネか。\n水の精霊として崇められていた者が\n手に武器を持っているとは。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3dee"
  ],
  "who": "キーラ"
 },
 {
  "id": "s2075:00c5e",
  "jp": "時代の変化を感じるな。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3df8"
  ],
  "who": "キーラ"
 },
 {
  "id": "s2075:00c75",
  "jp": "こんな時代にしたきっかけである\n国の住人が、偉そうな口をきくな！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3e12"
  ],
  "who": "フィービー"
 },
 {
  "id": "s2075:00cb5",
  "jp": "やれやれ、ケンカっぱやい\n精霊もいたものだな。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3e2b"
  ],
  "who": "キーラ"
 },
 {
  "id": "s2075:00ce3",
  "jp": "よかろう。\nかかってこい。\n私は、強いぞ？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3e40"
  ],
  "who": "キーラ"
 },
 {
  "id": "s2075:00d0c",
  "jp": "ガンガガ、ガンガガ！！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3f1b"
  ],
  "who": "ガング"
 },
 {
  "id": "s2075:00d23",
  "jp": "な、何故、遺跡の守護固体が\nこんな所に……？\nプログラムを誤ったか……？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3f34"
  ],
  "who": "キーラ"
 },
 {
  "id": "s2075:00d6a",
  "jp": "ほぉ、その武器。\n私ですら見たことがないとは……。\n珍しいな。少し撃ってみてくれ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x401e"
  ],
  "who": "キーラ"
 },
 {
  "id": "s2075:00dbb",
  "jp": "言われなくても撃ちますよ！\nせいぜい、怪我をなさらぬように\nしてくださいね！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4038"
  ],
  "who": "ユグドラ"
 },
 {
  "id": "s2075:00e06",
  "jp": "古代人……か。\nとてもそのようには見えないな。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x410c"
  ],
  "who": "カミュル"
 },
 {
  "id": "s2075:00e34",
  "jp": "お前の古代人のイメージは\n知らないが。\nまぁ、期待に沿えずにスマンな。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4125"
  ],
  "who": "キーラ"
 },
 {
  "id": "s2075:00e79",
  "jp": "ねぇ。なんか、古代ユーフォリアに\n関わるお宝なんてないの？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4200"
  ],
  "who": "アンヌ"
 },
 {
  "id": "s2075:00eb3",
  "jp": "現代の物の価値が\n私にわかるわけなかろう。\nまぁ、あるとしたら、この遺跡だな",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4219"
  ],
  "who": "キーラ"
 },
 {
  "id": "s2075:00efe",
  "jp": "じゃあここは宝の山ってわけね。\nウフフ。\n後が楽しみね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4233"
  ],
  "who": "アンヌ"
 },
 {
  "id": "s2075:00f35",
  "jp": "なんかアンタ、私と雰囲気が\n似てるんだわさ……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4315"
  ],
  "who": "パメラ"
 },
 {
  "id": "s2075:00f65",
  "jp": "そうか？　私には感じないんだが。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x432e"
  ],
  "who": "キーラ"
 },
 {
  "id": "s2075:00f86",
  "jp": "ムカツク！　目立ち役はこの\nパメラ様だけで充分なんだわさ！\nアンタなんか、ぶっ倒してやる！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4348"
  ],
  "who": "パメラ"
 },
 {
  "id": "s2075:00fdf",
  "jp": "おや、こんな所で神界の住人に\n会うとは。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x444e"
  ],
  "who": "キーラ"
 },
 {
  "id": "s2075:01007",
  "jp": "……アナタ。\n神界とはどういった関係が？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4468"
  ],
  "who": "イータ"
 },
 {
  "id": "s2075:0102f",
  "jp": "なに、ただ眠っている間に\n世話になっただけだよ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4481"
  ],
  "who": "キーラ"
 },
 {
  "id": "s2075:0105f",
  "jp": "テメェの顔、なぁんか気にいらねぇ！\n一発殴らせろ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x44d4"
  ],
  "who": "#15"
 },
 {
  "id": "s2075:01091",
  "jp": "り、理不尽な神界人だな……。\n困った……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x44ed"
  ],
  "who": "キーラ"
 },
 {
  "id": "s2075:010bb",
  "jp": "おいおい！　なんだよコイツの\nフォーメーションは！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x45e0"
  ],
  "voice": 3576,
  "who": "イシュト"
 },
 {
  "id": "s2075:010f1",
  "jp": "縦横斜め……メチャクチャね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x45fe"
  ],
  "voice": 3577,
  "who": "エリーシャ"
 },
 {
  "id": "s2075:01112",
  "jp": "私に性別はない。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4617"
  ],
  "voice": 3578,
  "who": "キーラ"
 },
 {
  "id": "s2075:01127",
  "jp": "そんな人間、いるはずありません。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4635"
  ],
  "voice": 3579,
  "who": "ピンガー"
 },
 {
  "id": "s2075:0114c",
  "jp": "そうだな。\n私の体は、既に人ではない。\n何年海に沈んでいたと思う。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x464e"
  ],
  "voice": 3580,
  "who": "キーラ"
 },
 {
  "id": "s2075:01191",
  "jp": "古代ユーフォリア王国が沈んだのは\n今から約千年前だ……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x466c"
  ],
  "voice": 3581,
  "who": "ザザーランド"
 },
 {
  "id": "s2075:011cd",
  "jp": "ユーフォリアと共に眠るためには、\n人間をやめるしかなかったのだ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4685"
  ],
  "voice": 3582,
  "who": "キーラ"
 },
 {
  "id": "s2075:01211",
  "jp": "そこまでして、ユーフォリアを\n復活させたかったのか。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x46a3"
  ],
  "voice": 3583,
  "who": "イシュト"
 },
 {
  "id": "s2075:01249",
  "jp": "ユーフォリアは全てを統べる存在。\n失わせるわけにはいかなかった。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x46bc"
  ],
  "voice": 3584,
  "who": "キーラ"
 },
 {
  "id": "s2075:0128d",
  "jp": "それが悪用されようとしている\nのにか。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x46da"
  ],
  "voice": 3585,
  "who": "イシュト"
 },
 {
  "id": "s2075:012b7",
  "jp": "正直言うとな……。\n千年後のことなんてわかるかい！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x470f"
  ],
  "voice": 3586,
  "who": "キーラ"
 },
 {
  "id": "s2075:012ed",
  "jp": "うわ！　無責任な人だった！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x472d"
  ],
  "voice": 3587,
  "who": "ピンガー"
 },
 {
  "id": "s2075:0130c",
  "jp": "人間やめてまで故郷を守ったんだ！\n阻まれてたまるか！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4746"
  ],
  "voice": 3588,
  "who": "キーラ"
 },
 {
  "id": "s2075:01344",
  "jp": "グロリア海賊団！\nアシュレイ様のもとへは行かさん！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4c68"
  ],
  "voice": 3617,
  "who": "#53"
 },
 {
  "id": "s2075:0137a",
  "jp": "チ、メンドクセーのが出てきたぜ！\nザコはさっさと片付けるぞ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4c86"
  ],
  "voice": 3618,
  "who": "ザザーランド"
 },
 {
  "id": "s2075:013ba",
  "jp": "王族のウィルのみを注目していたが\n……なるほど他の戦闘員のウィルも\n中々目を張るものがある。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x500c"
  ],
  "voice": 3589,
  "who": "キーラ"
 },
 {
  "id": "s2075:01419",
  "jp": "見事だ……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5016"
  ],
  "voice": 3590,
  "who": "キーラ"
 },
 {
  "id": "s2075:0142a",
  "jp": "まさか、私の力を上回るとはな。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5877"
  ],
  "voice": 3591,
  "who": "キーラ"
 },
 {
  "id": "s2075:0144d",
  "jp": "教えてくれ……何故、ユーフォリア\nは海に沈んだんだ？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5890"
  ],
  "voice": 3592,
  "who": "イシュト"
 },
 {
  "id": "s2075:01485",
  "jp": "……。\nこの世界は、あらゆるウィルで\n出来ている。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x58a9"
  ],
  "voice": 3593,
  "who": "キーラ"
 },
 {
  "id": "s2075:014ba",
  "jp": "ユーフォリアは、その全てを\nエネルギーに変換させて生活を\nしていた。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x58b0"
  ],
  "voice": 3594,
  "who": "キーラ"
 },
 {
  "id": "s2075:01501",
  "jp": "エネルギーに変換！？\nアジョー・グラフォーが言ってた、\nルルゥの機能……！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x58c6"
  ],
  "voice": 3595,
  "who": "エリーシャ"
 },
 {
  "id": "s2075:0154e",
  "jp": "しかし、私達は知らなかった。\nこの世界のウィルは、有限だった\nのだ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x58dc"
  ],
  "voice": 3596,
  "who": "キーラ"
 },
 {
  "id": "s2075:01595",
  "jp": "古代ユーフォリア王国は、\nウィルの枯渇が原因で滅んだのか……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x58f5"
  ],
  "voice": 3597,
  "who": "ザザーランド"
 },
 {
  "id": "s2075:015d7",
  "jp": "私は再びウィルが世界を満たすまで\nユーフォリアと共に眠りについた\nのであった。完。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x590e"
  ],
  "voice": 3598,
  "who": "キーラ"
 },
 {
  "id": "s2075:0162c",
  "jp": "ルルゥと遺跡のカードを作ったのも\nお前なのか？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5927"
  ],
  "voice": 3599,
  "who": "イシュト"
 },
 {
  "id": "s2075:0165e",
  "jp": "そうだ。カードは世界のウィルを\n少しずつ吸収し、シンフォニアの\n動力源とするため。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5940"
  ],
  "voice": 3600,
  "who": "キーラ"
 },
 {
  "id": "s2075:016b3",
  "jp": "シンフォニアは、ユーフォリアの\n核となるための存在だ。",
