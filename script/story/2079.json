   "0x1e16"
  ],
  "voice": 3891,
  "who": "ルルゥ"
 },
 {
  "id": "s2079:0087d",
  "jp": "ボク達の意思をぶつければ\n兄貴の意思が勝つ。\nそういうことですね。",
