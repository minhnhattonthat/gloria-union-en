  "status": "todo",
  "slots": [
   "0x1b1a"
  ],
  "voice": 3868,
  "who": "ザザーランド"
 },
 {
  "id": "s2079:0039a",
  "jp": "アシュレイ、てめえええぇぇ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1b48"
  ],
  "voice": 3869,
  "who": "#36"
 },
 {
  "id": "s2079:003bb",
  "jp": "イシュト、\nお前は僕と一つになってくれ！\nそして、僕の夢を叶えてくれ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1b61"
  ],
  "voice": 3870,
  "who": "#35"
 },
 {
  "id": "s2079:00404",
  "jp": "イシュトの体から、\nアシュレイの声が聞こえる……。",
