   "0x1ae1"
  ],
  "voice": 3866,
  "who": "ザザーランド"
 },
 {
  "id": "s2079:00315",
  "jp": "二人が、一人になろうとしてる。\nアシュレイとイシュトが、\n一つになろうとしているの！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1afa"
  ],
  "voice": 3867,
  "who": "ルルゥ"
 },
