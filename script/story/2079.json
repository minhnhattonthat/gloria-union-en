  "status": "todo",
  "slots": [
   "0x255b"
  ],
  "voice": 3919,
  "who": "ザザーランド"
 },
 {
  "id": "s2079:00e2f",
  "jp": "あんなにマナーを守れなかった\n少年が、立派になったものだ。",
