  "status": "todo",
  "slots": [
   "0x262f"
  ],
  "who": "ミネソタ"
 },
 {
  "id": "s2079:00e69",
  "jp": "だが、大人として、\nまだまだ負けるわけにはいかない！",
  "en": "",
