  "status": "todo",
  "slots": [
   "0x5bda"
  ],
  "who": "#15"
 },
 {
  "id": "s2065:010b7",
  "jp": "いいよなぁこの色！\nチャンピオンって感じがするぜ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5c25"
  ],
  "who": "#15"
 },
 {
  "id": "s2065:028c4",
  "jp": "そうそう、私が遺跡で言ったこと\nまだ覚えていますか？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4541"
  ],
  "voice": 2002,
  "who": "トレイシー"
 },
 {
  "id": "s2065:028fc",
  "jp": "古代ユーフォリア王家の末裔。\nそう言ったな。\nもしかして、俺が、それなのか？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x455a"
  ],
  "voice": 2003,
  "who": "イシュト"
 },
 {
  "id": "s2065:0294b",
  "jp": "皇帝陛下もね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x4573"
  ],
  "voice": 2004,
  "who": "トレイシー"
 },
 {
  "id": "s2065:0295e",
  "jp": "この剣と、ルルゥのことも知って\nいるのか……？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x458c"
  ],
  "voice": 2005,
  "who": "イシュト"
 },
 {
  "id": "s2065:02990",
  "jp": "全ての答えは、ユーフォリアに\nあります。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x45a5"
  ],
  "voice": 2006,
  "who": "トレイシー"
 },
 {
  "id": "s2065:029bc",
  "jp": "ユーフォリアに……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x45be"
  ],
  "voice": 2007,
  "who": "イシュト"
 },
 {
  "id": "s2065:029d5",
  "jp": "お話はコレでお終いです。\nさぁ、かかってきて。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x45d7"
  ],
  "voice": 2008,
  "who": "トレイシー"
 },
 {
  "id": "s2065:02a07",
  "jp": "……どうした、随分と覇気がないな",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5cfc"
  ],
  "voice": 2009,
  "who": "イシュト"
 },
 {
  "id": "s2065:02a2c",
  "jp": "私は人より知恵のあるただの女\nですから。フフ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5d15"
  ],
  "voice": 2010,
  "who": "トレイシー"
 },
 {
  "id": "s2065:02a5e",
  "jp": "本当は気が進まないんですよ？\nあなたは私の娘同然なんですから。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5e0e"
  ],
  "voice": 2011,
  "who": "トレイシー"
 },
 {
  "id": "s2065:02aa0",
  "jp": "だとしても、子供を捨てる親を\nボクは親とは認めませんよ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5e28"
  ],
  "voice": 2012,
  "who": "ピンガー"
 },
 {
  "id": "s2065:02adc",
  "jp": "ねぇ、ピンガー。\nこの近くに、昔多くの町や村が\nあったこと……知ってる？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5e41"
  ],
  "voice": 2013,
  "who": "トレイシー"
 },
 {
  "id": "s2065:02b27",
  "jp": "知ってますよ……ボクの、故郷だ。\n廃墟になってますが、確かに\nここは、ボクの故郷……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5e5b"
  ],
  "voice": 2014,
  "who": "ピンガー"
 },
 {
  "id": "s2065:02b80",
  "jp": "そう、そして、私の始まりの地でも\nある。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5e74"
  ],
  "voice": 2015,
  "who": "トレイシー"
 },
 {
  "id": "s2065:02bac",
  "jp": "この島で、私の全てが始まり、\n私の全てが狂った……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5e7b"
  ],
  "voice": 2016,
  "who": "トレイシー"
 },
 {
  "id": "s2065:02be4",
  "jp": "なら、終わらせてあげます。\nボクの、手で！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5e95"
  ],
  "voice": 2017,
  "who": "ピンガー"
 },
 {
  "id": "s2065:02c12",
  "jp": "ねぇ、本当にアナタが、\nあのベルガスを作ったの？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5f70"
  ],
  "who": "ルルゥ"
 },
 {
  "id": "s2065:02c42",
  "jp": "……なぜ、そう思うのです？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5f89"
  ],
  "who": "トレイシー"
 },
 {
  "id": "s2065:02c5d",
  "jp": "ベルガスの体に流れていた\n“もう一つのウィル”\nあのウィル……まさか。私の。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5fa3"
  ],
  "who": "ルルゥ"
 },
 {
  "id": "s2065:02ca8",
  "jp": "フフフ。\nさぁて、どうかしらね？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x5fbc"
  ],
  "who": "トレイシー"
 },
 {
  "id": "s2065:02cc8",
  "jp": "アンタ、見た目はそんなに\n悪そうじゃないってのに。\nとんだ化けの皮を被ってるのね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x6097"
  ],
  "who": "エリーシャ"
 },
 {
  "id": "s2065:02d19",
  "jp": "ウフフ。商人ですから。\n化けの皮の一枚や二枚は持って\nいないと。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x60b0"
  ],
  "who": "トレイシー"
 },
 {
  "id": "s2065:02d58",
  "jp": "今のアンタも化けの皮ってわけ？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x60ca"
  ],
  "who": "エリーシャ"
 },
 {
  "id": "s2065:02d77",
  "jp": "面白いわ。\nアンタの皮。残さず全部剥ぎ取って\nやるんだから！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x60df"
  ],
  "who": "エリーシャ"
 },
 {
  "id": "s2065:02db2",
  "jp": "聞きそびれていたんだが……。\nお前、何故ルキア皇国と\n手を組んだんだ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x61ba"
  ],
  "who": "ザザーランド"
 },
 {
  "id": "s2065:02df7",
  "jp": "これだけの大商団だ。\n金には困ってなかっただろう？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x61c4"
  ],
  "who": "ザザーランド"
 },
 {
  "id": "s2065:02e29",
  "jp": "皇国軍に属せば、数多くの戦場を\n周る事になります。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x61dd"
  ],
  "who": "トレイシー"
 },
 {
  "id": "s2065:02e5b",
  "jp": "そして、そこには数多くの人がいる\n……そういうことですよ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x61e7"
  ],
  "who": "トレイシー"
 },
 {
  "id": "s2065:02e95",
  "jp": "すまないが、少し、キミの研究室を\n見せてくれないか？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x62bb"
  ],
  "who": "ミネソタ"
 },
 {
  "id": "s2065:02ec9",
  "jp": "あらあら。アナタも、私の研究に\n興味がおありなのかしら？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x62d4"
  ],
  "who": "トレイシー"
 },
 {
  "id": "s2065:02f01",
  "jp": "いや。\nただ、私にはどうもキミが悪者に\n見えなくてね。気になったんだ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x62ee"
  ],
  "who": "ミネソタ"
 },
 {
  "id": "s2065:02f46",
  "jp": "ウフフ。\n稀有な人もいたものですね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x6307"
  ],
  "who": "トレイシー"
 },
 {
  "id": "s2065:02f6a",
  "jp": "ん？　お姉ちゃん。\nなんだかウィルに元気ないね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x63db"
  ],
  "who": "ロコモコ"
 },
 {
  "id": "s2065:02f9a",
  "jp": "ここは私の思い出の地でして。\n少し、感傷に浸っていたのですよ。\nまぁ、アナタには関係ありません。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x63f4"
  ],
  "who": "トレイシー"
 },
 {
  "id": "s2065:02ff9",
  "jp": "黄泉の国……今まで私の手に\nかかった人達も、いるのですかね？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x64de"
  ],
  "who": "トレイシー"
 },
 {
  "id": "s2065:03035",
  "jp": "少なくとも、罪人課でアナタの\n名前は聞いたことがないっす。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x64f8"
  ],
  "who": "ラズベリー"
 },
 {
  "id": "s2065:0306f",
  "jp": "あら、そう……残念だわ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x6511"
  ],
  "who": "トレイシー"
 },
 {
  "id": "s2065:03088",
  "jp": "ウンディーネ、獣人。\n共に人間の亜種にして、\n不老で強靭な肉体を持つ種族。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x65fb"
  ],
  "who": "トレイシー"
 },
 {
  "id": "s2065:030d1",
  "jp": "ウフフ。まさしく、人類の夢ですね\n私の最終目標ともいえます。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x6605"
  ],
  "who": "トレイシー"
 },
 {
  "id": "s2065:0310d",
  "jp": "その過程で生まれたのが\nピンガーというわけか……。\nふざけやがって……！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x661f"
  ],
  "who": "フィービー"
 },
 {
  "id": "s2065:03154",
  "jp": "貴様の様な奴には絶対に負けん！\n我が怒りの槍！　受けてみよ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x6629"
  ],
  "who": "フィービー"
 },
 {
  "id": "s2065:03190",
  "jp": "ガガング、ガンガンガガン！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x66fd"
  ],
  "who": "ガング"
 },
 {
  "id": "s2065:031ab",
  "jp": "生身と機械の融合……先人達は、\n果たしてそれすらも、行っていたと\nいうのでしょうか。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x6716"
  ],
  "who": "トレイシー"
 },
 {
  "id": "s2065:031fe",
  "jp": "ウフフ。古代ユーフォリアには、\n夢がたくさんですね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x6720"
  ],
  "who": "トレイシー"
 },
 {
  "id": "s2065:03232",
  "jp": "アナタの研究で亡くなった\n人達の分も、私は負けません！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x67f4"
  ],
  "who": "ユグドラ"
 },
 {
  "id": "s2065:03268",
  "jp": "では、私は亡くなった人達の分も、\n精一杯生きるとしましょうか。\nウフフ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x680d"
  ],
  "who": "トレイシー"
 },
 {
  "id": "s2065:032af",
  "jp": "体を機械化して人を強化するなど、\n愚の極み！\nそなたは武を愚弄している！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x68e1"
  ],
  "who": "カミュル"
 },
 {
  "id": "s2065:032f6",
  "jp": "ドーピングは立派な薬学\nなんですけどね。\nアナタもしてみますか？　ウフフ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x68fa"
  ],
  "who": "トレイシー"
 },
 {
  "id": "s2065:0333f",
  "jp": "姉さん。本当の事を話さないの？\nそうすれば、あの人達のことだし、\n許してくれるかもよ？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x69ce"
  ],
  "who": "アンヌ"
 },
 {
  "id": "s2065:03394",
  "jp": "今更許される気などありません。\n誰にも、ね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x69e7"
  ],
  "who": "トレイシー"
 },
 {
  "id": "s2065:033c0",
  "jp": "人と獣を融合させるなんて、\n思い切った事するわねぇ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x6abb"
  ],
  "who": "パメラ"
 },
 {
  "id": "s2065:033f4",
  "jp": "アンタとは美味い酒が飲めそう\nだわさ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x6ac5"
  ],
  "who": "パメラ"
 },
 {
  "id": "s2065:0341a",
  "jp": "ウフフ。お互い、悪趣味ですね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x6ade"
  ],
  "who": "トレイシー"
 },
 {
  "id": "s2065:03439",
  "jp": "アナタの所業、詩に残すのも\n憚れますわ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x6bc0"
  ],
  "who": "イータ"
 },
 {
  "id": "s2065:03461",
  "jp": "確かに。\n私の歴史は、詩にするには\n少し辛すぎますね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x6bd9"
  ],
  "who": "トレイシー"
 },
 {
  "id": "s2065:03496",
  "jp": "俺はテメェみてぇな陰湿で汚ぇ奴が\n大嫌いなんだよ！\n一発殴らせろ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x6c25"
  ],
  "who": "#15"
 },
 {
  "id": "s2065:034d7",
  "jp": "私はか弱い女性ですから。\nこうでもしないと勝てないんですよ\nごめんなさいね。",
