  "id": "s2065:04196",
  "jp": "えぇ、本当です。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x7ee5"
  ],
  "voice": 2077,
  "who": "エンリエッタ"
 },
 {
  "id": "s2065:041ab",
  "jp": "なんで、そのことを俺達に\n教えるんだ？",
