[
 {
  "id": "s2069:00028",
  "jp": "お母さん……あの実験。\nどういうことなの？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1661"
  ],
  "voice": 3108,
  "who": "エリーシャ"
 },
 {
  "id": "s2069:00056",
  "jp": "あの方々の犠牲のおかげで、\nルルゥＭｋ－２が生まれたのよ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x167a"
  ],
  "voice": 3109,
  "who": "エンリエッタ"
 },
 {
  "id": "s2069:00094",
  "jp": "なにが生まれたよ！\n戦争の道具を作っただけじゃない！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1693"
  ],
  "voice": 3110,
  "who": "エリーシャ"
 },
 {
  "id": "s2069:000cc",
  "jp": "それを言うなら、アナタ達だって、\nルルゥという戦争の道具を使って\n敵を倒しているじゃない。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x16ac"
  ],
  "voice": 3111,
  "who": "エンリエッタ"
 },
 {
  "id": "s2069:00129",
  "jp": "ルルゥは家族だ！\n道具なんて安い言葉を\n使うんじゃねぇよ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x16c5"
  ],
  "voice": 3112,
  "who": "イシュト"
 },
 {
  "id": "s2069:00166",
  "jp": "アナタ達は、ここに来るまでに\n何人の人を殺めましたか？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x16de"
  ],
  "voice": 3113,
  "who": "エンリエッタ"
 },
 {
  "id": "s2069:001a0",
  "jp": "ッ！！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x16fe"
  ],
  "voice": 3114,
  "who": "イシュト"
 },
 {
  "id": "s2069:001ab",
  "jp": "人は皆犠牲の上に立っている。\nしかし、犠牲は平等に力を与えて\nしまう。悪にも、正義にもです。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x171e"
  ],
  "voice": 3115,
  "who": "エンリエッタ"
 },
 {
  "id": "s2069:0020a",
  "jp": "それならば、こちらで犠牲を\n決めちまえば、悪に力は生まれない\n……そうだったよな。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1737"
  ],
  "voice": 3116,
  "who": "ザザーランド"
 },
 {
  "id": "s2069:0025f",
  "jp": "憶えていてくれたのね。\n嬉しいわ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1750"
  ],
  "voice": 3117,
  "who": "エンリエッタ"
 },
 {
  "id": "s2069:00285",
  "jp": "憶えていたよ……\n憶えていたからこそ、\n俺は今のお前が許せない！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1774"
  ],
  "voice": 3118,
  "who": "ザザーランド"
 },
 {
  "id": "s2069:002c8",
  "jp": "どういうこと？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x178a"
  ],
  "voice": 3119,
  "who": "エンリエッタ"
 },
 {
  "id": "s2069:002db",
  "jp": "犠牲が必要といいながら、犠牲を\n出すことを心から嫌っていたお前が\n……こんなことをしているからだ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x17a3"
  ],
  "voice": 3120,
  "who": "ザザーランド"
 },
 {
  "id": "s2069:00340",
  "jp": "……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x17ca"
  ],
  "voice": 3121,
  "who": "エンリエッタ"
 },
 {
  "id": "s2069:0034b",
  "jp": "お前は誰よりも優しかったんだ！\n誰よりも人を愛していたんだ！\nそれなのに……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x17e3"
  ],
  "voice": 3122,
  "who": "ザザーランド"
 },
 {
  "id": "s2069:0039c",
  "jp": "今のお前は、何をしているんだ！！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x17ed"
  ],
  "voice": 3123,
  "who": "ザザーランド"
 },
 {
  "id": "s2069:003c1",
  "jp": "黙りなさい……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1806"
  ],
  "voice": 3124,
  "who": "エンリエッタ"
 },
 {
  "id": "s2069:003d6",
  "jp": "何がエルマーレ連合だ！\n何が反皇国連合軍だ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x181f"
  ],
  "voice": 3125,
  "who": "ザザーランド"
 },
 {
  "id": "s2069:00406",
  "jp": "黙りなさい……！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1838"
  ],
  "voice": 3126,
  "who": "エンリエッタ"
 },
 {
  "id": "s2069:0041b",
  "jp": "お前はこの１７年間……どれだけの\n無駄な犠牲を出したんだ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1851"
  ],
  "voice": 3127,
  "who": "ザザーランド"
 },
 {
  "id": "s2069:00459",
  "jp": "黙れぇ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1871"
  ],
  "voice": 3128,
  "who": "エンリエッタ"
 },
 {
  "id": "s2069:00466",
  "jp": "無駄な犠牲なんてない！\n彼らの魂は、犠牲は！\n私の意思となって生き続けている！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x187d"
  ],
  "voice": 3129,
  "who": "エンリエッタ"
 },
 {
  "id": "s2069:004b7",
  "jp": "それを否定する奴は……。\n許さない！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1887"
  ],
  "voice": 3130,
  "who": "エンリエッタ"
 },
 {
  "id": "s2069:004df",
  "jp": "親父ぃ、お母さんを怒らせて\nどうするのよ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1947"
  ],
  "voice": 3131,
  "who": "エリーシャ"
 },
 {
  "id": "s2069:0050d",
  "jp": "おかげでウィルが\nうなぎのぼりだよ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1965"
  ],
  "voice": 3132,
  "who": "ルルゥ"
 },
 {
  "id": "s2069:00535",
  "jp": "すまねぇ。\nただ、どうしても、な。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1983"
  ],
  "voice": 3133,
  "who": "ザザーランド"
 },
 {
  "id": "s2069:0055b",
  "jp": "安心しろって親父、俺は親父と\n同意見だぜ？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x199c"
  ],
  "voice": 3134,
  "who": "イシュト"
 },
 {
  "id": "s2069:00589",
  "jp": "お前みたいなひよっ子に同意され\nても、嬉しくもなんともねぇよ！\nお前ら、気ぃ引き締めろよ？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x19ba"
  ],
  "voice": 3135,
  "who": "ザザーランド"
 },
 {
  "id": "s2069:005e6",
  "jp": "おうよ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x19d3"
  ],
  "voice": 3136,
  "who": "イシュト"
 },
 {
  "id": "s2069:005f3",
  "jp": "エリーシャ、\nアナタも、彼と同意見なの……？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x21bb"
  ],
  "voice": 3137,
  "who": "エンリエッタ"
 },
 {
  "id": "s2069:00623",
  "jp": "えぇ、誰に育てられてきた\nと思ってるの？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x21d5"
  ],
  "voice": 3138,
  "who": "エリーシャ"
 },
 {
  "id": "s2069:0064f",
  "jp": "そう。\nならば、アナタもここで、\n犠牲となりなさい！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x21ee"
  ],
  "voice": 3139,
  "who": "エンリエッタ"
 },
 {
  "id": "s2069:00686",
  "jp": "私は、アナタを殺す。\nアナタの犠牲の上に立って、\n世界を平和にしてみせる。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x22e7"
  ],
  "voice": 3140,
  "who": "エンリエッタ"
 },
 {
  "id": "s2069:006d3",
  "jp": "やれるもんならやってみな。\n俺は、強いぜ？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2301"
  ],
  "voice": 3141,
  "who": "ザザーランド"
 },
 {
  "id": "s2069:00701",
  "jp": "アナタも犠牲の上に立つ人間なら\nわかるはずです！\n私の意思が、願いが！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1e99"
  ],
  "who": "エンリエッタ"
 },
 {
  "id": "s2069:00746",
  "jp": "わからねぇよ！\n俺は、犠牲の上に立つなんて事は\nできねぇ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1eb3"
  ],
  "who": "イシュト"
 },
 {
  "id": "s2069:0077f",
  "jp": "アイツは、俺の、永遠のライバル\nなんだからなぁ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1ebd"
  ],
  "who": "イシュト"
 },
 {
  "id": "s2069:007af",
  "jp": "何故、何故わからないのですか！\n平和を願う気持ちは、\n皆一緒のハズです！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1fa7"
  ],
  "who": "エンリエッタ"
 },
 {
  "id": "s2069:007f6",
  "jp": "残念ながら、平和ってのは\nそこにいる人と同じ数\n存在するんですよ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1fc1"
  ],
  "who": "ピンガー"
 },
 {
  "id": "s2069:00837",
  "jp": "例えどんな戦火の中でも、\n笑ってる人はいるんですよ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1fcb"
  ],
  "who": "ピンガー"
 },
 {
  "id": "s2069:0086b",
  "jp": "仲間が一人消えるたびに、ウィルが\n高まっていく……悲しいね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x209f"
  ],
  "who": "ルルゥ"
 },
 {
  "id": "s2069:008a7",
  "jp": "黙りなさい！\nアナタさえいなくなれば、\n皇国軍の計画は崩れる！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x20b8"
  ],
  "who": "エンリエッタ"
 },
 {
  "id": "s2069:008e4",
  "jp": "覚悟しなさい！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x20c2"
  ],
  "who": "エンリエッタ"
 },
 {
  "id": "s2069:008f3",
  "jp": "アッチが立てばコッチが立たず。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x23d5"
  ],
  "who": "ミネソタ"
 },
 {
  "id": "s2069:00912",
  "jp": "難しいものだな。人というのは。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x23df"
  ],
  "who": "ミネソタ"
 },
 {
  "id": "s2069:00931",
  "jp": "だからこそ、私の様な者が\n必要なのです！\n平和を別ける、審判者が。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x23f8"
  ],
  "who": "エンリエッタ"
 },
 {
  "id": "s2069:00972",
  "jp": "死んだ人を犠牲なんて呼んで。\nそれって、なんかおかしいよね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x24cc"
  ],
  "who": "ロコモコ"
 },
 {
  "id": "s2069:009ae",
  "jp": "純粋な子供にはわかりませんよ。\nこの、捩れきった世界の事なんて。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x24e5"
  ],
  "who": "エンリエッタ"
 },
 {
  "id": "s2069:009ee",
  "jp": "犠牲、ねぇ。\n私にはよくわからないっすよ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x25b2"
  ],
  "who": "ラズベリー"
 },
 {
  "id": "s2069:00a18",
  "jp": "死体に理由がついたって、\n死体は死体なんすから。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x25bc"
  ],
  "who": "ラズベリー"
 },
 {
  "id": "s2069:00a48",
  "jp": "私とアナタは似ていますね。\n同じ、犠牲の上に立つ者。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x26a6"
  ],
  "who": "エンリエッタ"
 },
 {
  "id": "s2069:00a7c",
  "jp": "私は、犠牲の上に立てる程\n大それた者でもないさ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x26c0"
  ],
  "who": "フィービー"
 },
 {
  "id": "s2069:00aac",
  "jp": "一緒にするな。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x26d5"
  ],
  "who": "フィービー"
 },
 {
  "id": "s2069:00abb",
  "jp": "ガガンガ、ガンガングガガガン！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x27b0"
  ],
  "who": "ガング"
 },
 {
  "id": "s2069:00ada",
  "jp": "アナタだって、戦争の為に\n生み出された道具なのです。\n私達と、一緒なのですよ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x27c9"
  ],
  "who": "エンリエッタ"
 },
 {
  "id": "s2069:00b27",
  "jp": "アナタも私も、同じ\n“正義を目指すもの”",
  "en": "",
  "status": "todo",
  "slots": [
   "0x28a4"
  ],
  "who": "ユグドラ"
 },
 {
  "id": "s2069:00b4f",
  "jp": "もしも違う道があったらと\n思うと……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x28b9"
  ],
  "who": "ユグドラ"
 },
 {
  "id": "s2069:00b75",
  "jp": "違う道など、ありません。\nどんな事があろうと、ね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x28d2"
  ],
  "who": "エンリエッタ"
 },
 {
  "id": "s2069:00ba7",
  "jp": "アナタは、そうまでして……\nそうまでしてルキア皇国に\n勝ちたかったのですか！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x29ad"
  ],
  "who": "カミュル"
 },
 {
  "id": "s2069:00bf2",
  "jp": "ルキア皇国を討つのは、\n私だけの願いだけではないのですよ",
  "en": "",
  "status": "todo",
  "slots": [
   "0x29c6"
  ],
  "who": "エンリエッタ"
 },
 {
  "id": "s2069:00c2a",
  "jp": "アナタが思っているほど、\nルキア皇国は憎まれているんですよ",
  "en": "",
  "status": "todo",
  "slots": [
   "0x29d0"
  ],
  "who": "エンリエッタ"
 },
 {
  "id": "s2069:00c64",
  "jp": "アナタが、姉さんにベルガスを\n渡したわけ？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2aa4"
  ],
  "who": "アンヌ"
 },
 {
  "id": "s2069:00c8e",
  "jp": "彼女は、ルキア皇国の人間であり\nエルマーレ連合国の人間でも\nありますから。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2abd"
  ],
  "who": "エンリエッタ"
 },
 {
  "id": "s2069:00cd7",
  "jp": "こんな人に恨まれる様な事して。\n物好きもいたもんだわさ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2b91"
  ],
  "who": "パメラ"
 },
 {
  "id": "s2069:00d0f",
  "jp": "本当の物好きは、自分が物好きだと\n言う事に気がつかないもの\nなんですよ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2baa"
  ],
  "who": "エンリエッタ"
 },
 {
  "id": "s2069:00d56",
  "jp": "アナタの心を表すには、\nどれほどの悲しい詩を語れば\nいいのでしょうか……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2c7e"
  ],
  "who": "イータ"
 },
 {
  "id": "s2069:00d9f",
  "jp": "私を語るのに詩は必要ありません。\n事実と結果さえあれば、\n私は充分です。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2c97"
  ],
  "who": "エンリエッタ"
 },
 {
  "id": "s2069:00de6",
  "jp": "そんな……私の意思が……私の……\n犠牲が……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x2ef2"
  ],
  "voice": 3142,
  "who": "エンリエッタ"
 },
 {
  "id": "s2069:00e18",
  "jp": "これだけ攻めても、まだウィルが\n普通の人の倍はある……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x36dd"
  ],
  "voice": 3143,
  "who": "ルルゥ"
 },
 {
  "id": "s2069:00e54",
  "jp": "１７年って年月は、こうまで人を\n壊せるのか……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x36f6"
  ],
  "voice": 3144,
  "who": "イシュト"
 },
 {
  "id": "s2069:00e88",
  "jp": "フン、貴様らの１７年と、私達の\n１７年を一緒にするな。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x370b"
  ],
  "voice": 3145,
  "who": "ガリオレッド"
 },
 {
  "id": "s2069:00ec2",
  "jp": "ッ！？\n誰だお前は！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x37a9"
  ],
  "voice": 3146,
  "who": "イシュト"
 },
 {
  "id": "s2069:00eda",
  "jp": "誰？\nそれならば、そこの脳筋大男が\n知っているよ。",
  "en": "",
  "status": "todo",
  "slots": [
