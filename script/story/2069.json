 },
 {
  "id": "s2069:00f0f",
  "jp": "口の悪さは相変わらずだな。\nガリオレッド将軍。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x37d7"
  ],
  "voice": 3148,
  "who": "ザザーランド"
 },
 {
  "id": "s2069:00f41",
  "jp": "今は宰相だよ。\nザザーランド元将軍。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x37ec"
  ],
  "voice": 3149,
  "who": "ガリオレッド"
 },
 {
  "id": "s2069:00f69",
  "jp": "親父、こいつは、誰なんだ？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x3805"
  ],
  "voice": 3150,
  "who": "イシュト"
 },
 {
  "id": "s2069:00f88",
  "jp": "こいつの名前はガリオレッド。\n恐らくは、この戦争全ての\n黒幕となった男だ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x381e"
  ],
  "voice": 3151,
  "who": "ザザーランド"
 },
 {
  "id": "s2069:00fd8",
  "jp": "わーい、おかぁさーん！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1ad9",
   "0x1bc7"
  ],
  "who": "#73"
 },
 {
  "id": "s2069:00fef",
  "jp": "はいはい、あまりはしゃいで\n転ばないようにね。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1aeb",
   "0x1bd9"
  ],
  "who": "#76"
 },
 {
  "id": "s2069:0101d",
  "jp": "エンリエッタ様が来てから、\nこの地を狙って来る人達も\nいなくなりましたし。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1af2"
  ],
  "who": "#76"
 },
 {
  "id": "s2069:01066",
  "jp": "本当に、平和そのもの……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1af9"
  ],
  "who": "#76"
 },
 {
  "id": "s2069:01081",
  "jp": "お母さんプリンー。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1b0b"
  ],
  "who": "#73"
 },
 {
  "id": "s2069:01094",
  "jp": "ハイハイ。まってくださいねー。\nあ、アナタもお一つどうですか？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1b1d"
  ],
  "who": "#76"
 },
 {
  "id": "s2069:010d2",
  "jp": "本当に、ここはいいところです。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1b8c"
  ],
  "who": "#76"
 },
 {
  "id": "s2069:010f1",
  "jp": "いつまでも、この平和が続くと\nいいわね……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1ba4"
  ],
  "who": "#76"
 },
 {
  "id": "s2069:0111d",
  "jp": "隣で戦争が起こってるってのに、\nのん気なもんだねぇ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1beb"
  ],
  "who": "ザザーランド"
 },
 {
  "id": "s2069:01151",
  "jp": "俺達にも、あったんだよな。\nこんな時代が……。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1bf2"
  ],
  "who": "ザザーランド"
 },
 {
  "id": "s2069:0117f",
  "jp": "何時の間に、この景色が懐かしく\nなっちまったんだろうなぁ。",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1c0a"
  ],
  "who": "ザザーランド"
 },
 {
  "id": "s2069:011b9",
  "jp": "そ、それは、\nクリスタルと海底の薔薇！？",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1cb4"
  ],
  "who": "#47"
 },
 {
  "id": "s2069:011e1",
  "jp": "ありがとう、持ってきてくれた\nのかい？\nじゃあ、早速つくりますね！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1cbb"
  ],
  "who": "#47"
 },
 {
  "id": "s2069:01222",
  "jp": "出来た！　さ、最高の出来だ！",
  "en": "",
  "status": "todo",
  "slots": [
   "0x1d9d"
  ],
  "who": "#47"
 },
 {
  "id": "s2069:0123f",
  "jp": "これでまた一歩、ドクターに\n近づけたよ。ありがとう！",
  "en": "",
  "status": "todo",
